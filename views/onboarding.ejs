<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personalisasi & Verifikasi Profil | SkillSphere AI</title>
  <meta name="description" content="Personalisasi ruang belajar atau portal instruktur cerdas SkillSphere AI berdasarkan keahlian, institusi kelulusan, sertifikat, dan target karir.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">

  
  <style>
    .onboarding-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px;
      max-width: 680px;
      margin: 0 auto;
      width: 100%;
    }

    .onboarding-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .onboarding-progress-wrapper {
      margin-bottom: 28px;
    }

    .progress-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      font-size: 13px;
      flex-wrap: nowrap;
      gap: 10px;
    }

    .progress-left-info {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .progress-step-counter {
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
    }

    .role-indicator-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .progress-percent-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      flex-shrink: 0;
    }

    .progress-track {
      height: 6px;
      width: 100%;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      overflow: hidden;
      position: relative;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--accent-primary);
      border-radius: var(--radius-full);
      transition: width 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      width: 20%;
    }

    /* --- Framer Blur Animation Keyframes --- */
    @keyframes framerStepEnter {
      0% {
        opacity: 0;
        filter: blur(16px);
        transform: translateY(28px) scale(0.97);
      }
      60% {
        filter: blur(3px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes framerStepExit {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        filter: blur(16px);
        transform: translateY(-24px) scale(0.96);
      }
    }

    @keyframes framerStepExitBack {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
      100% {
        opacity: 0;
        filter: blur(16px);
        transform: translateY(24px) scale(0.96);
      }
    }

    .step-enter {
      animation: framerStepEnter 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }

    .step-exit {
      animation: framerStepExit 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    .step-exit-back {
      animation: framerStepExitBack 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    /* --- Question Container & Hero --- */
    .question-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 36px 32px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
      position: relative;
    }

    .question-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--accent-primary-light);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 4px 12px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 16px;
    }

    .question-title {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.35;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .question-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 26px;
    }

    /* --- Options Grid / Stack --- */
    .options-stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .options-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    @media (max-width: 600px) {
      .options-grid-2 {
        grid-template-columns: 1fr;
      }
      .question-card {
        padding: 24px 20px;
      }
    }

    .option-card-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 16px 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      position: relative;
    }

    .option-card-btn:hover {
      border-color: var(--text-primary);
      background: var(--bg-surface-subtle);
      transform: translateY(-2px) scale(1.01);
      box-shadow: var(--shadow-sm);
    }

    .option-card-btn:active {
      transform: scale(0.985);
    }

    .option-card-btn.selected {
      border-color: var(--text-primary);
      background: var(--accent-primary-light);
    }

    .option-icon-box {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      color: var(--text-primary);
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .option-card-btn:hover .option-icon-box {
      transform: scale(1.08);
    }

    .option-info {
      flex: 1;
    }

    .option-label {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .option-desc {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    .option-check-icon {
      color: var(--text-tertiary);
      font-size: 14px;
      opacity: 0;
      transition: all 0.2s ease;
    }

    .option-card-btn.selected .option-check-icon {
      opacity: 1;
      color: var(--text-primary);
    }

    /* Form step fields */
    .form-step-fields {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* --- Certificate Upload Dropzone & WebP Optimization Styles --- */
    .file-upload-dropzone {
      border: 2px dashed var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 22px 16px;
      text-align: center;
      background: var(--bg-surface-subtle);
      cursor: pointer;
      transition: all 0.22s ease;
      position: relative;
    }

    .file-upload-dropzone:hover, .file-upload-dropzone.dragover {
      border-color: var(--text-primary);
      background: var(--accent-primary-light);
    }

    .dropzone-icon {
      font-size: 28px;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .dropzone-title {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .dropzone-hint {
      font-size: 11.5px;
      color: var(--text-tertiary);
    }

    .webp-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      margin-top: 8px;
    }

    .cert-preview-box {
      display: none;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-subtle);
      margin-top: 10px;
      background: var(--bg-surface);
    }

    .cert-preview-img {
      width: 100%;
      max-height: 200px;
      object-fit: contain;
      display: block;
      background: rgba(0, 0, 0, 0.05);
    }

    .cert-preview-info {
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      border-top: 1px solid var(--border-subtle);
    }

    .cert-remove-btn {
      background: none;
      border: none;
      color: var(--color-danger);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* --- Navigation Footer Inside Card --- */
    .question-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 28px;
      padding-top: 18px;
      border-top: 1px solid var(--border-subtle);
    }

    .back-step-btn {
      background: none;
      border: none;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s ease;
      padding: 6px 10px;
      border-radius: var(--radius-md);
    }

    .back-step-btn:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    /* --- AI Persona Generation Final Slide --- */
    .ai-generating-view {
      text-align: center;
      padding: 48px 24px;
    }

    .ai-pulsing-orb {
      width: 72px;
      height: 72px;
      border-radius: var(--radius-full);
      background: var(--accent-primary-light);
      border: 1px solid var(--border-subtle);
      margin: 0 auto 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      color: var(--text-primary);
      animation: orbGlow 2s ease-in-out infinite;
    }

    @keyframes orbGlow {
      0%, 100% {
        box-shadow: 0 0 0 4px var(--accent-primary-light), 0 8px 24px rgba(0,0,0,0.1);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 0 12px var(--accent-primary-light), 0 12px 32px rgba(0,0,0,0.2);
        transform: scale(1.06);
      }
    }

    /* Mobile Responsive Rules for Onboarding */
    @media (max-width: 640px) {
      .onboarding-page {
        padding: 12px 16px 20px;
        max-width: 100%;
      }

      .onboarding-header {
        margin-bottom: 16px;
      }

      .onboarding-progress-wrapper {
        margin-bottom: 20px;
      }

      .question-card {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }

      .question-title {
        font-size: 21px;
        margin-bottom: 8px;
        line-height: 1.35;
      }

      .question-subtitle {
        font-size: 13px;
        margin-bottom: 20px;
      }

      .options-stack {
        gap: 10px;
      }

      .options-grid-2 {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .option-card-btn {
        padding: 13px 14px;
        gap: 12px;
      }

      .option-icon-box {
        width: 36px;
        height: 36px;
        font-size: 15px;
      }

      .option-label {
        font-size: 13.5px;
      }

      .option-desc {
        font-size: 11.5px;
      }

      .question-footer-nav {
        margin-top: 20px;
        padding-top: 14px;
      }
    }
  </style>

  <script>
    // Initial Theme Script to prevent flash
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="onboarding-page">
    <!-- Header Navigation -->
    <header class="onboarding-header">
      <a href="/" class="brand-logo" id="brand-home-link">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
          </svg>
        </div>
        <span>SkillSphere AI</span>
      </a>

      <!-- Theme Switcher -->
      <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode">
        <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
        <i class="fas fa-moon" id="theme-icon-moon"></i>
        <span id="theme-text">Mode Gelap</span>
      </button>
    </header>

    <!-- Progress Bar Tracker -->
    <div class="onboarding-progress-wrapper" id="progress-wrapper">
      <div class="progress-meta-row">
        <div class="progress-left-info">
          <span class="progress-step-counter" id="progress-counter">
            <i class="fas fa-wand-magic-sparkles" style="font-size: 11px;"></i>
            <span>Langkah <strong id="step-number-text">1</strong>/5</span>
          </span>
          <span class="role-indicator-badge" id="role-badge-display">
            <i class="fas fa-user-graduate" style="font-size: 10px;"></i> Siswa
          </span>
        </div>
        <span class="progress-percent-label" id="progress-percent-label">20% Selesai</span>
      </div>
      <div class="progress-track">
        <div class="progress-bar-fill" id="progress-fill" style="width: 20%;"></div>
      </div>
    </div>

    <!-- Main Container For Step Questions -->
    <main id="onboarding-container">
      
      <!-- ========================================================================= -->
      <!-- SECTION A: STUDENT ONBOARDING STEPS (If user role === 'student')           -->
      <!-- ========================================================================= -->
      <div id="flow-student">
        
        <!-- STUDENT STEP 1: Status Pendidikan & Aktivitas -->
        <div class="question-card step-enter" id="student-step-1" data-step="1">
          <div class="question-badge">
            <i class="fas fa-user-graduate"></i> Latar Belakang
          </div>
          <h1 class="question-title">Apa status pendidikan atau aktivitas utama Anda saat ini?</h1>
          <p class="question-subtitle">AI kami akan menyesuaikan tingkat kesulitan dan kedalaman materi pembelajaran untuk Anda.</p>

          <div class="options-stack">
            <div class="option-card-btn" data-key="education_status" data-value="Pelajar SMP / SMA / SMK">
              <div class="option-icon-box"><i class="fas fa-school"></i></div>
              <div class="option-info">
                <div class="option-label">Pelajar SMP / SMA / SMK</div>
                <div class="option-desc">Mempersiapkan dasar logika pemrograman & karir teknologi sejak dini</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="education_status" data-value="Mahasiswa (D3 / S1 / S2)">
              <div class="option-icon-box"><i class="fas fa-graduation-cap"></i></div>
              <div class="option-info">
                <div class="option-label">Mahasiswa (D3 / S1 / S2)</div>
                <div class="option-desc">Mendalami skill praktis, proyek akhir, dan persiapan karir profesional</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="education_status" data-value="Karyawan / Profesional">
              <div class="option-icon-box"><i class="fas fa-briefcase"></i></div>
              <div class="option-info">
                <div class="option-label">Karyawan / Profesional</div>
                <div class="option-desc">Upgrade keahlian teknologi terkini, efisiensi AI, dan promosi karir</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="education_status" data-value="Career Switcher / Umum">
              <div class="option-icon-box"><i class="fas fa-rocket"></i></div>
              <div class="option-info">
                <div class="option-label">Career Switcher / Umum</div>
                <div class="option-desc">Beralih haluan karir dari bidang non-IT menuju ekosistem digital</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>
          </div>
        </div>

        <!-- STUDENT STEP 2: Rentang Usia -->
        <div class="question-card" id="student-step-2" data-step="2" style="display: none;">
          <div class="question-badge">
            <i class="fas fa-cake-candles"></i> Rentang Usia
          </div>
          <h1 class="question-title">Berapa rentang usia Anda?</h1>
          <p class="question-subtitle">Membantu AI menyesuaikan gaya penyampaian materi dan studi kasus yang relevan.</p>

          <div class="options-grid-2">
            <div class="option-card-btn" data-key="age_range" data-value="Di bawah 18 Tahun">
              <div class="option-icon-box"><i class="fas fa-child"></i></div>
              <div class="option-info">
                <div class="option-label">< 18 Tahun</div>
                <div class="option-desc">Eksplorasi minat dasar</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="age_range" data-value="18 - 24 Tahun">
              <div class="option-icon-box"><i class="fas fa-user-astronaut"></i></div>
              <div class="option-info">
                <div class="option-label">18 - 24 Tahun</div>
                <div class="option-desc">Pembangunan portofolio</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="age_range" data-value="25 - 34 Tahun">
              <div class="option-icon-box"><i class="fas fa-user-tie"></i></div>
              <div class="option-info">
                <div class="option-label">25 - 34 Tahun</div>
                <div class="option-desc">Akselerasi & spesialisasi</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="age_range" data-value="35+ Tahun">
              <div class="option-icon-box"><i class="fas fa-compass"></i></div>
              <div class="option-info">
                <div class="option-label">35+ Tahun</div>
                <div class="option-desc">Penguasaan inovasi AI</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>
          </div>

          <div class="question-footer-nav">
            <button type="button" class="back-step-btn" data-target="1">
              <i class="fas fa-arrow-left"></i> Kembali
            </button>
          </div>
        </div>

        <!-- STUDENT STEP 3: Target Karir & Cita-Cita -->
        <div class="question-card" id="student-step-3" data-step="3" style="display: none;">
          <div class="question-badge">
            <i class="fas fa-bullseye"></i> Target Karir
          </div>
          <h1 class="question-title">Apa cita-cita atau target karir yang ingin Anda capai?</h1>
          <p class="question-subtitle">AI Roadmap generator akan merancang kurikulum belajar berbasis target ini.</p>

          <div class="options-stack">
            <div class="option-card-btn" data-key="career_goal" data-value="AI & Machine Learning Engineer">
              <div class="option-icon-box"><i class="fas fa-brain"></i></div>
              <div class="option-info">
                <div class="option-label">AI & Machine Learning Engineer</div>
                <div class="option-desc">LLM, Deep Learning, PyTorch, dan AI Model Deployment</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="career_goal" data-value="Backend & Cloud Engineer">
              <div class="option-icon-box"><i class="fas fa-server"></i></div>
              <div class="option-info">
                <div class="option-label">Backend & Cloud Engineer</div>
                <div class="option-desc">Node.js, Relational DB MySQL, Microservices, API Security</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="career_goal" data-value="Fullstack Web & Mobile Developer">
              <div class="option-icon-box"><i class="fas fa-laptop-code"></i></div>
              <div class="option-info">
                <div class="option-label">Fullstack Web & Mobile Developer</div>
                <div class="option-desc">React, Next.js, Flutter, Tailwind, Modern Architecture</div>
              </div>
              <i class="fas fa-check option-check-icon"></i>
            </div>

            <div class="option-card-btn" data-key="career_goal" data-value="Data Scientist & Business Intelligence">
              <div class="option-icon-box"><i class="fas fa-chart-pie"></i></div>
              <div class="option-info">
                <div class="option-label">Data Scientist & Business Intelligence</div>
                <div class="option-desc">Data Analytics, SQL Querying, Python Pandas, Visualisasi Data</div>
              </div>
