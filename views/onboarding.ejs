  <script>
    // --- 1. Theme Switcher Logic ---
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // --- 2. Role Detection (Student vs Tutor) ---
    let currentUserRole = 'student';
    const activeToken = localStorage.getItem('skillsphere_access_token');
    if (!activeToken) {
      window.location.href = '/login';
    }

    try {
      const savedUser = localStorage.getItem('skillsphere_user');
      if (savedUser) {
        const parsed = JSON.parse(savedUser);
        if (parsed.role === 'tutor') {
          currentUserRole = 'tutor';
        }
      }
    } catch (e) {}

    // Query param override if any
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('role') === 'tutor') {
      currentUserRole = 'tutor';
    }

    const roleBadgeDisplay = document.getElementById('role-badge-display');
    const flowStudent = document.getElementById('flow-student');
    const flowTutor = document.getElementById('flow-tutor');

    if (currentUserRole === 'tutor') {
      roleBadgeDisplay.textContent = 'Instruktur / Tutor';
      roleBadgeDisplay.innerHTML = '<i class="fas fa-chalkboard-user" style="margin-right:4px;"></i> Tutor';
      flowStudent.style.display = 'none';
      flowTutor.style.display = 'block';
    } else {
      roleBadgeDisplay.textContent = 'Peserta Belajar';
      roleBadgeDisplay.innerHTML = '<i class="fas fa-user-graduate" style="margin-right:4px;"></i> Siswa';
      flowStudent.style.display = 'block';
      flowTutor.style.display = 'none';
    }

    // --- 3. Step Navigation & Data Storage ---
    const personalizationData = {
      role: currentUserRole,
      // Student specific
      education_status: '',
      age_range: '',
      career_goal: '',
      learning_style: '',
      weekly_commitment: '',
      // Tutor specific
      specialization: '',
      institution_name: '',
      experience_years: 0,
      certificate_name: '',
      issuer: '',
      credential_url: '',
      certificate_file_url: '',
      certificate_image_base64: '',
      linkedin_url: '',
      portfolio_url: '',
      weekly_teaching_commitment: '',
    };

    let currentStep = 1;
    const totalSteps = 5;

    const progressFill = document.getElementById('progress-fill');
    const stepNumberText = document.getElementById('step-number-text');
    const progressPercentLabel = document.getElementById('progress-percent-label');
    const progressWrapper = document.getElementById('progress-wrapper');

    function updateProgressBar(step) {
      const percentage = Math.round((step / totalSteps) * 100);
      progressFill.style.width = percentage + '%';
      stepNumberText.textContent = step;
      if (progressPercentLabel) {
        progressPercentLabel.textContent = percentage + '% Selesai';
      }
    }

    function getStepElementId(stepNum) {
      return currentUserRole === 'tutor' ? `tutor-step-${stepNum}` : `student-step-${stepNum}`;
    }

    function goToStep(nextStep, isBack = false) {
      const currentEl = document.getElementById(getStepElementId(currentStep));
      const nextEl = document.getElementById(getStepElementId(nextStep));

      if (!currentEl || !nextEl) return;

      // Framer exit blur animation
      currentEl.className = isBack ? 'question-card step-exit-back' : 'question-card step-exit';

      setTimeout(() => {
        currentEl.style.display = 'none';
        nextEl.style.display = 'block';
        nextEl.className = 'question-card step-enter';
        currentStep = nextStep;
        updateProgressBar(currentStep);
      }, 300);
    }

    // Handle Option Card Clicks
    document.querySelectorAll('.option-card-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = btn.getAttribute('data-key');
        const value = btn.getAttribute('data-value');

        // Highlight selection
        btn.parentElement.querySelectorAll('.option-card-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');

        personalizationData[key] = value;

        // Auto transition to next step after brief click effect (280ms)
        setTimeout(() => {
          if (currentStep < totalSteps) {
            goToStep(currentStep + 1);
          } else {
            finishPersonalization();
          }
        }, 280);
      });
    });

    // Handle Back Buttons
    document.querySelectorAll('.back-step-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetStep = parseInt(btn.getAttribute('data-target'));
        goToStep(targetStep, true);
      });
    });

    // Tutor Step 2 Submit: Institution & Degree
    const btnSubmitTutorStep2 = document.getElementById('btn-submit-tutor-step2');
    if (btnSubmitTutorStep2) {
      btnSubmitTutorStep2.addEventListener('click', () => {
        const inst = document.getElementById('tutor-institution').value.trim();
        const degree = document.getElementById('tutor-degree').value.trim();
        if (!inst) {
          alert('Harap masukkan nama universitas / institusi kelulusan Anda.');
          return;
        }
        personalizationData.institution_name = degree ? `${inst} (${degree})` : inst;
        goToStep(3);
      });
    }

    // --- Tutor Step 4: Certificate File Dropzone & Image Handling ---
    const certDropzone = document.getElementById('tutor-cert-dropzone');
    const certFileInput = document.getElementById('tutor-cert-file-input');
    const certPreviewBox = document.getElementById('cert-preview-box');
    const certPreviewImg = document.getElementById('cert-preview-image');
    const certFileInfo = document.getElementById('cert-file-info');
    const certRemoveBtn = document.getElementById('cert-remove-btn');
    let uploadedCertificateBase64 = '';

    if (certDropzone && certFileInput) {
      certDropzone.addEventListener('click', () => certFileInput.click());

      certDropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        certDropzone.classList.add('dragover');
      });

      certDropzone.addEventListener('dragleave', () => {
        certDropzone.classList.remove('dragover');
      });

      certDropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        certDropzone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleCertificateFile(e.dataTransfer.files[0]);
        }
      });

      certFileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          handleCertificateFile(e.target.files[0]);
        }
      });
    }

    function handleCertificateFile(file) {
      if (!file.type.startsWith('image/')) {
        alert('Format file tidak didukung. Harap pilih file gambar sertifikat (JPG, PNG, WEBP).');
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        alert('Ukuran file terlalu besar. Maksimal 10MB.');
        return;
      }

      const reader = new FileReader();
      reader.onload = function(evt) {
        uploadedCertificateBase64 = evt.target.result;
        personalizationData.certificate_image_base64 = uploadedCertificateBase64;
        
        certPreviewImg.src = uploadedCertificateBase64;
        certFileInfo.textContent = `${file.name} (${Math.round(file.size / 1024)} KB) - Siap dikompresi ke WebP`;
        certPreviewBox.style.display = 'block';
        certDropzone.style.display = 'none';
      };
      reader.readAsDataURL(file);
    }

    if (certRemoveBtn) {
      certRemoveBtn.addEventListener('click', () => {
        uploadedCertificateBase64 = '';
        personalizationData.certificate_image_base64 = '';
        personalizationData.certificate_file_url = '';
        certFileInput.value = '';
        certPreviewBox.style.display = 'none';
        certDropzone.style.display = 'block';
      });
    }

    // Tutor Step 4 Submit: Certificate, LinkedIn & Portfolio
    const btnSubmitTutorStep4 = document.getElementById('btn-submit-tutor-step4');
    if (btnSubmitTutorStep4) {
      btnSubmitTutorStep4.addEventListener('click', () => {
        const certName = document.getElementById('tutor-cert-name').value.trim();
        const issuer = document.getElementById('tutor-cert-issuer').value.trim();
        const linkedinUrl = document.getElementById('tutor-linkedin-url').value.trim();
        const portfolioUrl = document.getElementById('tutor-portfolio-url').value.trim();

        personalizationData.certificate_name = certName;
        personalizationData.issuer = issuer;
        personalizationData.linkedin_url = linkedinUrl;
        personalizationData.portfolio_url = portfolioUrl;
        personalizationData.certificate_image_base64 = uploadedCertificateBase64;

        goToStep(5);
      });
    }

    // Skip Button -> Direct to dashboard
    document.getElementById('btn-skip-onboarding').addEventListener('click', () => {
      window.location.href = '/dashboard';
    });

    // --- 4. Final Submission & AI Persona Synthesis ---
    async function finishPersonalization() {
      progressWrapper.style.display = 'none';
      const currentEl = document.getElementById(getStepElementId(currentStep));
      const finishEl = document.getElementById('step-finish');

      if (currentEl) currentEl.className = 'question-card step-exit';
      setTimeout(() => {
        if (currentEl) currentEl.style.display = 'none';
        finishEl.style.display = 'block';
        finishEl.className = 'question-card step-enter';
      }, 300);

      const finishTitle = document.getElementById('ai-finish-title');
      const finishText = document.getElementById('ai-status-text');

      if (currentUserRole === 'tutor') {
        finishTitle.textContent = 'Memverifikasi Portal Pengajar Cerdas';
        finishText.textContent = 'Menyimpan spesialisasi, asal kelulusan, dan dokumen sertifikat Anda...';
      }

      const token = localStorage.getItem('skillsphere_access_token');

      try {
        const response = await fetch('/api/auth/personalize', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(token ? { 'Authorization': 'Bearer ' + token } : {}),
          },
          body: JSON.stringify(personalizationData),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          if (result.data) {
            localStorage.setItem('skillsphere_user', JSON.stringify(result.data));
          }

          finishText.innerHTML = `
            <span style="color:var(--color-success); font-weight:600;">
              <i class="fas fa-circle-check" style="margin-right:6px;"></i> ${currentUserRole === 'tutor' ? 'Portal tutor siap! Membuka Dashboard...' : 'Ruang belajar siap! Membuka Dashboard...'}
            </span>
          `;

          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1000);
        } else {
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1200);
        }
      } catch (e) {
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 1200);
      }
    }
  </script>
  <!-- PWA Service Worker & Install Prompt Banner -->
  <script src="/javascripts/pwa-installer.js"></script>
</body>
</html>
