  <script>
    // --- 1. Theme Switcher Logic ---
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // --- 2. Framer-Motion Style Transitions Between Screens ---
    const stepRole = document.getElementById('step-role-selection');
    const stepRegister = document.getElementById('step-register');
    const stepOtp = document.getElementById('step-otp');

    const cardChooseStudent = document.getElementById('card-choose-student');
    const cardChooseTutor = document.getElementById('card-choose-tutor');
    const btnChangeRole = document.getElementById('btn-change-role');

    const roleInput = document.getElementById('reg-role');
    const selectedRoleLabel = document.getElementById('selected-role-label');
    const selectedRoleIcon = document.getElementById('selected-role-icon');

    function selectRoleAndTransition(role) {
      roleInput.value = role;
      if (role === 'student') {
        selectedRoleLabel.textContent = 'Peserta Belajar (Siswa)';
        selectedRoleIcon.className = 'fas fa-user-graduate';
      } else {
        selectedRoleLabel.textContent = 'Pengajar / Tutor Ahli';
        selectedRoleIcon.className = 'fas fa-chalkboard-user';
      }

      // Framer exit blur animation
      stepRole.className = 'framer-exit-up';
      setTimeout(() => {
        stepRole.style.display = 'none';
        stepRegister.style.display = 'block';
        stepRegister.className = 'framer-enter-up';
        document.getElementById('reg-name').focus();
      }, 300);
    }

    cardChooseStudent.addEventListener('click', () => selectRoleAndTransition('student'));
    cardChooseTutor.addEventListener('click', () => selectRoleAndTransition('tutor'));

    cardChooseStudent.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectRoleAndTransition('student');
      }
    });

    cardChooseTutor.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectRoleAndTransition('tutor');
      }
    });

    // Change role button back to screen 1
    btnChangeRole.addEventListener('click', () => {
      stepRegister.className = 'framer-exit-down';
      setTimeout(() => {
        stepRegister.style.display = 'none';
        stepRole.style.display = 'block';
        stepRole.className = 'framer-enter-down';
      }, 300);
    });

    // --- 3. Password Visibility Toggle ---
    const regPasswordInput = document.getElementById('reg-password');
    const toggleRegPasswordBtn = document.getElementById('toggle-reg-password');
    const eyeIconReg = document.getElementById('eye-icon-reg');
    const eyeOffIconReg = document.getElementById('eye-off-icon-reg');

    toggleRegPasswordBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isPassword = regPasswordInput.getAttribute('type') === 'password';
      regPasswordInput.setAttribute('type', isPassword ? 'text' : 'password');
      if (isPassword) {
        eyeIconReg.style.display = 'none';
        eyeOffIconReg.style.display = 'inline-block';
      } else {
        eyeIconReg.style.display = 'inline-block';
        eyeOffIconReg.style.display = 'none';
      }
    });

    // --- 4. Alert Helpers ---
    function showAlert(elementId, type, message) {
      const banner = document.getElementById(elementId);
      banner.className = 'alert-box alert-' + type;
      banner.firstElementChild.textContent = message;
      banner.style.display = 'flex';
    }

    function hideAlert(elementId) {
      const banner = document.getElementById(elementId);
      banner.style.display = 'none';
    }

    // --- 5. Local Storage Saved Accounts Helper ---
    const SAVED_ACCOUNTS_KEY = 'skillsphere_saved_accounts';

    function encodeSecret(str) {
      try {
        return btoa(encodeURIComponent(str));
      } catch (e) {
        return str;
      }
    }

    function saveAccountLocally(user, password) {
      if (!user || !user.email) return;
      try {
        let accounts = [];
        const raw = localStorage.getItem(SAVED_ACCOUNTS_KEY);
        if (raw) accounts = JSON.parse(raw);
        accounts = accounts.filter(acc => acc.email.toLowerCase() !== user.email.toLowerCase());

        accounts.unshift({
          name: user.name || user.email.split('@')[0],
          email: user.email,
          role: user.role || 'student',
          avatar_url: user.profile ? user.profile.avatar_url : null,
          secret: password ? encodeSecret(password) : null,
          last_logged_in: Date.now(),
        });

        if (accounts.length > 5) accounts = accounts.slice(0, 5);
        localStorage.setItem(SAVED_ACCOUNTS_KEY, JSON.stringify(accounts));
      } catch (err) {
        console.warn('Gagal menyimpan riwayat akun ke localStorage:', err);
      }
    }

    // --- 6. Registration Submission ---
    const registerForm = document.getElementById('register-form');
    const regSubmitBtn = document.getElementById('reg-submit-btn');
    const regSpinner = document.getElementById('reg-spinner');
    const regBtnText = document.getElementById('reg-btn-text');
    const targetEmailDisplay = document.getElementById('target-email-display');

    let registeredEmail = '';
    let registeredPassword = '';

    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert('alert-banner-reg');

      const name = document.getElementById('reg-name').value.trim();
      const email = document.getElementById('reg-email').value.trim();
      const password = document.getElementById('reg-password').value;
      const role = roleInput.value;

      if (!name || !email || !password) {
        showAlert('alert-banner-reg', 'danger', 'Harap lengkapi semua data wajib.');
        return;
      }

      if (password.length < 6) {
        showAlert('alert-banner-reg', 'danger', 'Password minimal 6 karakter.');
        return;
      }

      const termsCheckbox = document.getElementById('terms-agree-checkbox');
      if (termsCheckbox && !termsCheckbox.checked) {
        showAlert('alert-banner-reg', 'danger', 'Anda wajib membaca dan menyetujui Ketentuan Layanan serta Kebijakan Privasi.');
        openLegalModal('terms');
        return;
      }

      regSubmitBtn.disabled = true;
      regSpinner.style.display = 'inline-block';
      regBtnText.textContent = 'Mendaftarkan & Mengirim OTP...';

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password, role }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          registeredEmail = email;
          registeredPassword = password;
          targetEmailDisplay.textContent = email;

          // Pre-save basic registration credentials in localStorage
          localStorage.setItem('skillsphere_last_registered_email', email);

          // Transition to OTP step with Framer animation
          stepRegister.className = 'framer-exit-up';
          setTimeout(() => {
            stepRegister.style.display = 'none';
            stepOtp.style.display = 'block';
            stepOtp.className = 'framer-enter-up';
            showAlert('alert-banner-otp', 'success', result.message || 'Kode OTP telah dikirim ke email Anda.');
            startResendCountdown();
            resetOtpDeck();
            setTimeout(() => otpBoxes[0].focus(), 300);
          }, 300);
        } else {
          showAlert('alert-banner-reg', 'danger', result.message || 'Pendaftaran gagal. Periksa kembali data Anda.');
          regSubmitBtn.disabled = false;
          regSpinner.style.display = 'none';
          regBtnText.textContent = 'Daftar & Kirim Kode OTP';
        }
      } catch (err) {
        showAlert('alert-banner-reg', 'danger', 'Gagal terhubung ke server.');
        regSubmitBtn.disabled = false;
        regSpinner.style.display = 'none';
        regBtnText.textContent = 'Daftar & Kirim Kode OTP';
      }
    });

    // =========================================================
    // --- 7. Card Deck Merging & Auto Verification Animation ---
    // =========================================================
    const otpContainer = document.getElementById('otp-inputs-container');
    const otpStatusContent = document.getElementById('otp-status-content');
    const successBadge = document.getElementById('otp-card-success-badge');
    const otpBoxes = [
      document.getElementById('otp-1'),
      document.getElementById('otp-2'),
      document.getElementById('otp-3'),
      document.getElementById('otp-4'),
      document.getElementById('otp-5'),
      document.getElementById('otp-6'),
    ];

    let isVerifying = false;

    function resetOtpDeck() {
      otpContainer.classList.remove('cards-stacked', 'verifying-stack', 'error-stack');
      successBadge.classList.remove('show');
      
      otpBoxes.forEach(box => {
        box.value = '';
        box.style.transform = '';
        box.style.zIndex = '';
        box.style.boxShadow = '';
        box.style.opacity = '1';
        box.style.filter = '';
        box.classList.remove('fanning-out');
        box.disabled = false;
      });

      const resendSec = document.querySelector('#step-otp .resend-section');
      if (resendSec) resendSec.style.visibility = '';
      const backBtn = document.getElementById('back-to-reg-btn');
      if (backBtn) backBtn.style.visibility = '';

      isVerifying = false;
      otpStatusContent.innerHTML = `
        <span class="otp-hint-text">
          <i class="fas fa-shield-halved"></i> Masukkan 6 digit kode dari email
        </span>
      `;
    }

    function stackCardsIntoDeck() {
      otpContainer.classList.add('cards-stacked', 'verifying-stack');
      const containerRect = otpContainer.getBoundingClientRect();
      const containerCenterX = containerRect.left + containerRect.width / 2;

      otpBoxes.forEach((box, i) => {
        const boxRect = box.getBoundingClientRect();
        const boxCenterX = boxRect.left + boxRect.width / 2;
        // Accurate translation so each box centers exactly regardless of screen width
        const translateX = containerCenterX - boxCenterX;
        const offset = i - (otpBoxes.length - 1) / 2; // -2.5, -1.5, -0.5, 0.5, 1.5, 2.5
        const rotateZ = offset * 2.8; // subtle dynamic card tilt
        const translateY = -Math.abs(offset) * 1.5;
        
        box.style.transform = `translateX(${translateX}px) translateY(${translateY}px) rotate(${rotateZ}deg) scale(0.97)`;
        box.style.zIndex = Math.round(20 - Math.abs(offset) * 2);
        box.style.boxShadow = `0 ${8 + Math.abs(offset)*2}px ${20 + Math.abs(offset)*3}px rgba(0,0,0,0.22)`;
        box.blur();
      });

      otpStatusContent.innerHTML = `
        <div class="otp-status-spinner"></div>
        <span style="font-weight:600; color:var(--text-primary);">Menyatukan kartu & memverifikasi kode...</span>
      `;
    }

    function fanOutCardsBackToPosition(errorMessage) {
      otpContainer.classList.remove('verifying-stack');
      otpContainer.classList.add('error-stack');

      otpStatusContent.innerHTML = `
        <i class="fas fa-circle-exclamation" style="color:var(--color-danger); font-size:15px;"></i>
        <span style="color:var(--color-danger); font-weight:600;">${errorMessage || 'Kode OTP salah atau kadaluarsa.'}</span>
      `;

      // Shake for 550ms, then smoothly fan back out to original positions
      setTimeout(() => {
        otpContainer.classList.remove('cards-stacked', 'error-stack');

        otpBoxes.forEach(box => {
          box.classList.add('fanning-out');
          box.style.transform = '';
          box.style.zIndex = '';
          box.style.boxShadow = '';
        });

        // After card fan-out transition completes (480ms)
        setTimeout(() => {
          otpBoxes.forEach(box => {
            box.value = '';
            box.classList.remove('fanning-out');
            box.disabled = false;
          });

          otpStatusContent.innerHTML = `
            <span class="otp-hint-text">
              <i class="fas fa-shield-halved"></i> Silakan masukkan 6 digit kode yang benar
            </span>
          `;

          isVerifying = false;
          otpBoxes[0].focus();
        }, 480);
      }, 550);
    }

    async function triggerAutoVerify(otpCode) {
      if (isVerifying || otpCode.length !== 6) return;
      isVerifying = true;
      hideAlert('alert-banner-otp');

      // 1. Trigger Card Stacking Animation (Slide together into a deck)
      stackCardsIntoDeck();

      try {
        const response = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail, otp: otpCode }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // 2. Success State: Pop-in Glowing Checkmark on top of Merged Cards
          setTimeout(() => {
            otpContainer.classList.remove('verifying-stack');
            otpBoxes.forEach(box => {
              box.style.opacity = '0.2';
              box.style.filter = 'blur(2px)';
            });

            successBadge.classList.add('show');

            // Clear text below checkmark as requested
            otpStatusContent.innerHTML = '';
            const resendSec = document.querySelector('#step-otp .resend-section');
            if (resendSec) resendSec.style.visibility = 'hidden';
            const backBtn = document.getElementById('back-to-reg-btn');
            if (backBtn) backBtn.style.visibility = 'hidden';

            // Save tokens & credentials to localStorage
            localStorage.setItem('skillsphere_access_token', result.data.accessToken);
            localStorage.setItem('skillsphere_refresh_token', result.data.refreshToken);
            localStorage.setItem('skillsphere_user', JSON.stringify(result.data.user));

            // Save account credentials to saved accounts for Quick Device / TouchID Login
            saveAccountLocally(result.data.user, registeredPassword);

            // Also persist credentials object for seamless session restoration
            localStorage.setItem('skillsphere_saved_credentials', JSON.stringify({
              email: result.data.user.email,
              name: result.data.user.name,
              role: result.data.user.role,
              secret: encodeSecret(registeredPassword)
            }));

            const hasCompletedOnboarding = result.data.user && result.data.user.profile && result.data.user.profile.study_preferences && result.data.user.profile.study_preferences.onboarding_completed;

            setTimeout(() => {
              if (result.data.user && result.data.user.role === 'student' && !hasCompletedOnboarding) {
                window.location.href = '/dashboard/onboarding';
              } else {
                window.location.href = '/dashboard';
              }
            }, 900);
          }, 350);
        } else {
          // 3. Error State: Shake deck and fan back out to initial positions
          setTimeout(() => {
            fanOutCardsBackToPosition(result.message);
          }, 350);
        }
      } catch (err) {
        setTimeout(() => {
          fanOutCardsBackToPosition('Koneksi ke server terputus.');
        }, 350);
      }
    }

    otpBoxes.forEach((box, index) => {
      box.addEventListener('input', (e) => {
        if (isVerifying) return;
        const value = e.target.value.replace(/\D/g, '');
        box.value = value ? value[0] : '';
        
        if (box.value && index < otpBoxes.length - 1) {
          otpBoxes[index + 1].focus();
        }

        const currentOtp = otpBoxes.map(b => b.value).join('');
        if (currentOtp.length === 6) {
          triggerAutoVerify(currentOtp);
        }
      });

      box.addEventListener('keydown', (e) => {
        if (isVerifying) return;
        if (e.key === 'Backspace' && !box.value && index > 0) {
          otpBoxes[index - 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        if (isVerifying) return;
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/\D/g, '');
        if (pasteData.length >= 6) {
          pasteData.substring(0, 6).split('').forEach((char, i) => {
            if (otpBoxes[i]) otpBoxes[i].value = char;
          });
          triggerAutoVerify(pasteData.substring(0, 6));
        }
      });
    });

    // --- 7. Resend OTP & Countdown Timer ---
    const resendOtpBtn = document.getElementById('resend-otp-btn');
    const resendTimer = document.getElementById('resend-timer');
    let timerInterval = null;

    function startResendCountdown() {
      let seconds = 60;
      resendOtpBtn.disabled = true;
      resendTimer.textContent = seconds;

      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        seconds--;
        resendTimer.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(timerInterval);
          resendOtpBtn.disabled = false;
          resendOtpBtn.innerHTML = '<i class="fas fa-rotate-right" style="font-size: 11px;"></i> Kirim Ulang Kode';
        }
      }, 1000);
    }

    resendOtpBtn.addEventListener('click', async () => {
      try {
        resendOtpBtn.disabled = true;
        const res = await fetch('/api/auth/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: registeredEmail }),
        });
        const result = await res.json();
        if (res.ok && result.success) {
          showAlert('alert-banner-otp', 'success', 'Kode OTP baru telah dikirim ke email.');
          resetOtpDeck();
          startResendCountdown();
          otpBoxes[0].focus();
        } else {
          showAlert('alert-banner-otp', 'danger', result.message || 'Gagal mengirim ulang OTP.');
          resendOtpBtn.disabled = false;
        }
      } catch (e) {
        showAlert('alert-banner-otp', 'danger', 'Gagal mengirim ulang OTP.');
        resendOtpBtn.disabled = false;
      }
    });

    // Back to registration form
    document.getElementById('back-to-reg-btn').addEventListener('click', () => {
      stepOtp.className = 'framer-exit-down';
      setTimeout(() => {
        stepOtp.style.display = 'none';
        stepRegister.style.display = 'block';
        stepRegister.className = 'framer-enter-down';
        regSubmitBtn.disabled = false;
        regSpinner.style.display = 'none';
        regBtnText.textContent = 'Daftar & Kirim Kode OTP';
      }, 300);
    });

    // --- 8. OAuth Social Signup Handler ---
    function handleOAuthSignup(provider) {
      const btn = provider === 'Google' ? document.getElementById('btn-reg-oauth-google') : document.getElementById('btn-reg-oauth-github');
      if (btn) {
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
      }
      // Pass selected role if user chose tutor on step 1
      const roleParam = selectedRole ? `?role=${selectedRole}` : '';
      window.location.href = `/api/auth/oauth/${provider.toLowerCase()}${roleParam}`;
    }

    // --- 9. Framer Exit Blur Transition to Login Page ---
    document.querySelectorAll('a[href="/login"]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const activeStep = document.getElementById('step-role-selection').style.display !== 'none' 
          ? document.getElementById('step-role-selection') 
          : document.getElementById('step-register');
        
        if (activeStep) {
          activeStep.className = 'framer-exit-up';
          setTimeout(() => {
            window.location.href = '/login';
          }, 280);
        } else {
          window.location.href = '/login';
        }
      });
    });

    // --- 10. Interactive Legal Modal & Scroll-To-Bottom Detection ---
    let currentLegalTab = 'terms';
    const hasReadDoc = {
      terms: false,
      privacy: false,
    };

    function openLegalModal(tab = 'terms') {
      const modal = document.getElementById('legal-doc-modal');
      if (!modal) return;
      modal.classList.add('active');
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      switchLegalDocTab(tab);
    }

    function closeLegalModal() {
      const modal = document.getElementById('legal-doc-modal');
      if (!modal) return;
      modal.classList.remove('active');
      setTimeout(() => {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }, 250);
    }

    function switchLegalDocTab(tab) {
      currentLegalTab = tab;
      const tabTerms = document.getElementById('tab-btn-terms');
      const tabPrivacy = document.getElementById('tab-btn-privacy');
      const contentTerms = document.getElementById('legal-content-terms');
      const contentPrivacy = document.getElementById('legal-content-privacy');
      const modalSubtitle = document.getElementById('legal-modal-subtitle');
      const scrollContainer = document.getElementById('legal-modal-body');

      if (tab === 'terms') {
        if (tabTerms) tabTerms.classList.add('active');
        if (tabPrivacy) tabPrivacy.classList.remove('active');
        if (contentTerms) contentTerms.style.display = 'block';
        if (contentPrivacy) contentPrivacy.style.display = 'none';
        if (modalSubtitle) modalSubtitle.textContent = 'Syarat dan Ketentuan Penggunaan Layanan SkillSphere AI';
      } else {
        if (tabTerms) tabTerms.classList.remove('active');
        if (tabPrivacy) tabPrivacy.classList.add('active');
        if (contentTerms) contentTerms.style.display = 'none';
        if (contentPrivacy) contentPrivacy.style.display = 'block';
        if (modalSubtitle) modalSubtitle.textContent = 'Kebijakan Privasi & Perlindungan Data Pribadi (UU PDP No. 27/2022)';
      }

      if (scrollContainer) {
        scrollContainer.scrollTop = 0;
      }
      updateScrollProgress();
    }

    function updateScrollProgress() {
      const scrollContainer = document.getElementById('legal-modal-body');
      const progressBar = document.getElementById('legal-scroll-progress');
      const percentLabel = document.getElementById('legal-scroll-percent');
      const noticeText = document.getElementById('legal-scroll-notice-text');
      const acceptBtn = document.getElementById('btn-accept-legal');

      if (!scrollContainer) return;

      const scrollTotal = scrollContainer.scrollHeight - scrollContainer.clientHeight;
      const currentScroll = scrollContainer.scrollTop;
      const percent = scrollTotal > 0 ? Math.min(Math.round((currentScroll / scrollTotal) * 100), 100) : 100;

      if (progressBar) progressBar.style.width = percent + '%';
      if (percentLabel) percentLabel.textContent = percent + '%';

      if (percent >= 94 || scrollTotal <= 20) {
        hasReadDoc[currentLegalTab] = true;
      }

      // If user has read the document in the current tab
      if (hasReadDoc[currentLegalTab]) {
        if (acceptBtn) {
          acceptBtn.disabled = false;
          acceptBtn.style.opacity = '1';
          acceptBtn.style.cursor = 'pointer';
          acceptBtn.style.pointerEvents = 'auto';
        }
        if (noticeText) {
          noticeText.innerHTML = '<i class="fas fa-circle-check" style="color: var(--color-success, #10b981); font-size: 14px;"></i> <span style="color: var(--text-primary); font-weight: 600;">Anda telah membaca seluruh dokumen ini. Silakan klik tombol setujui di bawah.</span>';
        }
      } else {
        if (acceptBtn) {
          acceptBtn.disabled = true;
          acceptBtn.style.opacity = '0.45';
          acceptBtn.style.cursor = 'not-allowed';
          acceptBtn.style.pointerEvents = 'none';
        }
        if (noticeText) {
          noticeText.innerHTML = '<i class="fas fa-arrow-down" style="color: var(--text-secondary); animation: bounceSoft 1.5s infinite;"></i> <span>Gulir sampai ke paling bawah untuk mengaktifkan tombol setujui.</span>';
        }
      }
    }

    function acceptLegalTerms() {
      const checkbox = document.getElementById('terms-agree-checkbox');
      hasReadDoc.terms = true;
      hasReadDoc.privacy = true;
      if (checkbox) {
        checkbox.checked = true;
      }
      closeLegalModal();
      showAlert('alert-banner-reg', 'success', 'Ketentuan Layanan dan Kebijakan Privasi telah disetujui.');
      setTimeout(() => hideAlert('alert-banner-reg'), 4000);
    }

    // Attach scroll and checkbox event listeners
    document.addEventListener('DOMContentLoaded', () => {
      const scrollBody = document.getElementById('legal-modal-body');
      if (scrollBody) {
        scrollBody.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateScrollProgress);
        });
      }

      // Checkbox click listener: triggers modal popup immediately when user attempts to check it
      const termsCheckbox = document.getElementById('terms-agree-checkbox');
      if (termsCheckbox) {
        termsCheckbox.addEventListener('click', (e) => {
          if (!hasReadDoc.terms) {
            e.preventDefault();
            termsCheckbox.checked = false;
            openLegalModal('terms');
          } else if (!termsCheckbox.checked) {
            // User manually unchecked
            hasReadDoc.terms = false;
            hasReadDoc.privacy = false;
          }
        });
      }

      // Close modal when clicking on backdrop
      const modalOverlay = document.getElementById('legal-doc-modal');
      if (modalOverlay) {
        modalOverlay.addEventListener('click', (e) => {
          if (e.target === modalOverlay) {
            closeLegalModal();
          }
        });
      }

      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const modal = document.getElementById('legal-doc-modal');
          if (modal && modal.classList.contains('active')) {
            closeLegalModal();
          }
        }
      });
    });
  </script>
  <!-- PWA Service Worker & Install Prompt Banner -->
  <script src="/javascripts/pwa-installer.js"></script>
</body>
