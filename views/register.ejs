<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Akun | SkillSphere AI</title>
  <meta name="description" content="Daftar akun SkillSphere AI untuk mengakses kursus AI terpersonalisasi, karir masa depan, atau menjadi pengajar ahli.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  
  <style>
    /* --- Framer Motion Blur & Spring Transitions --- */
    @keyframes framerSlideDownBlur {
      0% {
        opacity: 0;
        filter: blur(18px);
        transform: translateY(-36px) scale(0.96);
      }
      60% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes framerSlideUpBlur {
      0% {
        opacity: 0;
        filter: blur(18px);
        transform: translateY(36px) scale(0.96);
      }
      60% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes framerExitUpBlur {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: scale(1) translateY(0);
      }
      100% {
        opacity: 0;
        filter: blur(18px);
        transform: scale(0.95) translateY(-28px);
      }
    }

    @keyframes framerExitDownBlur {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: scale(1) translateY(0);
      }
      100% {
        opacity: 0;
        filter: blur(18px);
        transform: scale(0.95) translateY(28px);
      }
    }

    .framer-enter-down {
      animation: framerSlideDownBlur 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }

    .framer-enter-up {
      animation: framerSlideUpBlur 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }

    .framer-exit-up {
      animation: framerExitUpBlur 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    .framer-exit-down {
      animation: framerExitDownBlur 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    /* --- Large Framer Role Cards --- */
    .role-selection-stack {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin: 24px 0;
    }

    .role-big-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 18px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 16px;
      text-align: left;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      user-select: none;
    }

    .role-big-card:hover {
      border-color: var(--text-primary);
      background: var(--bg-surface-subtle);
      transform: translateY(-3px) scale(1.015);
      box-shadow: var(--shadow-md);
    }

    .role-big-card:active {
      transform: scale(0.985);
    }

    .role-big-icon-box {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-lg);
      background: var(--accent-primary-light);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--text-primary);
      flex-shrink: 0;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .role-big-card:hover .role-big-icon-box {
      transform: scale(1.1);
    }

    .role-big-info {
      flex: 1;
    }

    .role-big-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .role-big-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .role-big-badge {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
    }

    .role-big-desc {
      font-size: 12.5px;
      color: var(--text-secondary);
      line-height: 1.45;
    }

    .role-big-arrow {
      color: var(--text-tertiary);
      font-size: 14px;
      margin-left: 8px;
      transition: transform 0.2s ease, color 0.2s ease;
    }

    .role-big-card:hover .role-big-arrow {
      color: var(--text-primary);
      transform: translateX(4px);
    }

    /* --- Selected Role Banner in Form --- */
    .selected-role-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 10px 14px;
      margin-bottom: 20px;
      font-size: 13px;
    }

    .selected-role-tag {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .change-role-btn {
      background: none;
      border: none;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: color 0.2s ease;
      padding: 4px 6px;
      border-radius: var(--radius-sm);
    }

    .change-role-btn:hover {
      color: var(--text-primary);
      background: var(--bg-surface);
    }

    /* ========================================================= */
    /* --- OTP CARD DECK MERGING & FAN-OUT ANIMATION SYSTEM --- */
    /* ========================================================= */
    .otp-inputs-wrapper {
      position: relative;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      perspective: 1000px;
      overflow: visible;
      padding: 6px 0;
    }

    .otp-inputs-container {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: clamp(6px, 2.2vw, 10px);
      margin: 22px 0 16px;
      min-height: 64px;
      width: 100%;
      max-width: 380px;
    }

    .otp-digit-box {
      width: clamp(38px, 12.5vw, 48px);
      height: clamp(50px, 15.5vw, 58px);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      border-radius: var(--radius-md);
      font-family: var(--font-mono);
      font-size: clamp(20px, 6vw, 24px);
      font-weight: 700;
      text-align: center;
      color: var(--text-primary);
      outline: none;
      position: relative;
      flex-shrink: 1;
      min-width: 0;
      transition: transform 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.3s ease,
                  background-color 0.3s ease,
                  opacity 0.35s ease,
                  filter 0.35s ease;
      will-change: transform, box-shadow, opacity;
      box-shadow: var(--shadow-sm);
    }

    .otp-digit-box:focus {
      border-color: var(--text-primary);
      box-shadow: 0 0 0 2px var(--accent-primary-light);
      transform: translateY(-2px);
    }

    /* Card Stacked State */
    .otp-inputs-container.cards-stacked .otp-digit-box {
      cursor: default;
      pointer-events: none;
    }

    /* Shimmer Glow on Merged Card Stack while verifying */
    @keyframes cardStackPulse {
      0%, 100% {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25), 0 0 0 2px var(--accent-primary-light);
      }
      50% {
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.35), 0 0 0 5px var(--accent-primary-light);
      }
    }

    .otp-inputs-container.cards-stacked.verifying-stack .otp-digit-box {
      animation: cardStackPulse 1.2s ease-in-out infinite;
    }

    /* Error Shake on Merged Card Stack */
    @keyframes cardStackShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-9px) rotate(-1.5deg); }
      40%, 80% { transform: translateX(9px) rotate(1.5deg); }
    }

    .otp-inputs-container.cards-stacked.error-stack {
      animation: cardStackShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    .otp-inputs-container.cards-stacked.error-stack .otp-digit-box {
      border-color: var(--color-danger) !important;
      color: var(--color-danger) !important;
      background: var(--color-danger-bg) !important;
    }

    /* Success Card Checkmark Pop Badge */
    .otp-card-success-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      z-index: 60;
      pointer-events: none;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .otp-card-success-badge.show {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }

    .success-badge-circle {
      width: 62px;
      height: 62px;
      border-radius: var(--radius-full);
      background: var(--color-success);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      box-shadow: 0 12px 32px rgba(16, 185, 129, 0.45), 0 0 0 6px var(--color-success-bg);
      animation: successCircleBurst 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes successCircleBurst {
      0% { transform: scale(0.5); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 16px rgba(16, 185, 129, 0); }
      100% { transform: scale(1); }
    }

    /* Fan back out transition */
    .otp-digit-box.fanning-out {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.45s ease,
                  border-color 0.3s ease,
                  background-color 0.3s ease;
    }

    /* Verification Status Indicator Container */
    .otp-status-container {
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 8px 0 16px;
      text-align: center;
    }

    .otp-status-content {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all 0.25s ease;
    }

    .otp-status-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid var(--border-subtle);
      border-top-color: var(--text-primary);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    .otp-hint-text {
      font-size: 12.5px;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .email-sent-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 10px 0 16px;
    }

    .resend-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 14px;
    }

    .resend-btn {
      background: none;
      border: none;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      cursor: pointer;
      text-decoration: underline;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .resend-btn:disabled {
      color: var(--text-tertiary);
      cursor: not-allowed;
      text-decoration: none;
    }

    /* Mobile specific adjustments for register page */
    @media (max-width: 640px) {
      .role-selection-stack {
        gap: 10px;
        margin: 18px 0;
      }

      .role-big-card {
        padding: 14px 16px;
        gap: 12px;
      }

      .role-big-icon-box {
        width: 42px;
        height: 42px;
        font-size: 18px;
      }

      .role-big-title {
        font-size: 14.5px;
      }

      .role-big-desc {
        font-size: 12px;
      }
    }

    /* --- OAuth Social Buttons Resilience Styling --- */
    .oauth-divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 20px 0 16px;
      color: var(--text-tertiary);
      font-size: 12px;
      font-weight: 500;
    }

    .oauth-divider::before,
    .oauth-divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid var(--border-subtle);
    }

    .oauth-divider span {
      padding: 0 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 11px;
    }

    .oauth-grid {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 10px !important;
      width: 100% !important;
    }

    @media (max-width: 480px) {
      .oauth-grid {
        grid-template-columns: 1fr !important;
        gap: 8px !important;
      }
    }

    .oauth-btn {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 10px !important;
      padding: 11px 16px !important;
      border-radius: var(--radius-md) !important;
      background: var(--bg-surface) !important;
      border: 1px solid var(--border-subtle) !important;
      color: var(--text-primary) !important;
      font-size: 13.5px !important;
      font-weight: 500 !important;
      font-family: var(--font-sans) !important;
      text-decoration: none !important;
      cursor: pointer !important;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
      user-select: none !important;
      box-sizing: border-box !important;
      width: 100% !important;
    }

    .oauth-btn:hover {
      background: var(--bg-surface-subtle) !important;
      border-color: var(--border-strong) !important;
      transform: translateY(-1px) !important;
      box-shadow: var(--shadow-sm) !important;
    }

    .oauth-btn:active {
      transform: translateY(0) !important;
    }

    .oauth-icon {
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      min-height: 18px !important;
      max-width: 18px !important;
      max-height: 18px !important;
      display: inline-block !important;
      flex-shrink: 0 !important;
      vertical-align: middle !important;
    }

    /* --- Legal Terms & Privacy Modal Styles --- */
    .legal-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      opacity: 0;
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .legal-modal-overlay.active {
      display: flex;
      opacity: 1;
    }

    .legal-modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-2xl);
      max-width: 660px;
      width: 100%;
      max-height: 86vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.35);
      overflow: hidden;
      transform: scale(0.94) translateY(12px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .legal-modal-overlay.active .legal-modal-card {
      transform: scale(1) translateY(0);
    }

    .legal-tab-btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: var(--radius-md);
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }

    .legal-tab-btn.active {
      background: var(--bg-surface);
      border-color: var(--border-subtle);
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    .legal-doc-section {
      margin-bottom: 22px;
    }

    .legal-doc-section h4 {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .legal-doc-section p,
    .legal-doc-section li {
      font-size: 12.8px;
      color: var(--text-secondary);
      line-height: 1.65;
      margin: 0 0 6px;
    }

    .legal-doc-section ul {
      margin: 6px 0 10px 18px;
      padding: 0;
    }

    .terms-agree-box {
      margin-top: 14px;
      margin-bottom: 14px;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      transition: border-color 0.2s ease;
    }

    .terms-agree-box:hover {
      border-color: var(--border-strong);
    }

    @keyframes bounceSoft {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(3px); }
    }
  </style>

  <script>
    // Initial Theme Script to prevent flash
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="login-page">
    <!-- Header Navigation -->
    <header class="login-header">
      <a href="/" class="brand-logo" id="brand-home-link">
        <div class="brand-icon">
          <!-- 8-pointed Claude signature star -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
          </svg>
        </div>
        <span>SkillSphere AI</span>
      </a>

      <!-- Theme Switcher -->
      <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode">
        <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
        <i class="fas fa-moon" id="theme-icon-moon"></i>
        <span id="theme-text">Mode Gelap</span>
      </button>
    </header>

    <!-- Main Card Section -->
    <main class="login-main">
      <div class="login-card" style="max-width: 500px;">
        
        <!-- ========================================== -->
        <!-- STEP 1: Framer Animated Role Selection Box -->
        <!-- ========================================== -->
        <div id="step-role-selection" class="framer-enter-down">
          <div class="login-hero">
            <div class="claude-symbol">
              <i class="fas fa-compass" style="font-size: 18px;"></i>
            </div>
            <h1 class="login-title">Pilih Peran Anda</h1>
            <p class="login-subtitle">Pilih jalur untuk memulai perjalanan Anda di SkillSphere AI</p>
          </div>

          <!-- 2 Prominent Interactive Boxes with Framer animations -->
          <div class="role-selection-stack">
            <!-- Box 1: Siswa / Peserta Belajar -->
            <div class="role-big-card" id="card-choose-student" role="button" tabindex="0">
              <div class="role-big-icon-box">
                <i class="fas fa-user-graduate"></i>
              </div>
              <div class="role-big-info">
                <div class="role-big-title-row">
                  <span class="role-big-title">Peserta Belajar</span>
                  <span class="role-big-badge">Siswa</span>
                </div>
                <p class="role-big-desc">Akses kursus AI adaptif, AI mentor karir, kuis interaktif, dan sertifikat digital terverifikasi.</p>
              </div>
              <i class="fas fa-arrow-right role-big-arrow"></i>
            </div>

            <!-- Box 2: Pengajar / Tutor -->
            <div class="role-big-card" id="card-choose-tutor" role="button" tabindex="0">
              <div class="role-big-icon-box">
                <i class="fas fa-chalkboard-user"></i>
              </div>
              <div class="role-big-info">
                <div class="role-big-title-row">
                  <span class="role-big-title">Pengajar / Tutor</span>
                  <span class="role-big-badge">Bagi Hasil 80%</span>
                </div>
                <p class="role-big-desc">Publikasikan silabus & modul kursus, buka kelas interaktif, dan kelola dompet penghasilan mandiri.</p>
              </div>
              <i class="fas fa-arrow-right role-big-arrow"></i>
            </div>
          </div>

          <div style="margin-top: 24px; text-align: center; font-size: 13px; color: var(--text-secondary);">
