<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Kelas & Kurikulum Tutor | SkillSphere AI</title>
  <meta name="description" content="Studio kurikulum, upload materi multi-format, dan pengelolaan kelas Google Classroom style untuk Tutor SkillSphere AI.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <!-- Accessibility & Head Tracking Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/accessibility.css">

  <style>
    /* ========================================================= */
    /* --- GOOGLE CLASSROOM INTERIOR LAYOUT & CLAUDE THEME ----- */
    /* ========================================================= */
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      font-family: var(--font-sans);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    .classroom-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    /* Top Sticky Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 20px;
      height: 56px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      gap: 16px;
      box-sizing: border-box;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .classroom-sidebar-toggle-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      border: none;
      background: transparent;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.15s ease;
      flex-shrink: 0;
    }

    .classroom-sidebar-toggle-btn:hover {
      background: var(--bg-surface-subtle);
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .brand-logo span {
      font-family: 'Newsreader', serif;
      font-size: 19px;
      font-weight: 700;
      color: var(--text-primary);
      white-space: nowrap;
    }

    .header-breadcrumb {
      display: none;
    }

    /* Classroom Center Tabs (Forum, Tugas Kelas, Anggota) */
    .classroom-top-nav-tabs {
      display: flex;
      align-items: stretch;
      gap: 4px;
      margin: 0 auto;
      height: 56px;
    }

    .classroom-nav-tab {
      padding: 0 18px;
      height: 56px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap !important;
      transition: all 0.15s ease;
      position: relative;
      text-decoration: none;
      box-sizing: border-box;
    }

    .classroom-nav-tab span {
      white-space: nowrap !important;
    }

    .classroom-nav-tab:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .classroom-nav-tab.active {
      color: var(--text-primary);
      font-weight: 600;
    }

    .classroom-nav-tab.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--accent-primary);
      border-radius: 3px 3px 0 0;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn-dashboard-back {
      font-size: 12.5px;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .btn-dashboard-back:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
    }

    .theme-toggle-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .theme-toggle-btn:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .theme-toggle-btn #theme-text {
      display: none !important;
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 3px 10px 3px 3px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .user-profile-badge:hover {
      border-color: var(--border-strong);
    }

    .user-avatar-sm {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .user-name-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-primary);
      max-width: 100px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .logout-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .logout-btn:hover {
      color: var(--color-danger);
      border-color: var(--color-danger);
      background: var(--color-danger-bg);
    }

    .logout-btn span {
      display: none !important;
    }

    /* Container for Sidebar + Main Content */
    .classroom-app-container {
      display: flex;
      width: 100%;
      min-height: calc(100vh - 60px);
    }

    /* Google Classroom Drawer / Docked Sidebar */
    .classroom-sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(2px);
      z-index: 140;
    }

    .classroom-sidebar-backdrop.active {
      display: block;
    }

    .classroom-left-sidebar {
      width: 270px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 60px);
      position: sticky;
      top: 60px;
      transition: width 0.2s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      z-index: 90;
    }

    .classroom-left-sidebar.collapsed {
      width: 0;
      overflow: hidden;
      border-right: none;
    }

    .sidebar-scroll-body {
      padding: 12px 0 32px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sidebar-nav-group {
      display: flex;
      flex-direction: column;
      padding-right: 12px;
    }

    .sidebar-nav-pill {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 24px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 0 24px 24px 0;
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .sidebar-nav-pill:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-pill.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-icon {
      font-size: 16px;
      width: 22px;
      text-align: center;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .sidebar-nav-pill.active .sidebar-nav-icon {
      color: var(--text-primary);
    }

    .sidebar-divider-line {
      height: 1px;
      background: var(--border-subtle);
      margin: 8px 0;
    }

    .sidebar-section-header {
      padding: 10px 24px 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sidebar-class-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 8px 24px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 0 24px 24px 0;
      transition: all 0.15s ease;
      overflow: hidden;
      cursor: pointer;
    }

    .sidebar-class-row:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .sidebar-class-row.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .sidebar-class-circle {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: #FFFFFF;
      background: var(--accent-primary);
      flex-shrink: 0;
    }

    .sidebar-class-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1;
    }

    .sidebar-class-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 13px;
      color: var(--text-primary);
    }

    .sidebar-class-subtitle {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 11px;
      color: var(--text-tertiary);
    }

    /* Main Content Pane */
    .classroom-main-pane {
      flex: 1;
      min-width: 0;
      padding: 24px 32px 80px;
      max-width: 1180px;
      margin: 0 auto;
      width: 100%;
      box-sizing: border-box;
    }

    /* ========================================================= */
    /* --- TAB 1: FORUM (STREAM / HERO BANNER & 2-COLUMN) ------ */
    /* ========================================================= */
    .classroom-hero-banner {
      width: 100%;
      min-height: 210px;
      border-radius: var(--radius-xl);
      background: linear-gradient(135deg, #1F1E1B 0%, #2A2926 100%);
      color: #FFFFFF;
      padding: 28px 32px;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .classroom-hero-banner::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(15, 14, 13, 0.35) 0%, rgba(15, 14, 13, 0.85) 100%);
      z-index: 1;
      pointer-events: none;
    }

    .banner-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.85;
      filter: brightness(0.85);
      transition: transform 0.4s ease;
      z-index: 0;
    }

    .classroom-hero-banner:hover .banner-bg-img {
      transform: scale(1.02);
    }

    .banner-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .banner-badges {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }

    .banner-title {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 500;
      color: #FFFFFF;
      margin: 0;
      line-height: 1.25;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    }

    .banner-subtitle {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.88);
      margin: 0;
      max-width: 680px;
      line-height: 1.45;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .banner-footer-row {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    .banner-edit-btn {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #FFFFFF;
      padding: 7px 14px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .banner-edit-btn:hover {
      background: rgba(255, 255, 255, 0.28);
      color: #FFFFFF;
    }

    /* 2-Column Stream Layout */
    .classroom-stream-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      align-items: flex-start;
    }

    /* Left Card: Summary & Quick Info */
    .stream-info-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .info-card-header {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .info-metric-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .info-metric-item:last-child {
      border-bottom: none;
    }

    .info-metric-label {
      color: var(--text-secondary);
    }

    .info-metric-val {
      font-weight: 700;
      color: var(--text-primary);
    }

    .btn-stream-link {
      color: var(--accent-primary);
      font-size: 12.5px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      padding: 0;
      margin-top: 4px;
    }

    .btn-stream-link:hover {
      text-decoration: underline;
    }

    /* Right Feed Column */
    .stream-feed-column {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Stream Post Bar (Umumkan / Upload) */
    .stream-announcement-bar {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .stream-announcement-bar:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
    }

    .announcement-user-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      flex-shrink: 0;
    }

    .announcement-placeholder-text {
      font-size: 13.5px;
      color: var(--text-secondary);
      flex: 1;
    }

    /* Feed Items */
    .stream-post-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: all 0.15s ease;
    }

    .stream-post-item:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
    }

    .post-icon-circle {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .post-main-content {
      flex: 1;
      min-width: 0;
    }

    .post-title {
      font-size: 14.5px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      word-break: break-word;
    }

    .post-date-meta {
      font-size: 12px;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ========================================================= */
    /* --- TAB 2: TUGAS KELAS (CLASSWORK / CURRICULUM TREE) ---- */
    /* ========================================================= */
    .classwork-action-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .sections-container {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .section-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s ease;
    }

    .section-box:hover {
      border-color: var(--border-strong);
    }

    .section-header-bar {
      padding: 16px 22px;
      background: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .section-title-text {
      font-family: var(--font-serif);
      font-size: 19px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .material-list {
      padding: 6px 12px;
    }

    .material-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      margin: 4px 0;
      border: 1px solid transparent;
      background: var(--bg-surface);
      transition: all 0.15s ease;
      gap: 14px;
    }

    .material-item-row:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-subtle);
    }

    .material-icon-box {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }

    .material-info {
      flex: 1;
      min-width: 180px;
    }

    .material-title-text {
      font-weight: 600;
      font-size: 13.5px;
      color: var(--text-primary);
      margin-bottom: 3px;
    }

    .material-meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      color: var(--text-secondary);
      flex-wrap: wrap;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 600;
    }

    .status-active {
      background: var(--color-success-bg);
      color: var(--color-success);
      border: 1px solid var(--color-success);
    }

    .status-locked {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }

    /* ========================================================= */
    /* --- TAB 3: ANGGOTA (PEOPLE / CLASS MEMBERS) ------------- */
    /* ========================================================= */
    .people-section {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .people-section-header {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 500;
      color: var(--text-primary);
      border-bottom: 2px solid var(--accent-primary);
      padding-bottom: 12px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .people-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .people-item-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .people-item-row:last-child {
      border-bottom: none;
    }

    .people-avatar {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      flex-shrink: 0;
    }

    .people-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .people-email {
      font-size: 12px;
      color: var(--text-secondary);
    }

    /* Modals System (Upload, New Section, Media Preview) */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 14, 13, 0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
      box-sizing: border-box;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
      padding: 24px;
      position: relative;
      transform: translateY(8px) scale(0.98);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-sizing: border-box;
    }

    .modal-overlay.active .modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .modal-title {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0;
      display: flex;
      align-items: center;
    }

    .modal-close-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 16px;
      cursor: pointer;
      width: 32px;
      height: 32px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
    }

    .modal-close-btn:hover {
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
    }

    .input-field {
      width: 100%;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      font-size: 13.5px;
      color: var(--text-primary);
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      box-sizing: border-box;
    }

    .input-field:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    /* Toast System */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
      border-radius: var(--radius-lg);
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      min-width: 260px;
      max-width: 420px;
      pointer-events: auto;
      animation: toastSlideIn 0.25s ease;
    }

    @keyframes toastSlideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Multi-format Drag and Drop Zone */
    .drop-zone {
      border: 2px dashed var(--border-strong);
      border-radius: var(--radius-lg);
      padding: 32px 20px;
      text-align: center;
      background: var(--bg-surface-subtle);
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 20px;
    }

    .drop-zone.dragover {
      border-color: var(--accent-primary);
      background: var(--bg-surface);
    }

    .drop-zone-icon {
      font-size: 40px;
      color: var(--text-secondary);
      margin-bottom: 12px;
      transition: transform 0.2s ease;
    }

    .format-selector-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 8px;
      margin-bottom: 18px;
    }

    .format-card-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 6px;
      text-align: center;
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .format-card-btn:hover {
      border-color: var(--border-strong);
      color: var(--text-primary);
    }

    .format-card-btn.active {
      border-color: var(--accent-primary);
      background: var(--accent-primary);
      color: var(--accent-text);
    }

    .format-card-btn.active i {
      color: var(--accent-text);
    }

    .progress-bar-container {
      width: 100%;
      height: 6px;
      background: var(--border-subtle);
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-top: 14px;
      display: none;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--accent-primary);
      width: 0%;
      transition: width 0.2s ease;
    }

    .media-player-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000000;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .media-player-container video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Top Full-Width Verification Bar */
    .top-announcement-bar {
      background: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-subtle);
      padding: 10px 24px;
      font-size: 13px;
      color: var(--text-secondary);
      display: none;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
    }

    .top-announcement-content {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .top-bar-badge {
      background: var(--accent-primary);
      color: var(--accent-text);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: var(--radius-full);
    }

    .top-bar-cta {
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: underline;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* ========================================================= */
    /* --- RESPONSIVE STYLES (MOBILE & TABLET) ----------------- */
    /* ========================================================= */
    @media (max-width: 1024px) {
      .classroom-left-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        height: 100vh;
        z-index: 150;
        transform: translateX(-100%);
      }

      .classroom-left-sidebar.drawer-open {
        transform: translateX(0);
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.25);
      }
    }

    @media (max-width: 860px) {
      .navbar {
        padding: 8px 16px;
      }

      .header-breadcrumb {
        display: none;
      }

      .classroom-stream-grid {
        grid-template-columns: 1fr;
      }

      .classroom-main-pane {
        padding: 16px 16px 60px;
      }

      .classroom-hero-banner {
        min-height: 170px;
        padding: 20px;
      }

      .banner-title {
        font-size: 22px;
      }

      .banner-subtitle {
        font-size: 13px;
      }

      .classroom-top-nav-tabs {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .classroom-nav-tab {
        padding: 8px 12px;
        font-size: 13px;
        white-space: nowrap;
      }
    }

    @media (max-width: 640px) {
      .brand-logo span {
        font-size: 16px;
      }

      .theme-toggle-btn span,
      .logout-btn span,
      .user-profile-badge .user-name-label {
        display: none !important;
      }

      .theme-toggle-btn,
      .logout-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .user-profile-badge {
        padding: 0;
        background: transparent;
        border: none;
      }

      .user-profile-badge .user-avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 12px;
        border: 1.5px solid var(--border-subtle);
      }
    }
  </style>

  <script>
    // Initial Theme Script to prevent flash
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="classroom-shell">
    <!-- Top Full-Width Verification Announcement Bar -->
    <div class="top-announcement-bar" id="materials-verification-bar">
      <div class="top-announcement-content">
        <span class="top-bar-badge">Verifikasi Pengajar</span>
        <span class="top-bar-text">Akun Anda belum menyelesaikan verifikasi kualifikasi pengajar resmi SkillSphere AI.</span>
        <span>|</span>
        <a href="/dashboard" class="top-bar-cta">
          Ke Dashboard Verifikasi <i class="fas fa-arrow-right" style="font-size:10px;"></i>
        </a>
      </div>
    </div>

    <!-- Google Classroom Drawer Sidebar Backdrop -->
    <div class="classroom-sidebar-backdrop" id="classroom-sidebar-backdrop" onclick="toggleClassroomSidebar(false)"></div>

    <!-- Top Sticky Navigation Bar -->
    <header class="navbar">
      <div class="nav-brand-group">
        <!-- Sidebar Hamburger Button -->
        <button class="classroom-sidebar-toggle-btn" id="classroom-sidebar-toggle" onclick="toggleClassroomSidebar()" title="Menu Utama" aria-label="Menu Utama">
          <i class="fas fa-bars"></i>
        </button>

        <a href="/dashboard" class="brand-logo" style="text-decoration:none;">
          <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path opacity="0.38" d="M12 7.6L17.3 4.7L14.4 10L17.3 15.3L12 12.4L6.7 15.3L9.6 10L6.7 4.7Z" />
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span>SkillSphere AI</span>
        </a>
      </div>

      <!-- Center Tabs (Google Classroom Standard: Forum, Tugas kelas, Anggota) -->
      <nav class="classroom-top-nav-tabs">
        <button class="classroom-nav-tab active" id="tab-btn-forum" onclick="switchClassroomTab('forum')">
          <i class="fas fa-comments"></i>
          <span>Forum</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-classwork" onclick="switchClassroomTab('classwork')">
          <i class="fas fa-book-open"></i>
          <span>Tugas kelas</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-people" onclick="switchClassroomTab('people')">
          <i class="fas fa-user-group"></i>
          <span>Anggota</span>
        </button>
      </nav>

      <!-- Right Header Actions -->
      <div class="nav-actions">
        <!-- Back to Dashboard -->
        <a href="/dashboard" class="btn-dashboard-back" title="Kembali ke Dashboard Studio">
          <i class="fas fa-arrow-left"></i>
          <span>Dashboard</span>
        </a>

        <!-- Theme Toggle -->
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode" title="Ganti Mode Tampilan">
          <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
          <i class="fas fa-moon" id="theme-icon-moon"></i>
        </button>

        <!-- User Profile Pill (Clickable) -->
        <div class="user-profile-badge" onclick="window.location.href='/profile'" style="cursor:pointer;" title="Buka Pengaturan Profil Saya">
          <div class="user-avatar-sm" id="nav-avatar">T</div>
          <span class="user-name-label" id="nav-user-name">Memuat...</span>
        </div>

        <!-- Logout Button -->
        <button class="logout-btn" id="logout-btn" type="button" title="Keluar">
          <i class="fas fa-arrow-right-from-bracket"></i>
        </button>
      </div>
    </header>

    <!-- Google Classroom App Shell: Left Sidebar + Main Content -->
    <div class="classroom-app-container">
      <!-- Left Sidebar (Docked on Desktop, Drawer on Mobile) -->
      <aside class="classroom-left-sidebar" id="classroom-left-sidebar">
        <div class="sidebar-scroll-body">
          <div class="sidebar-nav-group">
            <a href="/dashboard" class="sidebar-nav-pill">
              <i class="fas fa-home sidebar-nav-icon"></i>
              <span>Beranda</span>
            </a>
            <a href="/dashboard" class="sidebar-nav-pill">
              <i class="fas fa-calendar-days sidebar-nav-icon"></i>
              <span>Kalender</span>
            </a>
          </div>

          <div class="sidebar-divider-line"></div>

          <!-- Section: Mengajar -->
          <div class="sidebar-section-header">
            <span>Mengajar</span>
            <i class="fas fa-chalkboard-user" style="font-size:13px; color:var(--text-tertiary);"></i>
          </div>

          <div class="sidebar-nav-group" id="sidebar-courses-list">
            <!-- Dynamically populated courses list -->
            <div style="padding:10px 24px; font-size:12px; color:var(--text-tertiary);">Memuat kelas...</div>
          </div>

          <div class="sidebar-divider-line"></div>

          <div class="sidebar-nav-group">
            <a href="/dashboard" class="sidebar-nav-pill">
              <i class="fas fa-clipboard-check sidebar-nav-icon"></i>
              <span>Periksa Tugas</span>
            </a>
            <a href="/profile" class="sidebar-nav-pill">
              <i class="fas fa-gear sidebar-nav-icon"></i>
              <span>Setelan Profil</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Right Main Content Area -->
      <main class="classroom-main-pane">
        
        <!-- ========================================================= -->
        <!-- TAB 1: FORUM (STREAM & HERO BANNER) --------------------- -->
        <!-- ========================================================= -->
        <div id="classroom-tab-forum" class="tab-pane-content">
          <!-- Course Hero Banner -->
          <section class="classroom-hero-banner" id="course-hero-banner">
            <img src="/icons/icon-512.png" id="banner-bg-img" class="banner-bg-img" alt="Sampul Kelas">
            
            <div class="banner-content">
              <div class="banner-badges">
                <span class="status-pill status-active" id="banner-status-badge">PUBLISHED</span>
                <span class="status-pill status-locked" id="banner-category-badge">Kategori</span>
                <span class="status-pill status-locked" id="banner-level-badge">Level</span>
              </div>
              <h1 class="banner-title" id="banner-course-title">Memuat Kelas Pembelajaran...</h1>
              <p class="banner-subtitle" id="banner-course-desc">Memuat deskripsi lengkap materi dan kurikulum...</p>
            </div>

            <div class="banner-footer-row">
              <div style="font-size:13px; color:rgba(255,255,255,0.85);" id="banner-tutor-name">
                <i class="fas fa-chalkboard-user" style="margin-right:6px;"></i> Pengajar: Tutor SkillSphere
              </div>

              <!-- WebP Thumbnail Upload Trigger -->
              <label for="thumb-file-input" class="banner-edit-btn">
                <i class="fas fa-camera"></i>
                <span>Ubah Sampul (WebP)</span>
              </label>
              <input type="file" id="thumb-file-input" accept="image/*" style="display:none;" onchange="handleThumbnailUpload(this)">
            </div>
          </section>

          <!-- 2-Column Stream Layout -->
          <div class="classroom-stream-grid">
            <!-- Left Info Card -->
            <div class="stream-info-card">
              <div class="info-card-header">
                <span>Ringkasan Kelas</span>
                <i class="fas fa-circle-info" style="color:var(--text-secondary);"></i>
              </div>

              <div class="info-metric-item">
                <span class="info-metric-label">Total Bab</span>
                <span class="info-metric-val" id="stream-stat-sections">0 Bab</span>
              </div>

              <div class="info-metric-item">
                <span class="info-metric-label">Total Materi</span>
                <span class="info-metric-val" id="stream-stat-materials">0 Unit</span>
              </div>

              <div class="info-metric-item">
                <span class="info-metric-label">Estimasi Durasi</span>
                <span class="info-metric-val" id="stream-stat-duration">0 Menit</span>
              </div>

              <div class="info-metric-item">
                <span class="info-metric-label">Harga Kelas</span>
                <span class="info-metric-val" id="stream-stat-price">Rp 0</span>
              </div>

              <button class="btn-stream-link" onclick="switchClassroomTab('classwork')">
                <span>Buka Tugas Kelas</span>
                <i class="fas fa-arrow-right" style="font-size:11px;"></i>
              </button>

              <div style="display:flex; flex-direction:column; gap:8px; margin-top:8px; padding-top:12px; border-top:1px solid var(--border-subtle);">
                <button class="btn btn-outline" style="width:100%; font-size:12px; padding:7px 10px;" onclick="openModal('new-section-modal')">
                  <i class="fas fa-folder-plus"></i> Tambah Bab
                </button>
                <button class="btn btn-primary" style="width:100%; font-size:12px; padding:7px 10px;" onclick="openUploadModal()">
                  <i class="fas fa-cloud-arrow-up"></i> Upload Materi
                </button>
              </div>
            </div>

            <!-- Right Feed Column -->
            <div class="stream-feed-column">
              <!-- Announcement / Post Trigger Bar -->
              <div class="stream-announcement-bar" onclick="openUploadModal()">
                <div class="announcement-user-avatar" id="announcement-avatar">T</div>
                <div class="announcement-placeholder-text">Umumkan materi pembelajaran atau upload konten baru ke kelas...</div>
                <button class="btn btn-outline" style="padding:6px 14px; font-size:12px; pointer-events:none;">
                  <i class="fas fa-paper-plane"></i>
                </button>
              </div>

              <!-- Published Materials Stream Feed List -->
              <div id="forum-materials-feed" style="display:flex; flex-direction:column; gap:12px;">
                <!-- Dynamically populated from activeCourse materials -->
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 2: TUGAS KELAS (CLASSWORK / ACCORDION CURRICULUM) ---- -->
        <!-- ========================================================= -->
        <div id="classroom-tab-classwork" class="tab-pane-content" style="display:none;">
          <div class="classwork-action-header">
            <div>
              <h2 style="font-family:var(--font-serif); font-size:24px; font-weight:500; margin:0 0 4px;">Struktur Kurikulum & Bab</h2>
              <p style="font-size:13px; color:var(--text-secondary); margin:0;">Susun materi video, slide PPT, dokumen PDF, dan atur urutan pembelajaran.</p>
            </div>

            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <button class="btn btn-outline" onclick="openModal('new-section-modal')">
                <i class="fas fa-folder-plus"></i> Tambah Bab Baru
              </button>
              <button class="btn btn-primary" onclick="openUploadModal()">
                <i class="fas fa-cloud-arrow-up"></i> Upload Materi Multi-Format
              </button>
            </div>
          </div>

          <!-- Curriculum Sections List -->
          <div class="sections-container" id="sections-container">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 3: ANGGOTA (PEOPLE / CLASS MEMBERS) ----------------- -->
        <!-- ========================================================= -->
        <div id="classroom-tab-people" class="tab-pane-content" style="display:none;">
          <!-- Pengajar Section -->
          <section class="people-section">
            <div class="people-section-header">
              <span>Pengajar</span>
            </div>
            <div class="people-list" id="people-tutors-list">
              <div class="people-item-row">
                <div class="people-avatar" id="people-tutor-avatar">T</div>
                <div>
                  <div class="people-name" id="people-tutor-name">Tutor SkillSphere</div>
                  <div class="people-email" id="people-tutor-email">tutor@skillsphere.id</div>
                </div>
              </div>
            </div>
          </section>

          <!-- Siswa Terdaftar Section -->
          <section class="people-section">
            <div class="people-section-header">
              <span>Siswa Terdaftar</span>
              <span style="font-family:var(--font-sans); font-size:13px; color:var(--text-secondary); font-weight:600;" id="people-student-count">0 Siswa</span>
            </div>
            <div class="people-list" id="people-students-list">
              <div style="padding:24px 0; text-align:center; color:var(--text-secondary); font-size:13px;">
                Belum ada siswa yang terdaftar di kelas ini. Kursus Anda siap diakses publik di katalog pembelajaran.
              </div>
            </div>
          </section>
        </div>

      </main>
    </div>

    <!-- ========================================================= -->
    <!-- MODALS (UPLOAD, CREATE SECTION, LIVE MEDIA PREVIEW) ----- -->
    <!-- ========================================================= -->

    <!-- Upload Multi-Format Material Modal -->
    <div class="modal-overlay" id="upload-material-modal">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title"><i class="fas fa-cloud-arrow-up" style="margin-right:8px;"></i> Upload Materi Kursus</h3>
          <button class="modal-close-btn" onclick="closeModal('upload-material-modal')"><i class="fas fa-xmark"></i></button>
        </div>

        <!-- Section Destination -->
        <div style="margin-bottom: 16px;">
          <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Pilih Bab Tujuan *</label>
          <select id="material-section-select" class="input-field" style="width:100%; font-size:13px;"></select>
        </div>

        <!-- Format Selector -->
        <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Tipe Konten Pembelajaran *</label>
        <div class="format-selector-grid">
          <div class="format-card-btn active" data-type="video" onclick="selectFormatType('video')">
            <i class="fas fa-file-video"></i>
            <span>Video MP4</span>
          </div>
          <div class="format-card-btn" data-type="ppt" onclick="selectFormatType('ppt')">
            <i class="fas fa-file-powerpoint"></i>
            <span>Slide PPT</span>
          </div>
          <div class="format-card-btn" data-type="pdf" onclick="selectFormatType('pdf')">
            <i class="fas fa-file-pdf"></i>
            <span>Dokumen PDF</span>
          </div>
          <div class="format-card-btn" data-type="doc" onclick="selectFormatType('doc')">
            <i class="fas fa-file-word"></i>
            <span>Word DOC</span>
          </div>
          <div class="format-card-btn" data-type="book" onclick="selectFormatType('book')">
            <i class="fas fa-book-open"></i>
            <span>Buku Digital</span>
          </div>
        </div>

        <!-- Drag and Drop Zone -->
        <div class="drop-zone" id="material-drop-zone" onclick="document.getElementById('material-file-input').click()">
          <i class="fas fa-cloud-arrow-up drop-zone-icon" id="drop-icon"></i>
          <div style="font-weight:600; font-size:14px; color:var(--text-primary);" id="drop-zone-text">Pilih atau Seret Berkas ke Sini</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;" id="drop-zone-sub">Maksimum ukuran file: 250 MB (Video MP4, PPTX, PDF, DOCX, ePUB)</div>
          <div class="progress-bar-container" id="upload-progress-container">
            <div class="progress-bar-fill" id="upload-progress-fill"></div>
          </div>
        </div>
        <input type="file" id="material-file-input" style="display:none;" onchange="handleMaterialFileSelected(this)">

        <!-- Title & Duration Inputs -->
        <div style="display:grid; grid-template-columns: 2fr 1fr; gap:12px; margin-bottom:16px;">
          <div>
            <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Judul Materi *</label>
            <input type="text" id="material-title-input" class="input-field" placeholder="Contoh: Arsitektur RESTful API & Keamanan JWT">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Durasi (Menit)</label>
            <input type="number" id="material-duration-input" class="input-field" value="15" min="1">
          </div>
        </div>

        <!-- Preview Toggle -->
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:24px; padding:12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
          <input type="checkbox" id="material-is-preview" style="width:16px; height:16px; accent-color:var(--accent-primary);">
          <div>
            <label for="material-is-preview" style="font-size:13px; font-weight:600; color:var(--text-primary); cursor:pointer;">Gratis untuk Preview Siswa</label>
            <div style="font-size:11px; color:var(--text-secondary);">Materi dapat ditonton oleh calon siswa sebelum membeli kursus</div>
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button class="btn btn-outline" onclick="closeModal('upload-material-modal')">Batal</button>
          <button class="btn btn-primary" id="btn-submit-upload" onclick="submitMaterialUpload()">
            <i class="fas fa-upload"></i> Unggah Materi
          </button>
        </div>
      </div>
    </div>

    <!-- Create Section Modal -->
    <div class="modal-overlay" id="new-section-modal">
      <div class="modal-card" style="max-width: 460px;">
        <div class="modal-header">
          <h3 class="modal-title">Tambah Bab / Modul Baru</h3>
          <button class="modal-close-btn" onclick="closeModal('new-section-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        <div style="margin-bottom: 20px;">
          <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Judul Bab *</label>
          <input type="text" id="new-section-title" class="input-field" placeholder="Contoh: Bab 2: Manajemen Basis Data Relasional">
        </div>
        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button class="btn btn-outline" onclick="closeModal('new-section-modal')">Batal</button>
          <button class="btn btn-primary" onclick="submitCreateSection()">
            <i class="fas fa-plus"></i> Buat Bab
          </button>
        </div>
      </div>
    </div>

    <!-- Live Media Previewer Modal -->
    <div class="modal-overlay" id="media-preview-modal">
      <div class="modal-card" style="max-width: 760px;">
        <div class="modal-header">
          <h3 class="modal-title" id="preview-modal-title">Pemutar Materi Pembelajaran</h3>
          <button class="modal-close-btn" onclick="closePreviewModal()"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div id="media-player-wrapper">
          <!-- Populated dynamically: Video / PDF / Doc -->
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px; flex-wrap:wrap; gap:10px;">
          <div style="font-size:12px; color:var(--text-secondary);" id="preview-file-info">-</div>
          <button class="btn btn-outline" onclick="closePreviewModal()">Tutup</button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toast-container"></div>
  </div>

  <script>
    // Theme Switcher
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Toast Notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: var(--color-success); font-size: 16px;"></i>';
      if (type === 'error') icon = '<i class="fas fa-circle-exclamation" style="color: var(--color-danger); font-size: 16px;"></i>';
      if (type === 'info') icon = '<i class="fas fa-circle-info" style="color: var(--text-primary); font-size: 16px;"></i>';

      toast.innerHTML = `${icon}<span>${escapeHtml(message)}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Modal Helpers
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // Tab Switcher (Forum, Tugas Kelas, Anggota)
    function switchClassroomTab(tabName) {
      const tabs = ['forum', 'classwork', 'people'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const pane = document.getElementById(`classroom-tab-${t}`);
        if (btn) btn.classList.toggle('active', t === tabName);
        if (pane) pane.style.display = (t === tabName) ? 'block' : 'none';
      });
    }

    // Classroom Sidebar Drawer Toggle
    function toggleClassroomSidebar(open) {
      const sidebar = document.getElementById('classroom-left-sidebar');
      const backdrop = document.getElementById('classroom-sidebar-backdrop');
      if (!sidebar) return;
      const isMobile = window.innerWidth <= 1024;
      if (isMobile) {
        const shouldOpen = (open !== undefined) ? open : !sidebar.classList.contains('drawer-open');
        if (shouldOpen) {
          sidebar.classList.add('drawer-open');
          if (backdrop) backdrop.classList.add('active');
          document.body.style.overflow = 'hidden';
        } else {
          sidebar.classList.remove('drawer-open');
          if (backdrop) backdrop.classList.remove('active');
          document.body.style.overflow = '';
        }
      } else {
        sidebar.classList.toggle('collapsed');
      }
    }

    // State Variables
    let currentCourses = [];
    let activeCourse = null;
    let currentUser = null;
    let selectedContentType = 'video';
    let selectedMaterialFile = null;

    const token = localStorage.getItem('skillsphere_access_token');
    if (!token) {
      window.location.href = '/login';
    }

    // Initialize User Session & Data
    document.addEventListener('DOMContentLoaded', () => {
      fetchUserProfile();
      loadTutorCourses();
      setupDragAndDrop();
      setupLogout();
    });

    async function fetchUserProfile() {
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          currentUser = json.data;
          document.getElementById('nav-user-name').textContent = currentUser.name || currentUser.email;
          document.getElementById('nav-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();
          document.getElementById('announcement-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();

          document.getElementById('people-tutor-name').textContent = currentUser.name || 'Tutor SkillSphere';
          document.getElementById('people-tutor-email').textContent = currentUser.email || 'tutor@skillsphere.id';
          document.getElementById('people-tutor-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();
          document.getElementById('banner-tutor-name').innerHTML = `<i class="fas fa-chalkboard-user" style="margin-right:6px;"></i> Pengajar: ${escapeHtml(currentUser.name || 'Tutor')}`;

          const apps = Array.isArray(currentUser.tutor_applications) ? currentUser.tutor_applications : [];
          const latestApp = apps.length > 0 ? apps[apps.length - 1] : null;
          const isVerifiedTutor = (currentUser.role === 'tutor' && latestApp && latestApp.status === 'approved') || currentUser.role === 'admin';

          const verifBar = document.getElementById('materials-verification-bar');
          if (verifBar) {
            verifBar.style.display = isVerifiedTutor ? 'none' : 'flex';
          }
        }
      } catch (err) {
        console.error('Failed to fetch user profile:', err);
      }
    }

    function setupLogout() {
      const logoutBtn = document.getElementById('logout-btn');
      if (!logoutBtn) return;
      logoutBtn.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + token }
          });
        } catch (_) {}
        localStorage.removeItem('skillsphere_access_token');
        localStorage.removeItem('skillsphere_refresh_token');
        window.location.href = '/login';
      });
    }

    // Load Tutor's Courses
    async function loadTutorCourses() {
      try {
        const res = await fetch('/api/courses/tutor/my-courses', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!res.ok || !json.success) {
          showToast(json.message || 'Gagal memuat kursus tutor.', 'error');
          return;
        }

        currentCourses = Array.isArray(json.data) ? json.data : [];

        if (!currentCourses.length) {
          document.getElementById('banner-course-title').textContent = 'Anda belum memiliki kelas.';
          document.getElementById('banner-course-desc').textContent = 'Silakan buat kelas baru melalui dashboard utama.';
          const crumbTitle = document.getElementById('crumb-course-title');
          if (crumbTitle) crumbTitle.textContent = 'Belum Ada Kelas';
          document.getElementById('sidebar-courses-list').innerHTML = `
            <div style="padding:10px 24px; font-size:12px; color:var(--text-tertiary);">Belum ada kelas diajar.</div>`;
          return;
        }

        renderSidebarCourses();

        const urlParams = new URLSearchParams(window.location.search);
        const courseIdParam = urlParams.get('courseId') || urlParams.get('course_id') || urlParams.get('id');
        const defaultId = courseIdParam ? parseInt(courseIdParam, 10) : currentCourses[0].id;

        changeActiveCourse(defaultId);

      } catch (err) {
        console.error('Failed to load courses:', err);
      }
    }

    // Render Courses in Sidebar
    function renderSidebarCourses() {
      const list = document.getElementById('sidebar-courses-list');
      if (!list) return;

      list.innerHTML = currentCourses.map(c => {
        const isActive = activeCourse && activeCourse.id === c.id;
        const initial = (c.title || 'K')[0].toUpperCase();
        return `
          <div class="sidebar-class-row${isActive ? ' active' : ''}" onclick="changeActiveCourse(${c.id}); toggleClassroomSidebar(false);" title="${escapeHtml(c.title)}">
            <div class="sidebar-class-circle">${initial}</div>
            <div class="sidebar-class-text">
              <span class="sidebar-class-title">${escapeHtml(c.title)}</span>
              <span class="sidebar-class-subtitle">${c.category ? escapeHtml(c.category.name) : 'Umum'} • ${(c.sections || []).length} Bab</span>
            </div>
          </div>
        `;
      }).join('');
    }

    // Change Active Course & Load Curriculum
    async function changeActiveCourse(courseId) {
      if (!courseId) return;
      try {
        const res = await fetch(`/api/courses/${courseId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (!json.success) return;

        activeCourse = json.data;
        renderSidebarCourses();
        renderActiveCourse(activeCourse);
      } catch (e) {
        console.error(e);
      }
    }

    function renderActiveCourse(course) {
      const rupiah = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 });

      // Breadcrumb & Hero Banner
      const crumbTitle = document.getElementById('crumb-course-title');
      if (crumbTitle) crumbTitle.textContent = course.title;
      document.getElementById('banner-course-title').textContent = course.title;
      document.getElementById('banner-course-desc').textContent = course.description || 'Tidak ada deskripsi tambahan.';
      document.getElementById('banner-status-badge').textContent = (course.status || 'draft').toUpperCase();
      document.getElementById('banner-category-badge').textContent = course.category ? course.category.name : 'Umum';
      document.getElementById('banner-level-badge').textContent = (course.level || 'beginner').toUpperCase();

      const bannerImg = document.getElementById('banner-bg-img');
      if (course.thumbnail_url) {
        bannerImg.src = course.thumbnail_url;
        bannerImg.style.display = 'block';
      } else {
        bannerImg.src = '';
        bannerImg.style.display = 'none';
      }

      const sections = course.sections || [];
      let totalMaterials = 0;
      let totalDuration = 0;
      const allMaterialsFlat = [];

      sections.forEach(s => {
        const mats = s.materials || [];
        totalMaterials += mats.length;
        mats.forEach(m => {
          totalDuration += (m.duration_minutes || 0);
          allMaterialsFlat.push({ ...m, section_title: s.title, section_id: s.id });
        });
      });

      // Stream Metrics
      document.getElementById('stream-stat-sections').textContent = `${sections.length} Bab`;
      document.getElementById('stream-stat-materials').textContent = `${totalMaterials} Unit`;
      document.getElementById('stream-stat-duration').textContent = `${totalDuration} Menit`;
      document.getElementById('stream-stat-price').textContent = rupiah.format(course.price || 0);

      // Render Upload Modal Section Selector
      const sectionSelect = document.getElementById('material-section-select');
      sectionSelect.innerHTML = sections.map(s => `
        <option value="${s.id}">${escapeHtml(s.title)}</option>
      `).join('');

      // Render Tab 1: Forum Stream Feed
      renderForumFeed(allMaterialsFlat);

      // Render Tab 2: Tugas Kelas (Curriculum Tree)
      renderClassworkSections(sections);
    }

    // Render Forum Stream Feed Items
    function renderForumFeed(materialsList) {
      const feedContainer = document.getElementById('forum-materials-feed');
      if (!materialsList.length) {
        feedContainer.innerHTML = `
          <div style="background:var(--bg-surface); border:1px dashed var(--border-subtle); border-radius:var(--radius-lg); padding:36px 20px; text-align:center; color:var(--text-secondary);">
            <i class="fas fa-clipboard-list" style="font-size:32px; color:var(--text-tertiary); margin-bottom:10px; display:block;"></i>
            <div style="font-weight:600; font-size:14px; color:var(--text-primary); margin-bottom:4px;">Belum Ada Materi Diumumkan</div>
            <div style="font-size:12.5px;">Klik "Upload Materi" untuk memposting video, slide, atau modul pembelajaran ke kelas ini.</div>
          </div>
        `;
        return;
      }

      feedContainer.innerHTML = materialsList.map(mat => {
        let icon = 'fa-file-video';
        if (mat.content_type === 'ppt') icon = 'fa-file-powerpoint';
        if (mat.content_type === 'pdf') icon = 'fa-file-pdf';
        if (mat.content_type === 'doc') icon = 'fa-file-lines';
        if (mat.content_type === 'book') icon = 'fa-book-open';

        return `
          <div class="stream-post-item" id="stream-item-${mat.id}">
            <div style="display:flex; align-items:center; gap:16px; flex:1; min-width:0;">
              <div class="post-icon-circle">
                <i class="fas ${icon}"></i>
              </div>
              <div class="post-main-content">
                <div class="post-title">${escapeHtml(mat.title)}</div>
                <div class="post-date-meta">
                  <span><i class="fas fa-folder" style="font-size:11px;"></i> ${escapeHtml(mat.section_title)}</span>
                  <span>•</span>
                  <span><i class="fas fa-clock" style="font-size:11px;"></i> ${mat.duration_minutes || 0} Menit</span>
                  <span>•</span>
                  <span>${mat.content_type.toUpperCase()}</span>
                  <span>•</span>
                  ${mat.is_preview ? '<span class="status-pill status-active">Gratis Preview</span>' : '<span class="status-pill status-locked">Terkunci</span>'}
                </div>
              </div>
            </div>

            <div style="display:flex; align-items:center; gap:8px;">
              <button class="btn btn-outline" style="padding:6px 12px; font-size:12px;" onclick="previewMaterial(${mat.id})">
                <i class="fas fa-play"></i> Putar / Lihat
              </button>
              <button class="logout-btn" style="padding:6px 10px; font-size:12px;" onclick="deleteMaterial(${mat.id}, '${escapeHtml(mat.title)}')" title="Hapus Materi">
                <i class="fas fa-trash-can"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    // Render Tab 2: Tugas Kelas Accordion
    function renderClassworkSections(sections) {
      const container = document.getElementById('sections-container');
      if (!sections.length) {
        container.innerHTML = `
          <div style="background:var(--bg-surface); border:1px dashed var(--border-subtle); border-radius:var(--radius-xl); padding:48px 24px; text-align:center;">
            <i class="fas fa-folder-open" style="font-size:36px; color:var(--text-tertiary); margin-bottom:14px; display:block;"></i>
            <h3 style="font-family:var(--font-serif); font-size:20px; color:var(--text-primary); margin-bottom:8px;">Belum Ada Bab Materi</h3>
            <p style="font-size:14px; color:var(--text-secondary); margin-bottom:20px; max-width:440px; margin-left:auto; margin-right:auto;">
              Buat bab pertama Anda untuk mulai mengunggah kurikulum multi-format.
            </p>
            <button class="btn btn-primary" onclick="openModal('new-section-modal')"><i class="fas fa-plus"></i> Buat Bab Pertama</button>
          </div>
        `;
        return;
      }

      container.innerHTML = sections.map(sec => {
        const materials = sec.materials || [];
        return `
          <div class="section-box" id="section-box-${sec.id}">
            <div class="section-header-bar">
              <div class="section-title-text">
                <i class="fas fa-folder" style="color:var(--text-secondary);"></i>
                <span>${escapeHtml(sec.title)}</span>
                <span style="font-family:var(--font-sans); font-size:12px; color:var(--text-secondary); font-weight:500;">(${materials.length} Materi)</span>
              </div>
              <div style="display:flex; align-items:center; gap:8px;">
                <button class="btn btn-outline" style="padding:6px 12px; font-size:12px;" onclick="openUploadModalForSection(${sec.id})">
                  <i class="fas fa-plus"></i> Tambah Materi
                </button>
                <button class="logout-btn" style="padding:6px 10px; font-size:12px;" onclick="deleteSection(${sec.id}, '${escapeHtml(sec.title)}')" title="Hapus Bab">
                  <i class="fas fa-trash-can"></i>
                </button>
              </div>
            </div>

            <div class="material-list">
              ${!materials.length ? `
                <div style="padding:24px; text-align:center; font-size:13px; color:var(--text-tertiary);">
                  Belum ada materi di bab ini. Klik "Tambah Materi" untuk mengunggah.
                </div>
              ` : materials.map((mat, index) => {
                let typeIcon = 'fa-video';
                if (mat.content_type === 'ppt') typeIcon = 'fa-file-powerpoint';
                if (mat.content_type === 'pdf') typeIcon = 'fa-file-pdf';
                if (mat.content_type === 'doc') typeIcon = 'fa-file-lines';
                if (mat.content_type === 'book') typeIcon = 'fa-book-open';

                return `
                  <div class="material-item-row" id="material-row-${mat.id}">
                    <div style="display:flex; align-items:center; gap:14px; flex:1; min-width:0;">
                      <div class="material-icon-box">
                        <i class="fas ${typeIcon}"></i>
                      </div>
                      <div class="material-info">
                        <div class="material-title-text">${escapeHtml(mat.title)}</div>
                        <div class="material-meta-row">
                          <span><i class="fas fa-clock" style="font-size:11px;"></i> ${mat.duration_minutes || 0} Menit</span>
                          <span>•</span>
                          <span>Tipe: ${mat.content_type.toUpperCase()}</span>
                          <span>•</span>
                          ${mat.is_preview ? '<span class="status-pill status-active"><i class="fas fa-unlock"></i> Gratis Preview</span>' : '<span class="status-pill status-locked"><i class="fas fa-lock"></i> Terkunci</span>'}
                        </div>
                      </div>
                    </div>

                    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                      <button class="btn btn-outline" style="padding:6px 12px; font-size:12px;" onclick="previewMaterial(${mat.id})">
                        <i class="fas fa-play"></i> Putar / Lihat
                      </button>
                      
                      <!-- Reorder Buttons -->
                      <button class="btn btn-outline" style="padding:6px 10px; font-size:11px;" onclick="moveMaterialOrder(${sec.id}, ${mat.id}, 'up')" title="Pindah ke Atas" ${index === 0 ? 'disabled style="opacity:0.35;"' : ''}>
                        <i class="fas fa-arrow-up"></i>
                      </button>
                      <button class="btn btn-outline" style="padding:6px 10px; font-size:11px;" onclick="moveMaterialOrder(${sec.id}, ${mat.id}, 'down')" title="Pindah ke Bawah" ${index === materials.length - 1 ? 'disabled style="opacity:0.35;"' : ''}>
                        <i class="fas fa-arrow-down"></i>
                      </button>

                      <button class="logout-btn" style="padding:6px 10px; font-size:12px;" onclick="deleteMaterial(${mat.id}, '${escapeHtml(mat.title)}')" title="Hapus Materi">
                        <i class="fas fa-trash-can"></i>
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('');
    }

    // Format Selector in Upload Modal
    function selectFormatType(type) {
      selectedContentType = type;
      document.querySelectorAll('.format-card-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-type') === type);
      });
    }

    // Drag and Drop Handling
    function setupDragAndDrop() {
      const dropZone = document.getElementById('material-drop-zone');
      if (!dropZone) return;
      ['dragenter', 'dragover'].forEach(name => {
        dropZone.addEventListener(name, (e) => {
          e.preventDefault();
          dropZone.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach(name => {
        dropZone.addEventListener(name, (e) => {
          e.preventDefault();
          dropZone.classList.remove('dragover');
        });
      });
      dropZone.addEventListener('drop', (e) => {
        if (e.dataTransfer.files.length) {
          handleFile(e.dataTransfer.files[0]);
        }
      });
    }

    function handleMaterialFileSelected(input) {
      if (input.files.length) {
        handleFile(input.files[0]);
      }
    }

    function handleFile(file) {
      selectedMaterialFile = file;
      document.getElementById('drop-zone-text').textContent = file.name;
      document.getElementById('drop-zone-sub').textContent = `Ukuran: ${(file.size / (1024 * 1024)).toFixed(2)} MB`;
      document.getElementById('drop-icon').className = 'fas fa-file-circle-check drop-zone-icon';
      document.getElementById('drop-icon').style.color = 'var(--color-success)';

      const nameWithoutExt = file.name.replace(/\.[^/.]+$/, "");
      if (!document.getElementById('material-title-input').value) {
        document.getElementById('material-title-input').value = nameWithoutExt;
      }

      const ext = file.name.split('.').pop().toLowerCase();
      if (['mp4', 'webm', 'mkv', 'mov'].includes(ext)) selectFormatType('video');
      else if (['ppt', 'pptx'].includes(ext)) selectFormatType('ppt');
      else if (['pdf'].includes(ext)) selectFormatType('pdf');
      else if (['doc', 'docx'].includes(ext)) selectFormatType('doc');
      else if (['epub', 'mobi'].includes(ext)) selectFormatType('book');
    }

    function openUploadModal() {
      selectedMaterialFile = null;
      document.getElementById('material-file-input').value = '';
      document.getElementById('drop-zone-text').textContent = 'Pilih atau Seret Berkas ke Sini';
      document.getElementById('drop-zone-sub').textContent = 'Maksimum ukuran file: 250 MB (Video MP4, PPTX, PDF, DOCX, ePUB)';
      document.getElementById('drop-icon').className = 'fas fa-cloud-arrow-up drop-zone-icon';
      document.getElementById('drop-icon').style.color = 'var(--text-secondary)';
      document.getElementById('material-title-input').value = '';
      document.getElementById('material-duration-input').value = '15';
      document.getElementById('material-is-preview').checked = false;
      document.getElementById('upload-progress-container').style.display = 'none';
      openModal('upload-material-modal');
    }

    function openUploadModalForSection(sectionId) {
      openUploadModal();
      document.getElementById('material-section-select').value = sectionId;
    }

    // Submit Material Upload
    async function submitMaterialUpload() {
      const sectionId = document.getElementById('material-section-select').value;
      const title = document.getElementById('material-title-input').value.trim();
      const duration = document.getElementById('material-duration-input').value;
      const isPreview = document.getElementById('material-is-preview').checked;

      if (!sectionId) {
        showToast('Pilih bab tujuan terlebih dahulu.', 'error');
        return;
      }
      if (!title) {
        showToast('Judul materi wajib diisi.', 'error');
        return;
      }
      if (!selectedMaterialFile) {
        showToast('Harap pilih berkas materi pembelajaran.', 'error');
        return;
      }

      const formData = new FormData();
      formData.append('section_id', sectionId);
      formData.append('title', title);
      formData.append('content_type', selectedContentType);
      formData.append('duration_minutes', duration);
      formData.append('is_preview', isPreview ? 'true' : 'false');
      formData.append('file', selectedMaterialFile);

      const btn = document.getElementById('btn-submit-upload');
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengunggah...';

      const progressContainer = document.getElementById('upload-progress-container');
      const progressFill = document.getElementById('upload-progress-fill');
      progressContainer.style.display = 'block';
      progressFill.style.width = '35%';

      try {
        progressFill.style.width = '70%';
        const res = await fetch('/api/materials', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + token },
          body: formData,
        });

        const json = await res.json();
        progressFill.style.width = '100%';

        if (res.ok && json.success) {
          showToast(`Materi "${title}" berhasil diunggah!`, 'success');
          closeModal('upload-material-modal');
          changeActiveCourse(activeCourse.id);
        } else {
          showToast(json.message || 'Gagal mengunggah materi.', 'error');
        }
      } catch (err) {
        showToast('Terjadi kesalahan jaringan saat upload.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-upload"></i> Unggah Materi';
      }
    }

    // Submit Create Section
    async function submitCreateSection() {
      const title = document.getElementById('new-section-title').value.trim();
      if (!title) {
        showToast('Judul bab wajib diisi.', 'error');
        return;
      }

      try {
        const res = await fetch(`/api/courses/${activeCourse.id}/sections`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title }),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Bab baru berhasil ditambahkan!', 'success');
          closeModal('new-section-modal');
          document.getElementById('new-section-title').value = '';
          changeActiveCourse(activeCourse.id);
        } else {
          showToast(json.message || 'Gagal membuat bab baru.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat membuat bab.', 'error');
      }
    }

    // Delete Section
    async function deleteSection(sectionId, sectionTitle) {
      if (!confirm(`Hapus bab "${sectionTitle}" beserta semua materi di dalamnya?`)) return;
      try {
        const res = await fetch(`/api/courses/sections/${sectionId}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Bab berhasil dihapus.', 'info');
          changeActiveCourse(activeCourse.id);
        } else {
          showToast(json.message || 'Gagal menghapus bab.', 'error');
        }
      } catch (e) {
        showToast('Gagal menghapus bab.', 'error');
      }
    }

    // Reorder Materials (Up / Down)
    async function moveMaterialOrder(sectionId, materialId, direction) {
      const sec = activeCourse.sections.find(s => s.id === sectionId);
      if (!sec) return;
      const materials = [...sec.materials];
      const idx = materials.findIndex(m => m.id === materialId);
      if (idx === -1) return;

      const targetIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (targetIdx < 0 || targetIdx >= materials.length) return;

      const temp = materials[idx];
      materials[idx] = materials[targetIdx];
      materials[targetIdx] = temp;

      const items = materials.map((m, i) => ({ id: m.id, order_index: i + 1 }));

      try {
        const res = await fetch('/api/materials/reorder', {
          method: 'PATCH',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ items }),
        });

        if (res.ok) {
          showToast('Urutan materi berhasil diperbarui.', 'success');
          changeActiveCourse(activeCourse.id);
        }
      } catch (e) {
        console.error(e);
      }
    }

    // Delete Material
    async function deleteMaterial(materialId, materialTitle) {
      if (!confirm(`Apakah Anda yakin ingin menghapus materi "${materialTitle}"? File pada server akan dibersihkan secara otomatis.`)) return;
      try {
        const res = await fetch(`/api/materials/${materialId}`, {
          headers: { 'Authorization': 'Bearer ' + token },
          method: 'DELETE'
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Materi dan berkas terkait berhasil dihapus.', 'info');
          changeActiveCourse(activeCourse.id);
        } else {
          showToast(json.message || 'Gagal menghapus materi.', 'error');
        }
      } catch (e) {
        showToast('Gagal menghapus materi.', 'error');
      }
    }

    // Live Media Previewer
    async function previewMaterial(materialId) {
      try {
        const res = await fetch(`/api/materials/${materialId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (!json.success) return;

        const mat = json.data;
        document.getElementById('preview-modal-title').textContent = mat.title;
        document.getElementById('preview-file-info').textContent = `Tipe: ${mat.content_type.toUpperCase()} • Durasi: ${mat.duration_minutes || 0} Menit • File: ${mat.file_url}`;

        const wrapper = document.getElementById('media-player-wrapper');

        if (mat.content_type === 'video') {
          wrapper.innerHTML = `
            <div class="media-player-container">
              <video controls autoplay poster="${activeCourse.thumbnail_url || ''}">
                <source src="${mat.file_url}" type="video/mp4">
                Browser Anda tidak mendukung pemutar video HTML5.
              </video>
            </div>
          `;
        } else if (mat.content_type === 'pdf') {
          wrapper.innerHTML = `
            <div style="width:100%; height:450px; border-radius:var(--radius-lg); overflow:hidden; border:1px solid var(--border-subtle);">
              <iframe src="${mat.file_url}" style="width:100%; height:100%; border:none;"></iframe>
            </div>
          `;
        } else {
          let icon = 'fa-file-lines';
          if (mat.content_type === 'ppt') icon = 'fa-file-powerpoint';
          if (mat.content_type === 'doc') icon = 'fa-file-word';
          if (mat.content_type === 'book') icon = 'fa-book-open';

          wrapper.innerHTML = `
            <div style="background:var(--bg-surface-subtle); border-radius:var(--radius-lg); padding:40px; text-align:center; border:1px solid var(--border-subtle);">
              <i class="fas ${icon}" style="font-size:48px; color:var(--text-secondary); margin-bottom:14px; display:block;"></i>
              <h4 style="font-family:var(--font-serif); font-size:18px; margin-bottom:8px;">Dokumen Pembelajaran ${mat.content_type.toUpperCase()}</h4>
              <p style="font-size:13px; color:var(--text-secondary); margin-bottom:18px;">Berkas siap diunduh atau dipelajari.</p>
              <a href="${mat.file_url}" target="_blank" class="btn btn-primary" style="display:inline-flex; text-decoration:none;">
                <i class="fas fa-download"></i> Unduh / Buka Dokumen
              </a>
            </div>
          `;
        }

        openModal('media-preview-modal');
      } catch (e) {
        showToast('Gagal memuat pratinjau materi.', 'error');
      }
    }

    function closePreviewModal() {
      const wrapper = document.getElementById('media-player-wrapper');
      const video = wrapper.querySelector('video');
      if (video) video.pause();
      wrapper.innerHTML = '';
      closeModal('media-preview-modal');
    }

    // Handle WebP Course Thumbnail Upload
    async function handleThumbnailUpload(input) {
      if (!input.files.length) return;
      const file = input.files[0];

      const formData = new FormData();
      formData.append('thumbnail', file);
      formData.append('quality', '85');
      formData.append('max_width', '1200');

      showToast('Mengompresi dan mengunggah thumbnail ke format WebP...', 'info');

      try {
        const uploadRes = await fetch('/api/media/upload/thumbnail', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + token },
          body: formData,
        });
        const uploadJson = await uploadRes.json();

        if (uploadRes.ok && uploadJson.success) {
          const webpUrl = uploadJson.data.relativeUrl;

          await fetch(`/api/courses/${activeCourse.id}`, {
            method: 'PUT',
            headers: {
              'Authorization': 'Bearer ' + token,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ thumbnail_url: webpUrl }),
          });

          activeCourse.thumbnail_url = webpUrl;
          const bannerImg = document.getElementById('banner-bg-img');
          if (bannerImg) {
            bannerImg.src = webpUrl;
            bannerImg.style.display = 'block';
          }
          showToast(`Sampul kursus berhasil dikonversi ke WebP (${uploadJson.data.savingsPercent} lebih hemat)!`, 'success');
        } else {
          showToast(uploadJson.message || 'Gagal mengunggah thumbnail.', 'error');
        }
      } catch (err) {
        showToast('Gagal memproses thumbnail.', 'error');
      }
    }
  </script>
  <!-- Accessibility & Head Tracking Script -->
  <script src="/javascripts/accessibility.js"></script>
</body>
</html>
