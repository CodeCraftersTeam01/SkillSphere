    // Format Selector in Upload Modal
    function selectFormatType(type) {
      selectedContentType = type;
      document.querySelectorAll('.format-card-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-type') === type);
      });
    }

    // Drag and Drop Handling
    function setupDragAndDrop() {
      const dropZone = document.getElementById('material-drop-zone');
      if (!dropZone) return;
      ['dragenter', 'dragover'].forEach(name => {
        dropZone.addEventListener(name, (e) => {
          e.preventDefault();
          dropZone.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach(name => {
        dropZone.addEventListener(name, (e) => {
          e.preventDefault();
          dropZone.classList.remove('dragover');
        });
      });
      dropZone.addEventListener('drop', (e) => {
        if (e.dataTransfer.files.length) {
          handleFile(e.dataTransfer.files[0]);
        }
      });
    }

    function handleMaterialFileSelected(input) {
      if (input.files.length) {
        handleFile(input.files[0]);
      }
    }

    function handleFile(file) {
      selectedMaterialFile = file;
      document.getElementById('drop-zone-text').textContent = file.name;
      document.getElementById('drop-zone-sub').textContent = `Ukuran: ${(file.size / (1024 * 1024)).toFixed(2)} MB`;
      document.getElementById('drop-icon').className = 'fas fa-file-circle-check drop-zone-icon';
      document.getElementById('drop-icon').style.color = 'var(--color-success)';

      const nameWithoutExt = file.name.replace(/\.[^/.]+$/, "");
      if (!document.getElementById('material-title-input').value) {
        document.getElementById('material-title-input').value = nameWithoutExt;
      }

      const ext = file.name.split('.').pop().toLowerCase();
      if (['mp4', 'webm', 'mkv', 'mov'].includes(ext)) selectFormatType('video');
      else if (['ppt', 'pptx'].includes(ext)) selectFormatType('ppt');
      else if (['pdf'].includes(ext)) selectFormatType('pdf');
      else if (['doc', 'docx'].includes(ext)) selectFormatType('doc');
      else if (['epub', 'mobi'].includes(ext)) selectFormatType('book');
    }

    let currentCreationMode = 'article';
    let currentPreviewMaterialId = null;

    function openStudentLearningRoom(materialId) {
      if (!activeCourse || !activeCourse.id) {
        showToast('Pilih kursus terlebih dahulu.', 'error');
        return;
      }
      const targetId = materialId || currentPreviewMaterialId;
      const url = targetId 
        ? `/courses/${activeCourse.id}/learn?material_id=${targetId}`
        : `/courses/${activeCourse.id}/learn`;
      window.open(url, '_blank');
    }

    function openExamCreator() {
      if (activeCourse && activeCourse.id) {
        window.location.href = '/tutor/exams?courseId=' + activeCourse.id;
      } else {
        window.location.href = '/tutor/exams';
      }
    }

    // -------------------------------------------------------------
    // EMBEDDED EXAM & QUIZ CREATOR IN TUTOR PORTAL (SPRINT 4)
    // -------------------------------------------------------------
    let portalCourseExams = [];
    let portalQuestions = [];
    let portalEditingExamId = null;

    async function loadPortalExam() {
      if (!activeCourse || !activeCourse.id) return;
      const titleEl = document.getElementById('portal-exam-course-title');
      if (titleEl) titleEl.textContent = 'Bank Soal, Kuis & Ujian: ' + activeCourse.title;

      populatePortalSectionSelect();

      try {
        const res = await fetch('/api/exams/course/' + activeCourse.id + '/all', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (json.success && json.data) {
          portalCourseExams = Array.isArray(json.data) ? json.data : (json.data.all_exams || []);
        } else {
          portalCourseExams = [];
        }
        renderPortalExamsList();
      } catch (err) {
        console.error('Error loading portal exams:', err);
        portalCourseExams = [];
        renderPortalExamsList();
      }
    }

    function populatePortalSectionSelect() {
      const select = document.getElementById('portal-exam-section-select');
      if (!select) return;

      const currentVal = select.value;
      let opts = '<option value="">-- Seluruh Kursus / Ujian Akhir Kelulusan --</option>';

      if (activeCourse && Array.isArray(activeCourse.sections)) {
        activeCourse.sections.forEach((sec, idx) => {
          opts += `<option value="${sec.id}">Bab ${idx + 1}: ${escapeHtml(sec.title)}</option>`;
        });
      }
      select.innerHTML = opts;
      if (currentVal) select.value = currentVal;
    }

    function renderPortalExamsList() {
      const container = document.getElementById('portal-exams-list-container');
      const badgeCount = document.getElementById('portal-exams-count-badge');
      if (badgeCount) badgeCount.textContent = `${portalCourseExams.length} Evaluasi Terdaftar`;
      if (!container) return;

      if (portalCourseExams.length === 0) {
        container.innerHTML = `
          <div style="padding:36px; text-align:center; background:var(--bg-surface); border:1px dashed var(--border-subtle); border-radius:var(--radius-lg); color:var(--text-secondary);">
            <i class="fas fa-file-circle-question" style="font-size:36px; margin-bottom:12px; display:block; color:var(--text-tertiary);"></i>
            <div style="font-weight:600; font-size:15px; margin-bottom:4px; color:var(--text-primary);">Belum Ada Kuis atau Ujian di Kelas Ini</div>
            <p style="font-size:13px; margin:0 0 16px;">Buat kuis per bab atau ujian kelulusan akhir agar pemahaman siswa teruji secara interaktif.</p>
            <button type="button" class="btn btn-primary" onclick="openNewExamForm()">
              <i class="fas fa-plus"></i> Buat Kuis / Ujian Pertama
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = portalCourseExams.map((ex, idx) => {
        let typeBadge = '';
        if (ex.exam_type === 'quiz') {
          typeBadge = '<span style="font-size:11px; font-weight:700; padding:3px 8px; border-radius:4px; background:rgba(59, 130, 246, 0.12); color:#2563EB;"><i class="fas fa-lightbulb"></i> KUIS BAB</span>';
        } else if (ex.exam_type === 'chapter_exam') {
          typeBadge = '<span style="font-size:11px; font-weight:700; padding:3px 8px; border-radius:4px; background:rgba(217, 119, 6, 0.12); color:#D97706;"><i class="fas fa-book-bookmark"></i> UJIAN BAB</span>';
        } else {
          typeBadge = '<span style="font-size:11px; font-weight:700; padding:3px 8px; border-radius:4px; background:rgba(16, 185, 129, 0.12); color:#059669;"><i class="fas fa-award"></i> UJIAN KELULUSAN RESMI</span>';
        }

        const sectionName = ex.section 
          ? `Bab Terkait: ${escapeHtml(ex.section.title)}`
          : 'Cakupan: Seluruh Materi Kelas';

        const questionsCount = Array.isArray(ex.questions) ? ex.questions.length : (ex.total_questions || 0);

        return `
          <div class="card" style="background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:16px 20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
            <div style="flex:1; min-width:260px;">
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap;">
                ${typeBadge}
                <span style="font-size:11px; color:var(--text-tertiary); font-family:var(--font-mono);"><i class="fas fa-folder-tree"></i> ${sectionName}</span>
              </div>
              <h4 style="font-family:var(--font-serif); font-size:17px; font-weight:600; margin:0 0 6px; color:var(--text-primary);">
                ${escapeHtml(ex.title)}
              </h4>
              <div style="display:flex; gap:14px; font-size:12px; color:var(--text-secondary); flex-wrap:wrap;">
                <span><i class="fas fa-bullseye" style="color:var(--accent-amber);"></i> Passing Grade: <strong>${ex.passing_score}%</strong></span>
                <span><i class="fas fa-clock" style="color:var(--accent-amber);"></i> Durasi: <strong>${ex.duration_minutes} Menit</strong></span>
                <span><i class="fas fa-circle-question" style="color:var(--accent-amber);"></i> Total: <strong>${questionsCount} Soal</strong></span>
              </div>
              ${ex.description ? `<p style="font-size:12px; color:var(--text-secondary); margin:6px 0 0; line-height:1.4;">${escapeHtml(ex.description)}</p>` : ''}
            </div>

            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
              <button type="button" class="btn btn-primary" style="font-size:12px; padding:7px 12px;" onclick="editPortalExam(${ex.id})">
                <i class="fas fa-pen-to-square"></i> Edit Soal
              </button>
              <button type="button" class="btn btn-outline" style="font-size:12px; padding:7px 12px;" onclick="window.open('/exam/' + ${ex.id}, '_blank')" title="Buka Ruang Ujian Siswa">
                <i class="fas fa-arrow-up-right-from-square"></i> Ruang Siswa
              </button>
              <button type="button" class="btn btn-outline" style="font-size:12px; padding:7px 12px; color:var(--color-danger); border-color:rgba(239, 68, 68, 0.3);" onclick="deletePortalExam(${ex.id}, '${escapeHtml(ex.title)}')" title="Hapus Ujian">
                <i class="fas fa-trash-can"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function onPortalExamTypeChange() {
      const type = document.getElementById('portal-exam-type').value;
      const durationInput = document.getElementById('portal-exam-duration');
      const titleInput = document.getElementById('portal-exam-title');

      if (type === 'quiz') {
        if (!titleInput.value || titleInput.value.includes('Ujian')) {
          titleInput.value = 'Kuis Singkat: ' + (activeCourse ? activeCourse.title : '');
        }
        durationInput.value = 20;
      } else if (type === 'chapter_exam') {
        if (!titleInput.value || titleInput.value.includes('Kuis')) {
          titleInput.value = 'Ujian Evaluasi Bab: ' + (activeCourse ? activeCourse.title : '');
        }
        durationInput.value = 45;
      } else if (type === 'final') {
        if (!titleInput.value || titleInput.value.includes('Kuis')) {
          titleInput.value = 'Ujian Kelulusan Resmi: ' + (activeCourse ? activeCourse.title : '');
        }
        durationInput.value = 60;
        document.getElementById('portal-exam-section-select').value = '';
      }
    }

    function openNewExamForm() {
      portalEditingExamId = null;
      populatePortalSectionSelect();

      document.getElementById('portal-editor-mode-title').textContent = 'Buat Ujian / Kuis Baru';
      document.getElementById('portal-exam-title').value = 'Kuis Bab 1: ' + (activeCourse ? activeCourse.title : '');
      document.getElementById('portal-exam-type').value = 'quiz';
      document.getElementById('portal-exam-passing').value = 75;
      document.getElementById('portal-exam-duration').value = 25;
      document.getElementById('portal-exam-desc').value = 'Jawab pertanyaan pilihan ganda berikut untuk menguji pemahaman materi ini.';

      portalQuestions = [createEmptyQuestion(1)];
      renderPortalQuestions();

      const editorCard = document.getElementById('portal-exam-editor-card');
      if (editorCard) {
        editorCard.style.display = 'block';
        editorCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
