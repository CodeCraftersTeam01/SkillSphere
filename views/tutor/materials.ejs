    function updateWordCount() {
      const editor = document.getElementById('material-rich-editor');
      const countEl = document.getElementById('editor-word-count');
      if (!editor || !countEl) return;
      const text = (editor.innerText || '').trim();
      const count = text ? text.split(/\s+/).length : 0;
      countEl.textContent = `${count} kata`;
    }

    function renderArticleHtml(text) {
      if (!text) return '';
      // If it already contains HTML tags, return directly
      if (/<(p|h[1-6]|ul|ol|li|blockquote|pre|code|div|strong|em|br|hr|span|a)[^>]*>/i.test(text)) {
        return text;
      }
      let md = text.trim();
      md = md.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      md = md.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      md = md.replace(/^# (.*$)/gim, '<h1>$1</h1>');
      md = md.replace(/^\> (.*$)/gim, '<blockquote><p>$1</p></blockquote>');
      md = md.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      md = md.replace(/\*(.*?)\*/g, '<em>$1</em>');
      md = md.replace(/`([^`]+)`/g, '<code>$1</code>');
      md = md.replace(/\n\n/g, '</p><p>');
      md = '<p>' + md + '</p>';
      return md;
    }

