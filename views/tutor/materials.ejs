    let isEditorInPreview = false;
    function toggleEditorLivePreview() {
      const writePanel = document.getElementById('editor-write-panel');
      const prevPanel = document.getElementById('editor-preview-panel');
      const prevContent = document.getElementById('editor-preview-content');
      const editor = document.getElementById('material-rich-editor');
      const btn = document.getElementById('btn-toggle-editor-preview');

      isEditorInPreview = !isEditorInPreview;

      if (isEditorInPreview) {
        if (writePanel) writePanel.style.display = 'none';
        if (prevPanel) prevPanel.style.display = 'block';
        if (prevContent && editor) {
          prevContent.innerHTML = renderArticleHtml(editor.innerHTML);
        }
        if (btn) {
          btn.classList.add('active');
          btn.innerHTML = '<i class="fas fa-pen-to-square"></i> <span>Kembali ke Editor</span>';
        }
      } else {
        if (prevPanel) prevPanel.style.display = 'none';
        if (writePanel) writePanel.style.display = 'block';
        if (btn) {
          btn.classList.remove('active');
          btn.innerHTML = '<i class="fas fa-eye"></i> <span>Pratinjau Siswa</span>';
