<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Kelas & Kurikulum Tutor | SkillSphere AI</title>
  <meta name="description" content="Studio kurikulum, upload materi multi-format, dan pengelolaan kelas Google Classroom style untuk Tutor SkillSphere AI.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <!-- Accessibility & Head Tracking Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <!-- Custom Alert & Toast Stylesheet & Script -->
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    /* ========================================================= */
    /* --- GOOGLE CLASSROOM INTERIOR LAYOUT & CLAUDE THEME ----- */
    /* ========================================================= */
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      font-family: var(--font-sans);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    .classroom-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    /* Top Sticky Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 20px;
      height: 56px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      gap: 16px;
      box-sizing: border-box;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .classroom-sidebar-toggle-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      border: none;
      background: transparent;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.15s ease;
      flex-shrink: 0;
    }

    .classroom-sidebar-toggle-btn:hover {
      background: var(--bg-surface-subtle);
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .brand-logo span {
      font-family: 'Newsreader', serif;
      font-size: 19px;
      font-weight: 700;
      color: var(--text-primary);
      white-space: nowrap;
    }

    .header-breadcrumb {
      display: none;
    }

    /* Classroom Center Tabs (Forum, Tugas Kelas, Anggota) */
    .classroom-top-nav-tabs {
      display: flex;
      align-items: stretch;
      gap: 4px;
      margin: 0 auto;
      height: 56px;
    }

    .classroom-nav-tab {
      padding: 0 18px;
      height: 56px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap !important;
      transition: all 0.15s ease;
      position: relative;
      text-decoration: none;
      box-sizing: border-box;
    }

    .classroom-nav-tab span {
      white-space: nowrap !important;
    }

    .classroom-nav-tab:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .classroom-nav-tab.active {
      color: var(--text-primary);
      font-weight: 600;
    }

    .classroom-nav-tab.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--accent-primary);
      border-radius: 3px 3px 0 0;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn-dashboard-back {
      font-size: 12.5px;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .btn-dashboard-back:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
    }

    .theme-toggle-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .theme-toggle-btn:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .theme-toggle-btn #theme-text {
      display: none !important;
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 3px 10px 3px 3px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .user-profile-badge:hover {
      border-color: var(--border-strong);
    }

    .user-avatar-sm {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .user-name-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-primary);
      max-width: 100px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .logout-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .logout-btn:hover {
      color: var(--color-danger);
      border-color: var(--color-danger);
      background: var(--color-danger-bg);
    }

    .logout-btn span {
      display: none !important;
    }

    /* Container for Sidebar + Main Content */
    .classroom-app-container {
      display: flex;
      width: 100%;
      min-height: calc(100vh - 60px);
    }

    /* Google Classroom Drawer / Docked Sidebar */
    .classroom-sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(2px);
      z-index: 140;
    }

    .classroom-sidebar-backdrop.active {
      display: block;
    }

    .classroom-left-sidebar {
      width: 270px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 60px);
      position: sticky;
      top: 60px;
      transition: width 0.2s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      z-index: 90;
    }

    .classroom-left-sidebar.collapsed {
      width: 0;
      overflow: hidden;
      border-right: none;
    }

    .sidebar-scroll-body {
      padding: 12px 0 32px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sidebar-nav-group {
      display: flex;
      flex-direction: column;
      padding-right: 12px;
    }

    .sidebar-nav-pill {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 24px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 0 24px 24px 0;
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .sidebar-nav-pill:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-pill.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-icon {
      font-size: 16px;
      width: 22px;
      text-align: center;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .sidebar-nav-pill.active .sidebar-nav-icon {
      color: var(--text-primary);
    }

    .sidebar-divider-line {
      height: 1px;
      background: var(--border-subtle);
      margin: 8px 0;
    }

    .sidebar-section-header {
      padding: 10px 24px 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sidebar-class-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 8px 24px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 0 24px 24px 0;
      transition: all 0.15s ease;
      overflow: hidden;
      cursor: pointer;
    }

    .sidebar-class-row:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .sidebar-class-row.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .sidebar-class-circle {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: #FFFFFF;
      background: var(--accent-primary);
      flex-shrink: 0;
    }

    .sidebar-class-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1;
    }

    .sidebar-class-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 13px;
      color: var(--text-primary);
    }

    .sidebar-class-subtitle {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 11px;
      color: var(--text-tertiary);
    }

    /* Main Content Pane */
    .classroom-main-pane {
      flex: 1;
      min-width: 0;
      padding: 24px 32px 80px;
      width: 100%;
      box-sizing: border-box;
    }

    /* ========================================================= */
    /* --- TAB 1: FORUM (STREAM / HERO BANNER & 2-COLUMN) ------ */
    /* ========================================================= */
    .classroom-hero-banner {
      width: 100%;
      min-height: 210px;
      border-radius: var(--radius-xl);
      background: linear-gradient(135deg, #1F1E1B 0%, #2A2926 100%);
      color: #FFFFFF;
      padding: 28px 32px;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .classroom-hero-banner::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(15, 14, 13, 0.35) 0%, rgba(15, 14, 13, 0.85) 100%);
      z-index: 1;
      pointer-events: none;
    }

    .banner-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.85;
      filter: brightness(0.85);
      transition: transform 0.4s ease;
      z-index: 0;
    }

    .classroom-hero-banner:hover .banner-bg-img {
      transform: scale(1.02);
    }

    .banner-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .banner-badges {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }

    .banner-title {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 500;
      color: #FFFFFF;
      margin: 0;
      line-height: 1.25;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    }

    .banner-subtitle {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.88);
      margin: 0;
      max-width: 680px;
      line-height: 1.45;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .banner-footer-row {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    .banner-edit-btn {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #FFFFFF;
      padding: 7px 14px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .banner-edit-btn:hover {
      background: rgba(255, 255, 255, 0.28);
      color: #FFFFFF;
    }

    /* 2-Column Stream Layout */
    .classroom-stream-grid {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      align-items: flex-start;
    }

    /* Left Card: Summary & Quick Info */
    .stream-info-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .info-card-header {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .info-metric-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .info-metric-item:last-child {
      border-bottom: none;
    }

    .info-metric-label {
      color: var(--text-secondary);
    }

    .info-metric-val {
      font-weight: 700;
      color: var(--text-primary);
    }

    .btn-stream-link {
      color: var(--accent-primary);
      font-size: 12.5px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      padding: 0;
      margin-top: 4px;
    }

    .btn-stream-link:hover {
      text-decoration: underline;
    }

    /* Right Feed Column */
    .stream-feed-column {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Stream Post Bar (Umumkan / Upload) */
    .stream-announcement-bar {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .stream-announcement-bar:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
    }

    .announcement-user-avatar {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      flex-shrink: 0;
    }

    .announcement-placeholder-text {
      font-size: 13.5px;
      color: var(--text-secondary);
      flex: 1;
    }

    /* Feed Items */
    .stream-post-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: all 0.15s ease;
    }

    .stream-post-item:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
    }

    .post-icon-circle {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      flex-shrink: 0;
    }

    .post-main-content {
      flex: 1;
      min-width: 0;
    }

    .post-title {
      font-size: 14.5px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      word-break: break-word;
    }

    .post-date-meta {
      font-size: 12px;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ========================================================= */
    /* --- TAB 2: TUGAS KELAS (CLASSWORK / CURRICULUM TREE) ---- */
    /* ========================================================= */
    .classwork-action-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 14px;
    }

    .sections-container {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .section-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s ease;
    }

    .section-box:hover {
      border-color: var(--border-strong);
    }

    .section-header-bar {
      padding: 16px 22px;
      background: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .section-title-text {
      font-family: var(--font-serif);
      font-size: 19px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .material-list {
      padding: 6px 12px;
    }

    .material-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      margin: 4px 0;
      border: 1px solid transparent;
      background: var(--bg-surface);
      transition: all 0.15s ease;
      gap: 14px;
    }

    .material-item-row:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-subtle);
    }

    .material-icon-box {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }

    .material-info {
      flex: 1;
      min-width: 180px;
    }

    .material-title-text {
      font-weight: 600;
      font-size: 13.5px;
      color: var(--text-primary);
      margin-bottom: 3px;
    }

    .material-meta-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      color: var(--text-secondary);
      flex-wrap: wrap;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 600;
    }

    .status-active {
      background: var(--color-success-bg);
      color: var(--color-success);
      border: 1px solid var(--color-success);
    }

    .status-locked {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }

    /* ========================================================= */
    /* --- TAB 3: ANGGOTA (PEOPLE / CLASS MEMBERS) ------------- */
    /* ========================================================= */
    .people-section {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px 28px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .people-section-header {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 500;
      color: var(--text-primary);
      border-bottom: 2px solid var(--accent-primary);
      padding-bottom: 12px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .people-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .people-item-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .people-item-row:last-child {
      border-bottom: none;
    }

    .people-avatar {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      flex-shrink: 0;
    }

    .people-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .people-email {
      font-size: 12px;
      color: var(--text-secondary);
    }

    /* Modals System (Upload, New Section, Media Preview) */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 14, 13, 0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
      box-sizing: border-box;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
      padding: 24px;
      position: relative;
      transform: translateY(8px) scale(0.98);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-sizing: border-box;
    }

    .modal-overlay.active .modal-card {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .modal-title {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0;
      display: flex;
      align-items: center;
    }

    .modal-close-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 16px;
      cursor: pointer;
      width: 32px;
      height: 32px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
    }

    .modal-close-btn:hover {
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
    }

    .input-field {
      width: 100%;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      font-size: 13.5px;
      color: var(--text-primary);
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      box-sizing: border-box;
    }

    .input-field:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    /* TinyMCE-style Visual Rich Text Editor Tokens */
    .editor-mode-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 18px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 12px;
      flex-wrap: wrap;
    }

    .editor-mode-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .editor-mode-btn:hover {
      background: var(--bg-surface);
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .editor-mode-btn.active {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .tinymce-container {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--bg-surface);
      margin-bottom: 16px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .tinymce-container:focus-within {
      border-color: var(--border-accent);
      box-shadow: 0 0 0 3px rgba(200, 168, 107, 0.15);
    }

    .tinymce-toolbar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 4px;
      padding: 8px 10px;
      background: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-subtle);
      user-select: none;
    }

    .toolbar-group {
      display: inline-flex;
      align-items: center;
      gap: 2px;
    }

    .tb-btn {
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      border: 1px solid transparent;
      background: transparent;
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
    }

    .tb-btn:hover {
      background: var(--bg-surface);
      border-color: var(--border-subtle);
    }

    .tb-btn.active {
      background: var(--accent-primary);
      color: var(--accent-text);
    }

    .tb-divider {
      width: 1px;
      height: 20px;
      background: var(--border-subtle);
      margin: 0 4px;
    }

    .tinymce-content-area {
      min-height: 260px;
      max-height: 440px;
      overflow-y: auto;
      padding: 18px 20px;
      font-family: var(--font-sans);
      font-size: 14.5px;
      line-height: 1.7;
      color: var(--text-primary);
      outline: none;
    }

    .tinymce-content-area:empty:before {
      content: attr(placeholder);
      color: var(--text-tertiary);
      pointer-events: none;
      display: block;
    }

    .tinymce-content-area h1,
    .tinymce-content-area h2,
    .tinymce-content-area h3,
    .prose-content h1,
    .prose-content h2,
    .prose-content h3 {
      font-family: var(--font-serif);
      margin: 20px 0 10px 0;
      color: var(--text-primary);
      font-weight: 600;
    }

    .tinymce-content-area h2,
    .prose-content h2 {
      font-size: 21px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 6px;
    }

    .tinymce-content-area h3,
    .prose-content h3 {
      font-size: 17px;
    }

    .tinymce-content-area p,
    .prose-content p {
      margin: 0 0 14px 0;
    }

    .tinymce-content-area ul,
    .tinymce-content-area ol,
    .prose-content ul,
    .prose-content ol {
      margin: 0 0 16px 0;
      padding-left: 24px;
    }

    .tinymce-content-area li,
    .prose-content li {
      margin-bottom: 6px;
    }

    .tinymce-content-area blockquote,
    .prose-content blockquote {
      margin: 16px 0;
      padding: 12px 18px;
      border-left: 3px solid var(--border-accent);
      background: var(--bg-surface-subtle);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      color: var(--text-secondary);
      font-style: italic;
    }

    .tinymce-content-area pre,
    .prose-content pre {
      background: #141413;
      color: #FAF9F5;
      padding: 14px 18px;
      border-radius: var(--radius-md);
      font-family: var(--font-mono);
      font-size: 13px;
      overflow-x: auto;
      margin: 16px 0;
      line-height: 1.5;
    }

    .tinymce-content-area code,
    .prose-content code {
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      padding: 2px 6px;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      border: 1px solid var(--border-subtle);
    }

    .tinymce-content-area pre code,
    .prose-content pre code {
      background: transparent;
      color: inherit;
      padding: 0;
      border: none;
    }

    .article-reader-preview-box {
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 26px 24px;
      max-height: 520px;
      overflow-y: auto;
      line-height: 1.75;
      color: var(--text-primary);
    }

    /* Toast System */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
      border-radius: var(--radius-lg);
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      min-width: 260px;
      max-width: 420px;
      pointer-events: auto;
      animation: toastSlideIn 0.25s ease;
    }

    @keyframes toastSlideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Multi-format Drag and Drop Zone */
    .drop-zone {
      border: 2px dashed var(--border-strong);
      border-radius: var(--radius-lg);
      padding: 32px 20px;
      text-align: center;
      background: var(--bg-surface-subtle);
      cursor: pointer;
      transition: all 0.2s ease;
      margin-bottom: 20px;
    }

    .drop-zone.dragover {
      border-color: var(--accent-primary);
      background: var(--bg-surface);
    }

    .drop-zone-icon {
      font-size: 40px;
      color: var(--text-secondary);
      margin-bottom: 12px;
      transition: transform 0.2s ease;
    }

    .format-selector-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 8px;
      margin-bottom: 18px;
    }

    .format-card-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 6px;
      text-align: center;
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .format-card-btn:hover {
      border-color: var(--border-strong);
      color: var(--text-primary);
    }

    .format-card-btn.active {
      border-color: var(--accent-primary);
      background: var(--accent-primary);
      color: var(--accent-text);
    }

    .format-card-btn.active i {
      color: var(--accent-text);
    }

    .progress-bar-container {
      width: 100%;
      height: 6px;
      background: var(--border-subtle);
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-top: 14px;
      display: none;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--accent-primary);
      width: 0%;
      transition: width 0.2s ease;
    }

    .media-player-container {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000000;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .media-player-container video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Top Full-Width Verification Bar */
    .top-announcement-bar {
      background: var(--bg-surface-subtle);
      border-bottom: 1px solid var(--border-subtle);
      padding: 10px 24px;
      font-size: 13px;
      color: var(--text-secondary);
      display: none;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
    }

    .top-announcement-content {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .top-bar-badge {
      background: var(--accent-primary);
      color: var(--accent-text);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: var(--radius-full);
    }

    .top-bar-cta {
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: underline;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* ========================================================= */
    /* --- RESPONSIVE STYLES (MOBILE & TABLET) ----------------- */
    /* ========================================================= */
    @media (max-width: 1024px) {
      .classroom-left-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        height: 100vh;
        z-index: 150;
        transform: translateX(-100%);
      }

      .classroom-left-sidebar.drawer-open {
        transform: translateX(0);
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.25);
      }
    }

    @media (max-width: 860px) {
      .navbar {
        padding: 8px 16px;
      }

      .header-breadcrumb {
        display: none;
      }

      .classroom-stream-grid {
        grid-template-columns: 1fr;
      }

      .classroom-main-pane {
        padding: 16px 16px 60px;
      }

      .classroom-hero-banner {
        min-height: 170px;
        padding: 20px;
      }

      .banner-title {
        font-size: 22px;
      }

      .banner-subtitle {
        font-size: 13px;
      }

      .classroom-top-nav-tabs {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .classroom-nav-tab {
        padding: 8px 12px;
        font-size: 13px;
        white-space: nowrap;
      }
    }

    @media (max-width: 640px) {
      .brand-logo span {
        font-size: 16px;
      }

      .theme-toggle-btn span,
      .logout-btn span,
      .user-profile-badge .user-name-label {
        display: none !important;
      }

      .theme-toggle-btn,
      .logout-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .user-profile-badge {
        padding: 0;
        background: transparent;
        border: none;
      }

      .user-profile-badge .user-avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 12px;
        border: 1.5px solid var(--border-subtle);
      }
    }

    /* Embedded Exam & Certificate Studio Styles */
    .tab-header-banner {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .question-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 20px;
      margin-bottom: 18px;
      transition: border-color 0.15s ease;
    }

    .question-card:focus-within {
      border-color: var(--accent-amber);
    }

    .question-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .question-badge {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 600;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      color: var(--text-primary);
    }

    .btn-delete-q {
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-danger, #EF4444);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: var(--radius-sm);
      transition: all 0.15s ease-out;
    }

    .btn-delete-q:hover {
      background: rgba(239, 68, 68, 0.1);
      border-color: var(--color-danger, #EF4444);
    }

    .option-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .option-radio {
      width: 18px;
      height: 18px;
      accent-color: var(--accent-amber);
      cursor: pointer;
      flex-shrink: 0;
    }

    .cert-preview-card-wrapper {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      justify-content: center;
    }

    .portal-cert-canvas {
      width: 100%;
      max-width: 650px;
      aspect-ratio: 1.414 / 1;
      background: #FAF9F5;
      color: #141413;
      border: 8px double #B45309;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
      border-radius: 6px;
      padding: 24px 30px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .portal-cert-canvas::before {
      content: '';
      position: absolute;
      inset: 6px;
      border: 1px solid rgba(180, 83, 9, 0.3);
      pointer-events: none;
    }
  </style>

  <script>
    // Initial Theme Script to prevent flash
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="classroom-shell">
    <!-- Top Full-Width Verification Announcement Bar -->
    <div class="top-announcement-bar" id="materials-verification-bar">
      <div class="top-announcement-content">
        <span class="top-bar-badge">Verifikasi Pengajar</span>
        <span class="top-bar-text">Akun Anda belum menyelesaikan verifikasi kualifikasi pengajar resmi SkillSphere AI.</span>
        <span>|</span>
        <a href="/dashboard" class="top-bar-cta">
          Ke Dashboard Verifikasi <i class="fas fa-arrow-right" style="font-size:10px;"></i>
        </a>
      </div>
    </div>

    <!-- Google Classroom Drawer Sidebar Backdrop -->
    <div class="classroom-sidebar-backdrop" id="classroom-sidebar-backdrop" onclick="toggleClassroomSidebar(false)"></div>

    <!-- Top Sticky Navigation Bar -->
    <header class="navbar">
      <div class="nav-brand-group">
        <!-- Sidebar Hamburger Button -->
        <button class="classroom-sidebar-toggle-btn" id="classroom-sidebar-toggle" onclick="toggleClassroomSidebar()" title="Menu Utama" aria-label="Menu Utama">
          <i class="fas fa-bars"></i>
        </button>

        <a href="/dashboard" class="brand-logo" style="text-decoration:none;">
          <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path opacity="0.38" d="M12 7.6L17.3 4.7L14.4 10L17.3 15.3L12 12.4L6.7 15.3L9.6 10L6.7 4.7Z" />
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span>SkillSphere AI</span>
        </a>
      </div>

      <!-- Center Tabs (Forum, Tugas kelas, Ujian & Kuis, Sertifikat, Anggota) -->
      <nav class="classroom-top-nav-tabs">
        <button class="classroom-nav-tab active" id="tab-btn-forum" onclick="switchClassroomTab('forum')">
          <i class="fas fa-comments"></i>
          <span>Forum</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-classwork" onclick="switchClassroomTab('classwork')">
          <i class="fas fa-book-open"></i>
          <span>Tugas kelas</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-exams" onclick="switchClassroomTab('exams')">
          <i class="fas fa-file-signature"></i>
          <span>Ujian & Kuis</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-certificates" onclick="switchClassroomTab('certificates')">
          <i class="fas fa-certificate"></i>
          <span>Sertifikat</span>
        </button>
        <button class="classroom-nav-tab" id="tab-btn-people" onclick="switchClassroomTab('people')">
          <i class="fas fa-user-group"></i>
          <span>Anggota</span>
        </button>
      </nav>

      <!-- Right Header Actions -->
      <div class="nav-actions">
        <!-- Back to Dashboard -->
        <a href="/dashboard" class="btn-dashboard-back" title="Kembali ke Dashboard Studio">
          <i class="fas fa-arrow-left"></i>
          <span>Dashboard</span>
        </a>

        <!-- Theme Toggle -->
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode" title="Ganti Mode Tampilan">
          <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
          <i class="fas fa-moon" id="theme-icon-moon"></i>
        </button>

        <!-- User Profile Pill (Clickable) -->
        <div class="user-profile-badge" onclick="window.location.href='/profile'" style="cursor:pointer;" title="Buka Pengaturan Profil Saya">
          <div class="user-avatar-sm" id="nav-avatar">T</div>
          <span class="user-name-label" id="nav-user-name">Memuat...</span>
        </div>

