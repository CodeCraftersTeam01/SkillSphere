    async function editPortalExam(examId) {
      portalEditingExamId = examId;
      populatePortalSectionSelect();

      try {
        const res = await fetch('/api/exams/' + examId, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (json.success && json.data) {
          const ex = json.data;
          document.getElementById('portal-editor-mode-title').textContent = 'Edit Evaluasi: ' + ex.title;
          document.getElementById('portal-exam-title').value = ex.title || '';
          document.getElementById('portal-exam-type').value = ex.exam_type || 'final';
          document.getElementById('portal-exam-section-select').value = ex.section_id || '';
          document.getElementById('portal-exam-passing').value = ex.passing_score || 75;
          document.getElementById('portal-exam-duration').value = ex.duration_minutes || 60;
          document.getElementById('portal-exam-desc').value = ex.description || '';

          if (Array.isArray(ex.questions) && ex.questions.length > 0) {
            portalQuestions = ex.questions.map(q => ({
              question_text: q.question_text || q.question || '',
              options: Array.isArray(q.options) ? q.options : ['', '', '', ''],
              correct_answer: q.correct_answer || 'A'
            }));
          } else {
            portalQuestions = [createEmptyQuestion(1)];
          }

          renderPortalQuestions();

          const editorCard = document.getElementById('portal-exam-editor-card');
          if (editorCard) {
            editorCard.style.display = 'block';
            editorCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else {
          showToast('Gagal memuat detail ujian.', 'error');
        }
      } catch (err) {
        console.error('Error edit portal exam:', err);
        showToast('Terjadi kesalahan jaringan saat memuat detail ujian.', 'error');
      }
    }

    function closeExamEditor() {
      const editorCard = document.getElementById('portal-exam-editor-card');
      if (editorCard) editorCard.style.display = 'none';
      portalEditingExamId = null;
    }

    async function deletePortalExam(examId, title) {
      if (!confirm(`Apakah Anda yakin ingin menghapus ujian/kuis "${title}"? Data hasil pengerjaan terkait juga akan terhapus.`)) {
        return;
      }

      try {
        const res = await fetch('/api/exams/' + examId, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (json.success) {
          showToast('Ujian/Kuis berhasil dihapus.', 'success');
          if (portalEditingExamId === examId) closeExamEditor();
          await loadPortalExam();
        } else {
          showToast(json.message || 'Gagal menghapus ujian.', 'error');
        }
      } catch (err) {
        console.error('Error delete exam:', err);
        showToast('Terjadi kesalahan jaringan saat menghapus ujian.', 'error');
      }
    }

    function createEmptyQuestion(num) {
      return {
        question_text: '',
        options: ['', '', '', ''],
        correct_answer: 'A'
      };
    }

    function renderPortalQuestions() {
      const container = document.getElementById('portal-questions-container');
      if (!container) return;

      if (portalQuestions.length === 0) {
        container.innerHTML = `
          <div style="padding:32px; text-align:center; background:var(--bg-app); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); color:var(--text-secondary);">
            <i class="fas fa-clipboard-question" style="font-size:32px; margin-bottom:8px; display:block; color:var(--text-tertiary);"></i>
            Belum ada butir soal. Klik <strong>Tambah Butir Soal</strong> untuk menyusun pertanyaan pertama.
          </div>
        `;
        return;
      }

      container.innerHTML = portalQuestions.map((q, idx) => `
        <div class="question-card" id="q-card-${idx}">
          <div class="question-header">
            <span class="question-badge">Soal #${idx + 1}</span>
            <button type="button" class="btn-delete-q" onclick="removePortalQuestion(${idx})">
              <i class="fas fa-trash-can"></i> Hapus Soal
            </button>
          </div>

          <div class="form-group" style="margin-bottom:14px;">
            <label class="form-label" style="font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:6px; display:block;">Pertanyaan</label>
            <textarea class="form-control" style="width:100%; padding:10px 12px; border:1px solid var(--border-subtle); border-radius:var(--radius-md); background:var(--bg-app); color:var(--text-primary); font-family:inherit; font-size:13px; box-sizing:border-box;" rows="2" placeholder="Tuliskan teks pertanyaan soal pilihan ganda..." oninput="updatePortalQText(${idx}, this.value)">${escapeHtml(q.question_text || '')}</textarea>
          </div>

          <label class="form-label" style="font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:8px; display:block;">Pilihan Jawaban (Pilih Lingkaran untuk Kunci Jawaban Benar)</label>
          <div class="options-list">
            ${['A', 'B', 'C', 'D'].map((opt, oIdx) => `
              <div class="option-row">
                <input type="radio" class="option-radio" name="portal_correct_${idx}" value="${opt}" ${q.correct_answer === opt ? 'checked' : ''} onchange="updatePortalQAnswer(${idx}, '${opt}')" title="Kunci Jawaban Benar">
                <strong style="width:20px; font-size:13px; color:var(--text-primary);">${opt}.</strong>
                <input type="text" class="form-control" style="flex:1; padding:8px 12px; border:1px solid var(--border-subtle); border-radius:var(--radius-md); background:var(--bg-app); color:var(--text-primary); font-size:13px;" placeholder="Isi pilihan jawaban ${opt}" value="${escapeHtml((q.options && q.options[oIdx]) || '')}" oninput="updatePortalQOption(${idx}, ${oIdx}, this.value)">
              </div>
            `).join('')}
          </div>
        </div>
      `).join('');
    }

    function addPortalQuestion() {
      portalQuestions.push(createEmptyQuestion(portalQuestions.length + 1));
      renderPortalQuestions();
    }

    function removePortalQuestion(idx) {
      if (portalQuestions.length <= 1) {
        showToast('Minimal harus ada 1 butir soal ujian.', 'error');
        return;
      }
      portalQuestions.splice(idx, 1);
      renderPortalQuestions();
    }

    function updatePortalQText(idx, val) {
      if (portalQuestions[idx]) portalQuestions[idx].question_text = val;
    }

    function updatePortalQOption(idx, oIdx, val) {
      if (portalQuestions[idx]) {
        if (!Array.isArray(portalQuestions[idx].options)) portalQuestions[idx].options = ['', '', '', ''];
        portalQuestions[idx].options[oIdx] = val;
      }
    }

    function updatePortalQAnswer(idx, ans) {
      if (portalQuestions[idx]) portalQuestions[idx].correct_answer = ans;
    }

    async function savePortalExam() {
      if (!activeCourse || !activeCourse.id) {
        showToast('Pilih kursus terlebih dahulu.', 'error');
        return;
      }

      const title = document.getElementById('portal-exam-title').value.trim();
      const examType = document.getElementById('portal-exam-type').value;
      const sectionIdVal = document.getElementById('portal-exam-section-select').value;
      const description = document.getElementById('portal-exam-desc').value.trim();
      const passingScore = parseInt(document.getElementById('portal-exam-passing').value, 10) || 75;
      const durationMinutes = parseInt(document.getElementById('portal-exam-duration').value, 10) || 30;

      if (!title) {
        showToast('Judul ujian/kuis wajib diisi.', 'error');
        return;
      }

      for (let i = 0; i < portalQuestions.length; i++) {
        const q = portalQuestions[i];
        if (!q.question_text || !q.question_text.trim()) {
          showToast(`Pertanyaan pada Soal #${i + 1} belum diisi.`, 'error');
          return;
        }
        for (let j = 0; j < 4; j++) {
          if (!q.options[j] || !q.options[j].trim()) {
            showToast(`Pilihan ${['A', 'B', 'C', 'D'][j]} pada Soal #${i + 1} belum diisi.`, 'error');
            return;
          }
        }
      }

      try {
        const payload = {
          id: portalEditingExamId,
          course_id: activeCourse.id,
          title,
          exam_type: examType,
          section_id: sectionIdVal ? Number(sectionIdVal) : null,
          description,
          passing_score: passingScore,
          duration_minutes: durationMinutes,
          questions: portalQuestions
        };

        const res = await fetch('/api/exams', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify(payload)
        });

        const json = await res.json();
        if (json.success) {
          showToast(json.message || 'Evaluasi berhasil disimpan dan dipublikasikan.', 'success');
          closeExamEditor();
          await loadPortalExam();
        } else {
          showToast(json.message || 'Gagal menyimpan ujian/kuis.', 'error');
        }
      } catch (err) {
        console.error('Error saving portal exam:', err);
        showToast('Terjadi kesalahan jaringan saat menyimpan evaluasi.', 'error');
      }
    }

