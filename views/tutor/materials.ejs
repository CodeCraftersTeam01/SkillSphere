  <script>
    // Theme Switcher
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Toast Notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: var(--color-success); font-size: 16px;"></i>';
      if (type === 'error') icon = '<i class="fas fa-circle-exclamation" style="color: var(--color-danger); font-size: 16px;"></i>';
      if (type === 'info') icon = '<i class="fas fa-circle-info" style="color: var(--text-primary); font-size: 16px;"></i>';

      toast.innerHTML = `${icon}<span>${escapeHtml(message)}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Modal Helpers
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // Tab Switcher (Forum, Tugas Kelas, Ujian, Sertifikat, Anggota)
    function switchClassroomTab(tabName) {
      const tabs = ['forum', 'classwork', 'exams', 'certificates', 'people'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const pane = document.getElementById(`classroom-tab-${t}`);
        if (btn) btn.classList.toggle('active', t === tabName);
        if (pane) pane.style.display = (t === tabName) ? 'block' : 'none';
      });

      if (tabName === 'exams') {
        loadPortalExam();
      } else if (tabName === 'certificates') {
        loadPortalCertificates();
      }
    }

    // Classroom Sidebar Drawer Toggle
    function toggleClassroomSidebar(open) {
      const sidebar = document.getElementById('classroom-left-sidebar');
      const backdrop = document.getElementById('classroom-sidebar-backdrop');
      if (!sidebar) return;
      const isMobile = window.innerWidth <= 1024;
      if (isMobile) {
        const shouldOpen = (open !== undefined) ? open : !sidebar.classList.contains('drawer-open');
        if (shouldOpen) {
          sidebar.classList.add('drawer-open');
          if (backdrop) backdrop.classList.add('active');
          document.body.style.overflow = 'hidden';
        } else {
          sidebar.classList.remove('drawer-open');
          if (backdrop) backdrop.classList.remove('active');
          document.body.style.overflow = '';
        }
      } else {
        sidebar.classList.toggle('collapsed');
      }
    }

    // State Variables
    let currentCourses = [];
    let activeCourse = null;
    let currentUser = null;
    let selectedContentType = 'video';
    let selectedMaterialFile = null;

    const token = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('accessToken') || localStorage.getItem('token');
    if (!token) {
      window.location.href = '/login?redirect=/tutor/materials';
    } else {
      if (!localStorage.getItem('skillsphere_access_token')) localStorage.setItem('skillsphere_access_token', token);
      if (!localStorage.getItem('accessToken')) localStorage.setItem('accessToken', token);
      if (!localStorage.getItem('token')) localStorage.setItem('token', token);
    }

    // Initialize User Session & Data
    document.addEventListener('DOMContentLoaded', () => {
      fetchUserProfile();
      loadTutorCourses();
      setupDragAndDrop();
      setupLogout();
    });

    async function fetchUserProfile() {
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          currentUser = json.data;
          document.getElementById('nav-user-name').textContent = currentUser.name || currentUser.email;
          document.getElementById('nav-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();
          document.getElementById('announcement-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();

          document.getElementById('people-tutor-name').textContent = currentUser.name || 'Tutor SkillSphere';
          document.getElementById('people-tutor-email').textContent = currentUser.email || 'tutor@skillsphere.id';
          document.getElementById('people-tutor-avatar').textContent = (currentUser.name || 'T')[0].toUpperCase();
          document.getElementById('banner-tutor-name').innerHTML = `<i class="fas fa-chalkboard-user" style="margin-right:6px;"></i> Pengajar: ${escapeHtml(currentUser.name || 'Tutor')}`;

          const apps = Array.isArray(currentUser.tutor_applications) ? currentUser.tutor_applications : [];
          const latestApp = apps.length > 0 ? apps[apps.length - 1] : null;
          const isVerifiedTutor = (currentUser.role === 'tutor' && latestApp && latestApp.status === 'approved') || currentUser.role === 'admin';

          const verifBar = document.getElementById('materials-verification-bar');
          if (verifBar) {
            verifBar.style.display = isVerifiedTutor ? 'none' : 'flex';
          }
        }
      } catch (err) {
        console.error('Failed to fetch user profile:', err);
      }
    }

    function setupLogout() {
      const logoutBtn = document.getElementById('logout-btn');
      if (!logoutBtn) return;
      logoutBtn.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + token }
          });
        } catch (_) {}
        localStorage.removeItem('skillsphere_access_token');
        localStorage.removeItem('skillsphere_refresh_token');
        localStorage.removeItem('accessToken');
        localStorage.removeItem('token');
        localStorage.removeItem('refreshToken');
        localStorage.removeItem('skillsphere_user');
        window.location.href = '/login';
      });
    }

    // Load Tutor's Courses
    async function loadTutorCourses() {
      try {
        const res = await fetch('/api/courses/tutor/my-courses', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!res.ok || !json.success) {
          showToast(json.message || 'Gagal memuat kursus tutor.', 'error');
          return;
        }

        currentCourses = Array.isArray(json.data) ? json.data : [];

        if (!currentCourses.length) {
          document.getElementById('banner-course-title').textContent = 'Anda belum memiliki kelas.';
          document.getElementById('banner-course-desc').textContent = 'Silakan buat kelas baru melalui dashboard utama.';
          const crumbTitle = document.getElementById('crumb-course-title');
          if (crumbTitle) crumbTitle.textContent = 'Belum Ada Kelas';
          document.getElementById('sidebar-courses-list').innerHTML = `
            <div style="padding:10px 24px; font-size:12px; color:var(--text-tertiary);">Belum ada kelas diajar.</div>`;
          return;
        }

        renderSidebarCourses();

        const urlParams = new URLSearchParams(window.location.search);
        const courseIdParam = urlParams.get('courseId') || urlParams.get('course_id') || urlParams.get('id');
        const defaultId = courseIdParam ? parseInt(courseIdParam, 10) : currentCourses[0].id;

        changeActiveCourse(defaultId);

      } catch (err) {
        console.error('Failed to load courses:', err);
      }
    }

    // Render Courses in Sidebar
    function renderSidebarCourses() {
      const list = document.getElementById('sidebar-courses-list');
      if (!list) return;

      list.innerHTML = currentCourses.map(c => {
        const isActive = activeCourse && activeCourse.id === c.id;
        const initial = (c.title || 'K')[0].toUpperCase();
        return `
          <div class="sidebar-class-row${isActive ? ' active' : ''}" onclick="changeActiveCourse(${c.id}); toggleClassroomSidebar(false);" title="${escapeHtml(c.title)}">
            <div class="sidebar-class-circle">${initial}</div>
            <div class="sidebar-class-text">
              <span class="sidebar-class-title">${escapeHtml(c.title)}</span>
              <span class="sidebar-class-subtitle">${c.category ? escapeHtml(c.category.name) : 'Umum'} • ${(c.sections || []).length} Bab</span>
            </div>
          </div>
        `;
      }).join('');
    }

    // Change Active Course & Load Curriculum
    async function changeActiveCourse(courseId) {
      if (!courseId) return;
      try {
        const res = await fetch(`/api/courses/${courseId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (!json.success) return;

        activeCourse = json.data;
        renderSidebarCourses();
        renderActiveCourse(activeCourse);
      } catch (e) {
        console.error(e);
      }
    }

    function renderActiveCourse(course) {
      const rupiah = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 });

      // Breadcrumb & Hero Banner
      const crumbTitle = document.getElementById('crumb-course-title');
      if (crumbTitle) crumbTitle.textContent = course.title;
      document.getElementById('banner-course-title').textContent = course.title;
      document.getElementById('banner-course-desc').textContent = course.description || 'Tidak ada deskripsi tambahan.';
      document.getElementById('banner-status-badge').textContent = (course.status || 'draft').toUpperCase();
      document.getElementById('banner-category-badge').textContent = course.category ? course.category.name : 'Umum';
      document.getElementById('banner-level-badge').textContent = (course.level || 'beginner').toUpperCase();

      // Update embedded exam & certificate course titles
      const exTitle = document.getElementById('portal-exam-course-title');
      if (exTitle) exTitle.textContent = 'Bank Soal & Ujian: ' + course.title;
      const certTitle = document.getElementById('portal-cert-course-title');
      if (certTitle) certTitle.textContent = 'Sertifikat Kelulusan: ' + course.title;
      const prevCourse = document.getElementById('portal-preview-course');
      if (prevCourse) prevCourse.textContent = course.title;

      // If exams or certs tab is currently visible, reload it
      const examsPane = document.getElementById('classroom-tab-exams');
      if (examsPane && examsPane.style.display !== 'none') loadPortalExam();
      const certsPane = document.getElementById('classroom-tab-certificates');
      if (certsPane && certsPane.style.display !== 'none') loadPortalCertificates();

      const bannerImg = document.getElementById('banner-bg-img');
      if (course.thumbnail_url) {
        bannerImg.src = course.thumbnail_url;
        bannerImg.style.display = 'block';
      } else {
        bannerImg.src = '';
        bannerImg.style.display = 'none';
      }

      const sections = course.sections || [];
      let totalMaterials = 0;
      let totalDuration = 0;
      const allMaterialsFlat = [];

      sections.forEach(s => {
        const mats = s.materials || [];
        totalMaterials += mats.length;
        mats.forEach(m => {
          totalDuration += (m.duration_minutes || 0);
          allMaterialsFlat.push({ ...m, section_title: s.title, section_id: s.id });
        });
      });

      // Stream Metrics
      document.getElementById('stream-stat-sections').textContent = `${sections.length} Bab`;
      document.getElementById('stream-stat-materials').textContent = `${totalMaterials} Unit`;
      document.getElementById('stream-stat-duration').textContent = `${totalDuration} Menit`;
      document.getElementById('stream-stat-price').textContent = rupiah.format(course.price || 0);

      // Render Upload Modal Section Selector
      const sectionSelect = document.getElementById('material-section-select');
      sectionSelect.innerHTML = sections.map(s => `
        <option value="${s.id}">${escapeHtml(s.title)}</option>
      `).join('');

      // Render Tab 1: Forum Stream Feed
      renderForumFeed(allMaterialsFlat);

      // Render Tab 2: Tugas Kelas (Curriculum Tree)
      renderClassworkSections(sections);
    }

