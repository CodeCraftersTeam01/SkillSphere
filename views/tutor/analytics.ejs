      <div class="tab-pane" id="pane-quality">
        <!-- 2-Column Split: Rating Breakdown & Audience Feedback Highlights -->
        <div class="grid-two-col">
          <!-- Rating Breakdown Chart -->
          <div class="chart-card" style="margin-bottom:0;">
            <div class="chart-card-header">
              <div>
                <h2 class="chart-card-title"><i class="fas fa-ranking-star"></i> Distribusi Rating & Kepuasan Audiens</h2>
                <div class="chart-card-subtitle">Pengukuran sentimen kualitas kurikulum: apakah materi disukai siswa atau tidak.</div>
              </div>
              <span class="chart-badge-tag" style="color:var(--color-success);"><i class="fas fa-thumbs-up"></i> 96% Positif</span>
            </div>
            <div class="chart-container-box" id="chartRatingBreakdown" style="height:280px; min-height:280px;"></div>
          </div>

          <!-- Audience Needs & Curricular Highlights -->
          <div class="metric-summary-card">
            <div>
              <h3 class="summary-heading"><i class="fas fa-magnifying-glass-chart"></i> Analisis Kebutuhan & Masukan Audiens</h3>
              <p class="summary-desc">Rangkuman sentimen berbasis ulasan riil siswa untuk perbaikan kurikulum berkelanjutan.</p>

              <div style="margin-bottom:14px;">
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--color-success); letter-spacing:0.05em; margin-bottom:6px;">
                  <i class="fas fa-heart"></i> Aspek Materi Paling Disukai Siswa
                </div>
                <ul class="insight-list" id="feedbackStrengthsList">
                  <li class="insight-item"><i class="fas fa-check insight-icon-good"></i> Penjelasan arsitektur sistem lugas dan runut.</li>
                  <li class="insight-item"><i class="fas fa-check insight-icon-good"></i> Studi kasus dunia nyata relevan dengan standar industri.</li>
                  <li class="insight-item"><i class="fas fa-check insight-icon-good"></i> Ujian kelulusan terstruktur memberi validasi kompetensi nyata.</li>
                </ul>
              </div>

              <div>
                <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--color-warning); letter-spacing:0.05em; margin-bottom:6px;">
                  <i class="fas fa-lightbulb"></i> Saran Peningkatan dari Audiens
                </div>
                <ul class="insight-list" id="feedbackImprovementsList">
                  <li class="insight-item"><i class="fas fa-wrench insight-icon-focus"></i> Perbanyak kuis interaktif cepat di tengah-tengah bab materi.</li>
                  <li class="insight-item"><i class="fas fa-wrench insight-icon-focus"></i> Sediakan diagram arsitektur format PDF siap unduh per modul.</li>
