              <div class="chart-card-subtitle">Umpan balik langsung dari peserta kelas mengenai pengalaman dan dampak pembelajaran.</div>
            </div>
            <span class="chart-badge-tag"><i class="fas fa-message"></i> Ulasan Terverifikasi</span>
          </div>

          <div class="reviews-list-grid" id="reviewsContainer">
            <!-- Dynamically populated reviews -->
            <div style="padding:20px; text-align:center; color:var(--text-secondary); grid-column:1/-1;">
              Memuat ulasan siswa...
            </div>
