      <!-- ======================================================= -->
      <!-- TAB 4: PERFORMA KURIKULUM & KELAS                       -->
      <!-- ======================================================= -->
      <div class="tab-pane" id="pane-courses">
        <!-- Course Performance Breakdown Table -->
        <div class="chart-card">
          <div class="chart-card-header">
            <div>
              <h2 class="chart-card-title"><i class="fas fa-table-list"></i> Matriks Performa Seluruh Kursus</h2>
              <div class="chart-card-subtitle">Perbandingan metrik pendaftaran, progres rata-rata, pendapatan bersih, dan kelulusan tiap kelas.</div>
            </div>
            <span class="chart-badge-tag" id="courseTableCountBadge">0 Kelas</span>
          </div>

          <div class="table-responsive-box">
            <table class="custom-analytics-table">
              <thead>
                <tr>
                  <th>Judul Kelas</th>
                  <th>Kategori</th>
                  <th>Harga</th>
                  <th style="text-align:center;">Siswa</th>
                  <th style="text-align:right;">Hak Tutor (80%)</th>
                  <th style="text-align:center;">Rata-rata Progres</th>
                  <th style="text-align:center;">Rating</th>
                  <th style="text-align:center;">Kelulusan Ujian</th>
                  <th style="text-align:center;">Status</th>
                  <th style="text-align:center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="tbodyCoursesAnalytics">
                <tr>
                  <td colspan="10" style="text-align:center; padding:32px; color:var(--text-secondary);">
                    <i class="fas fa-circle-notch fa-spin"></i> Memuat data performa kelas...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
