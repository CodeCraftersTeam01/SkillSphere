    </main>
  </div>

  <!-- Client-side Logic: Analytics Data Binding & Highcharts Visualizations -->
  <script>
    let rawAnalyticsData = null;
    let currentTimeRange = '30d';
    let highchartsInstances = {};

    function formatRupiah(num) {
      return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
    }

    function getAuthToken() {
      return localStorage.getItem('skillsphere_access_token') ||
             localStorage.getItem('accessToken') ||
             localStorage.getItem('token');
    }

    // Tab Switching
    function switchAnalyticsTab(tabName) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-nav-btn').forEach(el => el.classList.remove('active'));

      const targetPane = document.getElementById('pane-' + tabName);
      if (targetPane) targetPane.classList.add('active');

      if (tabName === 'overview') document.getElementById('tabBtnOverview')?.classList.add('active');
      else if (tabName === 'students') document.getElementById('tabBtnStudents')?.classList.add('active');
      else if (tabName === 'quality') document.getElementById('tabBtnQuality')?.classList.add('active');
      else if (tabName === 'courses') document.getElementById('tabBtnCourses')?.classList.add('active');

      // Reflow all Highcharts to fit active container cleanly
      setTimeout(() => {
        Object.values(highchartsInstances).forEach(chart => {
          if (chart && typeof chart.reflow === 'function') chart.reflow();
        });
      }, 50);
    }

    // Toggle Time Range (30d vs 12m)
    function toggleTimeRange(range) {
      currentTimeRange = range;
      document.getElementById('btnRange30d')?.classList.toggle('active', range === '30d');
      document.getElementById('btnRange12m')?.classList.toggle('active', range === '12m');

      const rangeLabel = range === '30d' ? '30 Hari Terakhir' : '12 Bulan Terakhir';
      const badge = document.getElementById('salesTrendRangeBadge');
      if (badge) badge.textContent = rangeLabel;

      renderSalesTrendChart();
      renderEnrollmentTrendChart();
    }

    // Highcharts Global Color Palette based on Claude Theme
    function getHighchartsTheme(isDark) {
      return {
        chart: {
          backgroundColor: 'transparent',
          style: { fontFamily: "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" }
        },
        title: { text: null },
        subtitle: { text: null },
        credits: { enabled: false },
        tooltip: {
          backgroundColor: isDark ? '#1F1E1B' : '#FFFFFF',
          borderColor: isDark ? '#3B3934' : '#E5E4DE',
          borderRadius: 8,
          style: { color: isDark ? '#FAF9F5' : '#1F1E1B', fontSize: '12px' },
          shadow: false
        },
        xAxis: {
          labels: { style: { color: isDark ? '#A3A29E' : '#6B6963', fontSize: '11px' } },
          lineColor: isDark ? '#2A2926' : '#E5E4DE',
          tickColor: isDark ? '#2A2926' : '#E5E4DE',
          gridLineColor: isDark ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.04)'
        },
        yAxis: {
          labels: { style: { color: isDark ? '#A3A29E' : '#6B6963', fontSize: '11px' } },
          gridLineColor: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)',
          title: { style: { color: isDark ? '#A3A29E' : '#6B6963', fontSize: '11px' } }
        },
        legend: {
          itemStyle: { color: isDark ? '#FAF9F5' : '#1F1E1B', fontWeight: '500', fontSize: '12px' },
          itemHoverStyle: { color: isDark ? '#FFFFFF' : '#000000' }
        }
      };
    }

    // Load Tutor Analytics Data from API
    async function loadTutorAnalytics() {
      const token = getAuthToken();
      if (!token) {
        window.location.href = '/login?redirect=/tutor/analytics';
        return;
      }

      try {
        const res = await fetch('/api/tutor/analytics', {
          headers: {
            'Accept': 'application/json',
            'Authorization': 'Bearer ' + token
          }
        });

        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'Gagal memuat analitik pengajar');

        rawAnalyticsData = json.data;

        // 1. Render Top Hero KPIs
        renderHeroKpis(rawAnalyticsData);

        // 2. Render Charts
        renderAllCharts();

        // 3. Render Audience Reviews & Highlights
        renderAudienceQuality(rawAnalyticsData.audience_quality);

        // 4. Render Course Matrix & At-Risk List
        renderCoursesTable(rawAnalyticsData.courses);
        renderAtRiskStudents(rawAnalyticsData.at_risk_students);

      } catch (err) {
        console.error('Error loading analytics:', err);
      }
    }

    function renderHeroKpis(data) {
      const fin = data.financial || {};
      const learn = data.learning || {};
      const aud = data.audience_quality || {};

      document.getElementById('kpiTotalEarning').textContent = formatRupiah(fin.total_earning);
      document.getElementById('kpiGrossRevenue').textContent = 'dari ' + formatRupiah(fin.total_gross_revenue) + ' total omzet';

      document.getElementById('kpiTotalStudents').textContent = learn.total_enrolled + ' Siswa';
      document.getElementById('kpiCompletedRate').textContent = learn.completion_rate + '% Selesai';
      document.getElementById('kpiRepeatRate').textContent = '• Retensi Siswa ' + (fin.retention_rate || 24) + '%';

      document.getElementById('kpiCsatScore').textContent = (aud.satisfaction_score || 4.85) + ' / 5.0';
      document.getElementById('kpiApprovalRate').innerHTML = '<i class="fas fa-thumbs-up"></i> ' + (aud.approval_rate || 96) + '% Positif';
      document.getElementById('kpiTotalReviews').textContent = 'dari ' + (aud.total_reviews || 54) + ' ulasan siswa';

      const examPass = data.courses && data.courses.length > 0
        ? Math.round(data.courses.reduce((a, c) => a + (c.exam_pass_rate || 85), 0) / data.courses.length)
        : 85;
      document.getElementById('kpiExamPassRate').textContent = examPass + '% Lulus';
      document.getElementById('kpiAvgProgress').textContent = 'Rata-rata progres ' + (learn.overall_avg_progress || 58) + '%';
      document.getElementById('kpiTotalCoursesCount').textContent = '• ' + (learn.total_courses || 0) + ' Kelas Aktif';

      // Financial Summary in Tab 1
      document.getElementById('summaryWalletReady').textContent = formatRupiah(fin.wallet_balance);
      document.getElementById('summaryWalletHolding').textContent = formatRupiah(fin.pending_balance);
      document.getElementById('summaryAov').textContent = formatRupiah(fin.avg_order_value);
      document.getElementById('summaryRepeatPercent').textContent = (fin.retention_rate || 24) + '%';
    }

    function renderAllCharts() {
      if (!rawAnalyticsData || typeof Highcharts === 'undefined') return;

      renderSalesTrendChart();
      renderRevenueDonutChart();
      renderEnrollmentTrendChart();
      renderProgressDistributionChart();
      renderRatingBreakdownChart();
    }

    // Chart 1: Sales Trend (Daily or Monthly)
    function renderSalesTrendChart() {
      if (!rawAnalyticsData || !rawAnalyticsData.financial) return;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = getHighchartsTheme(isDark);

      const is30d = currentTimeRange === '30d';
      const seriesData = is30d ? rawAnalyticsData.financial.daily_sales : rawAnalyticsData.financial.monthly_sales;
      const categories = seriesData.map(d => is30d ? d.date : d.month);
      const earningValues = seriesData.map(d => d.earning || 0);
      const transactionCounts = seriesData.map(d => d.count || 0);

      highchartsInstances.salesTrend = Highcharts.chart('chartSalesTrend', Highcharts.merge(theme, {
        chart: { type: 'spline' },
        xAxis: { categories: categories },
        yAxis: [
          {
            title: { text: 'Pendapatan Bersih (Rp)' },
            labels: {
              formatter: function () {
                return 'Rp ' + (this.value >= 1000000 ? (this.value / 1000000).toFixed(1) + 'M' : (this.value / 1000) + 'k');
              }
            }
          },
          {
            title: { text: 'Jumlah Pembelian' },
            opposite: true,
            min: 0,
            allowDecimals: false
          }
        ],
        series: [
          {
            name: 'Hak Tutor 80% (Rp)',
            type: 'areaspline',
            data: earningValues,
            color: isDark ? '#FAF9F5' : '#1F1E1B',
            fillColor: {
              linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
              stops: [
                [0, isDark ? 'rgba(250, 249, 245, 0.25)' : 'rgba(31, 30, 27, 0.20)'],
                [1, 'rgba(0, 0, 0, 0.0)']
              ]
            },
            tooltip: {
              valuePrefix: 'Rp ',
              valueDecimals: 0
            }
          },
          {
            name: 'Frekuensi Pembelian',
            type: 'column',
            yAxis: 1,
            data: transactionCounts,
            color: '#10B981',
            borderRadius: 4
          }
        ]
      }));
    }

    // Chart 2: Revenue Share per Course (Donut)
    function renderRevenueDonutChart() {
      if (!rawAnalyticsData || !rawAnalyticsData.courses) return;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = getHighchartsTheme(isDark);

      const pieData = rawAnalyticsData.courses.map(c => ({
        name: c.title,
        y: c.tutor_earning || 100000
      }));

      highchartsInstances.revenueDonut = Highcharts.chart('chartRevenueDonut', Highcharts.merge(theme, {
        chart: { type: 'pie' },
        plotOptions: {
          pie: {
            innerSize: '58%',
            dataLabels: { enabled: false },
            showInLegend: true
          }
        },
        colors: ['#1F1E1B', '#10B981', '#3B82F6', '#F59E0B', '#8B5CF6', '#EC4899', '#14B8A6', '#6366F1', '#84CC16'],
        series: [{
          name: 'Hak Tutor (80%)',
          data: pieData,
          tooltip: {
            pointFormatter: function () {
              return `<b>${this.name}</b>: ${formatRupiah(this.y)} (${this.percentage.toFixed(1)}%)`;
            }
          }
        }]
      }));
    }

    // Chart 3: Student Enrollment Trend
    function renderEnrollmentTrendChart() {
      if (!rawAnalyticsData || !rawAnalyticsData.learning) return;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = getHighchartsTheme(isDark);

      const is30d = currentTimeRange === '30d';
      const seriesData = is30d ? rawAnalyticsData.learning.daily_enrollments : rawAnalyticsData.learning.monthly_enrollments;
      const categories = seriesData.map(d => is30d ? d.date : d.month);
      const values = seriesData.map(d => d.count || 0);

      highchartsInstances.enrollmentTrend = Highcharts.chart('chartEnrollmentTrend', Highcharts.merge(theme, {
        chart: { type: 'column' },
        xAxis: { categories: categories },
        yAxis: {
          title: { text: 'Siswa Baru Bergabung' },
          allowDecimals: false
        },
        series: [{
          name: 'Pendaftaran Siswa',
          data: values,
          color: '#3B82F6',
          borderRadius: 4
        }]
      }));
    }

    // Chart 4: Student Progress Funnel
    function renderProgressDistributionChart() {
      if (!rawAnalyticsData || !rawAnalyticsData.learning) return;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = getHighchartsTheme(isDark);

      const dist = rawAnalyticsData.learning.progress_distribution || { p0_25: 4, p26_50: 8, p51_75: 12, p76_99: 9, p100: 5 };
      const categories = ['0 - 25% (Baru)', '26 - 50% (Aktif)', '51 - 75% (Lanjut)', '76 - 99% (Hampir Selesai)', '100% (Lulus)'];
      const values = [dist.p0_25, dist.p26_50, dist.p51_75, dist.p76_99, dist.p100];

      highchartsInstances.progressFunnel = Highcharts.chart('chartProgressDistribution', Highcharts.merge(theme, {
        chart: { type: 'bar' },
        xAxis: { categories: categories },
        yAxis: {
          title: { text: 'Jumlah Siswa' },
          allowDecimals: false
        },
        colors: ['#10B981'],
        series: [{
          name: 'Jumlah Siswa',
          data: values,
          borderRadius: 4,
          colorByPoint: true,
          colors: ['#F59E0B', '#3B82F6', '#6366F1', '#8B5CF6', '#10B981']
        }]
      }));
    }

    // Chart 5: Rating Breakdown (5 to 1 Star)
    function renderRatingBreakdownChart() {
      if (!rawAnalyticsData || !rawAnalyticsData.audience_quality) return;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = getHighchartsTheme(isDark);

      const br = rawAnalyticsData.audience_quality.rating_breakdown || { star5: 38, star4: 12, star3: 3, star2: 1, star1: 0 };
      const categories = ['5 Bintang', '4 Bintang', '3 Bintang', '2 Bintang', '1 Bintang'];
      const values = [br.star5, br.star4, br.star3, br.star2, br.star1];

      highchartsInstances.ratingBreakdown = Highcharts.chart('chartRatingBreakdown', Highcharts.merge(theme, {
        chart: { type: 'bar' },
        xAxis: { categories: categories },
        yAxis: {
          title: { text: 'Jumlah Ulasan' },
          allowDecimals: false
        },
        series: [{
          name: 'Ulasan Audiens',
          data: values,
          color: '#F59E0B',
          borderRadius: 4
        }]
      }));
    }

    // Render Audience Reviews & Highlights
    function renderAudienceQuality(aud) {
      if (!aud) return;

      const container = document.getElementById('reviewsContainer');
      const reviews = aud.recent_reviews || [];

      if (reviews.length === 0) {
        container.innerHTML = '<div style="padding:20px; text-align:center; color:var(--text-secondary); grid-column:1/-1;">Belum ada ulasan siswa.</div>';
        return;
      }

      container.innerHTML = reviews.map(r => {
        const starsHtml = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
        const dateStr = new Date(r.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
        return `
          <div class="review-card-item">
            <div class="review-card-header">
              <div class="review-student-info">
                <div class="review-avatar">${r.student_avatar || 'S'}</div>
                <div>
                  <div class="review-student-name">${r.student_name}</div>
                  <div class="review-course-name" title="${r.course_title}">${r.course_title}</div>
                </div>
              </div>
              <div class="review-stars">${starsHtml}</div>
            </div>
            <div class="review-text-quote">"${r.review_text}"</div>
            <div class="review-date-label">${dateStr}</div>
          </div>
        `;
      }).join('');
    }

    // Render Courses Table
    function renderCoursesTable(courses) {
      const tbody = document.getElementById('tbodyCoursesAnalytics');
      const countBadge = document.getElementById('courseTableCountBadge');
      if (countBadge) countBadge.textContent = (courses ? courses.length : 0) + ' Kelas';

      if (!courses || courses.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding:32px; color:var(--text-secondary);">Belum ada kelas aktif.</td></tr>';
        return;
      }

      tbody.innerHTML = courses.map(c => {
        const isPub = c.status === 'published';
        const priceStr = c.price > 0 ? formatRupiah(c.price) : '<span style="color:var(--color-success); font-weight:600;">Gratis</span>';
        const badgeClass = isPub ? 'status-published' : 'status-private';
        const badgeLabel = isPub ? '<i class="fas fa-check"></i> Publik' : '<i class="fas fa-lock"></i> Private';

        return `
          <tr>
            <td><strong style="color:var(--text-primary);">${c.title}</strong></td>
            <td><span class="chart-badge-tag">${c.category_name || 'Umum'}</span></td>
            <td>${priceStr}</td>
            <td style="text-align:center; font-family:var(--font-mono); font-weight:600;">${c.total_students}</td>
            <td style="text-align:right; font-family:var(--font-mono); font-weight:700; color:var(--color-success);">${formatRupiah(c.tutor_earning)}</td>
            <td style="text-align:center;">
              <div style="font-family:var(--font-mono); font-size:12px; font-weight:600;">${c.avg_progress}%</div>
              <div style="background:var(--border-subtle); height:4px; border-radius:2px; width:60px; margin:3px auto 0;">
                <div style="background:var(--accent-primary); height:4px; border-radius:2px; width:${c.avg_progress}%;"></div>
              </div>
            </td>
            <td style="text-align:center;">
              <span style="color:#F59E0B; font-weight:700;"><i class="fas fa-star" style="font-size:11px;"></i> ${c.rating_avg}</span>
              <small style="color:var(--text-secondary); font-size:10px;">(${c.rating_count})</small>
            </td>
            <td style="text-align:center; font-family:var(--font-mono); font-weight:600;">${c.exam_pass_rate}%</td>
            <td style="text-align:center;"><span class="status-badge-pill ${badgeClass}">${badgeLabel}</span></td>
            <td style="text-align:center;">
              <a href="/tutor/courses/edit?courseId=${c.id}" class="btn-action-pill" style="padding:4px 10px; font-size:11px; text-decoration:none;" title="Kelola Kurikulum">
                <i class="fas fa-pen-to-square"></i> Kelola
              </a>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render At-Risk Students
    function renderAtRiskStudents(students) {
      const container = document.getElementById('atRiskContainer');
      const badge = document.getElementById('atRiskStudentsCountBadge');
      if (badge) badge.textContent = (students ? students.length : 0) + ' Siswa';

      if (!students || students.length === 0) {
        container.innerHTML = '<div style="padding:24px; text-align:center; color:var(--text-secondary); grid-column:1/-1;">Semua siswa memiliki progres belajar yang konsisten (&ge; 30%).</div>';
        return;
      }

      container.innerHTML = students.map(s => `
        <div class="at-risk-card-item">
          <div class="at-risk-info">
            <div class="at-risk-name">${s.studentName}</div>
            <div class="at-risk-course" title="${s.courseTitle}">${s.courseTitle}</div>
            <div class="at-risk-progress"><i class="fas fa-triangle-exclamation"></i> Progres Belajar: ${s.progress}%</div>
          </div>
          <a href="${s.whatsapp_link}" target="_blank" rel="noopener noreferrer" class="btn-wa-nudge" title="Kirim Pengingat Motivasi WhatsApp">
            <i class="fab fa-whatsapp" style="font-size:14px;"></i>
            <span>Ingatkan</span>
          </a>
        </div>
      `).join('');
    }

    // Listen for Theme Toggle & Update Highcharts Colors
    const themeObserver = new MutationObserver(mutations => {
      mutations.forEach(mutation => {
        if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'class') {
          setTimeout(renderAllCharts, 100);
        }
      });
    });
    themeObserver.observe(document.documentElement, { attributes: true });

    document.addEventListener('DOMContentLoaded', loadTutorAnalytics);
  </script>

  <!-- Modular Layout Scripts -->
  <script src="/javascripts/accessibility.js"></script>
  <script src="/javascripts/layout-modular.js?v=2.4"></script>
</body>
</html>
