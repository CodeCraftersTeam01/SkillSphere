        <!-- At-Risk Intervention Panel -->
        <div class="chart-card">
          <div class="chart-card-header">
            <div>
              <h2 class="chart-card-title"><i class="fas fa-user-clock" style="color:var(--color-warning);"></i> Siswa Membutuhkan Intervensi (Progres &lt; 30%)</h2>
              <div class="chart-card-subtitle">Siswa yang melambat dan berisiko dropout. Kirimkan dorongan motivasi langsung via WhatsApp.</div>
            </div>
            <span class="chart-badge-tag" style="background:rgba(245,158,11,0.12); color:#B45309;" id="atRiskStudentsCountBadge">0 Siswa</span>
          </div>

          <div class="at-risk-grid" id="atRiskContainer">
            <div style="padding:24px; text-align:center; color:var(--text-secondary); grid-column:1/-1;">
              Tidak ada siswa yang membutuhkan intervensi saat ini.
            </div>
          </div>
