<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pembuat Ujian Kelulusan | Studio Pengajar SkillSphere AI</title>
  <meta name="description" content="Studio perancangan bank soal, passing grade kelulusan, dan batas waktu ujian resmi bagi instruktur SkillSphere AI.">

  <!-- Immediate Theme Initializer -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts: Newsreader, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Claude Design System Stylesheet & Accessibility Toolkit -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      font-family: var(--font-sans);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Navigation Bar Consistent with Studio */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 24px;
      height: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-sizing: border-box;
      gap: 16px;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 1.12rem;
    }

    .brand-logo span {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .brand-tag {
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      border: 1px solid var(--border-subtle);
    }

    /* Center Navigation Tabs */
    .studio-nav-tabs {
      display: flex;
      align-items: stretch;
      gap: 4px;
      height: 60px;
    }

    .studio-nav-tab {
      padding: 0 16px;
      height: 60px;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.15s ease-out;
      white-space: nowrap;
    }

    .studio-nav-tab:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .studio-nav-tab.active {
      color: var(--text-primary);
      font-weight: 600;
      border-bottom-color: var(--text-primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease-out;
    }

    .icon-btn:hover {
      background: var(--bg-surface-subtle);
      transform: translateY(-1px);
    }

    .icon-btn:focus-visible {
      outline: 2px solid var(--text-primary);
      outline-offset: 2px;
    }

    /* Main Container */
    .container {
      max-width: 1020px;
      width: 100%;
      margin: 32px auto;
      padding: 0 20px;
      flex: 1;
    }

    .page-header {
      margin-bottom: 28px;
    }

    .page-title {
      font-family: var(--font-serif);
      font-size: 2.15rem;
      font-weight: 600;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
      color: var(--text-primary);
    }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: 0.95rem;
      max-width: 720px;
    }

    /* Cards */
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 26px 24px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
      transition: border-color 0.18s ease-out;
    }

    .card-title {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .card-desc {
      font-size: 0.88rem;
      color: var(--text-secondary);
      margin-bottom: 20px;
    }

    /* Form Elements */
    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .form-control {
      width: 100%;
      padding: 12px 14px;
      font-size: 0.95rem;
      font-family: inherit;
      color: var(--text-primary);
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      box-sizing: border-box;
      outline: none;
      transition: border-color 0.15s ease-out, box-shadow 0.15s ease-out;
      min-height: 44px;
    }

    .form-control:focus {
      border-color: var(--text-primary);
      box-shadow: 0 0 0 2px var(--border-strong);
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr;
      }
      .studio-nav-tabs {
        display: none;
      }
      .navbar {
        padding: 0 16px;
      }
      .page-title {
        font-size: 1.75rem;
      }
    }

    /* Question Cards */
    .question-card {
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 20px;
      margin-bottom: 18px;
      transition: border-color 0.15s ease;
    }

    .question-card:focus-within {
      border-color: var(--border-strong);
    }

    .question-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .question-badge {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 600;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      color: var(--text-primary);
    }

    .btn-delete-q {
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-danger);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 10px;
      border-radius: var(--radius-sm);
      min-height: 36px;
      transition: all 0.15s ease-out;
    }

    .btn-delete-q:hover {
      background: var(--color-danger-bg);
      border-color: rgba(220, 38, 38, 0.2);
    }

    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 14px;
    }

    @media (max-width: 620px) {
      .options-grid {
        grid-template-columns: 1fr;
      }
    }

    .option-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      transition: all 0.15s ease-out;
    }

    .option-item.correct {
      border-color: var(--color-success);
      background: var(--color-success-bg);
    }

    .option-radio {
      accent-color: var(--color-success);
      cursor: pointer;
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .option-input {
      border: none;
      background: transparent;
      outline: none;
      width: 100%;
      font-size: 0.92rem;
      font-family: inherit;
      color: var(--text-primary);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s ease-out;
      min-height: 44px;
      box-sizing: border-box;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .btn-primary:hover {
      background: var(--accent-primary-hover);
      transform: translateY(-1px);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-primary);
      border-color: var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
    }

    /* Sticky Footer Action Bar */
    .sticky-footer {
      position: sticky;
      bottom: 0;
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      z-index: 40;
      box-shadow: 0 -4px 16px rgba(0,0,0,0.04);
      flex-wrap: wrap;
    }

    .stat-pill {
      font-size: 0.86rem;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .stat-item strong {
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-weight: 700;
    }
  </style>
</head>
<body>

  <!-- Top Studio Header -->
  <header class="navbar" role="banner">
    <div class="nav-brand-group">
      <a href="/dashboard" class="brand-logo" aria-label="Ke Dashboard SkillSphere">
        <i class="fa-solid fa-sparkles" style="color: var(--accent-amber);"></i>
        <span>SkillSphere Studio</span>
        <span class="brand-tag">Pengajar</span>
      </a>
    </div>

    <!-- Center Studio Tabs -->
    <nav class="studio-nav-tabs" aria-label="Navigasi Studio Pengajar">
      <a href="/tutor/materials" class="studio-nav-tab">
        <i class="fa-solid fa-book-open"></i>
        <span>Kurikulum & Materi</span>
      </a>
      <a href="/tutor/exams" class="studio-nav-tab active" aria-current="page">
        <i class="fa-solid fa-file-signature"></i>
        <span>Ujian Kelulusan</span>
      </a>
      <a href="/tutor/wallet" class="studio-nav-tab">
        <i class="fa-solid fa-wallet"></i>
        <span>Dompet & Penarikan</span>
      </a>
    </nav>

    <!-- Right Controls -->
    <div class="nav-actions">
      <button type="button" class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Ganti Tema Tampilan" title="Ganti Tema">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>

      <a href="/dashboard" class="btn btn-outline" style="min-height: 40px; padding: 6px 14px; font-size: 0.84rem;">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Dashboard</span>
      </a>
    </div>
  </header>

  <main class="container" role="main">
    <div class="page-header">
      <h1 class="page-title">Pembuat Ujian Kelulusan Resmi</h1>
      <p class="page-subtitle">Rancang bank soal pilihan ganda, tetapkan standar nilai kelulusan (passing grade), dan durasi pengerjaan untuk sertifikasi siswa.</p>
    </div>

    <!-- 1. Pemilihan Kursus Target -->
    <section class="card" aria-labelledby="headingCourseSelect">
      <h2 class="card-title" id="headingCourseSelect">
        <i class="fa-solid fa-graduation-cap" style="color: var(--accent-amber);"></i>
        <span>1. Pilih Kursus Target</span>
      </h2>
      <p class="card-desc">Pilih kelas yang ingin Anda kelola bank soal ujian kelulusannya.</p>

      <div class="form-group">
        <label class="form-label" for="courseSelect">Kursus yang Anda Ampu</label>
        <select id="courseSelect" class="form-control" onchange="loadCourseExam()" aria-label="Pilih Kursus Target">
          <option value="">Memuat daftar kursus Anda...</option>
        </select>
      </div>
    </section>

    <!-- 2. Parameter Standar Kelulusan -->
    <section class="card" id="examConfigCard" style="opacity: 0.5; pointer-events: none;" aria-labelledby="headingConfig">
      <h2 class="card-title" id="headingConfig">
        <i class="fa-solid fa-sliders" style="color: var(--accent-amber);"></i>
        <span>2. Konfigurasi Standar Kelulusan</span>
      </h2>
      <p class="card-desc">Tentukan kriteria kelulusan dan durasi pengerjaan sebelum sertifikat diterbitkan secara otomatis.</p>

      <div class="form-group">
        <label class="form-label" for="examTitle">Judul Ujian Kelulusan</label>
        <input type="text" id="examTitle" class="form-control" placeholder="Contoh: Ujian Kompetensi Akhir: Fullstack Next.js">
      </div>

      <div class="form-group">
        <label class="form-label" for="examDesc">Deskripsi atau Instruksi Pengerjaan</label>
        <textarea id="examDesc" class="form-control" rows="2" placeholder="Instruksi singkat untuk siswa sebelum menekan tombol mulai ujian..."></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label class="form-label" for="passingScore">Passing Grade Kelulusan (%)</label>
          <input type="number" id="passingScore" class="form-control" min="10" max="100" value="75" oninput="updateStats()">
          <span style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px; display: block;">
            Siswa yang meraih skor sama atau lebih besar dari nilai ini akan otomatis diterbitkan sertifikat resminya.
          </span>
        </div>

        <div class="form-group">
          <label class="form-label" for="durationMinutes">Batas Waktu Pengerjaan (Menit)</label>
          <input type="number" id="durationMinutes" class="form-control" min="5" max="300" value="60" oninput="updateStats()">
          <span style="font-size: 0.78rem; color: var(--text-secondary); margin-top: 4px; display: block;">
            Countdown timer di layar siswa akan otomatis mengumpulkan jawaban saat waktu habis.
          </span>
        </div>
      </div>
    </section>

    <!-- 3. Bank Soal Pilihan Ganda -->
    <section class="card" id="questionsCard" style="opacity: 0.5; pointer-events: none;" aria-labelledby="headingQuestions">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
        <div>
          <h2 class="card-title" id="headingQuestions" style="margin-bottom: 4px;">
            <i class="fa-solid fa-list-check" style="color: var(--accent-amber);"></i>
            <span>3. Bank Soal Pilihan Ganda</span>
          </h2>
          <p class="card-desc" style="margin-bottom: 0;">Buat pertanyaan dengan 4 pilihan jawaban dan tentukan 1 kunci jawaban benar.</p>
        </div>
        <button type="button" class="btn btn-outline" onclick="addQuestion()" aria-label="Tambah Butir Soal Baru">
          <i class="fa-solid fa-plus"></i>
          <span>Tambah Butir Soal</span>
        </button>
      </div>

      <div id="questionsContainer" role="list" aria-label="Daftar Pertanyaan Ujian">
        <!-- Soal dinamis akan di-render di sini -->
      </div>
    </section>
  </main>

  <!-- Sticky Footer Action Bar -->
  <footer class="sticky-footer" id="stickyFooter" style="display: none;" role="contentinfo">
    <div class="stat-pill">
      <div class="stat-item">Total Soal: <strong id="statTotalQ">0</strong> butir</div>
      <div class="stat-item">Passing Grade: <strong id="statPassing">75%</strong></div>
      <div class="stat-item">Batas Waktu: <strong id="statDuration">60</strong> Menit</div>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <button type="button" class="btn btn-outline" onclick="addQuestion()">
        <i class="fa-solid fa-plus"></i>
        <span>Tambah Soal</span>
      </button>
      <button type="button" class="btn btn-primary" onclick="saveExam()">
        <i class="fa-solid fa-floppy-disk"></i>
        <span>Simpan & Publikasikan Ujian</span>
      </button>
    </div>
  </footer>

  <script>
    let questions = [];
    let currentCourseId = null;

    // Theme Toggle Functionality
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const target = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      localStorage.setItem('skillsphere_theme', target);
      localStorage.setItem('theme', target);
      updateThemeIcon(target);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }
    }

    function notifyUser(msg, type = 'success') {
      if (typeof window.showToast === 'function') {
        window.showToast(msg, type);
      } else {
        alert(msg);
      }
    }

    async function loadMyCourses() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/courses', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        const select = document.getElementById('courseSelect');
        select.innerHTML = '<option value="">-- Pilih Kursus --</option>';

        const courseList = (json.data && Array.isArray(json.data.courses)) 
          ? json.data.courses 
          : (Array.isArray(json.data) ? json.data : []);

        if (courseList.length === 0) {
          select.innerHTML = '<option value="">Belum ada kursus yang dibuat</option>';
          return;
        }

        courseList.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.title + ' (' + (c.level || 'all-level') + ')';
          select.appendChild(opt);
        });
      } catch (err) {
        console.error('Error loading courses:', err);
        notifyUser('Gagal memuat daftar kursus pengajar.', 'error');
      }
    }

    async function loadCourseExam() {
      const select = document.getElementById('courseSelect');
      currentCourseId = select.value;

      const examCard = document.getElementById('examConfigCard');
      const qCard = document.getElementById('questionsCard');
      const footer = document.getElementById('stickyFooter');

      if (!currentCourseId) {
        examCard.style.opacity = '0.5';
        examCard.style.pointerEvents = 'none';
        qCard.style.opacity = '0.5';
        qCard.style.pointerEvents = 'none';
        footer.style.display = 'none';
        return;
      }

      examCard.style.opacity = '1';
      examCard.style.pointerEvents = 'auto';
      qCard.style.opacity = '1';
      qCard.style.pointerEvents = 'auto';
      footer.style.display = 'flex';

      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/exams/course/' + currentCourseId, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (json.success && json.data) {
          const ex = json.data;
          document.getElementById('examTitle').value = ex.title || '';
          document.getElementById('examDesc').value = ex.description || '';
          document.getElementById('passingScore').value = ex.passing_score || 75;
          document.getElementById('durationMinutes').value = ex.duration_minutes || 60;
          questions = Array.isArray(ex.questions) && ex.questions.length > 0 ? ex.questions : [];
        } else {
          document.getElementById('examTitle').value = 'Ujian Kelulusan Resmi';
          document.getElementById('examDesc').value = 'Ujian kompetensi kelulusan standar industri.';
          document.getElementById('passingScore').value = 75;
          document.getElementById('durationMinutes').value = 60;
          questions = [];
        }

        if (questions.length === 0) {
          addQuestion();
        } else {
          renderQuestions();
        }
        updateStats();
      } catch (err) {
        console.error('Error fetching exam:', err);
        notifyUser('Gagal mengambil data ujian kursus.', 'error');
      }
    }

    function addQuestion() {
      const newId = String(Date.now() + Math.floor(Math.random() * 100));
      questions.push({
        id: newId,
        question: '',
        options: ['', '', '', ''],
        correct_answer: 'A',
        points: 10
      });
      renderQuestions();
      updateStats();
    }

    function deleteQuestion(index) {
      if (questions.length <= 1) {
        notifyUser('Ujian wajib memiliki minimal 1 butir pertanyaan.', 'warning');
        return;
      }
      questions.splice(index, 1);
      renderQuestions();
      updateStats();
    }

    function renderQuestions() {
      const container = document.getElementById('questionsContainer');
      container.innerHTML = '';

      questions.forEach((q, idx) => {
        const qCard = document.createElement('div');
        qCard.className = 'question-card';
        qCard.setAttribute('role', 'listitem');

        const qHeader = document.createElement('div');
        qHeader.className = 'question-header';
        qHeader.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="question-badge">Soal #${idx + 1}</span>
            <span style="font-size: 0.8rem; color: var(--text-secondary);">Bobot: 10 Poin</span>
          </div>
          <button type="button" class="btn-delete-q" onclick="deleteQuestion(${idx})" aria-label="Hapus Soal #${idx + 1}">
            <i class="fa-regular fa-trash-can"></i>
            <span>Hapus</span>
          </button>
        `;
        qCard.appendChild(qHeader);

        // Pertanyaan Textarea
        const textGroup = document.createElement('div');
        textGroup.className = 'form-group';
        textGroup.innerHTML = `
          <label class="form-label" for="q_input_${idx}">Teks Pertanyaan</label>
          <textarea id="q_input_${idx}" class="form-control" rows="2" placeholder="Tuliskan pertanyaan Anda di sini..." oninput="updateQuestionText(${idx}, this.value)">${escapeHtml(q.question || '')}</textarea>
        `;
        qCard.appendChild(textGroup);

        // 4 Pilihan Jawaban
        const optGrid = document.createElement('div');
        optGrid.className = 'options-grid';

        const optionLabels = ['A', 'B', 'C', 'D'];
        optionLabels.forEach((label, optIdx) => {
          const optVal = (q.options && q.options[optIdx]) ? q.options[optIdx] : '';
          const isCorrect = String(q.correct_answer || 'A').toUpperCase() === label;

          const optItem = document.createElement('div');
          optItem.className = 'option-item ' + (isCorrect ? 'correct' : '');
          optItem.innerHTML = `
            <input type="radio" name="correct_${q.id}" id="radio_${q.id}_${label}" class="option-radio" ${isCorrect ? 'checked' : ''} onchange="setCorrectAnswer(${idx}, '${label}')" aria-label="Kunci jawaban ${label}">
            <label for="radio_${q.id}_${label}" style="font-weight: 700; font-size: 0.85rem; color: var(--text-secondary); cursor: pointer;">${label}.</label>
            <input type="text" class="option-input" placeholder="Opsi ${label}" value="${escapeHtml(optVal)}" oninput="updateOptionText(${idx}, ${optIdx}, this.value)" aria-label="Teks Pilihan ${label}">
          `;
          optGrid.appendChild(optItem);
        });

        qCard.appendChild(optGrid);
        container.appendChild(qCard);
      });
    }

    function updateQuestionText(qIdx, text) {
      if (questions[qIdx]) questions[qIdx].question = text;
    }

    function updateOptionText(qIdx, optIdx, text) {
      if (questions[qIdx]) {
        if (!Array.isArray(questions[qIdx].options)) questions[qIdx].options = ['', '', '', ''];
        questions[qIdx].options[optIdx] = text;
      }
    }

    function setCorrectAnswer(qIdx, label) {
      if (questions[qIdx]) {
        questions[qIdx].correct_answer = label;
        renderQuestions();
      }
    }

    function updateStats() {
      document.getElementById('statTotalQ').textContent = questions.length;
      document.getElementById('statPassing').textContent = (document.getElementById('passingScore').value || 75) + '%';
      document.getElementById('statDuration').textContent = document.getElementById('durationMinutes').value || 60;
    }

    async function saveExam() {
      if (!currentCourseId) {
        notifyUser('Pilih kursus terlebih dahulu.', 'warning');
        return;
      }

      const title = document.getElementById('examTitle').value.trim();
      const description = document.getElementById('examDesc').value.trim();
      const passingScore = Number(document.getElementById('passingScore').value) || 75;
      const durationMinutes = Number(document.getElementById('durationMinutes').value) || 60;

      if (!title) {
        notifyUser('Judul ujian wajib diisi.', 'warning');
        return;
      }

      for (let i = 0; i < questions.length; i++) {
        const q = questions[i];
        if (!q.question || q.question.trim().length === 0) {
          notifyUser(`Pertanyaan nomor ${i + 1} masih kosong.`, 'warning');
          return;
        }
        for (let j = 0; j < 4; j++) {
          if (!q.options[j] || q.options[j].trim().length === 0) {
            notifyUser(`Opsi ${['A', 'B', 'C', 'D'][j]} pada soal #${i + 1} masih kosong.`, 'warning');
            return;
          }
        }
      }

      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/exams', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify({
            course_id: currentCourseId,
            title,
            description,
            passing_score: passingScore,
            duration_minutes: durationMinutes,
            questions
          })
        });

        const json = await res.json();
        if (json.success) {
          notifyUser('Ujian kelulusan kursus berhasil disimpan dan dipublikasikan.', 'success');
        } else {
          notifyUser(json.message || 'Gagal menyimpan ujian.', 'error');
        }
      } catch (err) {
        console.error('Error saving exam:', err);
        notifyUser('Terjadi kesalahan jaringan saat menyimpan ujian.', 'error');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', async () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeIcon(currentTheme);
      await loadMyCourses();

      // Check if courseId is passed via URL query params (e.g. /tutor/exams?courseId=123)
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedCourseId = urlParams.get('courseId');
      if (preselectedCourseId) {
        const select = document.getElementById('courseSelect');
        if (select) {
          select.value = preselectedCourseId;
          if (select.value === preselectedCourseId) {
            loadCourseExam();
          }
        }
      }
    });
  </script>
</body>
</html>
