<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Hyperspace Transition | SkillSphere AI</title>
  <meta name="description" content="Transisi hyperspace portal menuju dashboard pembelajaran SkillSphere AI.">
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#09090b">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    body, html {
      width: 100%;
      height: 100%;
      height: 100dvh;
      overflow: hidden;
      background-color: #09090b;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      user-select: none;
    }

    #wormhole-portal-overlay {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      z-index: 999999;
      background: transparent;
      overflow: hidden;
    }

    #wormhole-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    #wormhole-flash {
      position: absolute;
      inset: 0;
      background: #ffffff;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.28s ease;
      z-index: 10;
    }

    #wormhole-flash.active {
      opacity: 1;
    }
  </style>
</head>
<body>
  <div id="wormhole-portal-overlay">
    <canvas id="wormhole-canvas"></canvas>
    <div id="wormhole-flash"></div>
  </div>

  <script>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      let targetUrl = urlParams.get('to') || '/dashboard';
      if (!targetUrl.startsWith('/') || targetUrl.startsWith('//')) {
        targetUrl = '/dashboard';
      }

      const canvas = document.getElementById('wormhole-canvas');
      const flash = document.getElementById('wormhole-flash');
      const ctx = canvas.getContext('2d');

      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);
      let cx = width / 2;
      let cy = height / 2;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        cx = width / 2;
        cy = height / 2;
      });

      const MAX_DEPTH = 1800;
      const NUM_STARS = 460;

      // Authentic 404 Star Streaks
      class Star {
        constructor() {
          this.reset(true);
        }
        reset(initial = false) {
          this.x = (Math.random() - 0.5) * width * 2.8;
          this.y = (Math.random() - 0.5) * height * 2.8;
          this.z = initial ? Math.random() * MAX_DEPTH : MAX_DEPTH;
          this.pz = this.z;
        }
        update(speed) {
          this.pz = this.z;
          this.z -= speed;
          if (this.z <= 10) {
            this.reset();
          }
        }
        draw(speed) {
          const k = 320 / this.z;
          const px = this.x * k + cx;
          const py = this.y * k + cy;

          const prevK = 320 / Math.max(this.pz + speed * 0.9, 10);
          const prevPx = this.x * prevK + cx;
          const prevPy = this.y * prevK + cy;

          if (px < 0 || px > width || py < 0 || py > height) return;

          const depth = 1 - this.z / MAX_DEPTH;
          const alpha = Math.min(Math.max(depth * 1.3, 0.15), 1);

          ctx.beginPath();
          ctx.moveTo(prevPx, prevPy);
          ctx.lineTo(px, py);
          ctx.strokeStyle = `rgba(255, 255, 255, ${alpha * 0.95})`;
          ctx.lineWidth = Math.max(k * 1.25, 0.85);
          ctx.lineCap = 'round';
          ctx.stroke();
        }
      }

      const stars = Array.from({ length: NUM_STARS }, () => new Star());

      const startTime = performance.now();
      const DURATION = 1900;
      const EXPAND_TIME = 800;
      let redirected = false;

      function easeOutQuart(x) {
        return 1 - Math.pow(1 - x, 4);
      }

      function render(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / DURATION, 1.0);
        const expandProgress = Math.min(elapsed / EXPAND_TIME, 1.0);

        const maxR = Math.hypot(cx, cy) * 1.06;
        const currentR = easeOutQuart(expandProgress) * maxR;

        ctx.clearRect(0, 0, width, height);

        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, currentR, 0, Math.PI * 2);
        ctx.clip();

        ctx.fillStyle = '#09090b';
        ctx.fillRect(0, 0, width, height);

        const currentSpeed = 12 + Math.pow(progress, 2.3) * 70;

        for (let i = 0; i < stars.length; i++) {
          stars[i].update(currentSpeed);
          stars[i].draw(currentSpeed);
        }

        ctx.restore();

        if (expandProgress < 1.0) {
          const rimAlpha = Math.max(1 - expandProgress * 0.85, 0.2);
          ctx.beginPath();
          ctx.arc(cx, cy, currentR, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(255, 255, 255, ${rimAlpha * 0.85})`;
          ctx.lineWidth = Math.max(2.5 * (1 - expandProgress), 1.2);
          ctx.stroke();
        }

        if (progress >= 0.88 && !flash.classList.contains('active')) {
          flash.classList.add('active');
        }

        if (progress >= 1.0 && !redirected) {
          redirected = true;
          window.location.href = targetUrl;
          return;
        }

        requestAnimationFrame(render);
      }

      requestAnimationFrame(render);

      setTimeout(() => {
        if (!redirected) {
          redirected = true;
          window.location.href = targetUrl;
        }
      }, 2400);
    })();
  </script>
</body>
</html>
