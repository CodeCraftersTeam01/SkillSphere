  <!-- Accessibility Accessibility Controls Helper -->
  <script src="/javascripts/accessibility.js"></script>

  <!-- Interactive Landing Script -->
  <script>
    // -------------------------------------------------------------
    // Theme Engine (Sync with Claude Warm Paper & Obsidian)
    // -------------------------------------------------------------
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('skillsphere_theme', theme);
      localStorage.setItem('theme', theme);
      if (themeIcon) {
        themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }
    }

    const savedTheme = localStorage.getItem('skillsphere_theme') || localStorage.getItem('theme') || 'light';
    applyTheme(savedTheme);

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(nextTheme);
      });
    }

    // -------------------------------------------------------------
    // Auth State Detection in Header Actions
    // -------------------------------------------------------------
    document.addEventListener('DOMContentLoaded', () => {
      const token = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('accessToken') || localStorage.getItem('token');
      if (token) {
        const loginBtn = document.getElementById('navLoginBtn');
        const regBtn = document.getElementById('navRegisterBtn');
        if (loginBtn) {
          loginBtn.style.display = 'none';
        }
        if (regBtn) {
          regBtn.textContent = 'Dashboard';
          regBtn.href = '/dashboard';
        }
      }
    });

    // -------------------------------------------------------------
    // Mobile Drawer Controls
    // -------------------------------------------------------------
    const mobileMenuTrigger = document.getElementById('mobileMenuTrigger');
    const drawerCloseBtn = document.getElementById('drawerCloseBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const drawerBackdrop = document.getElementById('drawerBackdrop');

    function openDrawer() {
      if (mobileDrawer) mobileDrawer.classList.add('open');
      if (drawerBackdrop) drawerBackdrop.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (mobileDrawer) mobileDrawer.classList.remove('open');
      if (drawerBackdrop) drawerBackdrop.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (mobileMenuTrigger) mobileMenuTrigger.addEventListener('click', openDrawer);
    if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeDrawer);
    if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeDrawer);

    // -------------------------------------------------------------
    // Sticky Nav Shadow on Scroll
    // -------------------------------------------------------------
    const mainNav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => {
      if (mainNav) {
        if (window.scrollY > 20) {
          mainNav.classList.add('scrolled');
        } else {
          mainNav.classList.remove('scrolled');
        }
      }
    });

    // -------------------------------------------------------------
    // Jakub Krehel Smooth Scroll Reveal (IntersectionObserver)
    // -------------------------------------------------------------
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      revealElements.forEach(el => revealObserver.observe(el));
    } else {
      revealElements.forEach(el => el.classList.add('revealed'));
    }

    // -------------------------------------------------------------
    // Rotating Typewriter Simulator (Dicoding Inspired, Interactive)
    // -------------------------------------------------------------
    const typewriterGoals = [
      "Aku ingin belajar arsitektur backend & microservices dari nol...",
      "Bagaimana membedakan 2NF dan 3NF pada basis data relasional...",
      "Aku ingin menjadi Fullstack AI Engineer berstandar industri...",
      "Mengapa Redis Cache-Aside lebih aman untuk mitigasi beban tinggi...",
      "Aku ingin menguasai Flutter & Clean Architecture..."
    ];

    let currentGoalIdx = 0;
    let currentCharIdx = 0;
    let isDeleting = false;
    let typewriterPaused = false;
    let typewriterTimeout = null;

    const goalInput = document.getElementById('careerGoalInput');
    const placeholderEl = document.getElementById('typewriterPlaceholder');
    const typewriterTextEl = document.getElementById('typewriterText');

    function stepTypewriter() {
      if (typewriterPaused) return;

      const currentText = typewriterGoals[currentGoalIdx];

      if (!isDeleting) {
        currentCharIdx++;
        if (typewriterTextEl) typewriterTextEl.textContent = currentText.substring(0, currentCharIdx);

        if (currentCharIdx >= currentText.length) {
          isDeleting = true;
          typewriterTimeout = setTimeout(stepTypewriter, 2600);
          return;
        }
      } else {
        currentCharIdx--;
        if (typewriterTextEl) typewriterTextEl.textContent = currentText.substring(0, currentCharIdx);

        if (currentCharIdx <= 0) {
          isDeleting = false;
          currentGoalIdx = (currentGoalIdx + 1) % typewriterGoals.length;
          typewriterTimeout = setTimeout(stepTypewriter, 450);
          return;
        }
      }

      const speed = isDeleting ? 28 : 65;
      typewriterTimeout = setTimeout(stepTypewriter, speed);
    }

    if (typewriterTextEl) {
      typewriterTimeout = setTimeout(stepTypewriter, 800);
    }

    function focusGoalInput() {
      if (goalInput) {
        goalInput.focus();
      }
    }

    if (goalInput) {
      goalInput.addEventListener('focus', () => {
        typewriterPaused = true;
        clearTimeout(typewriterTimeout);
        if (placeholderEl && goalInput.value.length > 0) {
          placeholderEl.style.opacity = '0';
        }
      });

      goalInput.addEventListener('input', () => {
        if (placeholderEl) {
          placeholderEl.style.opacity = goalInput.value.trim().length > 0 ? '0' : '1';
        }
      });

      goalInput.addEventListener('blur', () => {
        if (goalInput.value.trim().length === 0) {
          if (placeholderEl) placeholderEl.style.opacity = '1';
          typewriterPaused = false;
          stepTypewriter();
        }
      });

      goalInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleGoalSubmit();
        }
      });
    }

    // Socratic Scenarios Data for Quick Preview
    const socraticInsights = {
      backend: {
        title: "Arsitektur Backend & Microservices",
        text: "Pada sistem berskala besar, memecah arsitektur monolit ke microservices membutuhkan toleransi kegagalan (circuit breaker) dan komunikasi asinkron event-driven. Di SkillSphere, Anda membedah orkestrasi Kubernetes dan Redis Pub/Sub dari fondasi hingga produksi.",
        actionUrl: "/catalog?cat=backend"
      },
      database: {
        title: "Normalisasi Relasional 3NF & Desain Database",
        text: "Normalisasi 2NF mengeliminasi ketergantungan parsial pada composite key, sedangkan 3NF membuang dependensi transitif antar atribut non-kunci. Pendekatan ini mencegah anomali insert, update, dan delete saat beban transaksi jutaan baris.",
        actionUrl: "/catalog?cat=database"
      },
      ai: {
        title: "AI Engineer & Rekayasa Autonomous Agent",
        text: "Membangun AI Agent bukan sekadar menyusun prompt teks, melainkan merancang siklus persepsi, pemanggilan alat (tool calling), verifikasi evaluasi terstruktur, dan memori percakapan berdaya tahan tinggi dengan model LLM terkini.",
        actionUrl: "/catalog?cat=ai"
      },
      frontend: {
        title: "Modern Frontend & Sistem Desain Terstandar",
        text: "Arsitektur frontend modern menitikberatkan aksesibilitas WCAG AA, Core Web Vitals, dan sistem token desain modular tanpa membebani ukuran bundle JavaScript pengguna.",
        actionUrl: "/catalog?cat=frontend"
      }
    };

    function selectGoalChip(topicKey) {
      const data = socraticInsights[topicKey];
      if (!data) return;

      if (goalInput) {
        goalInput.value = data.title;
        if (placeholderEl) placeholderEl.style.opacity = '0';
      }

      displaySocraticInsight(data);
    }

    function displaySocraticInsight(data) {
      const insightBox = document.getElementById('orionInsightBox');
      const insightContent = document.getElementById('orionInsightContent');
      const mouth = document.getElementById('orbMouth');

      if (!insightBox || !insightContent) return;

      if (mouth) mouth.classList.add('speaking');

      insightContent.innerHTML = `
        <div style="font-weight:600; color:var(--text-primary); margin-bottom:4px; font-size:13.5px;">
          ${data.title}
        </div>
        <div style="margin-bottom:12px; font-size:13px; line-height:1.6;">
          ${data.text}
        </div>
        <div style="display:flex; justify-content:flex-end;">
          <a href="${data.actionUrl}" class="btn-clean btn-clean-primary" style="padding:6px 14px; font-size:12px;">
            Jelajahi Kurikulum Terkait <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      `;

      insightBox.classList.add('active');

      setTimeout(() => {
        if (mouth) mouth.classList.remove('speaking');
      }, 700);
    }

    function closeInsightBox() {
      const insightBox = document.getElementById('orionInsightBox');
      if (insightBox) insightBox.classList.remove('active');
    }

    function handleGoalSubmit() {
      const val = goalInput ? goalInput.value.trim() : '';
      if (!val) {
        const currentText = typewriterGoals[currentGoalIdx];
        window.location.href = `/register?goal=${encodeURIComponent(currentText)}`;
        return;
      }

      const lower = val.toLowerCase();
      if (lower.includes('normalisasi') || lower.includes('database') || lower.includes('sql') || lower.includes('2nf') || lower.includes('3nf')) {
        displaySocraticInsight(socraticInsights.database);
      } else if (lower.includes('backend') || lower.includes('microservice') || lower.includes('cloud')) {
        displaySocraticInsight(socraticInsights.backend);
      } else if (lower.includes('ai') || lower.includes('agent') || lower.includes('llm') || lower.includes('prompt')) {
        displaySocraticInsight(socraticInsights.ai);
      } else if (lower.includes('front') || lower.includes('ui') || lower.includes('css') || lower.includes('html')) {
        displaySocraticInsight(socraticInsights.frontend);
      } else {
        window.location.href = `/register?goal=${encodeURIComponent(val)}`;
      }
    }

    function scrollToGoalCard() {
      const card = document.getElementById('careerGoalCard');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          if (goalInput) goalInput.focus();
          card.style.transform = 'scale(1.015)';
          setTimeout(() => { card.style.transform = 'none'; }, 250);
        }, 400);
      }
    }

    // -------------------------------------------------------------
    // Curriculum Explorer Category Switcher
    // -------------------------------------------------------------
    const coursesData = [
      {
        category: 'backend',
        catLabel: 'Backend Architecture',
        level: 'Menengah',
        title: 'Basis Data Lanjut: Arsitektur Skema & Normalisasi Relasional',
        desc: 'Reduksi redundansi, mitigasi tiga anomali database, dekomposisi tabel dari 1NF hingga 3NF dan BCNF berdasarkan kasus nyata perbankan.',
        tutorInitial: 'AL',
        tutorName: 'Arjuna Lanang',
        url: '/catalog'
      },
      {
        category: 'backend',
        catLabel: 'Cloud Native',
        level: 'Lanjutan',
        title: 'Mastering Enterprise Backend: Microservices & Event-Driven',
        desc: 'Perancangan arsitektur microservices berdaya tahan tinggi, message broker Redis Pub/Sub, gRPC, dan orkestrasi kontainer Kubernetes.',
        tutorInitial: 'CS',
        tutorName: 'CS-Orion Lead',
        url: '/catalog'
      },
      {
        category: 'ai',
        catLabel: 'AI & LLM',
        level: 'Semua Tingkat',
        title: 'Mastering Large Language Models: Dari Prompting hingga Agen Otonom',
        desc: 'Integrasi Gemini Interactions API, pembuatan retrieval-augmented generation (RAG), vector embeddings, dan perancangan AI agent handal.',
        tutorInitial: 'AS',
        tutorName: 'Akhmad Satrio',
        url: '/catalog'
      },
      {
        category: 'ai',
        catLabel: 'Data Science',
        level: 'Dasar - Menengah',
        title: 'Data Science & Machine Learning: Analitika Prediktif Python',
        desc: 'Pemodelan data tabular, visualisasi interaktif, feature engineering dengan scikit-learn, dan deployment model ke production pipeline.',
        tutorInitial: 'DP',
        tutorName: 'Dimas Pratama',
        url: '/catalog'
      },
      {
        category: 'frontend',
        catLabel: 'Frontend Engineering',
        level: 'Dasar',
        title: 'Mastering Modern HTML5, Semantik Web & Desain Responsif',
        desc: 'Fondasi arsitektur web modern, aksesibilitas WCAG AA, Core Web Vitals, dan sistem tata letak grid fleksibel tanpa ketergantungan framework berat.',
        tutorInitial: 'NW',
        tutorName: 'Nadia Wardani',
        url: '/catalog'
      },
      {
        category: 'frontend',
        catLabel: 'UI/UX Engineering',
        level: 'Menengah',
        title: 'UI/UX Design Masterclass: Dari Wireframe ke Sistem Desain Produksi',
        desc: 'Penguasaan prinsip desain warm paper, micro-interaction bernilai tinggi, desain motion Jakob Krehel, dan standarisasi token komponen.',
        tutorInitial: 'FA',
        tutorName: 'Fadiyah A.',
        url: '/catalog'
      },
      {
        category: 'mobile',
        catLabel: 'Mobile App',
        level: 'Menengah',
        title: 'Membangun Aplikasi Multi-Platform dengan Flutter & Clean Architecture',
        desc: 'Penerapan BLoC state management, offline-first SQLite cache, autentikasi biometric, dan optimalisasi render 60 FPS pada iOS dan Android.',
        tutorInitial: 'RH',
        tutorName: 'Rafi Hidayat',
        url: '/catalog'
      }
    ];

    function switchCategoryTab(cat) {
      document.querySelectorAll('.tab-category-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');

      const grid = document.getElementById('coursesGrid');
      if (!grid) return;

      const filtered = coursesData.filter(c => c.category === cat);
      grid.style.opacity = '0.3';
      grid.style.transform = 'translateY(6px)';

      setTimeout(() => {
        grid.innerHTML = filtered.map(c => `
          <div class="course-showcase-card revealed" data-category="${c.category}">
            <div>
              <div class="card-top-meta">
                <span class="course-cat-label">${c.catLabel}</span>
                <span class="course-level-pill">${c.level}</span>
              </div>
              <h4 class="card-course-title">${c.title}</h4>
              <p class="card-course-desc">${c.desc}</p>
            </div>
            <div class="card-course-footer">
              <div class="tutor-info">
                <div class="tutor-avatar-circle">${c.tutorInitial}</div>
                <span>${c.tutorName}</span>
              </div>
              <a href="${c.url}" class="btn-clean btn-clean-outline" style="padding:6px 12px; font-size:12px;">Lihat Silabus</a>
            </div>
          </div>
        `).join('');

        grid.style.opacity = '1';
        grid.style.transform = 'translateY(0)';
      }, 180);
    }
  </script>

  <!-- Floating Orion Launcher Widget (Dicoding Inspired) -->
  <button type="button" class="floating-orion-launcher" id="floatingOrionLauncher" onclick="scrollToGoalCard()" title="Tanya Orion AI" aria-label="Tanya Orion AI">
    <div class="orion-orb-container" style="width:34px; height:34px; box-shadow:0 0 14px rgba(59,130,246,0.5);">
      <div class="orb-face" style="width:16px; height:13px;">
        <div class="orb-eyes" style="gap:4px;">
          <div class="orb-eye" style="width:2.5px; height:4.5px;"></div>
          <div class="orb-eye" style="width:2.5px; height:4.5px;"></div>
        </div>
        <div class="orb-mouth" style="width:5px; height:1.5px;"></div>
      </div>
    </div>
    <span class="floating-launcher-label">Tanya Orion AI</span>
  </button>
</body>
