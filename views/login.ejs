  <script>
    // --- 1. Theme Switcher Logic ---
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // --- 2. Password Visibility Toggle ---
    const passwordInput = document.getElementById('password');
    const togglePasswordBtn = document.getElementById('toggle-password');
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');

    togglePasswordBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isPassword = passwordInput.getAttribute('type') === 'password';
      passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
      
      if (isPassword) {
        eyeIcon.style.display = 'none';
        eyeOffIcon.style.display = 'inline-block';
        togglePasswordBtn.setAttribute('aria-label', 'Sembunyikan password');
      } else {
        eyeIcon.style.display = 'inline-block';
        eyeOffIcon.style.display = 'none';
        togglePasswordBtn.setAttribute('aria-label', 'Lihat password');
      }
    });

    // --- 3. Local Storage Saved Accounts & WebAuthn / Device Lock PIN Verification ---
    const SAVED_ACCOUNTS_KEY = 'skillsphere_saved_accounts';
    const emailInput = document.getElementById('email');
    const rememberMeCheckbox = document.getElementById('remember-me');
    const savedAccountsWrapper = document.getElementById('saved-accounts-wrapper');
    const savedAccountsList = document.getElementById('saved-accounts-list');
    const clearSavedAccountsBtn = document.getElementById('clear-saved-accounts-btn');

    function getSavedAccounts() {
      try {
        const raw = localStorage.getItem(SAVED_ACCOUNTS_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function encodeSecret(str) {
      try {
        return btoa(encodeURIComponent(str));
      } catch (e) {
        return str;
      }
    }

    function decodeSecret(str) {
      try {
        return decodeURIComponent(atob(str));
      } catch (e) {
        return str;
      }
    }

    function saveAccountLocally(user, password) {
      if (!user || !user.email) return;
      let accounts = getSavedAccounts();
      accounts = accounts.filter(acc => acc.email.toLowerCase() !== user.email.toLowerCase());
      
      accounts.unshift({
        name: user.name || user.email.split('@')[0],
        email: user.email,
        role: user.role || 'student',
        avatar_url: user.profile ? user.profile.avatar_url : null,
        secret: password ? encodeSecret(password) : null,
        last_logged_in: Date.now(),
      });

      if (accounts.length > 5) accounts = accounts.slice(0, 5);
      localStorage.setItem(SAVED_ACCOUNTS_KEY, JSON.stringify(accounts));
      renderSavedAccounts();
    }

    function removeSavedAccount(email) {
      let accounts = getSavedAccounts();
      accounts = accounts.filter(acc => acc.email.toLowerCase() !== email.toLowerCase());
      localStorage.setItem(SAVED_ACCOUNTS_KEY, JSON.stringify(accounts));
      renderSavedAccounts();
    }

    async function promptDeviceLockVerification(account) {
      showAlert('success', 'Silakan verifikasi dengan PIN / Touch ID perangkat Anda...');

      let verificationSuccess = false;

      if (window.PublicKeyCredential) {
        try {
          const challenge = new Uint8Array(32);
          window.crypto.getRandomValues(challenge);

          const userId = new Uint8Array(16);
          window.crypto.getRandomValues(userId);

          await navigator.credentials.create({
            publicKey: {
              challenge: challenge,
              rp: {
                name: "SkillSphere AI Security",
                id: window.location.hostname
              },
              user: {
                id: userId,
                name: account.email,
                displayName: account.name || account.email
              },
              pubKeyCredParams: [
                { alg: -7, type: "public-key" },
                { alg: -257, type: "public-key" }
              ],
              authenticatorSelection: {
                authenticatorAttachment: "platform",
                userVerification: "required"
              },
              timeout: 60000
            }
          });

          verificationSuccess = true;
        } catch (err) {
          console.warn("Device PIN / Touch ID authentication result:", err);
          if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
            showAlert('danger', 'Verifikasi PIN / Layar Kunci perangkat dibatalkan. Silakan ketik password manual.');
            emailInput.value = account.email;
            passwordInput.value = '';
            passwordInput.focus();
            return;
          }
          verificationSuccess = true;
        }
      } else {
        verificationSuccess = confirm(`Verifikasi identitas: Izinkan masuk cepat untuk ${account.email}?`);
      }

      if (verificationSuccess) {
        emailInput.value = account.email;
        if (account.secret) {
          passwordInput.value = decodeSecret(account.secret);
        } else {
          passwordInput.value = 'password123';
        }

        showAlert('success', `Verifikasi berhasil! Memproses masuk untuk ${account.name}...`);
        
        setTimeout(() => {
          submitLoginForm();
        }, 400);
      }
    }

    function renderSavedAccounts() {
      const accounts = getSavedAccounts();
      if (!accounts || accounts.length === 0) {
        savedAccountsWrapper.style.display = 'none';
        return;
      }

      savedAccountsWrapper.style.display = 'block';
      savedAccountsList.innerHTML = '';

      accounts.forEach((acc, index) => {
        const chip = document.createElement('div');
        chip.className = 'account-chip' + (index === 0 && !emailInput.value ? ' active' : '');
        
        const initials = acc.name ? acc.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';
        
        chip.innerHTML = `
          <div class="account-chip-main" title="Klik untuk verifikasi PIN & Masuk Otomatis">
            <div class="account-avatar">${initials}</div>
            <div class="account-info">
              <span class="account-name">${escapeHtml(acc.name)}</span>
              <span class="account-email">${escapeHtml(acc.email)}</span>
            </div>
          </div>
          <span class="account-badge">${escapeHtml(acc.role)}</span>
          <button type="button" class="remove-account-btn" title="Hapus dari perangkat ini" aria-label="Hapus">
            <i class="fas fa-xmark" style="font-size: 13px;"></i>
          </button>
        `;

        chip.querySelector('.account-chip-main').addEventListener('click', () => {
          document.querySelectorAll('.account-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          promptDeviceLockVerification(acc);
        });

        chip.querySelector('.remove-account-btn').addEventListener('click', (e) => {
          e.stopPropagation();
          removeSavedAccount(acc.email);
        });

        savedAccountsList.appendChild(chip);
      });
    }

    clearSavedAccountsBtn.addEventListener('click', () => {
      if (confirm('Hapus semua riwayat akun yang tersimpan di perangkat ini?')) {
        localStorage.removeItem(SAVED_ACCOUNTS_KEY);
        renderSavedAccounts();
        emailInput.value = '';
        passwordInput.value = '';
      }
    });

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    renderSavedAccounts();

    // --- 4. Form Submission & AJAX Login ---
    const loginForm = document.getElementById('login-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnSpinner = document.getElementById('btn-spinner');
    const btnText = document.getElementById('btn-text');
    const alertBanner = document.getElementById('alert-banner');
    const alertMessage = document.getElementById('alert-message');

    function showAlert(type, message) {
      alertBanner.className = 'alert-box alert-' + type;
      alertMessage.textContent = message;
      alertBanner.style.display = 'flex';
    }

    function hideAlert() {
      alertBanner.style.display = 'none';
    }

    async function submitLoginForm() {
      hideAlert();

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        showAlert('danger', 'Harap isi email dan kata sandi Anda.');
        return;
      }

      submitBtn.disabled = true;
      btnSpinner.style.display = 'inline-block';
      btnText.textContent = 'Memverifikasi...';

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, password }),
        });

        const result = await response.json();

        // 1. Case A: User has pending / unverified OTP
        if (result.requireOtp || result.require_otp) {
          activeLoginOtpEmail = result.email || email;
          activeLoginPassword = password;
          submitBtn.disabled = false;
          btnSpinner.style.display = 'none';
          btnText.innerHTML = '<i class="fas fa-right-to-bracket" style="margin-right: 6px;"></i> Masuk ke SkillSphere';

          // Framer Blur Transition to OTP Step
          const stepLogin = document.getElementById('step-login');
          const stepLoginOtp = document.getElementById('step-login-otp');
          stepLogin.className = 'framer-exit-up';
          setTimeout(() => {
            stepLogin.style.display = 'none';
            stepLoginOtp.style.display = 'block';
            stepLoginOtp.className = 'framer-enter-up';
            document.getElementById('target-otp-email').textContent = activeLoginOtpEmail;
            showLoginOtpAlert('success', result.message || 'Akun Anda belum aktif. Masukkan kode OTP dari email.');
            startLoginOtpResendCountdown();
            resetLoginOtpDeck();
            setTimeout(() => loginOtpBoxes[0].focus(), 300);
          }, 300);
          return;
        }

        // 2. Case B: Successful Login
        if (response.ok && result.success) {
          localStorage.setItem('skillsphere_access_token', result.data.accessToken);
          localStorage.setItem('skillsphere_refresh_token', result.data.refreshToken);
          localStorage.setItem('skillsphere_user', JSON.stringify(result.data.user));

          if (rememberMeCheckbox.checked) {
            saveAccountLocally(result.data.user, password);
          }

          const hasCompletedOnboarding = result.data.user.role === 'admin' || 
            (result.data.user && result.data.user.profile && result.data.user.profile.study_preferences && result.data.user.profile.study_preferences.onboarding_completed);

          if (!hasCompletedOnboarding || result.data.requires_onboarding) {
            showAlert('success', 'Login berhasil! Mengalihkan ke formulir personalisasi...');
          } else {
            showAlert('success', 'Login berhasil! Menyiapkan ruang belajar...');
          }

          btnText.innerHTML = '<i class="fas fa-check" style="margin-right: 6px;"></i> Berhasil Masuk';

          // Framer Exit Gaussian Blur Transition
          const loginCard = document.getElementById('login-card-container');
          if (loginCard) {
            loginCard.classList.remove('framer-enter-down');
            loginCard.classList.add('framer-exit-up');
          }

          setTimeout(() => {
            if (!hasCompletedOnboarding || result.data.requires_onboarding) {
              window.location.href = '/dashboard/onboarding';
            } else {
              window.location.href = '/dashboard';
            }
          }, 350);
        } else {
          showAlert('danger', result.message || 'Login gagal. Periksa kembali email dan password Anda.');
          submitBtn.disabled = false;
          btnSpinner.style.display = 'none';
          btnText.innerHTML = '<i class="fas fa-right-to-bracket" style="margin-right: 6px;"></i> Masuk ke SkillSphere';
        }
      } catch (err) {
        showAlert('danger', 'Koneksi ke server gagal. Pastikan server SkillSphere sedang aktif.');
        submitBtn.disabled = false;
        btnSpinner.style.display = 'none';
        btnText.innerHTML = '<i class="fas fa-right-to-bracket" style="margin-right: 6px;"></i> Masuk ke SkillSphere';
      }
    }

    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      submitLoginForm();
    });

    // =========================================================
    // --- 5. Pending OTP Card Deck Verification Logic ---
    // =========================================================
    let activeLoginOtpEmail = '';
    let activeLoginPassword = '';
    let isLoginVerifying = false;

    const loginOtpContainer = document.getElementById('login-otp-container');
    const loginOtpStatusContent = document.getElementById('login-otp-status-content');
    const loginOtpSuccessBadge = document.getElementById('login-otp-success-badge');
    const loginOtpBoxes = [
      document.getElementById('lotp-1'),
      document.getElementById('lotp-2'),
      document.getElementById('lotp-3'),
      document.getElementById('lotp-4'),
      document.getElementById('lotp-5'),
      document.getElementById('lotp-6'),
    ];

    function showLoginOtpAlert(type, message) {
      const banner = document.getElementById('alert-banner-login-otp');
      banner.className = 'alert-box alert-' + type;
      banner.firstElementChild.textContent = message;
      banner.style.display = 'flex';
    }

    function hideLoginOtpAlert() {
      const banner = document.getElementById('alert-banner-login-otp');
      banner.style.display = 'none';
    }

    function resetLoginOtpDeck() {
      loginOtpContainer.classList.remove('cards-stacked', 'verifying-stack', 'error-stack');
      loginOtpSuccessBadge.classList.remove('show');
      
      loginOtpBoxes.forEach(box => {
        box.value = '';
        box.style.transform = '';
        box.style.zIndex = '';
        box.style.boxShadow = '';
        box.style.opacity = '1';
        box.style.filter = '';
        box.classList.remove('fanning-out');
        box.disabled = false;
      });

      isLoginVerifying = false;
      loginOtpStatusContent.innerHTML = `
        <span class="otp-hint-text">
          <i class="fas fa-shield-halved"></i> Masukkan 6 digit kode dari email
        </span>
      `;
    }

    function stackLoginCardsIntoDeck() {
      loginOtpContainer.classList.add('cards-stacked', 'verifying-stack');
      const offsets = [-2.5, -1.5, -0.5, 0.5, 1.5, 2.5];
      const stride = 58;

      loginOtpBoxes.forEach((box, i) => {
        const offset = offsets[i];
        const translateX = -offset * stride;
        const rotateZ = offset * 2.8;
        const translateY = -Math.abs(offset) * 1.5;
        
        box.style.transform = `translateX(${translateX}px) translateY(${translateY}px) rotate(${rotateZ}deg) scale(0.97)`;
        box.style.zIndex = Math.round(20 - Math.abs(offset) * 2);
        box.style.boxShadow = `0 ${8 + Math.abs(offset)*2}px ${20 + Math.abs(offset)*3}px rgba(0,0,0,0.22)`;
        box.blur();
      });

      loginOtpStatusContent.innerHTML = `
        <div class="otp-status-spinner"></div>
        <span style="font-weight:600; color:var(--text-primary);">Menyatukan kartu & memverifikasi kode...</span>
      `;
    }

    function fanOutLoginCardsBackToPosition(errorMessage) {
      loginOtpContainer.classList.remove('verifying-stack');
      loginOtpContainer.classList.add('error-stack');

      loginOtpStatusContent.innerHTML = `
        <i class="fas fa-circle-exclamation" style="color:var(--color-danger); font-size:15px;"></i>
        <span style="color:var(--color-danger); font-weight:600;">${errorMessage || 'Kode OTP salah atau kadaluarsa.'}</span>
      `;

      setTimeout(() => {
        loginOtpContainer.classList.remove('cards-stacked', 'error-stack');

        loginOtpBoxes.forEach(box => {
          box.classList.add('fanning-out');
          box.style.transform = '';
          box.style.zIndex = '';
          box.style.boxShadow = '';
        });

        setTimeout(() => {
          loginOtpBoxes.forEach(box => {
            box.value = '';
            box.classList.remove('fanning-out');
            box.disabled = false;
          });

          loginOtpStatusContent.innerHTML = `
            <span class="otp-hint-text">
              <i class="fas fa-shield-halved"></i> Silakan masukkan 6 digit kode yang benar
            </span>
          `;

          isLoginVerifying = false;
          loginOtpBoxes[0].focus();
        }, 480);
      }, 550);
    }

    async function triggerLoginAutoVerify(otpCode) {
      if (isLoginVerifying || otpCode.length !== 6) return;
      isLoginVerifying = true;
      hideLoginOtpAlert();

      stackLoginCardsIntoDeck();

      try {
        const response = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: activeLoginOtpEmail, otp: otpCode }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          setTimeout(() => {
            loginOtpContainer.classList.remove('verifying-stack');
            loginOtpBoxes.forEach(box => {
              box.style.opacity = '0.2';
              box.style.filter = 'blur(2px)';
            });

            loginOtpSuccessBadge.classList.add('show');

            loginOtpStatusContent.innerHTML = `
              <i class="fas fa-circle-check" style="color:var(--color-success); font-size:16px;"></i>
              <span style="color:var(--color-success); font-weight:600;">Verifikasi Berhasil! Mengalihkan ke Ruang Belajar...</span>
            `;

            // Save tokens & credentials
            localStorage.setItem('skillsphere_access_token', result.data.accessToken);
            localStorage.setItem('skillsphere_refresh_token', result.data.refreshToken);
            localStorage.setItem('skillsphere_user', JSON.stringify(result.data.user));

            saveAccountLocally(result.data.user, activeLoginPassword);

            const hasCompletedOnboarding = result.data.user.role === 'admin' || 
              (result.data.user && result.data.user.profile && result.data.user.profile.study_preferences && result.data.user.profile.study_preferences.onboarding_completed);

            setTimeout(() => {
              if (!hasCompletedOnboarding) {
                window.location.href = '/dashboard/onboarding';
              } else {
                window.location.href = '/dashboard';
              }
            }, 900);
          }, 350);
        } else {
          setTimeout(() => {
            fanOutLoginCardsBackToPosition(result.message);
          }, 350);
        }
      } catch (err) {
        setTimeout(() => {
          fanOutLoginCardsBackToPosition('Koneksi ke server terputus.');
        }, 350);
      }
    }

    loginOtpBoxes.forEach((box, index) => {
      box.addEventListener('input', (e) => {
        if (isLoginVerifying) return;
        const value = e.target.value.replace(/\D/g, '');
        box.value = value ? value[0] : '';
        
        if (box.value && index < loginOtpBoxes.length - 1) {
          loginOtpBoxes[index + 1].focus();
        }

        const currentOtp = loginOtpBoxes.map(b => b.value).join('');
        if (currentOtp.length === 6) {
          triggerLoginAutoVerify(currentOtp);
        }
      });

      box.addEventListener('keydown', (e) => {
        if (isLoginVerifying) return;
        if (e.key === 'Backspace' && !box.value && index > 0) {
          loginOtpBoxes[index - 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        if (isLoginVerifying) return;
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim().replace(/\D/g, '');
        if (pasteData.length >= 6) {
          pasteData.substring(0, 6).split('').forEach((char, i) => {
            if (loginOtpBoxes[i]) loginOtpBoxes[i].value = char;
          });
          triggerLoginAutoVerify(pasteData.substring(0, 6));
        }
      });
    });

    // Resend OTP in Login
    const loginResendBtn = document.getElementById('login-resend-otp-btn');
    const loginResendTimer = document.getElementById('login-resend-timer');
    let loginTimerInterval = null;

    function startLoginOtpResendCountdown() {
      let seconds = 60;
      loginResendBtn.disabled = true;
      loginResendTimer.textContent = seconds;

      clearInterval(loginTimerInterval);
      loginTimerInterval = setInterval(() => {
        seconds--;
        loginResendTimer.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(loginTimerInterval);
          loginResendBtn.disabled = false;
          loginResendBtn.innerHTML = '<i class="fas fa-rotate-right" style="font-size: 11px;"></i> Kirim Ulang Kode';
        }
      }, 1000);
    }

    loginResendBtn.addEventListener('click', async () => {
      try {
        loginResendBtn.disabled = true;
        const res = await fetch('/api/auth/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: activeLoginOtpEmail }),
        });
        const result = await res.json();
        if (res.ok && result.success) {
          showLoginOtpAlert('success', 'Kode OTP baru telah dikirim ke email.');
          resetLoginOtpDeck();
          startLoginOtpResendCountdown();
          loginOtpBoxes[0].focus();
        } else {
          showLoginOtpAlert('danger', result.message || 'Gagal mengirim ulang OTP.');
          loginResendBtn.disabled = false;
        }
      } catch (e) {
        showLoginOtpAlert('danger', 'Gagal mengirim ulang OTP.');
        loginResendBtn.disabled = false;
      }
    });

    // Back to Login Form
    document.getElementById('back-to-login-form-btn').addEventListener('click', () => {
      const stepLogin = document.getElementById('step-login');
      const stepLoginOtp = document.getElementById('step-login-otp');
      stepLoginOtp.className = 'framer-exit-down';
      setTimeout(() => {
        stepLoginOtp.style.display = 'none';
        stepLogin.style.display = 'block';
        stepLogin.className = 'framer-enter-down';
      }, 300);
    });

    // --- 6. Framer Exit Blur Transition to Register Page ---
    const linkToRegister = document.getElementById('link-to-register');
    if (linkToRegister) {
      linkToRegister.addEventListener('click', (e) => {
        e.preventDefault();
        const loginCard = document.getElementById('login-card-container');
        if (loginCard) {
          loginCard.classList.remove('framer-enter-down');
          loginCard.classList.add('framer-exit-up');
          setTimeout(() => {
            window.location.href = '/register';
          }, 280);
        } else {
          window.location.href = '/register';
        }
      });
    }
  </script>
</body>
</html>
