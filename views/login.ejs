<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk | SkillSphere AI</title>
  <meta name="description" content="Masuk ke platform pembelajaran online SkillSphere AI untuk mengakses kursus, rekomendasi karir cerdas, dan portal tutor.">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">
  
  <style>
    /* Framer Motion-grade Gaussian Blur & Spring Animations for Login Page */
    @keyframes framerSlideDownBlur {
      0% {
        opacity: 0;
        filter: blur(20px);
        transform: translateY(-32px) scale(0.96);
      }
      60% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes framerSlideUpBlur {
      0% {
        opacity: 0;
        filter: blur(18px);
        transform: translateY(32px) scale(0.96);
      }
      60% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0) scale(1);
      }
    }

    @keyframes framerExitUpBlur {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: scale(1) translateY(0);
      }
      100% {
        opacity: 0;
        filter: blur(18px);
        transform: scale(0.95) translateY(-28px);
      }
    }

    @keyframes framerExitDownBlur {
      0% {
        opacity: 1;
        filter: blur(0px);
        transform: scale(1) translateY(0);
      }
      100% {
        opacity: 0;
        filter: blur(18px);
        transform: scale(0.95) translateY(28px);
      }
    }

    @keyframes framerStaggerItemBlur {
      0% {
        opacity: 0;
        filter: blur(12px);
        transform: translateY(14px);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0);
      }
    }

    .framer-enter-down {
      animation: framerSlideDownBlur 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }

    .framer-enter-up {
      animation: framerSlideUpBlur 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }

    .framer-exit-up {
      animation: framerExitUpBlur 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    .framer-exit-down {
      animation: framerExitDownBlur 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      will-change: transform, opacity, filter;
      pointer-events: none;
    }

    /* Staggered micro-blur appearance for inner elements */
    .framer-stagger-1 {
      animation: framerStaggerItemBlur 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.08s backwards;
    }
    .framer-stagger-2 {
      animation: framerStaggerItemBlur 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.15s backwards;
    }
    .framer-stagger-3 {
      animation: framerStaggerItemBlur 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.22s backwards;
    }
    /* ========================================================= */
    /* --- OTP CARD DECK MERGING & FAN-OUT ANIMATION SYSTEM --- */
    /* ========================================================= */
    .otp-inputs-wrapper {
      position: relative;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      perspective: 1000px;
    }

    .otp-inputs-container {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin: 28px 0 16px;
      min-height: 64px;
      width: 100%;
    }

    .otp-digit-box {
      width: 48px;
      height: 58px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      border-radius: var(--radius-md);
      font-family: var(--font-mono);
      font-size: 24px;
      font-weight: 700;
      text-align: center;
      color: var(--text-primary);
      outline: none;
      position: relative;
      transition: transform 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.48s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.3s ease,
                  background-color 0.3s ease,
                  opacity 0.35s ease,
                  filter 0.35s ease;
      will-change: transform, box-shadow, opacity;
      box-shadow: var(--shadow-sm);
    }

    .otp-digit-box:focus {
      border-color: var(--text-primary);
      box-shadow: 0 0 0 2px var(--accent-primary-light);
      transform: translateY(-2px);
    }

    .otp-inputs-container.cards-stacked .otp-digit-box {
      cursor: default;
      pointer-events: none;
    }

    @keyframes cardStackPulse {
      0%, 100% {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25), 0 0 0 2px var(--accent-primary-light);
      }
      50% {
        box-shadow: 0 14px 38px rgba(0, 0, 0, 0.35), 0 0 0 5px var(--accent-primary-light);
      }
    }

    .otp-inputs-container.cards-stacked.verifying-stack .otp-digit-box {
      animation: cardStackPulse 1.2s ease-in-out infinite;
    }

    @keyframes cardStackShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-9px) rotate(-1.5deg); }
      40%, 80% { transform: translateX(9px) rotate(1.5deg); }
    }

    .otp-inputs-container.cards-stacked.error-stack {
      animation: cardStackShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    .otp-inputs-container.cards-stacked.error-stack .otp-digit-box {
      border-color: var(--color-danger) !important;
      color: var(--color-danger) !important;
      background: var(--color-danger-bg) !important;
    }

    .otp-card-success-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      z-index: 60;
      pointer-events: none;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .otp-card-success-badge.show {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }

    .success-badge-circle {
      width: 62px;
      height: 62px;
      border-radius: var(--radius-full);
      background: var(--color-success);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      box-shadow: 0 12px 32px rgba(16, 185, 129, 0.45), 0 0 0 6px var(--color-success-bg);
      animation: successCircleBurst 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes successCircleBurst {
      0% { transform: scale(0.5); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { transform: scale(1.18); box-shadow: 0 0 0 16px rgba(16, 185, 129, 0); }
      100% { transform: scale(1); }
    }

    .otp-digit-box.fanning-out {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.45s ease,
                  border-color 0.3s ease,
                  background-color 0.3s ease;
    }

    .otp-status-container {
      min-height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 8px 0 16px;
      text-align: center;
    }

    .otp-status-content {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all 0.25s ease;
    }

    .otp-status-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid var(--border-subtle);
      border-top-color: var(--text-primary);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    .email-sent-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 10px 0 16px;
    }

    .resend-section {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 14px;
    }

    .resend-btn {
      background: none;
      border: none;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      cursor: pointer;
      text-decoration: underline;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .resend-btn:disabled {
      color: var(--text-tertiary);
      cursor: not-allowed;
      text-decoration: none;
    }
  </style>
  
  <script>
    // Initial Theme Script to prevent flash
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="login-page">
