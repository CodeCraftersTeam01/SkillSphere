              <input type="text" maxlength="1" class="otp-digit-box" id="lotp-5" data-index="4" inputmode="numeric">
              <input type="text" maxlength="1" class="otp-digit-box" id="lotp-6" data-index="5" inputmode="numeric">
              
              <!-- Pop-in Success Checkmark Badge on Card Center -->
