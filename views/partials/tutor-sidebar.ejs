<%
  const activeTutorNav = (typeof activeNav !== 'undefined' && activeNav) ? activeNav : 'home';
%>
<!-- Google Classroom Drawer Sidebar Backdrop -->
<div class="classroom-sidebar-backdrop" id="classroom-sidebar-backdrop" onclick="toggleClassroomSidebar(false)"></div>

<!-- Tutor Modular Sliding Left Sidebar -->
<aside class="classroom-left-sidebar" id="classroom-left-sidebar" aria-label="Menu Pengajar Studio">
  <div class="sidebar-scroll-body">
    <!-- Main Links -->
    <div class="sidebar-nav-group">
      <a href="/dashboard" class="sidebar-nav-pill <%= activeTutorNav === 'home' ? 'active' : '' %>">
        <i class="fas fa-house sidebar-nav-icon" aria-hidden="true"></i>
        <span>Beranda</span>
      </a>
      <a href="/dashboard#calendar" class="sidebar-nav-pill <%= activeTutorNav === 'calendar' ? 'active' : '' %>">
        <i class="fas fa-calendar-days sidebar-nav-icon" aria-hidden="true"></i>
        <span>Kalender</span>
      </a>
    </div>

    <div class="sidebar-divider-line"></div>

    <!-- Section: Mengajar -->
    <div class="sidebar-section-header">
      <span>Mengajar</span>
      <i class="fas fa-chalkboard-user" style="font-size:13px; color:var(--text-tertiary);" aria-hidden="true"></i>
    </div>

    <div class="sidebar-nav-group" id="sidebar-courses-list">
      <!-- Dynamically populated courses list or fallback -->
      <div style="padding:10px 24px; font-size:12px; color:var(--text-tertiary);">Memuat kelas...</div>
    </div>

    <div class="sidebar-divider-line"></div>

    <!-- Studio Management Links -->
    <div class="sidebar-nav-group">
      <a href="/tutor/exams" class="sidebar-nav-pill <%= activeTutorNav === 'exams' ? 'active' : '' %>">
        <i class="fas fa-file-signature sidebar-nav-icon" aria-hidden="true"></i>
        <span>Ujian Kelulusan</span>
      </a>
      <a href="/tutor/certificates" class="sidebar-nav-pill <%= activeTutorNav === 'certificates' ? 'active' : '' %>">
        <i class="fas fa-certificate sidebar-nav-icon" aria-hidden="true"></i>
        <span>Studio Sertifikat</span>
      </a>
      <a href="/tutor/wallet" class="sidebar-nav-pill <%= activeTutorNav === 'wallet' ? 'active' : '' %>">
        <i class="fas fa-wallet sidebar-nav-icon" aria-hidden="true"></i>
        <span>Dompet & Bagi Hasil</span>
      </a>
      <a href="/tutor/analytics" class="sidebar-nav-pill <%= activeTutorNav === 'analytics' ? 'active' : '' %>">
        <i class="fas fa-chart-line sidebar-nav-icon" aria-hidden="true"></i>
        <span>Analitik & Laporan</span>
      </a>
      <a href="/profile" class="sidebar-nav-pill <%= activeTutorNav === 'profile' ? 'active' : '' %>">
        <i class="fas fa-gear sidebar-nav-icon" aria-hidden="true"></i>
        <span>Setelan Profil</span>
      </a>
    </div>
  </div>
</aside>
