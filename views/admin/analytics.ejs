    // Main API Fetcher & Data Binder
    async function loadAdminAnalytics() {
      const icon = document.getElementById('refresh-icon');
      if (icon) icon.classList.add('fa-spin');

      const token = localStorage.getItem('token') || localStorage.getItem('skillsphere_token') || sessionStorage.getItem('token');
      if (!token) {
        window.location.href = '/login';
        return;
      }

      try {
        const res = await fetch('/api/admin/analytics', {
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
          },
        });

        const json = await res.json();
        if (!json.success) throw new Error(json.message || 'Gagal memuat analitik admin.');

        analyticsPayload = json.data;
        const { financial, users, courses, learning, payouts, tables } = json.data;

        // 1. Overview KPIs
        document.getElementById('valTotalGMV').textContent = formatRupiah(financial.total_gmv);
        document.getElementById('valPlatformFee').textContent = formatRupiah(financial.total_platform_fee);
        document.getElementById('valSuccessRate').textContent = `${financial.success_rate}%`;
        document.getElementById('valSettledCount').textContent = `${financial.settled_count} dari ${financial.total_transactions} transaksi`;

        document.getElementById('valTotalStudents').textContent = `${users.total_students} Siswa`;
        document.getElementById('valTotalTutors').textContent = `${users.total_tutors} pengajar resmi aktif`;

        document.getElementById('valCertificatesIssued').textContent = learning.certificates_issued;
        document.getElementById('valExamPassRate').textContent = `Kelulusan ujian: ${learning.exam_pass_rate}% (${learning.passed_exams} lulus)`;

        document.getElementById('valTutorShare').textContent = formatRupiah(financial.total_tutor_share);
        document.getElementById('valCompletedPayouts').textContent = formatRupiah(payouts.completed_amount);
        document.getElementById('valPendingPayouts').textContent = `${payouts.pending_count} Permintaan`;
        document.getElementById('valPendingPayoutAmount').textContent = formatRupiah(payouts.pending_amount);

        // 2. User Tab KPIs
        document.getElementById('kpiUserTotalStudents').textContent = users.total_students;
        document.getElementById('kpiUserTotalTutors').textContent = users.total_tutors;
        document.getElementById('kpiUserVerifiedCount').textContent = users.verified_count || users.total_students;
        document.getElementById('kpiUserActiveEnrollments').textContent = users.active_enrollments;

        // 3. Courses Tab KPIs
        document.getElementById('kpiCourseTotal').textContent = courses.total;
        document.getElementById('valCoursePubPriv').textContent = `${courses.published} Publik / ${courses.private} Private`;
        document.getElementById('kpiCoursePaidFree').textContent = `${courses.paid} Berbayar / ${courses.free} Gratis`;
        if (tables && tables.curriculum_summary) {
          document.getElementById('kpiCurriculumUnits').textContent = `${tables.curriculum_summary.total_materials} Unit`;
          document.getElementById('valCurriculumSections').textContent = `${tables.curriculum_summary.total_sections} Bab Kurikulum`;
          document.getElementById('kpiCurriculumHours').textContent = `${tables.curriculum_summary.total_duration_hours} Jam`;
        }

        // 4. Financial Tab KPIs
        document.getElementById('kpiFinGMV').textContent = formatRupiah(financial.total_gmv);
        document.getElementById('kpiFinPlatformFee').textContent = formatRupiah(financial.total_platform_fee);
        document.getElementById('kpiFinTutorShare').textContent = formatRupiah(financial.total_tutor_share);
        document.getElementById('kpiFinHolding').textContent = formatRupiah(payouts.total_holding_balance || 0);

        if (tables && tables.wallet_summary) {
          document.getElementById('valWalletReady').textContent = formatRupiah(tables.wallet_summary.total_balance);
          document.getElementById('valWalletHolding').textContent = formatRupiah(tables.wallet_summary.total_holding);
          document.getElementById('valWalletWithdrawn').textContent = formatRupiah(tables.wallet_summary.total_withdrawn);
          document.getElementById('valWalletPendingReq').textContent = `${tables.wallet_summary.pending_requests_count} Permintaan (${formatRupiah(tables.wallet_summary.pending_requests_amount)})`;
        }

        // 5. Learning Tab KPIs
        document.getElementById('kpiLearnExamAttempts').textContent = learning.exam_attempts;
        document.getElementById('valLearnTotalExams').textContent = `${learning.total_exams || 0} Bank Ujian Aktif`;
        document.getElementById('kpiLearnPassRate').textContent = `${learning.exam_pass_rate}%`;
        document.getElementById('valLearnPassedCount').textContent = `${learning.passed_exams} Lulus / ${learning.failed_exams || 0} Gagal`;
        document.getElementById('kpiLearnCerts').textContent = learning.certificates_issued;
        if (tables && tables.ai_roadmaps_summary) {
          document.getElementById('kpiLearnRoadmaps').textContent = tables.ai_roadmaps_summary.total;
          document.getElementById('valLearnRoadmapCompleted').textContent = `${tables.ai_roadmaps_summary.completed} Selesai Tercapai`;
        }

        // Render Quick Top Courses in Overview
        renderTopCoursesList(courses.top_courses);

        // Populate Tables
        populateTables(tables);

        // Render Visual Charts
        renderAllCharts();

      } catch (err) {
        console.error('Error in loadAdminAnalytics:', err);
      } finally {
        if (icon) icon.classList.remove('fa-spin');
      }
    }

    // Listen for Theme Switch to Repaint Charts
    const observer = new MutationObserver(() => {
      renderAllCharts();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });

    document.addEventListener('DOMContentLoaded', () => {
      loadAdminAnalytics();
    });
  </script>

  <script src="/javascripts/layout-modular.js"></script>
</body>
</html>