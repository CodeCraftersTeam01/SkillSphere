  <!-- Client-side Logic: Chart.js Initialization, Data Binding, & Search Filters -->
  <script>
    // State Store
    let analyticsPayload = null;
    let chartOverviewInstance = null;
    let chartUserGrowthInstance = null;
    let chartRoleDistInstance = null;
    let chartCourseGrowthInstance = null;
    let chartCatDistInstance = null;
    let chartMaterialTypesInstance = null;
    let chartRevenueSplitInstance = null;
    let chartPaymentMethodsInstance = null;
    let chartExamStatsInstance = null;

    let overviewScale = 'monthly';
    let userScale = 'monthly';
    let courseScale = 'monthly';
    let revenueScale = 'monthly';

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatRupiah(num) {
      return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '-';
      return d.toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
    }

    // Switch Tabs
    function switchAnalyticsTab(tabId) {
      document.querySelectorAll('.analytics-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabId);
      });
      document.querySelectorAll('.tab-pane').forEach(pane => {
        pane.classList.toggle('active', pane.id === `tab-pane-${tabId}`);
      });

      // Render charts for the newly activated tab (ensures non-zero canvas dimensions)
      setTimeout(() => {
        if (!analyticsPayload) return;
        ensureChartJsReady(() => {
          if (tabId === 'overview') {
            renderOverviewChart();
          } else if (tabId === 'users') {
            renderUserGrowthChart();
            renderRoleDistributionChart();
          } else if (tabId === 'courses') {
            renderCourseGrowthChart();
            renderCategoryDistributionChart();
            renderMaterialTypesChart();
          } else if (tabId === 'financial') {
            renderRevenueSplitChart();
            renderPaymentMethodsChart();
          } else if (tabId === 'learning') {
            renderExamStatsChart();
          }
        });
      }, 50);
    }

    // Resilient Chart.js loader check
    function ensureChartJsReady(callback, retries = 30) {
      if (typeof Chart !== 'undefined') {
        callback();
      } else if (retries > 0) {
        setTimeout(() => ensureChartJsReady(callback, retries - 1), 100);
      } else {
        console.error('Chart.js gagal dimuat setelah beberapa percobaan.');
        document.querySelectorAll('.chart-canvas-container').forEach(c => {
          if (!c.querySelector('.chart-fallback-msg')) {
            const msg = document.createElement('div');
            msg.className = 'chart-fallback-msg';
            msg.style.cssText = 'display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-tertiary);font-size:0.9rem;gap:8px;';
            msg.innerHTML = '<i class="fas fa-triangle-exclamation"></i> Gagal memuat library grafik. Silakan refresh halaman.';
            c.appendChild(msg);
          }
        });
      }
    }

    function getChartThemeColors() {
      const isDark = document.documentElement.classList.contains('dark') || 
                     document.documentElement.getAttribute('data-theme') === 'dark';
      return {
        textColor: isDark ? '#FAF9F5' : '#1F1E1B',
        textMuted: isDark ? '#A3A29E' : '#6B6963',
        gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)',
        surfaceColor: isDark ? '#1F1E1B' : '#FFFFFF',
        accent1: isDark ? '#FAF9F5' : '#1F1E1B',
        accentGreen: isDark ? '#75F39F' : '#0A6C35',
        accentYellow: isDark ? '#FCD34D' : '#92400E',
        accentBlue: isDark ? '#93C5FD' : '#2563EB',
        accentPurple: isDark ? '#C084FC' : '#7C3AED',
      };
    }

    // Render Overview Chart
    function renderOverviewChart() {
      if (typeof Chart === 'undefined') return;
      if (!analyticsPayload || !analyticsPayload.charts) return;
      const canvas = document.getElementById('chartOverviewTrends');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const colors = getChartThemeColors();
      const revData = analyticsPayload.charts.revenue_growth[overviewScale];
      const userData = analyticsPayload.charts.user_growth[overviewScale];
      if (!revData || !userData) return;

      if (chartOverviewInstance) chartOverviewInstance.destroy();

      chartOverviewInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: revData.labels,
          datasets: [
            {
              type: 'line',
              label: 'Pertumbuhan Pengguna Baru',
              data: userData.total,
              borderColor: colors.accentYellow,
              backgroundColor: colors.accentYellow,
              borderWidth: 2.5,
              tension: 0.35,
              pointRadius: 4,
              yAxisID: 'yUsers',
            },
            {
              type: 'bar',
              label: 'Omzet GMV (Rp)',
              data: revData.gmv,
              backgroundColor: colors.accent1,
              borderRadius: 6,
              yAxisID: 'yRevenue',
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              labels: { color: colors.textColor, font: { family: 'Plus Jakarta Sans', size: 12 } }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  if (context.dataset.yAxisID === 'yRevenue') {
                    return ` Omzet GMV: ${formatRupiah(context.raw)}`;
                  }
                  return ` Pengguna Baru: ${context.raw} akun`;
                }
              }
            }
          },
          scales: {
            x: {
              ticks: { color: colors.textMuted, font: { family: 'Plus Jakarta Sans', size: 11 } },
              grid: { color: colors.gridColor }
            },
            yRevenue: {
              type: 'linear',
              axis: 'y',
              position: 'left',
              ticks: {
                color: colors.textMuted,
                font: { family: 'JetBrains Mono', size: 10 },
                callback: function(val) {
                  const n = Number(val) || 0;
                  if (n >= 1000000) return 'Rp ' + (n / 1000000).toLocaleString('id-ID') + ' Jt';
                  if (n >= 1000) return 'Rp ' + (n / 1000).toLocaleString('id-ID') + ' Rb';
                  return 'Rp ' + n;
                }
              },
