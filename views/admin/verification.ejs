                </thead>
                <tbody id="admin-courses-table-body">
                  <tr>
                    <td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">
                      <i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Memuat data kursus platform...
