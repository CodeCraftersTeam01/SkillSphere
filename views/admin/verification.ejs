        padding: 16px 14px;
      }

      .welcome-title {
        font-size: 20px;
      }

      .welcome-desc {
        font-size: 12.5px;
      }

      .filter-bar {
        gap: 4px;
      }

      .filter-btn {
        font-size: 11px;
        padding: 5px 10px;
      }
    }
  </style>

  <script>
