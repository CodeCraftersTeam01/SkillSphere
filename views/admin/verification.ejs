    function renderFinancialTables(data) {
      const walletsTbody = document.getElementById('wallets-table-body');
      const withdrawalsTbody = document.getElementById('withdrawals-table-body');

      // Wallets
      if (walletsTbody) {
        const wallets = data.wallets || [];
        if (!wallets.length) {
          walletsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">Belum ada dompet virtual tutor aktif.</td></tr>`;
        } else {
          walletsTbody.innerHTML = wallets.map(w => {
            const tutorName = w.tutor ? w.tutor.name : 'Tutor';
            const tutorEmail = w.tutor ? w.tutor.email : '-';
            return `
              <tr>
                <td><strong>${escapeHtml(tutorName)}</strong></td>
                <td><span style="font-size:12px; color:var(--text-secondary);">${escapeHtml(tutorEmail)}</span></td>
                <td><strong style="color:var(--color-success);">Rp ${Number(w.balance || 0).toLocaleString('id-ID')}</strong></td>
                <td>Rp ${Number(w.pending_balance || 0).toLocaleString('id-ID')}</td>
                <td>Rp ${Number(w.total_withdrawn || 0).toLocaleString('id-ID')}</td>
                <td>
                  ${w.is_active 
                    ? '<span class="status-pill status-active"><i class="fas fa-check"></i> Aktif</span>' 
                    : '<span class="status-pill status-rejected">Nonaktif</span>'}
                </td>
              </tr>
            `;
          }).join('');
        }
      }

      // Withdrawals
      if (withdrawalsTbody) {
        const withdrawals = data.withdrawals || [];
        if (!withdrawals.length) {
          withdrawalsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">Belum ada riwayat permintaan penarikan dana.</td></tr>`;
        } else {
          withdrawalsTbody.innerHTML = withdrawals.map(wd => {
            const tutorName = wd.tutor ? wd.tutor.name : 'Tutor';
            const dateStr = new Date(wd.created_at || wd.createdAt || Date.now()).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
            let statusPill = '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Diproses</span>';
            if (wd.status === 'completed') statusPill = '<span class="status-pill status-active"><i class="fas fa-check"></i> Selesai</span>';
            if (wd.status === 'rejected') statusPill = '<span class="status-pill status-rejected"><i class="fas fa-xmark"></i> Ditolak</span>';

            return `
              <tr>
                <td><strong>${escapeHtml(tutorName)}</strong></td>
                <td><strong style="color:var(--text-primary);">Rp ${Number(wd.amount || 0).toLocaleString('id-ID')}</strong></td>
                <td><span class="user-role-tag">${escapeHtml(wd.bank_name || '-')}</span></td>
                <td><code>${escapeHtml(wd.account_number || '-')}</code> (${escapeHtml(wd.account_holder_name || '-')})</td>
                <td>${dateStr}</td>
                <td>${statusPill}</td>
              </tr>
            `;
          }).join('');
        }
      }
    }

    // ==========================================
    // USER MANAGEMENT FUNCTIONS (SISWA, TUTOR, ADMIN)
    // ==========================================

    async function fetchAdminUsers() {
      const tbody = document.getElementById('admin-users-table-body');
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">
              <i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Memuat data pengguna...
            </td>
          </tr>
        `;
      }

      try {
        const offset = currentUserPage * USERS_PER_PAGE;
        let queryParams = new URLSearchParams({
          limit: USERS_PER_PAGE,
          offset: offset,
          sort: 'created_at',
          order: 'DESC'
        });

        if (currentUserRoleFilter && currentUserRoleFilter !== 'all') {
          queryParams.append('role', currentUserRoleFilter);
        }
        if (currentUserStatusFilter && currentUserStatusFilter !== 'all') {
          queryParams.append('status', currentUserStatusFilter);
        }
        if (currentUserSearchQuery && currentUserSearchQuery.trim() !== '') {
          queryParams.append('search', currentUserSearchQuery.trim());
        }

        const res = await fetch(`/api/admin/users?${queryParams.toString()}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (json.success && json.data) {
          const { total, users, summary } = json.data;
          allUsers = Array.isArray(users) ? users : [];

          // Update Summary Statistics
          if (summary) {
            const totalBadge = document.getElementById('badge-users-total');
            if (totalBadge) totalBadge.textContent = summary.totalUsers || 0;

            const statTotal = document.getElementById('stat-users-total');
            if (statTotal) statTotal.textContent = summary.totalUsers || 0;

            const statStudent = document.getElementById('stat-users-student');
            if (statStudent) statStudent.textContent = summary.totalStudents || 0;

            const statTutor = document.getElementById('stat-users-tutor');
            if (statTutor) statTutor.textContent = summary.totalTutors || 0;

            const statAdmin = document.getElementById('stat-users-admin');
            if (statAdmin) statAdmin.textContent = summary.totalAdmins || 0;

            const statInactive = document.getElementById('stat-users-inactive');
            if (statInactive) statInactive.textContent = summary.totalInactive || 0;
          }

          renderUsersTable(allUsers, total, offset);
        } else {
          if (tbody) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--color-danger);">${escapeHtml(json.message || 'Gagal memuat pengguna.')}</td></tr>`;
          }
        }
      } catch (err) {
        console.error('Error fetching users:', err);
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--color-danger);">Terjadi kesalahan koneksi jaringan.</td></tr>`;
        }
      }
    }

    function renderUsersTable(users, total = 0, offset = 0) {
      const tbody = document.getElementById('admin-users-table-body');
      if (!tbody) return;

      if (!users.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align:center; padding:40px; color:var(--text-secondary);">
              <i class="fas fa-users-slash" style="font-size:24px; margin-bottom:10px; display:block; opacity:0.6;"></i>
              Tidak ada data pengguna yang sesuai dengan filter pencarian.
            </td>
          </tr>
        `;
        updateUsersPagination(0, 0, 0);
        return;
      }

      tbody.innerHTML = users.map(u => {
        const initials = (u.name || 'User').split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'U';
        const profile = u.profile || {};
        const isSelf = currentAdminUserId && u.id === currentAdminUserId;

        // Role Badge
        let roleBadge = '<span class="role-badge student"><i class="fas fa-user-graduate"></i> Siswa</span>';
        if (u.role === 'tutor') {
          roleBadge = '<span class="role-badge tutor"><i class="fas fa-chalkboard-user"></i> Tutor</span>';
        } else if (u.role === 'admin') {
          roleBadge = '<span class="role-badge admin"><i class="fas fa-shield-halved"></i> Admin</span>';
        }

        // Status Badge
        const statusBadge = u.is_active
          ? '<span class="status-pill status-active"><i class="fas fa-check"></i> Aktif</span>'
          : '<span class="status-pill status-rejected"><i class="fas fa-ban"></i> Suspended</span>';

        // Verified Badge
        const verifiedBadge = u.is_verified
          ? '<span style="color:var(--color-success); font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-circle-check"></i> Terverifikasi</span>'
          : '<span style="color:var(--text-tertiary); font-size:12px; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-clock"></i> Belum</span>';

        // Registered Date
        const dateStr = new Date(u.created_at || u.createdAt || Date.now()).toLocaleDateString('id-ID', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return `
          <tr>
            <td>
              <div class="user-cell-info">
                <div class="user-table-avatar">${escapeHtml(initials)}</div>
                <div class="user-cell-meta">
                  <div class="user-cell-name">
                    ${escapeHtml(u.name)}
                    ${isSelf ? '<span class="user-role-tag" style="margin-left:6px; font-size:9.5px; background:var(--accent-primary); color:var(--accent-text);">AKUN ANDA</span>' : ''}
                  </div>
                  <div class="user-cell-email">${escapeHtml(u.email)}</div>
                </div>
              </div>
            </td>
            <td>${roleBadge}</td>
            <td>${statusBadge}</td>
            <td>${verifiedBadge}</td>
            <td style="font-size:12.5px; color:var(--text-secondary);">${dateStr}</td>
            <td style="text-align:right;">
              <div class="user-actions-group">
                <button 
                  class="btn btn-outline btn-sm" 
                  onclick="openEditUserModal(${u.id})" 
                  title="Detail & Edit Pengguna"
                  style="padding:5px 9px; font-size:11.5px;"
                >
                  <i class="fas fa-pen-to-square"></i>
                </button>
                <button 
                  class="btn btn-outline btn-sm" 
                  onclick="quickChangeRoleAction(${u.id}, '${u.role}', '${escapeHtml(u.name)}')" 
                  title="Ubah Peran (Role)"
                  style="padding:5px 9px; font-size:11.5px;"
                  ${isSelf ? 'disabled' : ''}
                >
                  <i class="fas fa-user-tag"></i>
                </button>
                <button 
                  class="btn btn-outline btn-sm" 
                  onclick="toggleUserStatusAction(${u.id}, ${u.is_active}, '${escapeHtml(u.name)}')" 
                  title="${u.is_active ? 'Suspend / Bekukan Akun' : 'Aktifkan Kembali Akun'}"
                  style="padding:5px 9px; font-size:11.5px; ${u.is_active ? 'color:var(--color-warning);' : 'color:var(--color-success);'}"
                  ${isSelf ? 'disabled' : ''}
                >
                  <i class="fas ${u.is_active ? 'fa-user-slash' : 'fa-user-check'}"></i>
                </button>
                <button 
                  class="btn btn-outline btn-sm" 
                  onclick="deleteUserAction(${u.id}, '${escapeHtml(u.name)}', '${escapeHtml(u.email)}')" 
                  title="Hapus Akun Pengguna"
                  style="padding:5px 9px; font-size:11.5px; color:var(--color-danger);"
                  ${isSelf ? 'disabled' : ''}
                >
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      updateUsersPagination(total, offset, users.length);
    }

    function updateUsersPagination(total, offset, currentCount) {
      const infoEl = document.getElementById('users-pagination-info');
      const prevBtn = document.getElementById('btn-users-prev');
      const nextBtn = document.getElementById('btn-users-next');

      if (infoEl) {
        if (total === 0) {
          infoEl.textContent = 'Menampilkan 0 pengguna';
        } else {
          const start = offset + 1;
          const end = offset + currentCount;
          infoEl.textContent = `Menampilkan ${start}-${end} dari ${total} pengguna`;
        }
      }

      if (prevBtn) {
        prevBtn.disabled = currentUserPage <= 0;
      }
      if (nextBtn) {
        nextBtn.disabled = (offset + currentCount) >= total;
      }
    }

    function changeUsersPage(delta) {
      currentUserPage += delta;
      if (currentUserPage < 0) currentUserPage = 0;
      fetchAdminUsers();
    }

    function filterAdminUsersRole(role, btn) {
      currentUserRoleFilter = role;
      currentUserPage = 0;

      const group = document.getElementById('users-role-filter-group');
      if (group) {
        group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      }
      if (btn) btn.classList.add('active');

      fetchAdminUsers();
    }

    function filterAdminUsersStatus(status) {
      currentUserStatusFilter = status;
      currentUserPage = 0;
      fetchAdminUsers();
    }

    function debounceAdminUserSearch(val) {
      if (userSearchTimeout) clearTimeout(userSearchTimeout);
      userSearchTimeout = setTimeout(() => {
        currentUserSearchQuery = val;
        currentUserPage = 0;
        fetchAdminUsers();
      }, 350);
    }

    // Modal Add User
    function openAddUserModal() {
      const form = document.getElementById('form-add-user');
      if (form) form.reset();
      const activeCb = document.getElementById('add-user-active');
      const verifiedCb = document.getElementById('add-user-verified');
      if (activeCb) activeCb.checked = true;
      if (verifiedCb) verifiedCb.checked = true;

      openModal('modal-add-user');
    }

    async function submitAddUserForm(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-add-user');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

      const payload = {
        name: document.getElementById('add-user-name').value.trim(),
        email: document.getElementById('add-user-email').value.trim(),
        password: document.getElementById('add-user-password').value,
        role: document.getElementById('add-user-role').value,
        phone_number: document.getElementById('add-user-phone').value.trim(),
        career_goal: document.getElementById('add-user-career').value.trim(),
        bio: document.getElementById('add-user-bio').value.trim(),
        is_active: document.getElementById('add-user-active').checked,
        is_verified: document.getElementById('add-user-verified').checked,
      };

      try {
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Pengguna baru berhasil ditambahkan!', 'success');
          closeModal('modal-add-user');
          fetchAdminUsers();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menambahkan pengguna.', 'error');
        }
      } catch (err) {
        console.error('Error adding user:', err);
        showToast('Terjadi kesalahan jaringan saat membuat pengguna.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }

    // Modal Edit & Detail User
    async function openEditUserModal(userId) {
      try {
        const res = await fetch(`/api/admin/users/${userId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data) {
          showToast('Gagal memuat rincian data pengguna.', 'error');
          return;
        }

        const u = json.data;
        const profile = u.profile || {};
        const isSelf = currentAdminUserId && u.id === currentAdminUserId;

        document.getElementById('edit-user-id').value = u.id;
        document.getElementById('edit-user-name').value = u.name || '';
        document.getElementById('edit-user-email').value = u.email || '';
        document.getElementById('edit-user-role').value = u.role || 'student';
        document.getElementById('edit-user-phone').value = profile.phone_number || '';
        document.getElementById('edit-user-career').value = profile.career_goal || '';
        document.getElementById('edit-user-bio').value = profile.bio || '';
        document.getElementById('edit-user-password').value = '';
        document.getElementById('edit-user-active').checked = !!u.is_active;
        document.getElementById('edit-user-verified').checked = !!u.is_verified;

        // Role & status disable if self
        document.getElementById('edit-user-role').disabled = isSelf;
        document.getElementById('edit-user-active').disabled = isSelf;

        // Header meta info
        const initials = (u.name || 'User').split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'U';
        const dateStr = new Date(u.created_at || u.createdAt || Date.now()).toLocaleDateString('id-ID', {
          year: 'numeric', month: 'long', day: 'numeric'
        });

        let roleBadge = '<span class="role-badge student"><i class="fas fa-user-graduate"></i> Siswa</span>';
        if (u.role === 'tutor') {
          roleBadge = '<span class="role-badge tutor"><i class="fas fa-chalkboard-user"></i> Tutor</span>';
        } else if (u.role === 'admin') {
          roleBadge = '<span class="role-badge admin"><i class="fas fa-shield-halved"></i> Admin</span>';
        }

        document.getElementById('edit-user-header-info').innerHTML = `
          <div class="user-table-avatar" style="width:44px; height:44px; font-size:15px;">${escapeHtml(initials)}</div>
          <div style="flex:1;">
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <strong style="font-size:15px; color:var(--text-primary);">${escapeHtml(u.name)}</strong>
              ${roleBadge}
              ${u.is_active ? '<span class="status-pill status-active" style="font-size:10px;">Aktif</span>' : '<span class="status-pill status-rejected" style="font-size:10px;">Suspended</span>'}
            </div>
            <div style="font-size:12px; color:var(--text-secondary); margin-top:3px;">
              ID: #${u.id} • ${escapeHtml(u.email)} • Terdaftar sejak ${dateStr}
            </div>
          </div>
        `;

        // Extra stats section
        let extraStatsHtml = '';
        if (u.role === 'tutor') {
          const wallet = u.wallet || { balance: 0, pending_balance: 0 };
          const taughtCourses = Array.isArray(u.taught_courses) ? u.taught_courses.length : 0;
          extraStatsHtml = `
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; padding:12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
              <div>
                <span style="font-size:11px; text-transform:uppercase; color:var(--text-tertiary); font-weight:700;">Total Kursus Dibuat</span>
                <div style="font-size:16px; font-weight:700; color:var(--text-primary); margin-top:2px;">${taughtCourses} Kursus</div>
              </div>
              <div>
                <span style="font-size:11px; text-transform:uppercase; color:var(--text-tertiary); font-weight:700;">Saldo Dompet Tutor</span>
                <div style="font-size:16px; font-weight:700; color:var(--color-success); margin-top:2px;">Rp ${Number(wallet.balance || 0).toLocaleString('id-ID')}</div>
              </div>
            </div>
          `;
        } else if (u.role === 'student') {
          const enrollments = Array.isArray(u.enrollments) ? u.enrollments.length : 0;
          const certificates = Array.isArray(u.certificates) ? u.certificates.length : 0;
          extraStatsHtml = `
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; padding:12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
              <div>
                <span style="font-size:11px; text-transform:uppercase; color:var(--text-tertiary); font-weight:700;">Kursus Diikuti</span>
                <div style="font-size:16px; font-weight:700; color:var(--text-primary); margin-top:2px;">${enrollments} Kursus</div>
              </div>
              <div>
                <span style="font-size:11px; text-transform:uppercase; color:var(--text-tertiary); font-weight:700;">Sertifikat Diraih</span>
                <div style="font-size:16px; font-weight:700; color:var(--text-primary); margin-top:2px;">${certificates} Sertifikat</div>
              </div>
            </div>
          `;
        }
        document.getElementById('edit-user-extra-stats').innerHTML = extraStatsHtml;

        // Delete button inside modal
        const deleteBtn = document.getElementById('btn-delete-user-modal');
        if (deleteBtn) {
          deleteBtn.style.display = isSelf ? 'none' : 'inline-flex';
          deleteBtn.onclick = () => {
            closeModal('modal-edit-user');
            deleteUserAction(u.id, u.name, u.email);
          };
        }

        openModal('modal-edit-user');
      } catch (err) {
        console.error('Error fetching user detail:', err);
        showToast('Terjadi kesalahan saat memuat rincian pengguna.', 'error');
      }
    }

    async function submitEditUserForm(e) {
      e.preventDefault();
      const userId = document.getElementById('edit-user-id').value;
      const btn = document.getElementById('btn-submit-edit-user');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

      const payload = {
        name: document.getElementById('edit-user-name').value.trim(),
        email: document.getElementById('edit-user-email').value.trim(),
        role: document.getElementById('edit-user-role').value,
        phone_number: document.getElementById('edit-user-phone').value.trim(),
        career_goal: document.getElementById('edit-user-career').value.trim(),
        bio: document.getElementById('edit-user-bio').value.trim(),
        is_active: document.getElementById('edit-user-active').checked,
        is_verified: document.getElementById('edit-user-verified').checked,
      };

      const newPass = document.getElementById('edit-user-password').value.trim();
      if (newPass) {
        payload.password = newPass;
      }

      try {
        const res = await fetch(`/api/admin/users/${userId}`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Perubahan data pengguna berhasil disimpan!', 'success');
          closeModal('modal-edit-user');
          fetchAdminUsers();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyimpan perubahan pengguna.', 'error');
        }
      } catch (err) {
        console.error('Error updating user:', err);
        showToast('Terjadi kesalahan jaringan saat menyimpan data pengguna.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }

    // Toggle Suspend / Reactivate Status
    async function toggleUserStatusAction(userId, currentStatus, userName) {
      const willSuspend = currentStatus === true || currentStatus === 1 || currentStatus === 'true';
      const confirmed = await showCustomConfirm({
        title: willSuspend ? `Suspend Akun ${userName}?` : `Aktifkan Kembali Akun ${userName}?`,
        message: willSuspend
          ? `Akun "${userName}" tidak akan dapat login ke platform SkillSphere selama masa suspensi berlangsung.`
          : `Akun "${userName}" akan diaktifkan kembali dan dapat login serta mengakses fitur platform seperti biasa.`,
        type: willSuspend ? 'danger' : 'success',
        confirmText: willSuspend ? 'Ya, Suspend Akun' : 'Ya, Aktifkan Akun',
        cancelText: 'Batal',
        icon: willSuspend ? 'fa-user-slash' : 'fa-user-check'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/users/${userId}/status`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ is_active: !willSuspend }),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Status akun berhasil diperbarui!', willSuspend ? 'warning' : 'success');
          fetchAdminUsers();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mengubah status akun.', 'error');
        }
      } catch (err) {
        console.error('Error toggling status:', err);
        showToast('Kesalahan jaringan saat memproses status akun.', 'error');
      }
    }

    // Quick Change Role
    async function quickChangeRoleAction(userId, currentRole, userName) {
      // Cycle or choose role
      let nextRole = 'tutor';
      let nextRoleLabel = 'Pengajar (Tutor)';
      if (currentRole === 'tutor') {
        nextRole = 'admin';
        nextRoleLabel = 'Administrator (Admin)';
      } else if (currentRole === 'admin') {
        nextRole = 'student';
        nextRoleLabel = 'Siswa (Student)';
      } else {
        nextRole = 'tutor';
        nextRoleLabel = 'Pengajar (Tutor)';
      }

      const confirmed = await showCustomConfirm({
        title: `Ubah Peran Akun ${userName}`,
        message: `Ubah peran akun "${userName}" dari ${currentRole.toUpperCase()} menjadi ${nextRoleLabel}?`,
        type: 'primary',
        confirmText: `Ubah ke ${nextRole.toUpperCase()}`,
        cancelText: 'Batal',
        icon: 'fa-user-tag'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/users/${userId}/role`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ role: nextRole }),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Peran akun berhasil diubah!', 'success');
          fetchAdminUsers();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mengubah peran akun.', 'error');
        }
      } catch (err) {
        console.error('Error changing role:', err);
        showToast('Kesalahan jaringan saat mengubah peran pengguna.', 'error');
      }
    }

    // Delete User Action
    async function deleteUserAction(userId, userName, userEmail) {
      const confirmed = await showCustomConfirm({
        title: `Hapus Akun ${userName}?`,
        message: `PERINGATAN: Akun "${userName}" (${userEmail}) beserta seluruh data profil terkait akan dihapus secara permanen dari sistem. Tindakan ini tidak dapat dibatalkan.`,
        type: 'danger',
        confirmText: 'Hapus Akun Permanen',
        cancelText: 'Batal',
        icon: 'fa-triangle-exclamation'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/users/${userId}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token },
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Akun pengguna berhasil dihapus!', 'success');
          fetchAdminUsers();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menghapus akun pengguna.', 'error');
        }
      } catch (err) {
        console.error('Error deleting user:', err);
        showToast('Kesalahan jaringan saat menghapus akun pengguna.', 'error');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
  <!-- Accessibility & Head Tracking Script -->
  <script src="/javascripts/accessibility.js"></script>
</body>
</html>
