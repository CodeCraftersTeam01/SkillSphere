    // Approve / Publish Action
    async function approveCoursePrompt(courseId) {
      const course = currentCoursesMap[courseId] || {};
      const courseTitle = course.title || `Kursus #${courseId}`;

      const confirmed = await showCustomConfirm({
        title: 'Setujui & Publikasikan Kursus?',
        message: `Apakah Anda yakin ingin menyetujui dan mempublikasikan kursus "${courseTitle}"? Kursus ini akan langsung dapat diakses dan dibeli oleh seluruh siswa di platform.`,
        type: 'success',
        confirmText: 'Approve & Publish',
        cancelText: 'Batal',
        icon: 'fa-circle-check'
      });

      if (!confirmed) return;

      try {
        let res = await fetch(`/api/admin/courses/${courseId}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          res = await fetch(`/api/courses/${courseId}`, {
            method: 'PUT',
            headers: {
              'Authorization': 'Bearer ' + token,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: 'published' })
          });
        }

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Kursus berhasil dipublikasikan!', 'success');
          fetchPlatformCourses();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyetujui kursus.', 'error');
        }
      } catch (err) {
        console.error('Error approving course:', err);
        showToast('Kesalahan jaringan saat memproses persetujuan kursus.', 'error');
      }
    }

