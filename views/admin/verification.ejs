        if (app.status === 'rejected') statusBadge = '<span class="status-pill status-rejected"><i class="fas fa-xmark"></i> Ditolak</span>';

        const applicantName = app.applicant ? app.applicant.name : 'Pelamar';
        const applicantEmail = app.applicant ? app.applicant.email : '-';
        const expertise = app.institution_name || app.expertise_field || 'Pengajar';
        const expYears = app.experience_years !== undefined ? app.experience_years : (app.years_of_experience || 0);
        const dateStr = new Date(app.created_at || app.createdAt || Date.now()).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });

        let actionButtons = '';
