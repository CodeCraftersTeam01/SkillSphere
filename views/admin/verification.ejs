    // Delete Course Action
    async function deleteCoursePrompt(courseId) {
      const course = currentCoursesMap[courseId] || {};
      const courseTitle = course.title || `Kursus #${courseId}`;

      const confirmed = await showCustomConfirm({
        title: `Hapus Kursus?`,
        message: `PERINGATAN: Apakah Anda yakin ingin menghapus kursus "${courseTitle}"? Seluruh bab kurikulum, materi video/dokumen, serta riwayat enrollment terkait akan dihapus secara permanen.`,
        type: 'danger',
        confirmText: 'Ya, Hapus Kursus',
        cancelText: 'Batal',
        icon: 'fa-triangle-exclamation'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/courses/${courseId}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token },
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Kursus berhasil dihapus.', 'success');
          fetchPlatformCourses();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menghapus kursus.', 'error');
        }
      } catch (err) {
        console.error('Error deleting course:', err);
        showToast('Kesalahan jaringan saat menghapus kursus.', 'error');
      }
    }

    // =========================================================
    // --- Admin Curriculum & Sub-Bab Manager (Sections & Materials) ---
    // =========================================================

    async function openAdminCurriculumModal(courseId) {
      const container = document.getElementById('admin-curriculum-sections-container');
      const titleEl = document.getElementById('curriculum-modal-title');
      const subtitleEl = document.getElementById('curriculum-modal-subtitle');
      const statsEl = document.getElementById('curriculum-stats-summary');

      if (container) {
        container.innerHTML = `
          <div style="text-align:center; padding:40px; color:var(--text-secondary);">
            <i class="fas fa-spinner fa-spin" style="font-size:20px; margin-bottom:10px; display:block;"></i>
            Memuat kurikulum & sub-bab materi...
          </div>
        `;
      }

      openModal('modal-admin-curriculum');

      try {
        const res = await fetch(`/api/courses/${courseId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data) {
          showToast('Gagal memuat data kurikulum kursus.', 'error');
          closeModal('modal-admin-curriculum');
          return;
        }

        activeCurriculumCourse = json.data;
        const course = activeCurriculumCourse;
        const sections = Array.isArray(course.sections) ? course.sections : [];

        if (titleEl) {
          titleEl.innerHTML = `<i class="fas fa-list-check" style="margin-right:8px;"></i> ${escapeHtml(course.title)}`;
        }
        if (subtitleEl) {
          const tutorName = course.tutor ? course.tutor.name : 'Tutor';
          const catName = course.category ? course.category.name : 'Umum';
          subtitleEl.textContent = `Tutor: ${tutorName} • Kategori: ${catName} • ID: #${course.id}`;
        }

        // Calculate Stats
        let totalMaterials = 0;
        let totalDuration = 0;
        sections.forEach(s => {
          const mats = Array.isArray(s.materials) ? s.materials : [];
          totalMaterials += mats.length;
          mats.forEach(m => {
            totalDuration += (Number(m.duration_minutes) || 0);
          });
        });

        if (statsEl) {
          statsEl.innerHTML = `
            <span style="display:inline-flex; align-items:center; gap:16px;">
              <span><i class="fas fa-layer-group" style="color:var(--text-secondary); margin-right:4px;"></i> <strong>${sections.length}</strong> Bab Modul</span>
              <span><i class="fas fa-file-lines" style="color:var(--text-secondary); margin-right:4px;"></i> <strong>${totalMaterials}</strong> Sub-Materi</span>
              <span><i class="fas fa-clock" style="color:var(--text-secondary); margin-right:4px;"></i> <strong>${totalDuration}</strong> Menit Total</span>
            </span>
          `;
        }

        renderAdminCurriculumSections(sections);
      } catch (err) {
        console.error('Error opening curriculum modal:', err);
        showToast('Kesalahan saat memuat kurikulum kursus.', 'error');
        if (container) {
          container.innerHTML = `<div style="text-align:center; padding:30px; color:var(--color-danger);">Gagal memuat kurikulum: ${escapeHtml(err.message)}</div>`;
        }
      }
    }

    function renderAdminCurriculumSections(sections) {
