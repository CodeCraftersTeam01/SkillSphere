<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Portal: Verifikasi Pengajar & Sertifikat | SkillSphere AI</title>
  <meta name="description" content="Panel Verifikasi Pendaftaran Tutor dan Sertifikasi Pengajar SkillSphere AI.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">

  <style>
    .admin-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .admin-tag {
      background: #000000;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: var(--radius-sm);
    }
    [data-theme="dark"] .admin-tag {
      background: #ffffff;
      color: #000000;
    }

    .main-container {
      max-width: 1140px;
      width: 100%;
      margin: 0 auto;
      padding: 36px 24px 60px;
      flex: 1;
    }

    .page-header {
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }

    .page-title {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 500;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .page-desc {
      font-size: 14px;
      color: var(--text-secondary);
      max-width: 680px;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 30px;
    }

    .metric-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .metric-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .metric-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }

    .metric-number {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      font-feature-settings: "tnum";
    }

    .metric-sub {
      font-size: 12px;
      color: var(--text-tertiary);
      margin-top: 4px;
    }

    /* Tabs Component */
    .tabs-bar {
      display: flex;
      gap: 8px;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 4px;
      margin-bottom: 24px;
      width: fit-content;
    }

    .tab-btn {
      padding: 8px 20px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .tab-btn.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    .tab-badge {
      background: var(--accent-primary-light);
      color: var(--text-primary);
      font-size: 11px;
      padding: 2px 7px;
      border-radius: var(--radius-full);
      font-weight: 700;
    }

    /* Controls Bar: Filters & Search */
    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .search-input-wrapper {
      position: relative;
      flex: 1;
      min-width: 260px;
      max-width: 400px;
    }

    .search-input-wrapper i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
      font-size: 14px;
    }

    .search-input {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 10px 16px 10px 38px;
      font-size: 13px;
      color: var(--text-primary);
      outline: none;
      transition: all 0.2s ease;
    }

    .search-input:focus {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-sm);
    }

    .filter-pills {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .filter-pill {
      padding: 6px 14px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .filter-pill.active {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    /* Table & Cards */
    .panel-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
    }

    .styled-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }

    .styled-table th {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-subtle);
      white-space: nowrap;
    }

    .styled-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-primary);
      vertical-align: middle;
    }

    .styled-table tr:hover td {
      background: var(--bg-surface-subtle);
    }

    /* Badges */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 600;
    }

    .status-badge.pending {
      background: #FEF3C7;
      color: #92400E;
      border: 1px solid #FCD34D;
    }
    .status-badge.approved, .status-badge.verified {
      background: #D1FAE5;
      color: #065F46;
      border: 1px solid #6EE7B7;
    }
    .status-badge.rejected, .status-badge.unverified {
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #FCA5A5;
    }

    .action-btn-group {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-action {
      padding: 6px 12px;
      border-radius: var(--radius-md);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid transparent;
      transition: all 0.15s ease;
    }

    .btn-approve {
      background: #10B981;
      color: #ffffff;
    }
    .btn-approve:hover {
      background: #059669;
    }

    .btn-reject {
      background: #EF4444;
      color: #ffffff;
    }
    .btn-reject:hover {
      background: #DC2626;
    }

    .btn-detail {
      background: var(--bg-surface-subtle);
      border-color: var(--border-subtle);
      color: var(--text-primary);
    }
    .btn-detail:hover {
      background: var(--border-subtle);
    }

    /* Modal Overlay & Card */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 14, 13, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 580px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-floating);
      padding: 28px;
      position: relative;
      animation: modalSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes modalSlide {
      from { transform: translateY(16px) scale(0.98); }
      to { transform: translateY(0) scale(1); }
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 14px;
    }

    .modal-title {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .modal-close-btn {
      background: transparent;
      border: none;
      color: var(--text-tertiary);
      font-size: 18px;
      cursor: pointer;
      padding: 4px;
      transition: color 0.15s ease;
    }

    .modal-close-btn:hover {
      color: var(--text-primary);
    }

    .applicant-profile-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      padding: 14px;
      background: var(--bg-surface-subtle);
      border-radius: var(--radius-lg);
    }

    .applicant-avatar {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 700;
    }

    .info-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 24px;
    }

    .info-item {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 13px;
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--border-subtle);
    }

    .info-label {
      color: var(--text-secondary);
      font-weight: 500;
    }

    .info-val {
      color: var(--text-primary);
      font-weight: 600;
      text-align: right;
      max-width: 60%;
      word-break: break-word;
    }

    /* Toast Container */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toast {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-floating);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      animation: toastIn 0.3s ease;
      min-width: 280px;
      max-width: 420px;
    }

    @keyframes toastIn {
      from { transform: translateX(50px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  </style>

  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="admin-layout">
    <!-- Navbar -->
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 12px;">
        <a href="/dashboard" class="brand-logo" style="text-decoration:none;">
          <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span style="font-weight:700; color:var(--text-primary); font-size:16px;">SkillSphere</span>
        </a>
        <span class="admin-tag"><i class="fas fa-shield-halved"></i> Admin Portal</span>
      </div>

      <div class="nav-actions">
        <a href="/dashboard" class="btn btn-outline" style="padding: 6px 14px; font-size: 13px; text-decoration:none;">
          <i class="fas fa-arrow-left"></i> Dashboard Utama
        </a>
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button">
          <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
          <i class="fas fa-moon" id="theme-icon-moon"></i>
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-container">
      <!-- Page Header -->
      <div class="page-header">
        <div>
          <div style="display:flex; align-items:center; gap:8px; margin-bottom: 6px;">
            <span class="sprint-badge" style="background:var(--accent-primary-light); font-size:11px; padding:3px 10px; border-radius:99px; font-weight:700;">
              <i class="fas fa-user-check"></i> Sprint 1 Deliverable: Satrio (FE & QA)
            </span>
          </div>
          <h1 class="page-title">Verifikasi Dokumen & Sertifikat Pengajar</h1>
          <p class="page-desc">
            Modul validasi kredensial pendaftaran calon tutor dan verifikasi legalitas sertifikat resmi guna menjaga standar mutu dan integritas akademis platform SkillSphere.
          </p>
        </div>
      </div>

      <!-- Metrics Grid -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-header">
            <span>Total Pengajuan Tutor</span>
            <i class="fas fa-users-gear" style="color:var(--text-tertiary);"></i>
          </div>
          <div class="metric-number" id="metric-total-apps">0</div>
          <div class="metric-sub" id="metric-apps-sub">Semua riwayat pendaftaran</div>
        </div>

        <div class="metric-card" style="border-left: 3px solid var(--accent-amber);">
          <div class="metric-header">
            <span>Menunggu Review</span>
            <i class="fas fa-clock" style="color:var(--accent-amber);"></i>
          </div>
          <div class="metric-number" id="metric-pending-apps" style="color:var(--accent-amber);">0</div>
          <div class="metric-sub">Perlu tindakan verifikasi admin</div>
        </div>

        <div class="metric-card" style="border-left: 3px solid #10B981;">
          <div class="metric-header">
            <span>Tutor Disetujui</span>
            <i class="fas fa-circle-check" style="color:#10B981;"></i>
          </div>
          <div class="metric-number" id="metric-approved-apps" style="color:#10B981;">0</div>
          <div class="metric-sub">Tutor aktif & berdompet</div>
        </div>

        <div class="metric-card" style="border-left: 3px solid #3B82F6;">
          <div class="metric-header">
            <span>Sertifikasi Tervalidasi</span>
            <i class="fas fa-certificate" style="color:#3B82F6;"></i>
          </div>
          <div class="metric-number" id="metric-verified-certs" style="color:#3B82F6;">0</div>
          <div class="metric-sub">Sertifikat resmi terverifikasi</div>
        </div>
      </div>

      <!-- Tab Switcher -->
      <div class="tabs-bar">
        <button class="tab-btn active" id="tab-btn-applications" onclick="switchTab('applications')">
          <i class="fas fa-id-card"></i>
          <span>Pendaftaran Calon Tutor</span>
          <span class="tab-badge" id="tab-badge-pending-apps">0</span>
        </button>
        <button class="tab-btn" id="tab-btn-certifications" onclick="switchTab('certifications')">
          <i class="fas fa-award"></i>
          <span>Sertifikat Pengajar</span>
          <span class="tab-badge" id="tab-badge-pending-certs">0</span>
        </button>
      </div>

      <!-- Controls: Filters & Search -->
      <div class="controls-bar">
        <div class="search-input-wrapper">
          <i class="fas fa-magnifying-glass"></i>
          <input type="text" id="admin-search-input" class="search-input" placeholder="Cari nama, email, atau instansi...">
        </div>

        <div class="filter-pills" id="applications-filter-group">
          <button class="filter-pill active" onclick="setAppFilter('all')">Semua</button>
          <button class="filter-pill" onclick="setAppFilter('pending')"><i class="fas fa-clock"></i> Menunggu</button>
          <button class="filter-pill" onclick="setAppFilter('approved')"><i class="fas fa-check"></i> Disetujui</button>
          <button class="filter-pill" onclick="setAppFilter('rejected')"><i class="fas fa-xmark"></i> Ditolak</button>
        </div>

        <div class="filter-pills" id="certifications-filter-group" style="display:none;">
          <button class="filter-pill active" onclick="setCertFilter('all')">Semua</button>
          <button class="filter-pill" onclick="setCertFilter('false')"><i class="fas fa-clock"></i> Belum Terverifikasi</button>
          <button class="filter-pill" onclick="setCertFilter('true')"><i class="fas fa-circle-check"></i> Terverifikasi</button>
        </div>
      </div>

      <!-- Table Section: Tutor Applications -->
      <div class="panel-card" id="applications-panel">
        <div class="table-responsive">
          <table class="styled-table">
            <thead>
              <tr>
                <th>Calon Pengajar</th>
                <th>Instansi / Pengalaman</th>
                <th>Dokumen / Link</th>
                <th>Status</th>
                <th>Tanggal Pengajuan</th>
                <th style="text-align: right;">Aksi Verifikasi</th>
              </tr>
            </thead>
            <tbody id="applications-table-body">
              <tr>
                <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-secondary);">
                  <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Memuat data pendaftaran calon tutor...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Table Section: Tutor Certifications -->
      <div class="panel-card" id="certifications-panel" style="display: none;">
        <div class="table-responsive">
          <table class="styled-table">
            <thead>
              <tr>
                <th>Pengajar</th>
                <th>Nama Sertifikat</th>
                <th>Lembaga Penerbit</th>
                <th>Credential ID & Tautan</th>
                <th>Status Validasi</th>
                <th style="text-align: right;">Aksi</th>
              </tr>
            </thead>
            <tbody id="certifications-table-body">
              <tr>
                <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-secondary);">
                  <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Memuat sertifikasi pengajar...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Detail Application Modal -->
    <div class="modal-overlay" id="detail-modal">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title">Detail Berkas Pendaftaran Tutor</h3>
          <button class="modal-close-btn" onclick="closeModal('detail-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div class="applicant-profile-header">
          <div class="applicant-avatar" id="modal-applicant-avatar">U</div>
          <div>
            <div style="font-weight: 700; font-size: 16px; color: var(--text-primary);" id="modal-applicant-name">-</div>
            <div style="font-size: 13px; color: var(--text-secondary);" id="modal-applicant-email">-</div>
            <div style="margin-top: 4px;" id="modal-applicant-status">-</div>
          </div>
        </div>

        <div class="info-list">
          <div class="info-item">
            <span class="info-label"><i class="fas fa-building" style="width:16px;"></i> Instansi Asal</span>
            <span class="info-val" id="modal-applicant-institution">-</span>
          </div>
          <div class="info-item">
            <span class="info-label"><i class="fas fa-briefcase" style="width:16px;"></i> Pengalaman Mengajar</span>
            <span class="info-val" id="modal-applicant-exp">-</span>
          </div>
          <div class="info-item">
            <span class="info-label"><i class="fab fa-linkedin" style="width:16px;"></i> LinkedIn Profil</span>
            <span class="info-val" id="modal-applicant-linkedin">-</span>
          </div>
          <div class="info-item">
            <span class="info-label"><i class="fas fa-globe" style="width:16px;"></i> Portfolio / Web</span>
            <span class="info-val" id="modal-applicant-portfolio">-</span>
          </div>
          <div class="info-item">
            <span class="info-label"><i class="fas fa-file-pdf" style="width:16px;"></i> Berkas CV & Kualifikasi</span>
            <span class="info-val" id="modal-applicant-cv">-</span>
          </div>
          <div class="info-item" id="modal-rejection-row" style="display:none;">
            <span class="info-label" style="color:#EF4444;"><i class="fas fa-circle-exclamation" style="width:16px;"></i> Alasan Penolakan</span>
            <span class="info-val" style="color:#EF4444;" id="modal-applicant-rejection-reason">-</span>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;" id="modal-action-footer">
          <!-- Populated dynamically -->
        </div>
      </div>
    </div>

    <!-- Rejection Modal -->
    <div class="modal-overlay" id="reject-modal">
      <div class="modal-card" style="max-width: 480px;">
        <div class="modal-header">
          <h3 class="modal-title" style="color: #EF4444;"><i class="fas fa-triangle-exclamation"></i> Tolak Pendaftaran Tutor</h3>
          <button class="modal-close-btn" onclick="closeModal('reject-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">
          Harap berikan alasan penolakan yang jelas agar calon pengajar dapat melengkapi kualifikasi yang diperlukan.
        </p>
        <div style="margin-bottom: 18px;">
          <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Alasan Penolakan *</label>
          <textarea id="reject-reason-input" rows="4" style="width:100%; border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:10px; background:var(--bg-surface-subtle); color:var(--text-primary); font-size:13px; resize:none;" placeholder="Contoh: Dokumen sertifikasi mengajar belum melampirkan instansi resmi atau masa berlaku telah habis."></textarea>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px;">
          <button class="btn btn-outline" style="padding: 8px 16px; font-size:13px;" onclick="closeModal('reject-modal')">Batal</button>
          <button class="btn-action btn-reject" id="btn-confirm-reject" style="padding: 8px 18px; font-size:13px;">
            <i class="fas fa-ban"></i> Konfirmasi Penolakan
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toast-container"></div>
  </div>

  <script>
    // Theme Toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Toast Utility
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: #10B981; font-size: 16px;"></i>';
      if (type === 'error') {
        icon = '<i class="fas fa-circle-exclamation" style="color: #EF4444; font-size: 16px;"></i>';
      } else if (type === 'info') {
        icon = '<i class="fas fa-circle-info" style="color: #3B82F6; font-size: 16px;"></i>';
      }

      toast.innerHTML = `${icon}<span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // Modal Helpers
    function openModal(id) {
      document.getElementById(id).classList.add('active');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    // Application & State Variables
    let currentTab = 'applications';
    let appStatusFilter = 'all';
    let certStatusFilter = 'all';
    let searchQuery = '';
    let applicationsCache = [];
    let certificationsCache = [];
    let activeRejectAppId = null;

    const token = localStorage.getItem('skillsphere_access_token');
    if (!token) {
      window.location.href = '/login';
    }

    // Load initial data
    document.addEventListener('DOMContentLoaded', () => {
      loadAdminStats();
      loadApplications();
      loadCertifications();

      // Search event listener with debounce
      let searchTimeout;
      document.getElementById('admin-search-input').addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          searchQuery = e.target.value.trim();
          if (currentTab === 'applications') {
            loadApplications();
          } else {
            loadCertifications();
          }
        }, 350);
      });
    });

    // Tab Switching
    function switchTab(tab) {
      currentTab = tab;
      document.getElementById('tab-btn-applications').classList.toggle('active', tab === 'applications');
      document.getElementById('tab-btn-certifications').classList.toggle('active', tab === 'certifications');
      document.getElementById('applications-panel').style.display = tab === 'applications' ? 'block' : 'none';
      document.getElementById('certifications-panel').style.display = tab === 'certifications' ? 'block' : 'none';
      document.getElementById('applications-filter-group').style.display = tab === 'applications' ? 'flex' : 'none';
      document.getElementById('certifications-filter-group').style.display = tab === 'certifications' ? 'flex' : 'none';
    }

    function setAppFilter(status) {
      appStatusFilter = status;
      document.querySelectorAll('#applications-filter-group .filter-pill').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.toLowerCase().includes(status === 'all' ? 'semua' : status === 'pending' ? 'menunggu' : status === 'approved' ? 'disetujui' : 'ditolak'));
      });
      loadApplications();
    }

    function setCertFilter(status) {
      certStatusFilter = status;
      document.querySelectorAll('#certifications-filter-group .filter-pill').forEach(btn => {
        btn.classList.toggle('active', 
          (status === 'all' && btn.textContent.includes('Semua')) ||
          (status === 'false' && btn.textContent.includes('Belum')) ||
          (status === 'true' && btn.textContent.includes('Terverifikasi') && !btn.textContent.includes('Belum'))
        );
      });
      loadCertifications();
    }

    // Fetch Stats
    async function loadAdminStats() {
      try {
        const res = await fetch('/api/admin/stats', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        if (res.status === 403 || res.status === 401) {
          showToast('Akses ditolak. Halaman ini hanya untuk Administrator.', 'error');
          setTimeout(() => window.location.href = '/dashboard', 1500);
          return;
        }
        const json = await res.json();
        if (json.success) {
          const d = json.data;
          document.getElementById('metric-total-apps').textContent = d.applications.total;
          document.getElementById('metric-pending-apps').textContent = d.applications.pending;
          document.getElementById('metric-approved-apps').textContent = d.applications.approved;
          document.getElementById('metric-verified-certs').textContent = d.certifications.verified;
          
          document.getElementById('tab-badge-pending-apps').textContent = d.applications.pending;
          document.getElementById('tab-badge-pending-certs').textContent = d.certifications.pending;
        }
      } catch (err) {
        console.error('Failed to load admin stats:', err);
      }
    }

    // Fetch Applications
    async function loadApplications() {
      const tbody = document.getElementById('applications-table-body');
      try {
        let url = `/api/admin/tutor-applications?status=${appStatusFilter}`;
        if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;

        const res = await fetch(url, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data.applications.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-secondary);">
                <i class="fas fa-folder-open" style="font-size: 24px; margin-bottom: 8px; display:block;"></i>
                Tidak ada data pendaftaran tutor yang sesuai filter.
              </td>
            </tr>
          `;
          return;
        }

        applicationsCache = json.data.applications;
        tbody.innerHTML = applicationsCache.map(app => {
          const user = app.applicant || {};
          const profile = user.profile || {};
          const initials = user.name ? user.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';
          const formattedDate = new Date(app.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

          let statusBadge = `<span class="status-badge pending"><i class="fas fa-clock"></i> Menunggu</span>`;
          if (app.status === 'approved') {
            statusBadge = `<span class="status-badge approved"><i class="fas fa-circle-check"></i> Disetujui</span>`;
          } else if (app.status === 'rejected') {
            statusBadge = `<span class="status-badge rejected"><i class="fas fa-circle-xmark"></i> Ditolak</span>`;
          }

          return `
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap: 10px;">
                  <div style="width:34px; height:34px; border-radius:50%; background:var(--accent-primary); color:var(--accent-text); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;">
                    ${initials}
                  </div>
                  <div>
                    <div style="font-weight:600;">${user.name || 'Anonim'}</div>
                    <div style="font-size:12px; color:var(--text-secondary);">${user.email}</div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-weight:500;">${app.institution_name || profile.institution || '-'}</div>
                <div style="font-size:12px; color:var(--text-secondary);">${app.experience_years} Tahun Pengalaman</div>
              </td>
              <td>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                  ${app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="btn-action btn-detail" style="padding:4px 8px; text-decoration:none;"><i class="fas fa-file-lines"></i> CV</a>` : ''}
                  ${app.linkedin_url ? `<a href="${app.linkedin_url}" target="_blank" class="btn-action btn-detail" style="padding:4px 8px; text-decoration:none;"><i class="fab fa-linkedin"></i></a>` : ''}
                  ${app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="btn-action btn-detail" style="padding:4px 8px; text-decoration:none;"><i class="fas fa-globe"></i></a>` : ''}
                  ${!app.cv_url && !app.linkedin_url && !app.portfolio_url ? '<span style="color:var(--text-tertiary);">-</span>' : ''}
                </div>
              </td>
              <td>${statusBadge}</td>
              <td style="color:var(--text-secondary);">${formattedDate}</td>
              <td style="text-align: right;">
                <div class="action-btn-group" style="justify-content: flex-end;">
                  <button class="btn-action btn-detail" onclick="viewAppDetail(${app.id})" title="Lihat Detail">
                    <i class="fas fa-eye"></i> Detail
                  </button>
                  ${app.status === 'pending' ? `
                    <button class="btn-action btn-approve" onclick="approveApplication(${app.id}, '${user.name}')" title="Setujui Pengajar">
                      <i class="fas fa-check"></i> Setujui
                    </button>
                    <button class="btn-action btn-reject" onclick="openRejectModal(${app.id})" title="Tolak Pengajuan">
                      <i class="fas fa-xmark"></i>
                    </button>
                  ` : ''}
                </div>
              </td>
            </tr>
          `;
        }).join('');

      } catch (err) {
        console.error('Failed to load applications:', err);
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #EF4444; padding: 20px;">Gagal memuat data.</td></tr>`;
      }
    }

    // View Application Detail Modal
    function viewAppDetail(appId) {
      const app = applicationsCache.find(a => a.id === appId);
      if (!app) return;

      const user = app.applicant || {};
      const profile = user.profile || {};
      const initials = user.name ? user.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';

      document.getElementById('modal-applicant-avatar').textContent = initials;
      document.getElementById('modal-applicant-name').textContent = user.name;
      document.getElementById('modal-applicant-email').textContent = user.email;

      let statusHtml = `<span class="status-badge pending"><i class="fas fa-clock"></i> Menunggu Verifikasi</span>`;
      if (app.status === 'approved') statusHtml = `<span class="status-badge approved"><i class="fas fa-check"></i> Disetujui (Tutor Aktif)</span>`;
      if (app.status === 'rejected') statusHtml = `<span class="status-badge rejected"><i class="fas fa-xmark"></i> Ditolak</span>`;
      document.getElementById('modal-applicant-status').innerHTML = statusHtml;

      document.getElementById('modal-applicant-institution').textContent = app.institution_name || profile.institution || 'Belum diisi';
      document.getElementById('modal-applicant-exp').textContent = `${app.experience_years} Tahun`;
      
      document.getElementById('modal-applicant-linkedin').innerHTML = app.linkedin_url ? `<a href="${app.linkedin_url}" target="_blank" class="link" style="font-weight:600;">Lihat Profil LinkedIn <i class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></i></a>` : 'Tidak dilampirkan';
      document.getElementById('modal-applicant-portfolio').innerHTML = app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="link" style="font-weight:600;">Kunjungi Website <i class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></i></a>` : 'Tidak dilampirkan';
      document.getElementById('modal-applicant-cv').innerHTML = app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="btn-action btn-detail" style="display:inline-flex; text-decoration:none;"><i class="fas fa-download"></i> Unduh Berkas CV</a>` : 'Tidak dilampirkan';

      const rejRow = document.getElementById('modal-rejection-row');
      if (app.status === 'rejected' && app.rejection_reason) {
        rejRow.style.display = 'flex';
        document.getElementById('modal-applicant-rejection-reason').textContent = app.rejection_reason;
      } else {
        rejRow.style.display = 'none';
      }

      const footer = document.getElementById('modal-action-footer');
      if (app.status === 'pending') {
        footer.innerHTML = `
          <button class="btn btn-outline" style="padding: 8px 16px; font-size:13px;" onclick="closeModal('detail-modal')">Tutup</button>
          <button class="btn-action btn-reject" style="padding: 8px 16px; font-size:13px;" onclick="closeModal('detail-modal'); openRejectModal(${app.id});">
            <i class="fas fa-ban"></i> Tolak
          </button>
          <button class="btn-action btn-approve" style="padding: 8px 18px; font-size:13px;" onclick="closeModal('detail-modal'); approveApplication(${app.id}, '${user.name}');">
            <i class="fas fa-check"></i> Setujui Sebagai Tutor
          </button>
        `;
      } else {
        footer.innerHTML = `
          <button class="btn btn-outline" style="padding: 8px 16px; font-size:13px;" onclick="closeModal('detail-modal')">Tutup</button>
        `;
      }

      openModal('detail-modal');
    }

    // Approve Application Action
    async function approveApplication(appId, applicantName) {
      if (!confirm(`Konfirmasi verifikasi: Apakah Anda yakin ingin MENYETUJUI "${applicantName}" sebagai Tutor resmi SkillSphere? Akun akan di-upgrade ke Role Tutor dan Dompet Virtual diaktifkan.`)) {
        return;
      }

      try {
        const res = await fetch(`/api/admin/tutor-applications/${appId}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'success');
          loadAdminStats();
          loadApplications();
        } else {
          showToast(json.message || 'Gagal menyetujui pengajuan.', 'error');
        }
      } catch (err) {
        showToast('Terjadi kesalahan jaringan saat menyetujui pendaftaran.', 'error');
      }
    }

    // Open Reject Modal
    function openRejectModal(appId) {
      activeRejectAppId = appId;
      document.getElementById('reject-reason-input').value = '';
      openModal('reject-modal');
    }

    // Confirm Reject Action
    document.getElementById('btn-confirm-reject').addEventListener('click', async () => {
      const reason = document.getElementById('reject-reason-input').value.trim();
      if (!reason) {
        alert('Harap isi alasan penolakan.');
        return;
      }

      try {
        const res = await fetch(`/api/admin/tutor-applications/${activeRejectAppId}/reject`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ reason }),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          closeModal('reject-modal');
          showToast(json.message, 'info');
          loadAdminStats();
          loadApplications();
        } else {
          showToast(json.message || 'Gagal menolak pengajuan.', 'error');
        }
      } catch (err) {
        showToast('Terjadi kesalahan saat memproses penolakan.', 'error');
      }
    });

    // Fetch Certifications
    async function loadCertifications() {
      const tbody = document.getElementById('certifications-table-body');
      try {
        let url = `/api/admin/tutor-certifications?is_verified=${certStatusFilter}`;
        if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;

        const res = await fetch(url, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data.certifications.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-secondary);">
                <i class="fas fa-award" style="font-size: 24px; margin-bottom: 8px; display:block;"></i>
                Tidak ada sertifikasi pengajar yang sesuai filter.
              </td>
            </tr>
          `;
          return;
        }

        certificationsCache = json.data.certifications;
        tbody.innerHTML = certificationsCache.map(cert => {
          const tutor = cert.tutor || {};
          const initials = tutor.name ? tutor.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'T';

          let statusBadge = `<span class="status-badge pending"><i class="fas fa-clock"></i> Belum Divalidasi</span>`;
          if (cert.is_verified) {
            statusBadge = `<span class="status-badge verified"><i class="fas fa-shield-check"></i> Resmi Terverifikasi</span>`;
          }

          return `
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap: 10px;">
                  <div style="width:32px; height:32px; border-radius:50%; background:var(--accent-primary); color:var(--accent-text); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700;">
                    ${initials}
                  </div>
                  <div>
                    <div style="font-weight:600;">${tutor.name || 'Tutor'}</div>
                    <div style="font-size:12px; color:var(--text-secondary);">${tutor.email || ''}</div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-weight:600; color:var(--text-primary);">${cert.certificate_name}</div>
                <div style="font-size:11px; color:var(--text-secondary);">Masa Berlaku: ${cert.expiry_date || 'Seumur Hidup'}</div>
              </td>
              <td>
                <div style="font-weight:500;">${cert.issuer}</div>
                <div style="font-size:11px; color:var(--text-tertiary);">Terbit: ${cert.issue_date || '-'}</div>
              </td>
              <td>
                <div style="font-family:var(--font-mono); font-size:12px; color:var(--text-secondary);">
                  ${cert.credential_id || '-'}
                </div>
                ${cert.credential_url ? `
                  <a href="${cert.credential_url}" target="_blank" class="link" style="font-size:11px; font-weight:600;">
                    Buka Dokumen / Link <i class="fas fa-arrow-up-right-from-square" style="font-size:9px;"></i>
                  </a>
                ` : ''}
              </td>
              <td>${statusBadge}</td>
              <td style="text-align: right;">
                ${!cert.is_verified ? `
                  <button class="btn-action btn-approve" onclick="verifyCert(${cert.id}, '${cert.certificate_name}')">
                    <i class="fas fa-check"></i> Validasi Resmi
                  </button>
                ` : `
                  <button class="btn-action btn-reject" onclick="unverifyCert(${cert.id}, '${cert.certificate_name}')">
                    <i class="fas fa-rotate-left"></i> Batalkan
                  </button>
                `}
              </td>
            </tr>
          `;
        }).join('');

      } catch (err) {
        console.error('Failed to load certifications:', err);
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #EF4444; padding: 20px;">Gagal memuat sertifikasi.</td></tr>`;
      }
    }

    // Verify Certification Action
    async function verifyCert(certId, certName) {
      if (!confirm(`Validasi keaslian sertifikat "${certName}"? Kredensial ini akan diberi lencana resmi terverifikasi.`)) {
        return;
      }
      try {
        const res = await fetch(`/api/admin/tutor-certifications/${certId}/verify`, {
          method: 'PUT',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'success');
          loadAdminStats();
          loadCertifications();
        } else {
          showToast(json.message || 'Gagal memvalidasi sertifikat.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memvalidasi sertifikat.', 'error');
      }
    }

    // Unverify Certification Action
    async function unverifyCert(certId, certName) {
      if (!confirm(`Batalkan status verifikasi untuk sertifikat "${certName}"?`)) {
        return;
      }
      try {
        const res = await fetch(`/api/admin/tutor-certifications/${certId}/unverify`, {
          method: 'PUT',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'info');
          loadAdminStats();
          loadCertifications();
        } else {
          showToast(json.message || 'Gagal mengubah status verifikasi.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan.', 'error');
      }
    }
  </script>
</body>
</html>
