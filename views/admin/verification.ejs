        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
      }

      .theme-toggle-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .theme-toggle-btn #theme-text {
        display: none !important;
      }

      .user-profile-badge {
        padding: 0;
        background: transparent;
        border: none;
        cursor: pointer;
      }

      .user-profile-badge .user-avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 12px;
        border: 1.5px solid var(--border-subtle);
      }

      .user-profile-badge .user-name-label,
      .user-profile-badge .user-role-tag {
        display: none !important;
      }

      .logout-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .logout-btn span {
        display: none !important;
      }

      .mobile-menu-toggle {
