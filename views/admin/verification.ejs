                        <span class="user-role-tag" style="font-size:9.5px; padding:1px 5px;">${escapeHtml((mat.content_type || 'doc').toUpperCase())}</span>
                        ${mat.is_preview ? '<span style="color:var(--color-success); font-weight:600;"><i class="fas fa-unlock"></i> Gratis Preview</span>' : '<span style="color:var(--text-tertiary);"><i class="fas fa-lock"></i> Premium</span>'}
                      </div>
