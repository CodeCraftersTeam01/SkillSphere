    // Approve Application (ACC)
    async function approveApplication(id, name) {
      const confirmed = await showCustomConfirm({
        title: 'Setujui Pendaftaran Tutor (ACC)',
        message: `Setujui pendaftaran "${name}"? Peran akun akan diaktifkan sebagai Tutor dan Dompet Virtual langsung aktif.`,
        confirmText: 'Ya, Setujui (ACC)',
        cancelText: 'Batal',
        type: 'success',
        icon: 'fa-user-check'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/tutor-applications/${id}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(`Pendaftaran "${name}" berhasil disetujui (ACC)!`, 'success');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyetujui pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat menyetujui pendaftaran.', 'error');
      }
    }

    // Reset Application Status
    async function resetApplicationStatus(id, name) {
      const confirmed = await showCustomConfirm({
        title: 'Kembalikan ke Menunggu Review?',
        message: `Apakah Anda yakin ingin mengembalikan status pendaftaran "${name}" ke "Menunggu Review"?`,
        confirmText: 'Ya, Reset Status',
        cancelText: 'Batal',
        type: 'warning',
        icon: 'fa-rotate-left'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/tutor-applications/${id}/reset`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || `Status "${name}" berhasil direset ke Menunggu Review.`, 'info');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mereset status pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat mereset status.', 'error');
      }
    }

    // Quick Reason Pill Helper
    function applyQuickRejectReason(text) {
      const input = document.getElementById('reject-reason-input');
      if (input) {
        input.value = text;
        input.focus();
      }
    }

    // Reject Application Modal
    function openRejectModal(id, applicantName = '', isReversal = false) {
      pendingRejectId = id;
      const titleEl = document.getElementById('reject-modal-header-title');
      const infoEl = document.getElementById('reject-target-applicant-info');
      const input = document.getElementById('reject-reason-input');
      
      if (titleEl) {
        titleEl.textContent = isReversal ? 'Batalkan Persetujuan & Tolak' : 'Tolak Pendaftaran Pengajar';
      }
      if (infoEl) {
        infoEl.textContent = applicantName ? `Pelamar: ${applicantName}. Pilih alasan cepat atau ketik catatan penolakan:` : 'Pilih alasan cepat atau ketik catatan untuk pelamar:';
      }
      if (input) {
        input.value = '';
      }
      openModal('reject-reason-modal');
    }

    async function confirmRejectApplication() {
      if (!pendingRejectId) return;
      const reason = document.getElementById('reject-reason-input').value.trim();
      if (!reason) {
        showToast('Alasan penolakan wajib diisi atau pilih alasan cepat di atas.', 'error');
        return;
      }

      try {
        const res = await fetch(`/api/admin/tutor-applications/${pendingRejectId}/reject`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ reason: reason, rejection_reason: reason }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Pendaftaran tutor berhasil ditolak.', 'info');
          closeModal('reject-reason-modal');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menolak pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses penolakan.', 'error');
      }
    }

    // Fetch Tutor Certifications
    async function fetchCertifications() {
      try {
        const res = await fetch('/api/admin/tutor-certifications', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          if (Array.isArray(json.data)) {
            allCertifications = json.data;
          } else if (Array.isArray(json.data.certifications)) {
            allCertifications = json.data.certifications;
          } else {
            allCertifications = [];
          }
          renderCertificationsTable();
        }
      } catch (e) {
        console.error('Error fetching certifications:', e);
      }
    }

    function filterCerts(status, btn) {
      currentCertFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderCertificationsTable();
    }

    function renderCertificationsTable() {
      const tbody = document.getElementById('certifications-table-body');
      if (!tbody) return;

      let filtered = allCertifications;
      if (currentCertFilter === 'verified') filtered = allCertifications.filter(c => c.is_verified);
      if (currentCertFilter === 'pending') filtered = allCertifications.filter(c => !c.is_verified);

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">
              Tidak ada data sertifikasi pengajar dengan filter ini.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(cert => {
        const tutorName = cert.tutor ? cert.tutor.name : 'Tutor';
        const certName = cert.certificate_name || cert.title || 'Sertifikat';
        const issuer = cert.issuer || cert.issuer_organization || '-';
        const fileUrl = cert.certificate_file_url || cert.file_url || '';
        const isVerified = Boolean(cert.is_verified);
        const statusBadge = isVerified 
          ? '<span class="status-pill status-active"><i class="fas fa-circle-check"></i> Terverifikasi</span>'
          : '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Belum Divalidasi</span>';

        return `
          <tr>
            <td><strong>${escapeHtml(tutorName)}</strong></td>
            <td>${escapeHtml(certName)}</td>
            <td><span class="user-role-tag">${escapeHtml(issuer)}</span></td>
            <td><code>${escapeHtml(cert.credential_id || '-')}</code></td>
            <td>
              ${fileUrl ? `
                <button class="btn btn-outline btn-sm" onclick="previewCertificateImage('${fileUrl}', '${escapeHtml(certName)}')">
                  <i class="fas fa-image"></i> Lihat Berkas
                </button>
              ` : '<span style="color:var(--text-secondary); font-size:12px;">Tidak ada berkas</span>'}
            </td>
            <td>${statusBadge}</td>
            <td>
              <div class="action-cell-group">
                ${!isVerified ? `
                  <button class="btn btn-success btn-sm" onclick="verifyCertificate(${cert.id}, true)">
                    <i class="fas fa-check-double"></i> Validasi
                  </button>
                ` : `
                  <button class="btn btn-danger btn-sm" onclick="verifyCertificate(${cert.id}, false)">
                    <i class="fas fa-rotate-left"></i> Batalkan
                  </button>
                `}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function previewCertificateImage(url, title) {
      document.getElementById('cert-preview-title').textContent = title;
      const img = document.getElementById('cert-preview-img');
      const fallback = document.getElementById('cert-preview-fallback');
      if (url) {
        img.src = url;
        img.style.display = 'inline-block';
        fallback.style.display = 'none';
      } else {
        img.style.display = 'none';
        fallback.style.display = 'block';
      }
      openModal('cert-preview-modal');
    }

    async function verifyCertificate(id, shouldVerify) {
      const action = shouldVerify ? 'verify' : 'unverify';
      const confirmed = await showCustomConfirm({
        title: shouldVerify ? 'Validasi Sertifikat Resmi' : 'Batalkan Validasi Sertifikat',
        message: shouldVerify ? 'Verifikasi dan tandai sertifikat ini sebagai berkas keahlian resmi?' : 'Batalkan status verifikasi berkas sertifikat ini?',
        confirmText: shouldVerify ? 'Ya, Validasi' : 'Ya, Batalkan',
        cancelText: 'Batal',
        type: shouldVerify ? 'success' : 'warning',
        icon: shouldVerify ? 'fa-certificate' : 'fa-triangle-exclamation'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/tutor-certifications/${id}/${action}`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'success');
          fetchCertifications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mengubah status sertifikat.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses sertifikat.', 'error');
      }
    }

    // =========================================================
    // --- Course Management & Moderation Logic (Full CRUD & Curriculum) ---
    // =========================================================
    let currentAdminCourseStatus = 'all';
    let adminCourseSearchQuery = '';
    let adminCourseSearchTimeout = null;
    let currentCoursesMap = {};
    let cachedCategories = [];
    let cachedTutors = [];
    let activeCurriculumCourse = null;
    window.showConfirmDialog = showCustomConfirm;

    function filterAdminCourses(status, btnElement) {
      currentAdminCourseStatus = status;
      const group = document.getElementById('course-status-filter-group');
      if (group) {
        group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      }
      if (btnElement) btnElement.classList.add('active');
      fetchPlatformCourses();
    }

    function debounceAdminCourseSearch(val) {
      clearTimeout(adminCourseSearchTimeout);
      adminCourseSearchTimeout = setTimeout(() => {
        adminCourseSearchQuery = (val || '').trim();
        fetchPlatformCourses();
      }, 300);
    }

    // Populate Course Dropdowns (Tutors & Categories)
    async function populateCourseDropdowns() {
      try {
        if (!cachedCategories.length) {
          const resCat = await fetch('/api/courses/categories');
          const jsonCat = await resCat.json();
          if (jsonCat.success && Array.isArray(jsonCat.data)) {
            cachedCategories = jsonCat.data;
          }
        }

        if (!cachedTutors.length) {
          const resTut = await fetch('/api/admin/users?role=tutor&limit=100', {
            headers: { 'Authorization': 'Bearer ' + token }
          });
          const jsonTut = await resTut.json();
          if (jsonTut.success && jsonTut.data && Array.isArray(jsonTut.data.users)) {
            cachedTutors = jsonTut.data.users;
          }
        }

        const populateSelect = (selectId, items, placeholder, getValue, getText, selectedVal = null) => {
          const el = document.getElementById(selectId);
          if (!el) return;
          el.innerHTML = `<option value="">${placeholder}</option>` + items.map(item => {
            const val = getValue(item);
            const txt = getText(item);
            const isSelected = selectedVal !== null && String(selectedVal) === String(val);
            return `<option value="${escapeHtml(val)}" ${isSelected ? 'selected' : ''}>${escapeHtml(txt)}</option>`;
          }).join('');
        };

        // Create modal selects
        populateSelect('create-course-tutor-select', cachedTutors, '-- Pilih Tutor Pengajar --', t => t.id, t => `${t.name} (${t.email})`);
        populateSelect('create-course-category-select', cachedCategories, '-- Pilih Kategori --', c => c.id, c => c.name);

        // Edit modal selects
        populateSelect('edit-course-tutor-select', cachedTutors, '-- Pilih Tutor Pengajar --', t => t.id, t => `${t.name} (${t.email})`);
        populateSelect('edit-course-category-select', cachedCategories, '-- Pilih Kategori --', c => c.id, c => c.name);
      } catch (err) {
        console.error('Error populating course dropdowns:', err);
      }
    }

    // Fetch Platform Courses for Admin Management
    async function fetchPlatformCourses() {
      const tbody = document.getElementById('admin-courses-table-body');
      if (!tbody) return;

      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:28px; color:var(--text-secondary);"><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Memperbarui data kursus...</td></tr>`;

      try {
        let url = `/api/admin/courses?limit=100`;
        if (currentAdminCourseStatus !== 'all') {
          url += `&status=${encodeURIComponent(currentAdminCourseStatus)}`;
        }
        if (adminCourseSearchQuery) {
          url += `&search=${encodeURIComponent(adminCourseSearchQuery)}`;
        }

        let res = await fetch(url, {
          headers: { 'Authorization': 'Bearer ' + token }
        });

        if (!res.ok) {
          res = await fetch('/api/courses?limit=100' + (currentAdminCourseStatus !== 'all' ? `&status=${encodeURIComponent(currentAdminCourseStatus)}` : ''));
        }

        const json = await res.json();
        const courses = (json.data && Array.isArray(json.data.courses))
          ? json.data.courses
          : (Array.isArray(json.data) ? json.data : ((json.data && Array.isArray(json.data.items)) ? json.data.items : []));

        currentCoursesMap = {};
        courses.forEach(c => {
          currentCoursesMap[c.id] = c;
        });

        if (!courses.length) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">Tidak ada kursus yang sesuai filter (${escapeHtml(currentAdminCourseStatus)}).</td></tr>`;
          return;
        }

        tbody.innerHTML = courses.map(c => {
          const status = (c.status || 'draft').toLowerCase();
          let statusBadge = '';
          let toggleStatusButton = '';

          if (status === 'published') {
            statusBadge = `<span class="status-pill status-active"><i class="fas fa-circle-check"></i> PUBLISHED</span>`;
            toggleStatusButton = `
              <button class="btn btn-outline btn-sm" onclick="suspendCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 8px; color:var(--color-warning);" title="Bekukan (Suspend) Kursus">
                <i class="fas fa-ban"></i> Suspend
              </button>
            `;
          } else if (status === 'suspended') {
            statusBadge = `<span class="status-pill status-rejected"><i class="fas fa-ban"></i> SUSPENDED</span>`;
            toggleStatusButton = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 8px;" title="Setujui & Terbitkan Kursus">
                <i class="fas fa-check"></i> Terbitkan
              </button>
            `;
          } else if (status === 'draft') {
            statusBadge = `<span class="status-pill status-pending"><i class="fas fa-file-lines"></i> DRAFT</span>`;
            toggleStatusButton = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 8px;" title="Setujui & Publikasikan Kursus">
                <i class="fas fa-check"></i> Terbitkan
              </button>
            `;
          } else {
            statusBadge = `<span class="status-pill status-locked">${escapeHtml(status.toUpperCase())}</span>`;
            toggleStatusButton = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 8px;" title="Publikasikan Kursus">
                <i class="fas fa-check"></i> Publish
              </button>
            `;
          }

          return `
            <tr id="course-row-${c.id}">
              <td>
                <div style="font-weight:600; color:var(--text-primary);">${escapeHtml(c.title || 'Tanpa Judul')}</div>
                <div style="font-size:11.5px; color:var(--text-secondary); margin-top:2px;">ID: #${escapeHtml(String(c.id || ''))}</div>
              </td>
              <td>${c.tutor ? escapeHtml(c.tutor.name || '') : '<span style="color:var(--text-secondary);">-</span>'}</td>
              <td><span class="user-role-tag">${c.category ? escapeHtml(c.category.name || '') : 'Umum'}</span></td>
              <td><strong style="color:var(--text-primary);">Rp ${(Number(c.price) || 0).toLocaleString('id-ID')}</strong></td>
              <td><span class="status-pill status-locked">${escapeHtml((c.level || 'beginner').toUpperCase())}</span></td>
              <td id="course-status-cell-${c.id}">${statusBadge}</td>
              <td style="text-align:right;">
                <div style="display:inline-flex; gap:6px; justify-content:flex-end; align-items:center; flex-wrap:nowrap;">
                  <button 
                    class="btn btn-primary btn-sm" 
                    onclick="openAdminCurriculumModal(${c.id})" 
                    style="font-size:11.5px; padding:4px 9px; display:inline-flex; align-items:center; gap:5px;" 
                    title="Kelola Sub-Bab & Materi Kursus"
                  >
                    <i class="fas fa-list-check"></i> Sub-Bab & Materi
                  </button>
                  <button 
                    class="btn btn-outline btn-sm" 
                    onclick="openAdminEditCourseModal(${c.id})" 
                    style="font-size:11.5px; padding:4px 8px;" 
                    title="Edit Informasi Kursus"
                  >
                    <i class="fas fa-pen-to-square"></i>
                  </button>
                  ${toggleStatusButton}
                  <button 
                    class="btn btn-outline btn-sm" 
                    onclick="deleteCoursePrompt(${c.id})" 
                    style="font-size:11.5px; padding:4px 8px; color:var(--color-danger);" 
                    title="Hapus Kursus"
                  >
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      } catch (e) {
        console.error('Error fetching courses overview:', e);
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:32px; color:var(--color-danger);">Gagal memuat kursus platform: ${escapeHtml(e.message || 'Kesalahan data.')}</td></tr>`;
      }
    }

    // Modal Create Course (Admin)
    async function openAdminCreateCourseModal() {
      await populateCourseDropdowns();
      const form = document.getElementById('form-admin-create-course');
      if (form) form.reset();
      const levelSelect = document.getElementById('create-course-level-select');
      if (levelSelect) levelSelect.value = 'beginner';
      const statusSelect = document.getElementById('create-course-status-select');
      if (statusSelect) statusSelect.value = 'draft';
      const initSec = document.getElementById('create-course-initial-section');
      if (initSec) initSec.value = 'Bab 1: Pengantar & Dasar Teori';

      openModal('modal-admin-create-course');
    }

    async function submitAdminCreateCourse(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-admin-create-course');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

      const payload = {
        title: document.getElementById('create-course-title').value.trim(),
        tutor_id: document.getElementById('create-course-tutor-select').value,
        category_id: document.getElementById('create-course-category-select').value,
        level: document.getElementById('create-course-level-select').value,
        price: parseFloat(document.getElementById('create-course-price').value) || 0,
        status: document.getElementById('create-course-status-select').value,
        initial_section_title: document.getElementById('create-course-initial-section').value.trim(),
        thumbnail_url: document.getElementById('create-course-thumbnail').value.trim() || null,
        description: document.getElementById('create-course-description').value.trim() || null,
      };

      try {
        const res = await fetch('/api/courses', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Kursus baru berhasil dibuat!', 'success');
          closeModal('modal-admin-create-course');
          fetchPlatformCourses();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal membuat kursus baru.', 'error');
        }
      } catch (err) {
        console.error('Error creating course:', err);
        showToast('Kesalahan jaringan saat membuat kursus.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }

    // Modal Edit Course (Admin)
    async function openAdminEditCourseModal(courseId) {
      await populateCourseDropdowns();

      try {
        const res = await fetch(`/api/courses/${courseId}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data) {
          showToast('Gagal memuat detail kursus.', 'error');
          return;
        }

        const course = json.data;
        document.getElementById('edit-course-id').value = course.id;
        document.getElementById('edit-course-title').value = course.title || '';
        document.getElementById('edit-course-price').value = course.price || 0;
        document.getElementById('edit-course-level-select').value = course.level || 'beginner';
        document.getElementById('edit-course-status-select').value = course.status || 'draft';
        document.getElementById('edit-course-thumbnail').value = course.thumbnail_url || '';
        document.getElementById('edit-course-description').value = course.description || '';

        // Select Tutor & Category
        const tutorSelect = document.getElementById('edit-course-tutor-select');
        if (tutorSelect && course.tutor_id) {
          tutorSelect.value = course.tutor_id;
        }
        const categorySelect = document.getElementById('edit-course-category-select');
        if (categorySelect && course.category_id) {
          categorySelect.value = course.category_id;
        }

        // Delete button inside edit modal
        const delBtn = document.getElementById('btn-delete-course-from-edit');
        if (delBtn) {
          delBtn.onclick = () => {
            closeModal('modal-admin-edit-course');
            deleteCoursePrompt(course.id);
          };
        }

        openModal('modal-admin-edit-course');
      } catch (err) {
        console.error('Error fetching course for edit:', err);
        showToast('Kesalahan saat memuat detail kursus.', 'error');
      }
    }

