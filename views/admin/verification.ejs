                  <div style="display:flex; align-items:center; gap:6px; margin-left:12px; flex-shrink:0;">
                    <button 
                      class="btn btn-outline btn-sm" 
                      onclick="openEditMaterialModal(${sec.id}, ${mat.id})" 
