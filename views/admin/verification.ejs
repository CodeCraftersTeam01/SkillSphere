<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard & Panel Verifikasi | SkillSphere AI</title>
  <meta name="description" content="Dashboard Administrator SkillSphere AI: Verifikasi Tutor, Manajemen Kursus, Arsitektur Finansial 20%/80%, dan Pemantauan Sistem.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere Admin">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">

  <style>
    /* Admin App Shell Layout */
    .admin-app-wrapper {
      display: flex;
      min-height: 100vh;
      background-color: var(--bg-app);
      position: relative;
    }

    /* Fixed Left Sidebar */
    .admin-sidebar {
      width: 270px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 150;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar-brand {
      padding: 20px 24px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sidebar-brand a {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 16px;
    }

    .admin-badge-tag {
      background: var(--accent-primary);
      color: var(--accent-text);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 7px;
      border-radius: var(--radius-sm);
    }

    .sidebar-nav-container {
      flex: 1;
      padding: 20px 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .nav-group-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-tertiary);
      padding: 12px 12px 6px;
    }

    .sidebar-nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.15s ease;
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      width: 100%;
      text-align: left;
    }

    .sidebar-nav-item:hover {
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
    }

    .sidebar-nav-item.active {
      background: var(--accent-primary-light);
      color: var(--text-primary);
      border-color: var(--border-subtle);
      font-weight: 600;
    }

    .sidebar-nav-item i {
      font-size: 14px;
      width: 20px;
      margin-right: 10px;
      color: var(--text-secondary);
      transition: color 0.15s ease;
    }

    .sidebar-nav-item.active i {
      color: var(--text-primary);
    }

    .sidebar-count-badge {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
      padding: 2px 7px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 700;
    }

    .sidebar-count-badge.alert {
      background: var(--color-danger-bg);
      color: var(--color-danger);
      border-color: var(--color-danger);
    }

    .sidebar-footer {
      padding: 18px 20px;
      border-top: 1px solid var(--border-subtle);
      background: var(--bg-surface-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .sidebar-user-info {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow: hidden;
    }

    .sidebar-user-avatar {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .sidebar-user-meta {
      overflow: hidden;
      line-height: 1.25;
    }

    .sidebar-user-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
      display: block;
    }

    .sidebar-user-role {
      font-size: 11px;
      color: var(--text-secondary);
    }

    /* Main Area with Sticky Header */
    .admin-main-viewport {
      flex: 1;
      margin-left: 270px;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .admin-header {
      height: 68px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-left-side {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .mobile-menu-toggle {
      display: none;
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 8px 12px;
      border-radius: var(--radius-md);
      font-size: 16px;
      cursor: pointer;
    }

    .header-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-secondary);
    }

    .header-breadcrumb strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .header-right-side {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }

    .theme-toggle-btn:hover {
      background: var(--bg-surface);
      border-color: var(--border-strong);
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 5px 14px 5px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      font-family: var(--font-sans);
    }

    .user-avatar-sm {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11.5px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .user-name-label {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
    }

    .user-role-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: var(--radius-full);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      letter-spacing: 0.04em;
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 7px 14px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
      font-family: var(--font-sans);
    }

    .logout-btn:hover {
      background: var(--color-danger-bg);
      border-color: var(--color-danger);
      color: var(--color-danger);
    }

    .admin-content-body {
      padding: 36px 32px 80px;
      flex: 1;
      max-width: 1320px;
      width: 100%;
    }

    /* Tabbed Section Containers */
    .dashboard-view-section {
      display: none;
      animation: fadeIn 0.2s ease forwards;
    }

    .dashboard-view-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Welcome Hero Banner */
    .welcome-hero {
      margin-bottom: 28px;
    }

    .welcome-title {
      font-family: var(--font-serif);
      font-size: 30px;
      font-weight: 500;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .welcome-desc {
      font-size: 14px;
      color: var(--text-secondary);
      max-width: 720px;
      line-height: 1.55;
    }

    /* Metric Cards Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 30px;
    }

    .metric-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
    }

    .metric-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .metric-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }

    .metric-number {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      font-feature-settings: "tnum";
    }

    .metric-sub {
      font-size: 12px;
      color: var(--text-tertiary);
      margin-top: 4px;
    }

    /* Section Cards */
    .section-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 26px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 28px;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 14px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Data Tables */
    .table-responsive {
      overflow-x: auto;
      border-radius: var(--radius-md);
    }

    .styled-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }

    .styled-table th {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-subtle);
      white-space: nowrap;
    }

    .styled-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-primary);
      vertical-align: middle;
    }

    .styled-table tr:hover td {
      background: var(--bg-surface-subtle);
    }

    /* Status Pills */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 600;
    }

    .status-active {
      background: var(--color-success-bg);
      color: var(--color-success);
      border: 1px solid var(--color-success);
    }

    .status-pending {
      background: #FFFBEB;
      color: #B45309;
      border: 1px solid #FCD34D;
    }
    [data-theme="dark"] .status-pending {
      background: #2D2514;
      color: #FBBF24;
      border-color: #78350F;
    }

    .status-rejected {
      background: var(--color-danger-bg);
      color: var(--color-danger);
      border: 1px solid var(--color-danger);
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 8px 14px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
      font-family: var(--font-sans);
    }

    .logout-btn:hover {
      background: var(--color-danger-bg);
      border-color: var(--color-danger);
      color: var(--color-danger);
    }

    /* Claude Button System */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid transparent;
      text-decoration: none;
      line-height: 1.25;
      user-select: none;
      white-space: nowrap;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
      gap: 5px;
    }

    .btn-xs {
      padding: 4px 9px;
      font-size: 11px;
      gap: 4px;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .btn-primary:hover {
      background: var(--accent-primary-hover);
      border-color: var(--accent-primary-hover);
      box-shadow: var(--shadow-sm);
    }

    .btn-outline {
      background: var(--bg-surface);
      color: var(--text-primary);
      border-color: var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
      color: var(--text-primary);
    }

    .btn-success {
      background: var(--color-success-bg);
      color: var(--color-success);
      border-color: rgba(22, 163, 74, 0.3);
    }

    .btn-success:hover {
      background: var(--color-success);
      color: #FFFFFF;
      border-color: var(--color-success);
      box-shadow: 0 2px 8px rgba(22, 163, 74, 0.25);
    }

    .btn-danger {
      background: var(--color-danger-bg);
      color: var(--color-danger);
      border-color: rgba(220, 38, 38, 0.3);
    }

    .btn-danger:hover {
      background: var(--color-danger);
      color: #FFFFFF;
      border-color: var(--color-danger);
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.25);
    }

    .action-cell-group {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-wrap: nowrap;
      white-space: nowrap;
    }

    .input-field {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      font-family: var(--font-sans);
      font-size: 13.5px;
      color: var(--text-primary);
      transition: all 0.15s ease;
      outline: none;
      resize: vertical;
    }

    .input-field:focus {
      border-color: var(--accent-primary);
      box-shadow: 0 0 0 3px var(--accent-primary-light);
    }

    /* Filter Controls */
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .filter-btn-group {
      display: flex;
      gap: 6px;
      background: var(--bg-surface-subtle);
      padding: 4px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
    }

    .filter-btn {
      background: transparent;
      border: none;
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .filter-btn.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    /* Verification Sub-navigation Segmented Control */
    .view-subnav-tabs {
      display: inline-flex;
      gap: 6px;
      background: var(--bg-surface-subtle);
      padding: 5px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .view-subnav-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: var(--radius-full);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
      white-space: nowrap;
    }

    .view-subnav-btn:hover {
      color: var(--text-primary);
      background: rgba(0, 0, 0, 0.04);
    }
    [data-theme="dark"] .view-subnav-btn:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    .view-subnav-btn.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    .verification-subpanel {
      display: none;
      animation: fadeIn 0.2s ease forwards;
    }

    .verification-subpanel.active {
      display: block;
    }

    /* Custom Professional Confirmation / Alert Dialog */
    .custom-dialog-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 440px;
      width: 100%;
      padding: 28px 24px 22px;
      box-shadow: var(--shadow-floating);
      position: relative;
      animation: dialogPop 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      text-align: center;
    }

    @keyframes dialogPop {
      from {
        opacity: 0;
        transform: scale(0.94) translateY(8px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .dialog-icon-wrapper {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-full);
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .dialog-icon-wrapper.success {
      background: var(--color-success-bg);
      color: var(--color-success);
      border: 1px solid rgba(22, 163, 74, 0.25);
    }

    .dialog-icon-wrapper.danger {
      background: var(--color-danger-bg);
      color: var(--color-danger);
      border: 1px solid rgba(220, 38, 38, 0.25);
    }

    .dialog-icon-wrapper.warning {
      background: #FFFBEB;
      color: #D97706;
      border: 1px solid rgba(217, 119, 6, 0.25);
    }
    [data-theme="dark"] .dialog-icon-wrapper.warning {
      background: #2D2514;
      color: #FBBF24;
      border-color: rgba(251, 191, 36, 0.25);
    }

    .dialog-icon-wrapper.primary,
    .dialog-icon-wrapper.info {
      background: var(--accent-primary-light);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }

    .dialog-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }

    .dialog-message {
      font-size: 13.5px;
      color: var(--text-secondary);
      line-height: 1.55;
      margin-bottom: 22px;
    }

    .dialog-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .dialog-actions .btn {
      flex: 1;
      padding: 9px 16px;
    }

    /* Modals & Drawers */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 14, 13, 0.6);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-floating);
      padding: 28px;
      position: relative;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .modal-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .modal-close-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 16px;
      cursor: pointer;
      padding: 6px;
      border-radius: var(--radius-sm);
      transition: color 0.15s ease;
    }

    .modal-close-btn:hover {
      color: var(--text-primary);
    }

    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .toast {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-floating);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      min-width: 280px;
      max-width: 420px;
    }

    /* Responsive Breakpoints */
    @media (max-width: 992px) {
      .admin-sidebar {
        transform: translateX(-100%);
      }

      .admin-sidebar.mobile-open {
        transform: translateX(0);
      }

      .admin-main-viewport {
        margin-left: 0;
      }

      .mobile-menu-toggle {
        display: block;
      }

      .admin-content-body {
        padding: 20px 14px 60px;
      }

      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 14, 13, 0.5);
        z-index: 140;
        display: none;
      }

      .sidebar-backdrop.active {
        display: block;
      }
    }

    @media (max-width: 768px) {
      .admin-header {
        padding: 10px 14px;
        gap: 8px;
      }

      .header-right-side {
        gap: 8px;
      }

      .header-breadcrumb span:nth-child(2),
      .header-breadcrumb span:nth-child(3),
      .header-breadcrumb span:nth-child(4) {
        display: none;
      }

      .theme-toggle-btn #theme-text {
        display: none;
      }

      .theme-toggle-btn {
        padding: 6px 10px;
      }

      .user-profile-badge {
        padding: 3px 8px 3px 3px;
        gap: 6px;
      }

      .user-profile-badge .user-name-label {
        max-width: 75px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
      }

      .logout-btn span {
        display: none;
      }

      .logout-btn {
        padding: 6px 10px;
      }

      .metrics-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .section-card {
        padding: 18px 14px;
      }
    }

    @media (max-width: 480px) {
      .header-breadcrumb {
        font-size: 12px;
      }

      .user-profile-badge .user-name-label {
        display: none;
      }

