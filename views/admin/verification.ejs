                  <tr>
                    <td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">
                      <i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Memuat data penarikan...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

      </main>
    </div>

    <!-- Application Detail Modal -->
    <div class="modal-overlay" id="application-detail-modal">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title" id="modal-app-title">Detail Berkas Pendaftaran Tutor</h3>
          <button class="modal-close-btn" onclick="closeModal('application-detail-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div id="modal-app-content">
          <!-- Populated dynamically -->
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:24px; padding-top:16px; border-top:1px solid var(--border-subtle);" id="modal-app-actions">
          <button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>
        </div>
      </div>
    </div>

    <!-- Reject Reason Input Modal -->
    <div class="modal-overlay" id="reject-reason-modal">
      <div class="modal-card" style="max-width: 480px;">
        <div class="modal-header">
          <h3 class="modal-title">Alasan Penolakan Pendaftaran</h3>
          <button class="modal-close-btn" onclick="closeModal('reject-reason-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div style="margin-bottom: 20px;">
          <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Berikan Catatan untuk Pelamar *</label>
          <textarea id="reject-reason-input" class="input-field" rows="4" placeholder="Contoh: Berkas portofolio belum melampirkan bukti sertifikasi atau CV belum lengkap."></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button class="btn btn-outline" onclick="closeModal('reject-reason-modal')">Batal</button>
          <button class="btn btn-danger" id="btn-confirm-reject" onclick="confirmRejectApplication()">
            <i class="fas fa-ban"></i> Konfirmasi Tolak
          </button>
        </div>
      </div>
    </div>

    <!-- Certificate Preview Modal -->
    <div class="modal-overlay" id="cert-preview-modal">
      <div class="modal-card" style="max-width: 600px; text-align:center;">
        <div class="modal-header">
          <h3 class="modal-title" id="cert-preview-title">Pratinjau Sertifikat Pengajar</h3>
          <button class="modal-close-btn" onclick="closeModal('cert-preview-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div id="cert-preview-body" style="padding: 10px 0;">
          <img src="" id="cert-preview-img" style="max-width:100%; border-radius:var(--radius-lg); border:1px solid var(--border-subtle); display:none;" alt="Sertifikat">
          <div id="cert-preview-fallback" style="padding:30px; background:var(--bg-surface-subtle); border-radius:var(--radius-lg); font-size:13px; color:var(--text-secondary);">
            Tidak ada file gambar langsung.
          </div>
        </div>

        <div style="margin-top:16px;">
          <button class="btn btn-outline" onclick="closeModal('cert-preview-modal')">Tutup</button>
        </div>
      </div>
    </div>

    <!-- Custom Professional Modal Dialog (Confirm & Alert) -->
    <div class="modal-overlay" id="custom-dialog-modal" style="z-index: 2200;">
      <div class="custom-dialog-card" id="custom-dialog-card">
        <div class="dialog-icon-wrapper" id="dialog-icon-wrapper">
          <i class="fas fa-circle-question" id="dialog-icon"></i>
        </div>
        <h3 class="dialog-title" id="dialog-title">Konfirmasi</h3>
        <p class="dialog-message" id="dialog-message">Pesan konfirmasi dialog.</p>
        <div class="dialog-actions" id="dialog-actions">
          <button class="btn btn-outline" id="dialog-btn-cancel">Batal</button>
          <button class="btn btn-primary" id="dialog-btn-confirm">Lanjutkan</button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toast-container"></div>
  </div>

  <script>
    // Theme Switcher & Synchronization
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Mobile Sidebar Drawer Toggle
    function toggleMobileSidebar(open) {
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (open) {
        sidebar.classList.add('mobile-open');
        backdrop.classList.add('active');
      } else {
        sidebar.classList.remove('mobile-open');
        backdrop.classList.remove('active');
      }
    }

    // Modal Helpers
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // Custom Professional Dialog System (Alert & Confirm)
    let dialogResolve = null;

    function showCustomConfirm({
      title = 'Konfirmasi Tindakan',
      message = 'Apakah Anda yakin ingin melanjutkan tindakan ini?',
      confirmText = 'Konfirmasi',
      cancelText = 'Batal',
      type = 'primary', // 'primary' | 'success' | 'danger' | 'warning' | 'info'
      icon = null
    } = {}) {
      return new Promise((resolve) => {
        dialogResolve = resolve;
        const modal = document.getElementById('custom-dialog-modal');
        const iconWrapper = document.getElementById('dialog-icon-wrapper');
        const iconEl = document.getElementById('dialog-icon');
        const titleEl = document.getElementById('dialog-title');
        const messageEl = document.getElementById('dialog-message');
        const cancelBtn = document.getElementById('dialog-btn-cancel');
        const confirmBtn = document.getElementById('dialog-btn-confirm');

        titleEl.textContent = title;
        messageEl.textContent = message;
        cancelBtn.textContent = cancelText;
        cancelBtn.style.display = 'inline-flex';
        confirmBtn.textContent = confirmText;

        // Reset & apply type styles
        iconWrapper.className = `dialog-icon-wrapper ${type}`;
        confirmBtn.className = `btn btn-${type === 'info' ? 'primary' : type}`;

        let iconClass = 'fas fa-circle-question';
        if (icon) {
          iconClass = `fas ${icon}`;
        } else if (type === 'success') {
          iconClass = 'fas fa-circle-check';
        } else if (type === 'danger') {
          iconClass = 'fas fa-triangle-exclamation';
        } else if (type === 'warning') {
          iconClass = 'fas fa-circle-exclamation';
        } else if (type === 'info') {
          iconClass = 'fas fa-circle-info';
        }
        iconEl.className = iconClass;

        cancelBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(false);
            dialogResolve = null;
          }
        };

        confirmBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(true);
            dialogResolve = null;
          }
        };

        openModal('custom-dialog-modal');
      });
    }

    function showCustomAlert({
      title = 'Pemberitahuan',
      message = '',
      confirmText = 'Mengerti',
      type = 'primary',
      icon = null
    } = {}) {
      return new Promise((resolve) => {
        dialogResolve = resolve;
        const modal = document.getElementById('custom-dialog-modal');
        const iconWrapper = document.getElementById('dialog-icon-wrapper');
        const iconEl = document.getElementById('dialog-icon');
        const titleEl = document.getElementById('dialog-title');
        const messageEl = document.getElementById('dialog-message');
        const cancelBtn = document.getElementById('dialog-btn-cancel');
        const confirmBtn = document.getElementById('dialog-btn-confirm');

        titleEl.textContent = title;
        messageEl.textContent = message;
        cancelBtn.style.display = 'none';
        confirmBtn.textContent = confirmText;

        iconWrapper.className = `dialog-icon-wrapper ${type}`;
        confirmBtn.className = `btn btn-${type === 'info' ? 'primary' : type}`;

        let iconClass = 'fas fa-circle-info';
        if (icon) {
          iconClass = `fas ${icon}`;
        } else if (type === 'success') {
          iconClass = 'fas fa-circle-check';
        } else if (type === 'danger') {
          iconClass = 'fas fa-triangle-exclamation';
        }
        iconEl.className = iconClass;

        confirmBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(true);
            dialogResolve = null;
          }
        };

        openModal('custom-dialog-modal');
      });
    }

    // Intercept native alert calls as fallback
    window.alert = function(msg) {
      showCustomAlert({ title: 'Pemberitahuan', message: String(msg) });
    };

    // Toast Notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: var(--color-success); font-size: 16px;"></i>';
      if (type === 'error') icon = '<i class="fas fa-circle-exclamation" style="color: var(--color-danger); font-size: 16px;"></i>';
      if (type === 'info') icon = '<i class="fas fa-circle-info" style="color: var(--text-primary); font-size: 16px;"></i>';

      toast.innerHTML = `${icon}<span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // State & Auth
    const token = localStorage.getItem('skillsphere_access_token');
    if (!token) {
      window.location.href = '/login';
    }

    let allApplications = [];
    let currentAppFilter = 'all';
    let allCertifications = [];
    let currentCertFilter = 'all';
    let pendingRejectId = null;

    document.addEventListener('DOMContentLoaded', () => {
      fetchAdminProfile();
      fetchAdminStats();
      fetchApplications();
      fetchCertifications();
      fetchPlatformCourses();
      fetchFinancialData();
      setupLogout();
    });

    // Switch Admin View Tabs
    function switchAdminView(viewName, subTab = null) {
      toggleMobileSidebar(false);

      document.querySelectorAll('.sidebar-nav-item').forEach(item => {
        item.classList.toggle('active', item.getAttribute('data-view') === viewName);
      });

      document.querySelectorAll('.dashboard-view-section').forEach(sec => {
        sec.classList.toggle('active', sec.id === `view-${viewName}`);
      });

      const breadcrumbMap = {
        overview: 'Ringkasan Platform',
        verification: 'Verifikasi & Sertifikasi',
        courses: 'Data Kursus & Materi',
        financial: 'Bagi Hasil & Finansial',
      };
      document.getElementById('current-view-breadcrumb').textContent = breadcrumbMap[viewName] || 'Admin Panel';

      if (viewName === 'verification' && subTab) {
        switchVerificationSubTab(subTab);
      }

      if (viewName === 'financial') {
        fetchFinancialData();
      }

      if (viewName === 'courses') {
        fetchPlatformCourses();
      }
    }

    // Switch Verification Sub-tabs (Applications vs Certifications)
    function switchVerificationSubTab(subTabName) {
      const btnApps = document.getElementById('subtab-btn-applications');
      const btnCerts = document.getElementById('subtab-btn-certifications');
      const panelApps = document.getElementById('subpanel-applications');
      const panelCerts = document.getElementById('subpanel-certifications');

      if (subTabName === 'certifications') {
        if (btnApps) btnApps.classList.remove('active');
        if (btnCerts) btnCerts.classList.add('active');
        if (panelApps) panelApps.style.display = 'none';
        if (panelCerts) panelCerts.style.display = 'block';
      } else {
        if (btnApps) btnApps.classList.add('active');
        if (btnCerts) btnCerts.classList.remove('active');
        if (panelApps) panelApps.style.display = 'block';
        if (panelCerts) panelCerts.style.display = 'none';
      }
    }

    // Fetch Admin Profile
    async function fetchAdminProfile() {
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const user = json.data;
          if (user.role !== 'admin') {
            await showCustomAlert({
              title: 'Akses Ditolak',
              message: 'Halaman ini khusus untuk administrator platform. Anda akan dialihkan ke dashboard.',
              type: 'danger',
              icon: 'fa-shield-halved'
            });
            window.location.href = '/dashboard';
            return;
          }
          const name = user.name || 'Admin SkillSphere';
          const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'AS';
          
          const headerUserName = document.getElementById('header-user-name');
          if (headerUserName) headerUserName.textContent = name;
          
          const headerAvatar = document.getElementById('header-avatar');
          if (headerAvatar) headerAvatar.textContent = initials;

          const sidebarName = document.getElementById('sidebar-user-name');
          if (sidebarName) sidebarName.textContent = name;

          const sidebarAvatar = document.getElementById('sidebar-avatar');
          if (sidebarAvatar) sidebarAvatar.textContent = initials;
        }
      } catch (e) {
        console.error('Error fetching admin profile:', e);
      }
    }

    function setupLogout() {
      const performLogout = async () => {
        const confirmed = await showCustomConfirm({
          title: 'Konfirmasi Keluar',
          message: 'Apakah Anda yakin ingin keluar dari sesi Administrator SkillSphere?',
          confirmText: 'Ya, Keluar',
          cancelText: 'Batal',
          type: 'danger',
          icon: 'fa-arrow-right-from-bracket'
        });
        if (!confirmed) return;

        try {
          await fetch('/api/auth/logout', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + token }
          });
        } catch (_) {}
        localStorage.removeItem('skillsphere_access_token');
        localStorage.removeItem('skillsphere_refresh_token');
        window.location.href = '/login';
      };

      const sidebarBtn = document.getElementById('sidebar-logout-btn');
      if (sidebarBtn) {
        sidebarBtn.addEventListener('click', performLogout);
      }

      const headerBtn = document.getElementById('header-logout-btn');
      if (headerBtn) {
        headerBtn.addEventListener('click', performLogout);
      }
    }

    // Fetch Admin Stats
    async function fetchAdminStats() {
      try {
        const res = await fetch('/api/admin/stats', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const stats = json.data;
          const pendingApps = stats.applications ? stats.applications.pending : 0;
          const pendingCerts = stats.certifications ? stats.certifications.pending : 0;
          const totalTutors = stats.system ? stats.system.totalTutors : 0;
          const totalStudents = stats.system ? stats.system.totalStudents : 0;
          const totalCourses = stats.system ? stats.system.totalCourses : 0;

          const badgeSidebar = document.getElementById('badge-pending-verification-total');
          if (badgeSidebar) badgeSidebar.textContent = pendingApps + pendingCerts;

          const subtabBadgeApps = document.getElementById('subtab-badge-apps');
          if (subtabBadgeApps) subtabBadgeApps.textContent = pendingApps;

          const subtabBadgeCerts = document.getElementById('subtab-badge-certs');
          if (subtabBadgeCerts) subtabBadgeCerts.textContent = pendingCerts;

          const statPendingTotal = document.getElementById('stat-pending-total');
          if (statPendingTotal) statPendingTotal.textContent = pendingApps + pendingCerts;

          const statTotalTutors = document.getElementById('stat-total-tutors');
          if (statTotalTutors) statTotalTutors.textContent = totalTutors;

          const statTotalStudents = document.getElementById('stat-total-students');
          if (statTotalStudents) statTotalStudents.textContent = totalStudents;

          const statTotalCourses = document.getElementById('stat-total-courses');
          if (statTotalCourses) statTotalCourses.textContent = totalCourses;
        }
      } catch (e) {
        console.error('Error fetching stats:', e);
      }
    }

    // Fetch Tutor Applications
    async function fetchApplications() {
      try {
        const res = await fetch('/api/admin/tutor-applications?status=all', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          if (Array.isArray(json.data)) {
            allApplications = json.data;
          } else if (Array.isArray(json.data.applications)) {
            allApplications = json.data.applications;
          } else {
            allApplications = [];
          }
          renderApplicationsTable();
        }
      } catch (e) {
        console.error('Error fetching applications:', e);
      }
    }

    function filterApplications(status, btn) {
      currentAppFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderApplicationsTable();
    }

    function renderApplicationsTable() {
      const tbody = document.getElementById('applications-table-body');
      if (!tbody) return;

      let filtered = allApplications;
      if (currentAppFilter !== 'all') {
        filtered = allApplications.filter(a => a.status === currentAppFilter);
      }

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">
              Tidak ada data pendaftaran pengajar dengan filter ini.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(app => {
        let statusBadge = '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Menunggu</span>';
        if (app.status === 'approved') statusBadge = '<span class="status-pill status-active"><i class="fas fa-check"></i> Disetujui</span>';
        if (app.status === 'rejected') statusBadge = '<span class="status-pill status-rejected"><i class="fas fa-xmark"></i> Ditolak</span>';

        const applicantName = app.applicant ? app.applicant.name : 'Pelamar';
        const applicantEmail = app.applicant ? app.applicant.email : '-';
        const expertise = app.institution_name || app.expertise_field || 'Pengajar';
        const expYears = app.experience_years !== undefined ? app.experience_years : (app.years_of_experience || 0);
        const dateStr = new Date(app.created_at || app.createdAt || Date.now()).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });

        return `
          <tr>
            <td>
              <div style="font-weight:600; color:var(--text-primary);">${escapeHtml(applicantName)}</div>
              <div style="font-size:12px; color:var(--text-secondary);">${escapeHtml(applicantEmail)}</div>
            </td>
            <td><strong>${escapeHtml(expertise)}</strong></td>
            <td>${expYears} Tahun</td>
            <td>
              ${app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="link" style="font-size:12px; font-weight:600; margin-right:8px;"><i class="fas fa-link"></i> Portofolio</a>` : ''}
              ${app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="link" style="font-size:12px; font-weight:600;"><i class="fas fa-file-pdf"></i> CV</a>` : ''}
              ${(!app.portfolio_url && !app.cv_url) ? '<span style="font-size:12px; color:var(--text-secondary);">-</span>' : ''}
            </td>
            <td>${dateStr}</td>
            <td>${statusBadge}</td>
            <td>
              <div class="action-cell-group">
                <button class="btn btn-outline btn-sm" onclick="viewApplicationDetail(${app.id})">
                  <i class="fas fa-eye"></i> Review
                </button>
                ${app.status === 'pending' ? `
                  <button class="btn btn-success btn-sm" onclick="approveApplication(${app.id}, '${escapeHtml(applicantName)}')">
                    <i class="fas fa-check"></i> Setujui
                  </button>
                  <button class="btn btn-danger btn-sm" onclick="openRejectModal(${app.id})">
                    <i class="fas fa-ban"></i> Tolak
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // View Application Detail
    function viewApplicationDetail(id) {
      const app = allApplications.find(a => a.id === id);
      if (!app) return;

      const applicantName = app.applicant ? app.applicant.name : 'Pelamar';
      const expertise = app.institution_name || app.expertise_field || 'Pengajar';
      const expYears = app.experience_years !== undefined ? app.experience_years : (app.years_of_experience || 0);

      document.getElementById('modal-app-title').textContent = `Review Pendaftaran: ${applicantName}`;

      document.getElementById('modal-app-content').innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:18px;">
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
            <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Institusi / Bidang Keahlian</div>
            <div style="font-size:14px; font-weight:600; color:var(--text-primary); margin-top:4px;">${escapeHtml(expertise)}</div>
          </div>
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
            <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Pengalaman Mengajar</div>
            <div style="font-size:14px; font-weight:600; color:var(--text-primary); margin-top:4px;">${expYears} Tahun</div>
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label style="font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Surat Motivasi & Pengalaman</label>
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle); font-size:13px; line-height:1.6; color:var(--text-primary); margin-top:6px; white-space:pre-line;">
            ${escapeHtml(app.motivation_letter || 'Tidak ada surat motivasi.')}
          </div>
        </div>

        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          ${app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="btn btn-outline" style="font-size:12px;"><i class="fas fa-arrow-up-right-from-square"></i> Buka Tautan Portofolio</a>` : ''}
          ${app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="btn btn-outline" style="font-size:12px;"><i class="fas fa-file-pdf"></i> Unduh / Buka Berkas CV</a>` : ''}
        </div>
      `;

      const actionsContainer = document.getElementById('modal-app-actions');
      if (app.status === 'pending') {
        actionsContainer.innerHTML = `
          <button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>
          <button class="btn btn-danger" onclick="closeModal('application-detail-modal'); openRejectModal(${app.id})">
            <i class="fas fa-ban"></i> Tolak
          </button>
          <button class="btn btn-success" onclick="closeModal('application-detail-modal'); approveApplication(${app.id}, '${escapeHtml(applicantName)}')">
            <i class="fas fa-check"></i> Setujui Jadi Tutor
          </button>
        `;
      } else {
        actionsContainer.innerHTML = `<button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>`;
      }

      openModal('application-detail-modal');
    }

    // Approve Application
    async function approveApplication(id, name) {
      const confirmed = await showCustomConfirm({
        title: 'Setujui Pendaftaran Tutor',
        message: `Setujui pendaftaran "${name}"? Peran akun akan diubah menjadi Tutor dan Dompet Virtual diaktifkan secara otomatis.`,
        confirmText: 'Ya, Setujui',
        cancelText: 'Batal',
        type: 'success',
        icon: 'fa-user-check'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/tutor-applications/${id}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(`Pendaftaran "${name}" berhasil disetujui!`, 'success');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyetujui pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat menyetujui pendaftaran.', 'error');
      }
    }

    // Reject Application Modal
    function openRejectModal(id) {
      pendingRejectId = id;
      document.getElementById('reject-reason-input').value = '';
      openModal('reject-reason-modal');
    }

    async function confirmRejectApplication() {
      if (!pendingRejectId) return;
      const reason = document.getElementById('reject-reason-input').value.trim();
      if (!reason) {
        showToast('Alasan penolakan wajib diisi.', 'error');
        return;
      }

      try {
        const res = await fetch(`/api/admin/tutor-applications/${pendingRejectId}/reject`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ reason: reason, rejection_reason: reason }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Pendaftaran tutor berhasil ditolak.', 'info');
          closeModal('reject-reason-modal');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menolak pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses penolakan.', 'error');
      }
    }

    // Fetch Tutor Certifications
    async function fetchCertifications() {
      try {
        const res = await fetch('/api/admin/tutor-certifications', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          if (Array.isArray(json.data)) {
            allCertifications = json.data;
          } else if (Array.isArray(json.data.certifications)) {
            allCertifications = json.data.certifications;
          } else {
            allCertifications = [];
          }
          renderCertificationsTable();
        }
      } catch (e) {
        console.error('Error fetching certifications:', e);
      }
    }

    function filterCerts(status, btn) {
      currentCertFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderCertificationsTable();
    }

    function renderCertificationsTable() {
      const tbody = document.getElementById('certifications-table-body');
      if (!tbody) return;

      let filtered = allCertifications;
      if (currentCertFilter === 'verified') filtered = allCertifications.filter(c => c.is_verified);
      if (currentCertFilter === 'pending') filtered = allCertifications.filter(c => !c.is_verified);

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">
              Tidak ada data sertifikasi pengajar dengan filter ini.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(cert => {
        const tutorName = cert.tutor ? cert.tutor.name : 'Tutor';
        const certName = cert.certificate_name || cert.title || 'Sertifikat';
        const issuer = cert.issuer || cert.issuer_organization || '-';
        const fileUrl = cert.certificate_file_url || cert.file_url || '';
        const isVerified = Boolean(cert.is_verified);
        const statusBadge = isVerified 
          ? '<span class="status-pill status-active"><i class="fas fa-circle-check"></i> Terverifikasi</span>'
          : '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Belum Divalidasi</span>';

        return `
          <tr>
            <td><strong>${escapeHtml(tutorName)}</strong></td>
            <td>${escapeHtml(certName)}</td>
            <td><span class="user-role-tag">${escapeHtml(issuer)}</span></td>
            <td><code>${escapeHtml(cert.credential_id || '-')}</code></td>
            <td>
              ${fileUrl ? `
                <button class="btn btn-outline btn-sm" onclick="previewCertificateImage('${fileUrl}', '${escapeHtml(certName)}')">
                  <i class="fas fa-image"></i> Lihat Berkas
                </button>
              ` : '<span style="color:var(--text-secondary); font-size:12px;">Tidak ada berkas</span>'}
            </td>
            <td>${statusBadge}</td>
            <td>
              <div class="action-cell-group">
                ${!isVerified ? `
                  <button class="btn btn-success btn-sm" onclick="verifyCertificate(${cert.id}, true)">
                    <i class="fas fa-check-double"></i> Validasi
                  </button>
                ` : `
                  <button class="btn btn-danger btn-sm" onclick="verifyCertificate(${cert.id}, false)">
                    <i class="fas fa-rotate-left"></i> Batalkan
                  </button>
                `}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function previewCertificateImage(url, title) {
      document.getElementById('cert-preview-title').textContent = title;
      const img = document.getElementById('cert-preview-img');
      const fallback = document.getElementById('cert-preview-fallback');
      if (url) {
        img.src = url;
        img.style.display = 'inline-block';
        fallback.style.display = 'none';
      } else {
        img.style.display = 'none';
        fallback.style.display = 'block';
      }
      openModal('cert-preview-modal');
    }

    async function verifyCertificate(id, shouldVerify) {
      const action = shouldVerify ? 'verify' : 'unverify';
      const confirmed = await showCustomConfirm({
        title: shouldVerify ? 'Validasi Sertifikat Resmi' : 'Batalkan Validasi Sertifikat',
        message: shouldVerify ? 'Verifikasi dan tandai sertifikat ini sebagai berkas keahlian resmi?' : 'Batalkan status verifikasi berkas sertifikat ini?',
        confirmText: shouldVerify ? 'Ya, Validasi' : 'Ya, Batalkan',
        cancelText: 'Batal',
        type: shouldVerify ? 'success' : 'warning',
        icon: shouldVerify ? 'fa-certificate' : 'fa-triangle-exclamation'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/admin/tutor-certifications/${id}/${action}`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'success');
          fetchCertifications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mengubah status sertifikat.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses sertifikat.', 'error');
      }
    }

    // =========================================================
    // --- Course Management & Moderation Logic (Approve & Suspend) ---
    // =========================================================
    let currentAdminCourseStatus = 'all';
    let adminCourseSearchQuery = '';
    let adminCourseSearchTimeout = null;
    let currentCoursesMap = {};
    window.showConfirmDialog = showCustomConfirm;

    function filterAdminCourses(status, btnElement) {
      currentAdminCourseStatus = status;
      const group = document.getElementById('course-status-filter-group');
      if (group) {
        group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      }
      if (btnElement) btnElement.classList.add('active');
      fetchPlatformCourses();
    }

    function debounceAdminCourseSearch(val) {
      clearTimeout(adminCourseSearchTimeout);
      adminCourseSearchTimeout = setTimeout(() => {
        adminCourseSearchQuery = (val || '').trim();
        fetchPlatformCourses();
      }, 300);
    }

    // Fetch Platform Courses for Admin Management
    async function fetchPlatformCourses() {
      const tbody = document.getElementById('admin-courses-table-body');
      if (!tbody) return;

      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:28px; color:var(--text-secondary);"><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Memperbarui data kursus...</td></tr>`;

      try {
        let url = `/api/admin/courses?limit=100`;
        if (currentAdminCourseStatus !== 'all') {
          url += `&status=${encodeURIComponent(currentAdminCourseStatus)}`;
        }
        if (adminCourseSearchQuery) {
          url += `&search=${encodeURIComponent(adminCourseSearchQuery)}`;
        }

        let res = await fetch(url, {
          headers: { 'Authorization': 'Bearer ' + token }
        });

        if (!res.ok) {
          // Fallback to general courses endpoint if admin auth check fails
          res = await fetch('/api/courses?limit=100' + (currentAdminCourseStatus !== 'all' ? `&status=${encodeURIComponent(currentAdminCourseStatus)}` : ''));
        }

        const json = await res.json();
        const courses = (json.data && Array.isArray(json.data.courses))
          ? json.data.courses
          : (Array.isArray(json.data) ? json.data : ((json.data && Array.isArray(json.data.items)) ? json.data.items : []));

        currentCoursesMap = {};
        courses.forEach(c => {
          currentCoursesMap[c.id] = c;
        });

        if (!courses.length) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">Tidak ada kursus yang sesuai filter (${escapeHtml(currentAdminCourseStatus)}).</td></tr>`;
          return;
        }

        tbody.innerHTML = courses.map(c => {
          const status = (c.status || 'draft').toLowerCase();
          let statusBadge = '';
          let actionButtons = '';

          if (status === 'published') {
            statusBadge = `<span class="status-pill status-active"><i class="fas fa-circle-check"></i> PUBLISHED</span>`;
            actionButtons = `
              <button class="btn btn-danger btn-sm" onclick="suspendCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 10px;">
                <i class="fas fa-ban"></i> Suspend
              </button>
            `;
          } else if (status === 'suspended') {
            statusBadge = `<span class="status-pill status-rejected"><i class="fas fa-ban"></i> SUSPENDED</span>`;
            actionButtons = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 10px;">
                <i class="fas fa-check"></i> Approve & Publish
              </button>
            `;
          } else if (status === 'draft') {
            statusBadge = `<span class="status-pill status-pending"><i class="fas fa-file-lines"></i> DRAFT</span>`;
            actionButtons = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 10px;">
                <i class="fas fa-check"></i> Approve & Publish
              </button>
            `;
          } else {
            statusBadge = `<span class="status-pill status-locked">${escapeHtml(status.toUpperCase())}</span>`;
            actionButtons = `
              <button class="btn btn-success btn-sm" onclick="approveCoursePrompt(${c.id})" style="font-size:11.5px; padding:4px 10px;">
                <i class="fas fa-check"></i> Publish
              </button>
            `;
          }

          return `
            <tr id="course-row-${c.id}">
              <td>
                <div style="font-weight:600; color:var(--text-primary);">${escapeHtml(c.title || 'Tanpa Judul')}</div>
                <div style="font-size:11.5px; color:var(--text-secondary); margin-top:2px;">ID: #${escapeHtml(String(c.id || ''))}</div>
              </td>
              <td>${c.tutor ? escapeHtml(c.tutor.name || '') : '<span style="color:var(--text-secondary);">-</span>'}</td>
              <td><span class="user-role-tag">${c.category ? escapeHtml(c.category.name || '') : 'Umum'}</span></td>
              <td><strong style="color:var(--text-primary);">Rp ${(Number(c.price) || 0).toLocaleString('id-ID')}</strong></td>
              <td><span class="status-pill status-locked">${escapeHtml((c.level || 'beginner').toUpperCase())}</span></td>
              <td id="course-status-cell-${c.id}">${statusBadge}</td>
              <td style="text-align:right;">
                <div style="display:inline-flex; gap:6px; justify-content:flex-end; align-items:center;">
                  <span id="course-action-cell-${c.id}">${actionButtons}</span>
                  <a href="/tutor/materials?courseId=${c.id}" target="_blank" class="btn btn-outline btn-sm" style="font-size:11.5px; padding:4px 8px;" title="Lihat Materi Kursus">
                    <i class="fas fa-folder-open"></i>
                  </a>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      } catch (e) {
        console.error('Error fetching courses overview:', e);
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:32px; color:var(--color-danger);">Gagal memuat kursus platform: ${escapeHtml(e.message || 'Kesalahan data.')}</td></tr>`;
      }
    }

    // Approve / Publish Action
    async function approveCoursePrompt(courseId) {
      const course = currentCoursesMap[courseId] || {};
      const courseTitle = course.title || `Kursus #${courseId}`;

      const confirmed = await showCustomConfirm({
        title: 'Setujui & Publikasikan Kursus?',
        message: `Apakah Anda yakin ingin menyetujui dan mempublikasikan kursus "${courseTitle}"? Kursus ini akan langsung dapat diakses dan dibeli oleh seluruh siswa di platform.`,
        type: 'success',
        confirmText: 'Approve & Publish',
        cancelText: 'Batal',
        icon: 'fa-circle-check'
      });

      if (!confirmed) return;

      try {
        let res = await fetch(`/api/admin/courses/${courseId}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          // Fallback directly to general course update endpoint
          res = await fetch(`/api/courses/${courseId}`, {
            method: 'PUT',
            headers: {
              'Authorization': 'Bearer ' + token,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: 'published' })
          });
        }

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Kursus berhasil dipublikasikan!', 'success');
          fetchPlatformCourses();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyetujui kursus.', 'error');
        }
      } catch (err) {
        console.error('Error approving course:', err);
        showToast('Kesalahan jaringan saat memproses persetujuan kursus.', 'error');
      }
    }

    // Suspend / Freeze Action
    async function suspendCoursePrompt(courseId) {
      const course = currentCoursesMap[courseId] || {};
      const courseTitle = course.title || `Kursus #${courseId}`;

      const confirmed = await showCustomConfirm({
        title: 'Bekukan (Suspend) Kursus?',
        message: `Apakah Anda yakin ingin membekukan / suspend kursus "${courseTitle}"? Kursus ini akan dinonaktifkan dari katalog publik siswa hingga disetujui kembali.`,
        type: 'danger',
        confirmText: 'Suspend Kursus',
        cancelText: 'Batal',
        icon: 'fa-ban'
      });

      if (!confirmed) return;

      try {
        let res = await fetch(`/api/admin/courses/${courseId}/suspend`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ reason: 'Peninjauan kepatuhan materi oleh Administrator.' })
        });

        if (!res.ok) {
          // Fallback directly to general course update endpoint
          res = await fetch(`/api/courses/${courseId}`, {
            method: 'PUT',
            headers: {
              'Authorization': 'Bearer ' + token,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: 'suspended' })
          });
        }

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Kursus berhasil disuspend!', 'warning');
          fetchPlatformCourses();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal membekukan kursus.', 'error');
        }
      } catch (err) {
        console.error('Error suspending course:', err);
        showToast('Kesalahan jaringan saat memproses suspend kursus.', 'error');
      }
    }

    // Fetch Financial & Revenue Data
    async function fetchFinancialData() {
      try {
        const res = await fetch('/api/admin/financial', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          renderFinancialTables(json.data);
        }
      } catch (e) {
        console.error('Error fetching financial data:', e);
      }
    }

    function renderFinancialTables(data) {
      const walletsTbody = document.getElementById('wallets-table-body');
      const withdrawalsTbody = document.getElementById('withdrawals-table-body');

      // Wallets
      if (walletsTbody) {
        const wallets = data.wallets || [];
        if (!wallets.length) {
          walletsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">Belum ada dompet virtual tutor aktif.</td></tr>`;
        } else {
          walletsTbody.innerHTML = wallets.map(w => {
            const tutorName = w.tutor ? w.tutor.name : 'Tutor';
            const tutorEmail = w.tutor ? w.tutor.email : '-';
            return `
              <tr>
                <td><strong>${escapeHtml(tutorName)}</strong></td>
                <td><span style="font-size:12px; color:var(--text-secondary);">${escapeHtml(tutorEmail)}</span></td>
                <td><strong style="color:var(--color-success);">Rp ${Number(w.balance || 0).toLocaleString('id-ID')}</strong></td>
                <td>Rp ${Number(w.pending_balance || 0).toLocaleString('id-ID')}</td>
                <td>Rp ${Number(w.total_withdrawn || 0).toLocaleString('id-ID')}</td>
                <td>
                  ${w.is_active 
                    ? '<span class="status-pill status-active"><i class="fas fa-check"></i> Aktif</span>' 
                    : '<span class="status-pill status-rejected">Nonaktif</span>'}
                </td>
              </tr>
            `;
          }).join('');
        }
      }

      // Withdrawals
      if (withdrawalsTbody) {
        const withdrawals = data.withdrawals || [];
        if (!withdrawals.length) {
          withdrawalsTbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-secondary);">Belum ada riwayat permintaan penarikan dana.</td></tr>`;
        } else {
          withdrawalsTbody.innerHTML = withdrawals.map(wd => {
            const tutorName = wd.tutor ? wd.tutor.name : 'Tutor';
            const dateStr = new Date(wd.created_at || wd.createdAt || Date.now()).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
            let statusPill = '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Diproses</span>';
            if (wd.status === 'completed') statusPill = '<span class="status-pill status-active"><i class="fas fa-check"></i> Selesai</span>';
            if (wd.status === 'rejected') statusPill = '<span class="status-pill status-rejected"><i class="fas fa-xmark"></i> Ditolak</span>';

            return `
              <tr>
                <td><strong>${escapeHtml(tutorName)}</strong></td>
                <td><strong style="color:var(--text-primary);">Rp ${Number(wd.amount || 0).toLocaleString('id-ID')}</strong></td>
                <td><span class="user-role-tag">${escapeHtml(wd.bank_name || '-')}</span></td>
                <td><code>${escapeHtml(wd.account_number || '-')}</code> (${escapeHtml(wd.account_holder_name || '-')})</td>
                <td>${dateStr}</td>
                <td>${statusPill}</td>
              </tr>
            `;
          }).join('');
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
</html>
