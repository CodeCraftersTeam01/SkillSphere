      const courseTitle = course.title || `Kursus #${courseId}`;

      const confirmed = await showCustomConfirm({
        title: 'Bekukan (Suspend) Kursus?',
        message: `Apakah Anda yakin ingin membekukan / suspend kursus "${courseTitle}"? Kursus ini akan dinonaktifkan dari katalog publik siswa hingga disetujui kembali.`,
        type: 'danger',
        confirmText: 'Suspend Kursus',
        cancelText: 'Batal',
