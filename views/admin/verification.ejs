                <i class="fas fa-graduation-cap"></i> Manajemen Kursus & Materi Pembelajaran
              </h2>
              <a href="/tutor/materials" class="btn btn-outline" style="font-size:12px; padding:6px 14px;">
                <i class="fas fa-arrow-up-right-from-square"></i> Portal Upload Materi
              </a>
            </div>

            <div class="table-responsive">
              <table class="styled-table">
                <thead>
                  <tr>
                    <th>Judul Kursus</th>
