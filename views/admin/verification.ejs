        <!-- VIEW 3: TUTOR CERTIFICATIONS VALIDATION -->
        <section class="dashboard-view-section" id="view-certifications">
          <div class="section-card">
            <div class="section-header">
              <h2 class="section-title">
                <i class="fas fa-certificate"></i> Validasi Sertifikasi Pengajar
              </h2>
              <div class="filter-bar" style="margin-bottom:0;">
                <div class="filter-btn-group">
                  <button class="filter-btn active" onclick="filterCerts('all', this)">Semua</button>
                  <button class="filter-btn" onclick="filterCerts('pending', this)">Belum Terverifikasi</button>
                  <button class="filter-btn" onclick="filterCerts('verified', this)">Sudah Terverifikasi</button>
