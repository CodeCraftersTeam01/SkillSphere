    // Section Handlers
    function openAddSectionPrompt() {
      if (!activeCurriculumCourse) return;
      document.getElementById('section-form-modal-title').textContent = 'Tambah Bab Baru';
      document.getElementById('section-form-mode').value = 'create';
      document.getElementById('section-form-id').value = '';
      document.getElementById('section-title-input').value = '';
      
      const sections = activeCurriculumCourse.sections || [];
      document.getElementById('section-order-input').value = sections.length + 1;

      openModal('modal-admin-section-form');
    }

    function openEditSectionPrompt(sectionId, currentTitle, currentOrder) {
      document.getElementById('section-form-modal-title').textContent = 'Edit Judul Bab';
      document.getElementById('section-form-mode').value = 'edit';
      document.getElementById('section-form-id').value = sectionId;
      document.getElementById('section-title-input').value = currentTitle || '';
      document.getElementById('section-order-input').value = currentOrder || 1;

      openModal('modal-admin-section-form');
    }

    async function submitAdminSectionForm(e) {
      e.preventDefault();
      if (!activeCurriculumCourse) return;

      const mode = document.getElementById('section-form-mode').value;
      const sectionId = document.getElementById('section-form-id').value;
      const title = document.getElementById('section-title-input').value.trim();
      const order_index = parseInt(document.getElementById('section-order-input').value, 10) || 1;

      const btn = document.getElementById('btn-submit-section-form');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

      try {
        let url = `/api/courses/${activeCurriculumCourse.id}/sections`;
        let method = 'POST';

        if (mode === 'edit') {
          url = `/api/courses/sections/${sectionId}`;
          method = 'PUT';
        }

        const res = await fetch(url, {
          method,
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title, order_index }),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Bab berhasil disimpan!', 'success');
          closeModal('modal-admin-section-form');
          openAdminCurriculumModal(activeCurriculumCourse.id);
          fetchPlatformCourses();
        } else {
          showToast(json.message || 'Gagal menyimpan bab.', 'error');
        }
      } catch (err) {
        console.error('Error saving section:', err);
        showToast('Kesalahan jaringan saat menyimpan bab.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    }

    async function deleteSectionPrompt(sectionId, sectionTitle) {
      const confirmed = await showCustomConfirm({
        title: `Hapus Bab "${sectionTitle}"?`,
        message: `PERINGATAN: Menghapus bab ini akan menghapus seluruh sub-materi yang ada di dalamnya secara permanen.`,
        type: 'danger',
        confirmText: 'Ya, Hapus Bab',
        cancelText: 'Batal',
        icon: 'fa-trash'
      });

      if (!confirmed) return;

      try {
        const res = await fetch(`/api/courses/sections/${sectionId}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + token },
        });

        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message || 'Bab berhasil dihapus.', 'success');
          if (activeCurriculumCourse) {
            openAdminCurriculumModal(activeCurriculumCourse.id);
          }
          fetchPlatformCourses();
        } else {
          showToast(json.message || 'Gagal menghapus bab.', 'error');
        }
      } catch (err) {
        console.error('Error deleting section:', err);
        showToast('Kesalahan jaringan saat menghapus bab.', 'error');
      }
    }

    // Material Handlers
    function openAddMaterialModal(sectionId) {
      document.getElementById('material-form-modal-title').textContent = 'Tambah Materi Sub-Bab';
      document.getElementById('material-form-mode').value = 'create';
      document.getElementById('material-form-section-id').value = sectionId;
      document.getElementById('material-form-id').value = '';
      document.getElementById('material-title-input').value = '';
      document.getElementById('material-type-select').value = 'video';
      document.getElementById('material-duration-input').value = '10';
      document.getElementById('material-url-input').value = '';
      document.getElementById('material-preview-checkbox').checked = false;

      // Find highest order in section
      let nextOrder = 1;
      if (activeCurriculumCourse && activeCurriculumCourse.sections) {
        const sec = activeCurriculumCourse.sections.find(s => String(s.id) === String(sectionId));
        if (sec && sec.materials) {
          nextOrder = sec.materials.length + 1;
        }
      }
      document.getElementById('material-order-input').value = nextOrder;

      openModal('modal-admin-material-form');
    }

    async function openEditMaterialModal(sectionId, materialId) {
      let mat = null;
      if (activeCurriculumCourse && activeCurriculumCourse.sections) {
        const sec = activeCurriculumCourse.sections.find(s => String(s.id) === String(sectionId));
        if (sec && sec.materials) {
          mat = sec.materials.find(m => String(m.id) === String(materialId));
        }
      }

      if (!mat) {
        try {
          const res = await fetch(`/api/materials/${materialId}`, {
            headers: { 'Authorization': 'Bearer ' + token }
          });
          const json = await res.json();
          if (json.success && json.data) mat = json.data;
        } catch (_) {}
      }

      if (!mat) {
        showToast('Data materi tidak ditemukan.', 'error');
        return;
      }

      document.getElementById('material-form-modal-title').textContent = 'Edit Materi Sub-Bab';
      document.getElementById('material-form-mode').value = 'edit';
      document.getElementById('material-form-section-id').value = sectionId;
      document.getElementById('material-form-id').value = mat.id;
      document.getElementById('material-title-input').value = mat.title || '';
      document.getElementById('material-type-select').value = mat.content_type || 'video';
      document.getElementById('material-duration-input').value = mat.duration_minutes || 10;
      document.getElementById('material-url-input').value = mat.file_url || '';
      document.getElementById('material-preview-checkbox').checked = !!mat.is_preview;
      document.getElementById('material-order-input').value = mat.order_index || 1;

      openModal('modal-admin-material-form');
    }

