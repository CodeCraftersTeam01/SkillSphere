        return `
          <div style="background:var(--bg-surface-subtle); border-radius:var(--radius-lg); border:1px solid var(--border-subtle); padding:14px 16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
              <div style="display:flex; align-items:center; gap:10px;">
                <span class="status-pill status-locked" style="font-weight:700;">#${sec.order_index || (secIdx + 1)}</span>
                <strong style="font-size:14.5px; color:var(--text-primary);">${escapeHtml(sec.title)}</strong>
                <span class="user-role-tag" style="font-size:10px;">${materials.length} Materi</span>
