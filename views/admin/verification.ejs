                    <button 
                      class="btn btn-outline btn-sm" 
                      onclick="deleteMaterialPrompt(${mat.id}, '${escapeHtml(mat.title)}')" 
                      style="padding:4px 8px; font-size:11px; color:var(--color-danger);" 
                      title="Hapus Materi"
                    >
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </div>
              `;
            }).join('')}
