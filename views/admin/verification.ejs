            <button class="btn btn-danger btn-sm" onclick="openRejectModal(${app.id}, '${escapeHtml(applicantName)}')" title="Tolak pendaftaran" style="font-size:11.5px; padding:4px 10px;">
              <i class="fas fa-ban"></i> Tolak
            </button>
            <button class="btn btn-outline btn-sm" onclick="viewApplicationDetail(${app.id})" title="Review berkas lengkap" style="font-size:11.5px; padding:4px 8px;">
              <i class="fas fa-eye"></i>
            </button>
          `;
        } else if (app.status === 'approved') {
          actionButtons = `
            <button class="btn btn-outline btn-sm" onclick="viewApplicationDetail(${app.id})" title="Lihat detail berkas" style="font-size:11.5px; padding:4px 10px;">
              <i class="fas fa-eye"></i> Detail
            </button>
            <button class="btn btn-danger btn-sm" onclick="openRejectModal(${app.id}, '${escapeHtml(applicantName)}', true)" title="Ubah status: Batalkan ACC / Tolak" style="font-size:11.5px; padding:4px 10px;">
              <i class="fas fa-ban"></i> Tolak
            </button>
            <button class="btn btn-outline btn-sm" onclick="resetApplicationStatus(${app.id}, '${escapeHtml(applicantName)}')" title="Reset ke status Menunggu" style="font-size:11px; padding:4px 8px;">
              <i class="fas fa-rotate-left"></i>
            </button>
          `;
        } else if (app.status === 'rejected') {
          actionButtons = `
            <button class="btn btn-success btn-sm" onclick="approveApplication(${app.id}, '${escapeHtml(applicantName)}')" title="Ubah keputusan: ACC / Setujui jadi Tutor" style="font-size:11.5px; padding:4px 10px;">
              <i class="fas fa-check"></i> ACC
            </button>
            <button class="btn btn-outline btn-sm" onclick="viewApplicationDetail(${app.id})" title="Lihat alasan penolakan & berkas" style="font-size:11.5px; padding:4px 10px;">
              <i class="fas fa-eye"></i> Detail
            </button>
