  <script>
    // Theme Switcher & Synchronization
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Mobile Sidebar Drawer Toggle
    function toggleMobileSidebar(open) {
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (open) {
        sidebar.classList.add('mobile-open');
        backdrop.classList.add('active');
      } else {
        sidebar.classList.remove('mobile-open');
        backdrop.classList.remove('active');
      }
    }

    // Modal Helpers
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // Custom Professional Dialog System (Alert & Confirm)
    let dialogResolve = null;

    function showCustomConfirm({
      title = 'Konfirmasi Tindakan',
      message = 'Apakah Anda yakin ingin melanjutkan tindakan ini?',
      confirmText = 'Konfirmasi',
      cancelText = 'Batal',
      type = 'primary', // 'primary' | 'success' | 'danger' | 'warning' | 'info'
      icon = null
    } = {}) {
      return new Promise((resolve) => {
        dialogResolve = resolve;
        const modal = document.getElementById('custom-dialog-modal');
        const iconWrapper = document.getElementById('dialog-icon-wrapper');
        const iconEl = document.getElementById('dialog-icon');
        const titleEl = document.getElementById('dialog-title');
        const messageEl = document.getElementById('dialog-message');
        const cancelBtn = document.getElementById('dialog-btn-cancel');
        const confirmBtn = document.getElementById('dialog-btn-confirm');

        titleEl.textContent = title;
        messageEl.textContent = message;
        cancelBtn.textContent = cancelText;
        cancelBtn.style.display = 'inline-flex';
        confirmBtn.textContent = confirmText;

        // Reset & apply type styles
        iconWrapper.className = `dialog-icon-wrapper ${type}`;
        confirmBtn.className = `btn btn-${type === 'info' ? 'primary' : type}`;

        let iconClass = 'fas fa-circle-question';
        if (icon) {
          iconClass = `fas ${icon}`;
        } else if (type === 'success') {
          iconClass = 'fas fa-circle-check';
        } else if (type === 'danger') {
          iconClass = 'fas fa-triangle-exclamation';
        } else if (type === 'warning') {
          iconClass = 'fas fa-circle-exclamation';
        } else if (type === 'info') {
          iconClass = 'fas fa-circle-info';
        }
        iconEl.className = iconClass;

        cancelBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(false);
            dialogResolve = null;
          }
        };

        confirmBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(true);
            dialogResolve = null;
          }
        };

        openModal('custom-dialog-modal');
      });
    }

    function showCustomAlert({
      title = 'Pemberitahuan',
      message = '',
      confirmText = 'Mengerti',
      type = 'primary',
      icon = null
    } = {}) {
      return new Promise((resolve) => {
        dialogResolve = resolve;
        const modal = document.getElementById('custom-dialog-modal');
        const iconWrapper = document.getElementById('dialog-icon-wrapper');
        const iconEl = document.getElementById('dialog-icon');
        const titleEl = document.getElementById('dialog-title');
        const messageEl = document.getElementById('dialog-message');
        const cancelBtn = document.getElementById('dialog-btn-cancel');
        const confirmBtn = document.getElementById('dialog-btn-confirm');

        titleEl.textContent = title;
        messageEl.textContent = message;
        cancelBtn.style.display = 'none';
        confirmBtn.textContent = confirmText;

        iconWrapper.className = `dialog-icon-wrapper ${type}`;
        confirmBtn.className = `btn btn-${type === 'info' ? 'primary' : type}`;

        let iconClass = 'fas fa-circle-info';
        if (icon) {
          iconClass = `fas ${icon}`;
        } else if (type === 'success') {
          iconClass = 'fas fa-circle-check';
        } else if (type === 'danger') {
          iconClass = 'fas fa-triangle-exclamation';
        }
        iconEl.className = iconClass;

        confirmBtn.onclick = () => {
          closeModal('custom-dialog-modal');
          if (dialogResolve) {
            dialogResolve(true);
            dialogResolve = null;
          }
        };

        openModal('custom-dialog-modal');
      });
    }

    // Intercept native alert calls as fallback
    window.alert = function(msg) {
      showCustomAlert({ title: 'Pemberitahuan', message: String(msg) });
    };

    // Toast Notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: var(--color-success); font-size: 16px;"></i>';
      if (type === 'error') icon = '<i class="fas fa-circle-exclamation" style="color: var(--color-danger); font-size: 16px;"></i>';
      if (type === 'info') icon = '<i class="fas fa-circle-info" style="color: var(--text-primary); font-size: 16px;"></i>';

      toast.innerHTML = `${icon}<span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // State & Auth
    const token = localStorage.getItem('skillsphere_access_token');
    if (!token) {
      window.location.href = '/login';
    }

    let allApplications = [];
    let currentAppFilter = 'all';
    let allCertifications = [];
    let currentCertFilter = 'all';
    let pendingRejectId = null;

    // User Management State
    let allUsers = [];
    let currentUserRoleFilter = 'all';
    let currentUserStatusFilter = 'all';
    let currentUserSearchQuery = '';
    let currentUserPage = 0;
    const USERS_PER_PAGE = 15;
    let userSearchTimeout = null;
    let currentAdminUserId = null;

    document.addEventListener('DOMContentLoaded', () => {
      fetchAdminProfile();
      fetchAdminStats();
      fetchApplications();
      fetchCertifications();
      fetchPlatformCourses();
      fetchFinancialData();
      fetchAdminUsers();
      setupLogout();
    });

    // Switch Admin View Tabs
    function switchAdminView(viewName, subTab = null) {
      toggleMobileSidebar(false);

      document.querySelectorAll('.sidebar-nav-item').forEach(item => {
        item.classList.toggle('active', item.getAttribute('data-view') === viewName);
      });

      document.querySelectorAll('.dashboard-view-section').forEach(sec => {
        sec.classList.toggle('active', sec.id === `view-${viewName}`);
      });

      const breadcrumbMap = {
        overview: 'Ringkasan Platform',
        verification: 'Verifikasi & Sertifikasi',
        users: 'Manajemen Pengguna',
        courses: 'Data Kursus & Materi',
        financial: 'Bagi Hasil & Finansial',
      };
      document.getElementById('current-view-breadcrumb').textContent = breadcrumbMap[viewName] || 'Admin Panel';

      if (viewName === 'verification' && subTab) {
        switchVerificationSubTab(subTab);
      }

      if (viewName === 'users') {
        fetchAdminUsers();
      }

      if (viewName === 'financial') {
        fetchFinancialData();
      }

      if (viewName === 'courses') {
        fetchPlatformCourses();
      }
    }

    // Switch Verification Sub-tabs (Applications vs Certifications)
    function switchVerificationSubTab(subTabName) {
      const btnApps = document.getElementById('subtab-btn-applications');
      const btnCerts = document.getElementById('subtab-btn-certifications');
      const panelApps = document.getElementById('subpanel-applications');
      const panelCerts = document.getElementById('subpanel-certifications');

      if (subTabName === 'certifications') {
        if (btnApps) btnApps.classList.remove('active');
        if (btnCerts) btnCerts.classList.add('active');
        if (panelApps) panelApps.style.display = 'none';
        if (panelCerts) panelCerts.style.display = 'block';
      } else {
        if (btnApps) btnApps.classList.add('active');
        if (btnCerts) btnCerts.classList.remove('active');
        if (panelApps) panelApps.style.display = 'block';
        if (panelCerts) panelCerts.style.display = 'none';
      }
    }

    // Fetch Admin Profile
    async function fetchAdminProfile() {
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const user = json.data;
          if (user.role !== 'admin') {
            await showCustomAlert({
              title: 'Akses Ditolak',
              message: 'Halaman ini khusus untuk administrator platform. Anda akan dialihkan ke dashboard.',
              type: 'danger',
              icon: 'fa-shield-halved'
            });
            window.location.href = '/dashboard';
            return;
          }
          currentAdminUserId = user.id;
          const name = user.name || 'Admin SkillSphere';
          const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'AS';
          
          const headerUserName = document.getElementById('header-user-name');
          if (headerUserName) headerUserName.textContent = name;
          
          const headerAvatar = document.getElementById('header-avatar');
          if (headerAvatar) headerAvatar.textContent = initials;

          const sidebarName = document.getElementById('sidebar-user-name');
          if (sidebarName) sidebarName.textContent = name;

          const sidebarAvatar = document.getElementById('sidebar-avatar');
          if (sidebarAvatar) sidebarAvatar.textContent = initials;
        }
      } catch (e) {
        console.error('Error fetching admin profile:', e);
      }
    }

    function setupLogout() {
      const performLogout = async () => {
        const confirmed = await showCustomConfirm({
          title: 'Konfirmasi Keluar',
          message: 'Apakah Anda yakin ingin keluar dari sesi Administrator SkillSphere?',
          confirmText: 'Ya, Keluar',
          cancelText: 'Batal',
          type: 'danger',
          icon: 'fa-arrow-right-from-bracket'
        });
        if (!confirmed) return;

        try {
          await fetch('/api/auth/logout', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + token }
          });
        } catch (_) {}
        localStorage.removeItem('skillsphere_access_token');
        localStorage.removeItem('skillsphere_refresh_token');
        window.location.href = '/login';
      };

      const sidebarBtn = document.getElementById('sidebar-logout-btn');
      if (sidebarBtn) {
        sidebarBtn.addEventListener('click', performLogout);
      }

      const headerBtn = document.getElementById('header-logout-btn');
      if (headerBtn) {
        headerBtn.addEventListener('click', performLogout);
      }
    }

    // Fetch Admin Stats
    async function fetchAdminStats() {
      try {
        const res = await fetch('/api/admin/stats', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const stats = json.data;
          const pendingApps = stats.applications ? stats.applications.pending : 0;
          const pendingCerts = stats.certifications ? stats.certifications.pending : 0;
          const totalTutors = stats.system ? stats.system.totalTutors : 0;
          const totalStudents = stats.system ? stats.system.totalStudents : 0;
          const totalCourses = stats.system ? stats.system.totalCourses : 0;

          const badgeSidebar = document.getElementById('badge-pending-verification-total');
          if (badgeSidebar) badgeSidebar.textContent = pendingApps + pendingCerts;

          const subtabBadgeApps = document.getElementById('subtab-badge-apps');
          if (subtabBadgeApps) subtabBadgeApps.textContent = pendingApps;

          const subtabBadgeCerts = document.getElementById('subtab-badge-certs');
          if (subtabBadgeCerts) subtabBadgeCerts.textContent = pendingCerts;

          const statPendingTotal = document.getElementById('stat-pending-total');
          if (statPendingTotal) statPendingTotal.textContent = pendingApps + pendingCerts;

          const statTotalTutors = document.getElementById('stat-total-tutors');
          if (statTotalTutors) statTotalTutors.textContent = totalTutors;

          const statTotalStudents = document.getElementById('stat-total-students');
          if (statTotalStudents) statTotalStudents.textContent = totalStudents;

          const statTotalCourses = document.getElementById('stat-total-courses');
          if (statTotalCourses) statTotalCourses.textContent = totalCourses;
        }
      } catch (e) {
        console.error('Error fetching stats:', e);
      }
    }

    // Fetch Tutor Applications
    async function fetchApplications() {
      try {
        const res = await fetch('/api/admin/tutor-applications?status=all', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          if (Array.isArray(json.data)) {
            allApplications = json.data;
          } else if (Array.isArray(json.data.applications)) {
            allApplications = json.data.applications;
          } else {
            allApplications = [];
          }
          renderApplicationsTable();
        }
      } catch (e) {
        console.error('Error fetching applications:', e);
      }
    }

    function filterApplications(status, btn) {
      currentAppFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderApplicationsTable();
    }

    function renderApplicationsTable() {
      const tbody = document.getElementById('applications-table-body');
      if (!tbody) return;

      let filtered = allApplications;
      if (currentAppFilter !== 'all') {
        filtered = allApplications.filter(a => a.status === currentAppFilter);
      }

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-secondary);">
              Tidak ada data pendaftaran pengajar dengan filter ini.
            </td>
          </tr>
