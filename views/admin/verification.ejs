        </section>

      </main>
    </div>

    <!-- Application Detail Modal -->
    <div class="modal-overlay" id="application-detail-modal">
      <div class="modal-card">
        <div class="modal-header">
          <h3 class="modal-title" id="modal-app-title">Detail Berkas Pendaftaran Tutor</h3>
          <button class="modal-close-btn" onclick="closeModal('application-detail-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div id="modal-app-content">
          <!-- Populated dynamically -->
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:24px; padding-top:16px; border-top:1px solid var(--border-subtle);" id="modal-app-actions">
          <button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>
        </div>
      </div>
    </div>

    <!-- Reject Reason Input Modal -->
    <div class="modal-overlay" id="reject-reason-modal">
      <div class="modal-card" style="max-width: 480px;">
        <div class="modal-header">
          <h3 class="modal-title">Alasan Penolakan Pendaftaran</h3>
          <button class="modal-close-btn" onclick="closeModal('reject-reason-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div style="margin-bottom: 20px;">
          <label style="display:block; font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">Berikan Catatan untuk Pelamar *</label>
          <textarea id="reject-reason-input" class="input-field" rows="4" placeholder="Contoh: Berkas portofolio belum melampirkan bukti sertifikasi atau CV belum lengkap."></textarea>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px;">
          <button class="btn btn-outline" onclick="closeModal('reject-reason-modal')">Batal</button>
          <button class="btn btn-danger" id="btn-confirm-reject" onclick="confirmRejectApplication()">
            <i class="fas fa-ban"></i> Konfirmasi Tolak
          </button>
        </div>
      </div>
    </div>

    <!-- Certificate Preview Modal -->
    <div class="modal-overlay" id="cert-preview-modal">
      <div class="modal-card" style="max-width: 600px; text-align:center;">
        <div class="modal-header">
          <h3 class="modal-title" id="cert-preview-title">Pratinjau Sertifikat Pengajar</h3>
          <button class="modal-close-btn" onclick="closeModal('cert-preview-modal')"><i class="fas fa-xmark"></i></button>
        </div>
        
        <div id="cert-preview-body" style="padding: 10px 0;">
          <img src="" id="cert-preview-img" style="max-width:100%; border-radius:var(--radius-lg); border:1px solid var(--border-subtle); display:none;" alt="Sertifikat">
          <div id="cert-preview-fallback" style="padding:30px; background:var(--bg-surface-subtle); border-radius:var(--radius-lg); font-size:13px; color:var(--text-secondary);">
            Tidak ada file gambar langsung.
          </div>
        </div>

        <div style="margin-top:16px;">
          <button class="btn btn-outline" onclick="closeModal('cert-preview-modal')">Tutup</button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container" id="toast-container"></div>
  </div>

  <script>
    // Theme Switcher & Synchronization
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }
    updateThemeUI(document.documentElement.getAttribute('data-theme') || 'light');

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // Mobile Sidebar Drawer Toggle
    function toggleMobileSidebar(open) {
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (open) {
        sidebar.classList.add('mobile-open');
        backdrop.classList.add('active');
      } else {
        sidebar.classList.remove('mobile-open');
        backdrop.classList.remove('active');
      }
    }

    // Modal Helpers
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // Toast Notification
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast';
      
      let icon = '<i class="fas fa-circle-check" style="color: var(--color-success); font-size: 16px;"></i>';
      if (type === 'error') icon = '<i class="fas fa-circle-exclamation" style="color: var(--color-danger); font-size: 16px;"></i>';
      if (type === 'info') icon = '<i class="fas fa-circle-info" style="color: var(--text-primary); font-size: 16px;"></i>';

      toast.innerHTML = `${icon}<span>${message}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(50px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // State & Auth
    const token = localStorage.getItem('skillsphere_access_token');
    if (!token) {
      window.location.href = '/login';
    }

    let allApplications = [];
    let currentAppFilter = 'all';
    let allCertifications = [];
    let currentCertFilter = 'all';
    let pendingRejectId = null;

    document.addEventListener('DOMContentLoaded', () => {
      fetchAdminProfile();
      fetchAdminStats();
      fetchApplications();
      fetchCertifications();
      fetchPlatformCourses();
      setupLogout();
    });

    // Switch Admin View Tabs
    function switchAdminView(viewName) {
      toggleMobileSidebar(false);

      document.querySelectorAll('.sidebar-nav-item').forEach(item => {
        item.classList.toggle('active', item.getAttribute('data-view') === viewName);
      });

      document.querySelectorAll('.dashboard-view-section').forEach(sec => {
        sec.classList.toggle('active', sec.id === `view-${viewName}`);
      });

      const breadcrumbMap = {
        overview: 'Ringkasan Platform',
        verification: 'Verifikasi Pengajar',
        certifications: 'Validasi Sertifikat',
        courses: 'Data Kursus & Materi',
        financial: 'Bagi Hasil & Finansial',
      };
      document.getElementById('current-view-breadcrumb').textContent = breadcrumbMap[viewName] || 'Admin Panel';
    }

    // Fetch Admin Profile
    async function fetchAdminProfile() {
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const user = json.data;
          if (user.role !== 'admin') {
            alert('Akses khusus administrator. Mengalihkan ke dashboard...');
            window.location.href = '/dashboard';
            return;
          }
          document.getElementById('sidebar-user-name').textContent = user.name || user.email;
          document.getElementById('sidebar-avatar').textContent = (user.name || 'A')[0].toUpperCase();
        }
      } catch (e) {
        console.error('Error fetching admin profile:', e);
      }
    }

    function setupLogout() {
      const btn = document.getElementById('sidebar-logout-btn');
      if (btn) {
        btn.addEventListener('click', async () => {
          try {
            await fetch('/api/auth/logout', {
              method: 'POST',
              headers: { 'Authorization': 'Bearer ' + token }
            });
          } catch (_) {}
          localStorage.removeItem('skillsphere_access_token');
          localStorage.removeItem('skillsphere_refresh_token');
          window.location.href = '/login';
        });
      }
    }

    // Fetch Admin Stats
    async function fetchAdminStats() {
      try {
        const res = await fetch('/api/admin/stats', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const stats = json.data;
          const pendingApps = stats.applications ? stats.applications.pending : 0;
          const pendingCerts = stats.certifications ? stats.certifications.pending : 0;
          const totalTutors = stats.system ? stats.system.totalTutors : 0;
          const totalStudents = stats.system ? stats.system.totalStudents : 0;
          const totalCourses = stats.system ? stats.system.totalCourses : 0;

          document.getElementById('badge-pending-tutors').textContent = pendingApps;
          document.getElementById('badge-pending-certs').textContent = pendingCerts;
          document.getElementById('stat-pending-total').textContent = pendingApps + pendingCerts;
          document.getElementById('stat-total-tutors').textContent = totalTutors;
          document.getElementById('stat-total-students').textContent = totalStudents;
          document.getElementById('stat-total-courses').textContent = totalCourses;
        }
      } catch (e) {
        console.error('Error fetching stats:', e);
      }
    }

    // Fetch Tutor Applications
    async function fetchApplications() {
      try {
        const res = await fetch('/api/admin/tutor-applications?status=all', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success) {
          allApplications = json.data || [];
          renderApplicationsTable();
        }
      } catch (e) {
        console.error('Error fetching applications:', e);
      }
    }

    function filterApplications(status, btn) {
      currentAppFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderApplicationsTable();
    }

    function renderApplicationsTable() {
      const tbody = document.getElementById('applications-table-body');
      let filtered = allApplications;
      if (currentAppFilter !== 'all') {
        filtered = allApplications.filter(a => a.status === currentAppFilter);
      }

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-tertiary);">
              Tidak ada data pendaftaran pengajar dengan filter ini.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(app => {
        let statusBadge = '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Pending</span>';
        if (app.status === 'approved') statusBadge = '<span class="status-pill status-active"><i class="fas fa-check"></i> Disetujui</span>';
        if (app.status === 'rejected') statusBadge = '<span class="status-pill status-rejected"><i class="fas fa-xmark"></i> Ditolak</span>';

        const applicantName = app.applicant ? app.applicant.name : 'Pelamar';
        const applicantEmail = app.applicant ? app.applicant.email : '-';
        const dateStr = new Date(app.createdAt || Date.now()).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });

        return `
          <tr>
            <td>
              <div style="font-weight:600; color:var(--text-primary);">${escapeHtml(applicantName)}</div>
              <div style="font-size:12px; color:var(--text-secondary);">${escapeHtml(applicantEmail)}</div>
            </td>
            <td><strong>${escapeHtml(app.expertise_field || '-')}</strong></td>
            <td>${app.years_of_experience || 0} Tahun</td>
            <td>
              ${app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="link" style="font-size:12px; font-weight:600; margin-right:8px;"><i class="fas fa-link"></i> Portofolio</a>` : ''}
              ${app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="link" style="font-size:12px; font-weight:600;"><i class="fas fa-file-pdf"></i> CV</a>` : ''}
            </td>
            <td>${dateStr}</td>
            <td>${statusBadge}</td>
            <td>
              <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <button class="btn btn-outline" style="padding:4px 10px; font-size:12px;" onclick="viewApplicationDetail(${app.id})">
                  <i class="fas fa-eye"></i> Review
                </button>
                ${app.status === 'pending' ? `
                  <button class="btn btn-primary" style="padding:4px 10px; font-size:12px;" onclick="approveApplication(${app.id}, '${escapeHtml(applicantName)}')">
                    <i class="fas fa-check"></i> Setujui
                  </button>
                  <button class="logout-btn" style="padding:4px 10px; font-size:12px;" onclick="openRejectModal(${app.id})">
                    <i class="fas fa-ban"></i> Tolak
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // View Application Detail
    function viewApplicationDetail(id) {
      const app = allApplications.find(a => a.id === id);
      if (!app) return;

      const applicantName = app.applicant ? app.applicant.name : 'Pelamar';
      document.getElementById('modal-app-title').textContent = `Review Pendaftaran: ${applicantName}`;

      document.getElementById('modal-app-content').innerHTML = `
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:18px;">
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
            <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Bidang Keahlian</div>
            <div style="font-size:14px; font-weight:600; color:var(--text-primary); margin-top:4px;">${escapeHtml(app.expertise_field || '-')}</div>
          </div>
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
            <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Pengalaman Mengajar</div>
            <div style="font-size:14px; font-weight:600; color:var(--text-primary); margin-top:4px;">${app.years_of_experience || 0} Tahun</div>
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label style="font-size:12px; font-weight:700; color:var(--text-secondary); text-transform:uppercase;">Surat Motivasi & Pengalaman</label>
          <div style="background:var(--bg-surface-subtle); padding:14px; border-radius:var(--radius-md); border:1px solid var(--border-subtle); font-size:13px; line-height:1.6; color:var(--text-primary); margin-top:6px; white-space:pre-line;">
            ${escapeHtml(app.motivation_letter || 'Tidak ada surat motivasi.')}
          </div>
        </div>

        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          ${app.portfolio_url ? `<a href="${app.portfolio_url}" target="_blank" class="btn btn-outline" style="font-size:12px;"><i class="fas fa-arrow-up-right-from-square"></i> Buka Tautan Portofolio</a>` : ''}
          ${app.cv_url ? `<a href="${app.cv_url}" target="_blank" class="btn btn-outline" style="font-size:12px;"><i class="fas fa-file-pdf"></i> Unduh / Buka Berkas CV</a>` : ''}
        </div>
      `;

      const actionsContainer = document.getElementById('modal-app-actions');
      if (app.status === 'pending') {
        actionsContainer.innerHTML = `
          <button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>
          <button class="logout-btn" onclick="closeModal('application-detail-modal'); openRejectModal(${app.id})">Tolak</button>
          <button class="btn btn-primary" onclick="closeModal('application-detail-modal'); approveApplication(${app.id}, '${escapeHtml(applicantName)}')">
            <i class="fas fa-check"></i> Setujui Jadi Tutor
          </button>
        `;
      } else {
        actionsContainer.innerHTML = `<button class="btn btn-outline" onclick="closeModal('application-detail-modal')">Tutup</button>`;
      }

      openModal('application-detail-modal');
    }

    // Approve Application
    async function approveApplication(id, name) {
      if (!confirm(`Setujui pendaftaran "${name}"? Peran akun akan di-upgrade menjadi Tutor dan Dompet Virtual diaktifkan.`)) return;

      try {
        const res = await fetch(`/api/admin/tutor-applications/${id}/approve`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(`Pendaftaran "${name}" berhasil disetujui!`, 'success');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menyetujui pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat menyetujui pendaftaran.', 'error');
      }
    }

    // Reject Application Modal
    function openRejectModal(id) {
      pendingRejectId = id;
      document.getElementById('reject-reason-input').value = '';
      openModal('reject-reason-modal');
    }

    async function confirmRejectApplication() {
      if (!pendingRejectId) return;
      const reason = document.getElementById('reject-reason-input').value.trim();
      if (!reason) {
        showToast('Alasan penolakan wajib diisi.', 'error');
        return;
      }

      try {
        const res = await fetch(`/api/admin/tutor-applications/${pendingRejectId}/reject`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ rejection_reason: reason }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast('Pendaftaran tutor berhasil ditolak.', 'info');
          closeModal('reject-reason-modal');
          fetchApplications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal menolak pendaftaran.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses penolakan.', 'error');
      }
    }

    // Fetch Tutor Certifications
    async function fetchCertifications() {
      try {
        const res = await fetch('/api/admin/tutor-certifications', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success) {
          allCertifications = json.data || [];
          renderCertificationsTable();
        }
      } catch (e) {
        console.error('Error fetching certifications:', e);
      }
    }

    function filterCerts(status, btn) {
      currentCertFilter = status;
      btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderCertificationsTable();
    }

    function renderCertificationsTable() {
      const tbody = document.getElementById('certifications-table-body');
      let filtered = allCertifications;
      if (currentCertFilter === 'verified') filtered = allCertifications.filter(c => c.is_verified);
      if (currentCertFilter === 'pending') filtered = allCertifications.filter(c => !c.is_verified);

      if (!filtered.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding:32px; color:var(--text-tertiary);">
              Tidak ada data sertifikasi pengajar dengan filter ini.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(cert => {
        const tutorName = cert.tutor ? cert.tutor.name : 'Tutor';
        const isVerified = cert.is_verified;
        const statusBadge = isVerified 
          ? '<span class="status-pill status-active"><i class="fas fa-circle-check"></i> Terverifikasi Resmi</span>'
          : '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Belum Divalidasi</span>';

        return `
          <tr>
            <td><strong>${escapeHtml(tutorName)}</strong></td>
            <td>${escapeHtml(cert.title)}</td>
            <td><span class="user-role-tag">${escapeHtml(cert.issuer_organization || '-')}</span></td>
            <td><code>${escapeHtml(cert.credential_id || '-')}</code></td>
            <td>
              ${cert.certificate_file_url ? `
                <button class="btn btn-outline" style="padding:4px 10px; font-size:12px;" onclick="previewCertificateImage('${cert.certificate_file_url}', '${escapeHtml(cert.title)}')">
                  <i class="fas fa-image"></i> Lihat Berkas
                </button>
              ` : '<span style="color:var(--text-tertiary); font-size:12px;">Tidak ada berkas</span>'}
            </td>
            <td>${statusBadge}</td>
            <td>
              ${!isVerified ? `
                <button class="btn btn-primary" style="padding:4px 10px; font-size:12px;" onclick="verifyCertificate(${cert.id}, true)">
                  <i class="fas fa-check-double"></i> Validasi
                </button>
              ` : `
                <button class="logout-btn" style="padding:4px 10px; font-size:12px;" onclick="verifyCertificate(${cert.id}, false)">
                  <i class="fas fa-rotate-left"></i> Batalkan
                </button>
              `}
            </td>
          </tr>
        `;
      }).join('');
    }

    function previewCertificateImage(url, title) {
      document.getElementById('cert-preview-title').textContent = title;
      const img = document.getElementById('cert-preview-img');
      const fallback = document.getElementById('cert-preview-fallback');
      if (url) {
        img.src = url;
        img.style.display = 'inline-block';
        fallback.style.display = 'none';
      } else {
        img.style.display = 'none';
        fallback.style.display = 'block';
      }
      openModal('cert-preview-modal');
    }

    async function verifyCertificate(id, shouldVerify) {
      const action = shouldVerify ? 'verify' : 'unverify';
      const promptText = shouldVerify ? 'Verifikasi dan tandai sertifikat ini sebagai Resmi?' : 'Batalkan status verifikasi resmi sertifikat ini?';
      if (!confirm(promptText)) return;

      try {
        const res = await fetch(`/api/admin/tutor-certifications/${id}/${action}`, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
        });
        const json = await res.json();
        if (res.ok && json.success) {
          showToast(json.message, 'success');
          fetchCertifications();
          fetchAdminStats();
        } else {
          showToast(json.message || 'Gagal mengubah status sertifikat.', 'error');
        }
      } catch (e) {
        showToast('Kesalahan jaringan saat memproses sertifikat.', 'error');
      }
    }

    // Fetch Platform Courses for Overview
    async function fetchPlatformCourses() {
      try {
        const res = await fetch('/api/courses?limit=20');
        const json = await res.json();
        const tbody = document.getElementById('admin-courses-table-body');
        const courses = (json.data && json.data.courses) ? json.data.courses : [];

        if (!courses.length) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:32px; color:var(--text-tertiary);">Belum ada kursus yang terdaftar di platform.</td></tr>`;
          return;
        }

        tbody.innerHTML = courses.map(c => `
          <tr>
            <td><strong>${escapeHtml(c.title)}</strong></td>
            <td>${c.tutor ? escapeHtml(c.tutor.name) : '-'}</td>
            <td><span class="user-role-tag">${c.category ? escapeHtml(c.category.name) : 'Umum'}</span></td>
            <td>Rp ${(c.price || 0).toLocaleString('id-ID')}</td>
            <td><span class="status-pill status-locked">${(c.level || 'beginner').toUpperCase()}</span></td>
            <td><span class="status-pill status-active">${(c.status || 'published').toUpperCase()}</span></td>
          </tr>
        `).join('');
      } catch (e) {
        console.error('Error fetching courses overview:', e);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
</html>
