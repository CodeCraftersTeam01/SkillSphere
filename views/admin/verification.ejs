        <!-- VIEW 5: FINANCIAL & SPLIT REVENUE 20%/80% -->
        <section class="dashboard-view-section" id="view-financial">
          <div class="welcome-hero" style="margin-bottom:20px;">
            <h2 class="welcome-title" style="font-size:26px;">Model Finansial & Revenue Sharing 20% / 80%</h2>
            <p class="welcome-desc">
              Sistem revenue sharing SkillSphere AI membagi 20% biaya platform (infrastruktur server, AI Gemini API, operasional) dan 80% pendapatan bersih diberikan kepada Tutor dengan batas minimum penarikan Rp 100.000 dan masa holding 7 hari.
            </p>
          </div>

          <div class="metrics-grid">
            <div class="stat-card">
              <div class="stat-label">
                <span>Fee Platform</span>
                <span style="color:var(--text-primary); font-weight:700;">20%</span>
              </div>
              <div class="stat-value">Operasional & AI</div>
              <div class="stat-meta">Infrastruktur Server & LLM Token</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">
                <span>Bagi Hasil Tutor</span>
                <span style="color:var(--color-success); font-weight:700;">80%</span>
              </div>
              <div class="stat-value">Pendapatan Bersih</div>
              <div class="stat-meta">Masuk Otomatis ke Virtual Wallet</div>
            </div>

            <div class="stat-card">
              <div class="stat-label">
                <span>Holding Period</span>
