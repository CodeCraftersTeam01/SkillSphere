<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isValid ? ('Verifikasi Sertifikat: ' + certificate.certificate_code) : 'Sertifikat Tidak Valid' %> | SkillSphere AI</title>
  
  <!-- Immediate Theme Application to prevent FOUC -->
  <script>
    (function() {
      try {
        const saved = localStorage.getItem('skillsphere_theme') || localStorage.getItem('theme');
        const pref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const active = saved || pref;
        document.documentElement.setAttribute('data-theme', active);
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Newsreader, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Core Claude & Accessibility Stylesheets -->
  <link rel="stylesheet" href="/css/claude-theme.css">
  <link rel="stylesheet" href="/css/accessibility.css">
  
  <style>
    :root {
      --bg-app: #FBF9F5;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F3EFE6;
      --border-subtle: #E8E5DD;
      --border-accent: #C8A86B;
      --text-primary: #1F1E1D;
      --text-secondary: #6B665F;
      --text-muted: #8F8A81;
      --accent-primary: #1F1E1D;
      --accent-contrast: #FFFFFF;
      --success-green: #10B981;
      --success-bg: #ECFDF5;
      --danger-red: #EF4444;
      --danger-bg: #FEF2F2;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
    }

    [data-theme="dark"] {
      --bg-app: #141413;
      --bg-surface: #1F1E1B;
      --bg-subtle: #2A2926;
      --border-subtle: #33312B;
      --border-accent: #C8A86B;
      --text-primary: #FAF9F5;
      --text-secondary: #B5B2A8;
      --text-muted: #7A776E;
      --accent-primary: #FAF9F5;
      --accent-contrast: #141413;
      --success-bg: rgba(16, 185, 129, 0.15);
      --danger-bg: rgba(239, 68, 68, 0.15);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .header-bar {
      border-bottom: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.5px;
    }

    .brand-sparkle {
      color: var(--border-accent);
      font-size: 1.3rem;
    }

    .brand-tag {
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .theme-toggle-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .theme-toggle-btn:hover {
      background: var(--bg-subtle);
      border-color: var(--text-secondary);
    }

    .container {
      max-width: 760px;
      width: 100%;
      margin: 40px auto;
      padding: 0 20px;
      flex: 1;
    }

    .cert-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 40px 36px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
      position: relative;
      overflow: hidden;
      animation: fadeIn 0.3s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .cert-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #C8A86B, var(--border-subtle), #C8A86B);
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .badge-valid {
      background: var(--success-bg);
      color: var(--success-green);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .badge-invalid {
      background: var(--danger-bg);
      color: var(--danger-red);
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .cert-title {
      font-family: 'Newsreader', serif;
      font-size: 2.2rem;
      line-height: 1.2;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--text-primary);
    }

    .cert-subtitle {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 32px;
      padding: 24px;
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
    }

    @media (max-width: 640px) {
      .info-grid {
        grid-template-columns: 1fr;
        padding: 16px;
        gap: 16px;
      }
      .cert-card {
        padding: 26px 20px;
      }
      .cert-title {
        font-size: 1.75rem;
      }
    }

    .info-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .info-value {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-primary);
      word-break: break-word;
    }

    .info-value.serif {
      font-family: 'Newsreader', serif;
      font-size: 1.35rem;
    }

    .code-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      display: inline-block;
      color: var(--text-primary);
    }

    .action-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      cursor: pointer;
      min-height: 44px;
      transition: all 0.15s ease-in-out;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: var(--accent-contrast);
      border: 1px solid var(--accent-primary);
    }

    .btn-primary:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-subtle);
      border-color: var(--text-secondary);
    }

    .endorsement-box {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .endorsement-text {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .endorsement-author {
      font-weight: 600;
      color: var(--text-primary);
      margin-top: 2px;
    }

    .footer {
      border-top: 1px solid var(--border-subtle);
      padding: 24px 20px;
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.82rem;
      margin-top: auto;
    }
  </style>
</head>
<body>

  <!-- Top Header Navigation -->
  <header class="header-bar" role="banner">
    <a href="/" class="brand-logo" aria-label="Beranda SkillSphere AI">
      <span class="brand-sparkle" aria-hidden="true">✦</span>
      <span>SkillSphere AI</span>
      <span class="brand-tag">Registry</span>
    </a>
    
    <div class="header-actions">
      <button id="themeToggle" class="theme-toggle-btn" type="button" aria-label="Ganti Tema">
        <svg id="themeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
      <a href="/catalog" class="btn btn-outline" style="min-height: 40px; padding: 6px 14px; font-size: 0.84rem;">
        Katalog Kursus
      </a>
    </div>
  </header>

  <main class="container" role="main">
    <div class="cert-card">

      <% if (isValid && certificate) { %>
        <!-- Status Badge: Valid -->
        <div class="badge-status badge-valid" role="status">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Sertifikat Asli & Terverifikasi Resmi
        </div>

        <h1 class="cert-title">Sertifikat Kelulusan Resmi</h1>
        <p class="cert-subtitle">Dokumen kompetensi akademik dan teknis terdaftar resmi pada basis data SkillSphere AI.</p>

        <!-- Information Grid -->
        <div class="info-grid">
          <div>
            <div class="info-label">Nama Penerima</div>
            <div class="info-value serif"><%= certificate.student_name %></div>
          </div>

          <div>
            <div class="info-label">Nomor Sertifikat</div>
            <div class="code-pill"><%= certificate.certificate_code %></div>
          </div>

          <div>
            <div class="info-label">Kursus yang Diselesaikan</div>
            <div class="info-value"><%= certificate.course_title %></div>
          </div>

          <div>
            <div class="info-label">Instruktur Utama</div>
            <div class="info-value"><%= certificate.tutor_name %></div>
          </div>

          <div>
            <div class="info-label">Nilai Kelulusan Ujian</div>
            <div class="info-value" style="color: var(--success-green);"><%= certificate.score %>% (Lulus)</div>
          </div>

          <div>
            <div class="info-label">Tanggal Penerbitan</div>
            <div class="info-value"><%= certificate.formatted_date %></div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-group">
          <a href="/api/certificates/<%= certificate.certificate_code %>/pdf" target="_blank" class="btn btn-primary" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Unduh Salinan PDF Resmi
          </a>

          <% if (certificate.course_slug) { %>
            <a href="/courses/<%= certificate.course_slug %>" class="btn btn-outline">
              Lihat Silabus Kursus
            </a>
          <% } %>
        </div>

        <!-- Endorsement Validation -->
        <div class="endorsement-box">
          <div class="endorsement-text">
            Otoritas Pengesahan Platform:
            <div class="endorsement-author">Arjuna Lanang, S.Kom., M.T. (PM & Lead Backend)</div>
          </div>
          <div class="code-pill" style="font-size: 0.75rem;">
            VALIDATED: ED25519-SIG-SHA256
          </div>
        </div>

      <% } else { %>
        <!-- Status Badge: Invalid -->
        <div class="badge-status badge-invalid" role="status">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          Sertifikat Tidak Ditemukan atau Tidak Valid
        </div>

        <h1 class="cert-title">Verifikasi Kredensial Gagal</h1>
        <p class="cert-subtitle">
          Kode sertifikat <span class="code-pill"><%= queryCode || 'N/A' %></span> tidak ditemukan dalam pangkalan data resmi SkillSphere AI.
          Pastikan tautan atau kode yang Anda pindai sudah benar.
        </p>

        <div class="action-group">
          <a href="/catalog" class="btn btn-primary">
            Jelajahi Katalog Kursus
          </a>
          <a href="/" class="btn btn-outline">
            Kembali ke Beranda
          </a>
        </div>
      <% } %>

    </div>
  </main>

  <footer class="footer" role="contentinfo">
    SkillSphere AI Platform. Sistem Verifikasi Kredensial dan Sertifikasi Adaptif.
  </footer>

  <script>
    // Theme toggle handler
    const themeBtn = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');

    function updateThemeIcon(isDark) {
      if (!themeIcon) return;
      if (isDark) {
        themeIcon.innerHTML = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
      } else {
        themeIcon.innerHTML = '<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeIcon(currentTheme === 'dark');

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const active = document.documentElement.getAttribute('data-theme') || 'light';
        const next = active === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('skillsphere_theme', next);
        localStorage.setItem('theme', next);
        updateThemeIcon(next === 'dark');
      });
    }
  </script>

</body>
</html>
