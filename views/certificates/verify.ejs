<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isValid ? ('Verifikasi Sertifikat: ' + certificate.certificate_code) : 'Sertifikat Tidak Valid' %> | SkillSphere AI</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-warm: #FAF9F5;
      --surface: #FFFFFF;
      --border-subtle: #E5E4DE;
      --border-accent: #C8A86B;
      --text-main: #141413;
      --text-muted: #6B6960;
      --success-green: #10B981;
      --success-bg: #ECFDF5;
      --danger-red: #EF4444;
      --danger-bg: #FEF2F2;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-warm: #141413;
        --surface: #1F1E1B;
        --border-subtle: #2A2926;
        --border-accent: #C8A86B;
        --text-main: #FAF9F5;
        --text-muted: #A3A196;
        --success-bg: #064E3B;
        --danger-bg: #7F1D1D;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-warm);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .header-bar {
      border-bottom: 1px solid var(--border-subtle);
      background: var(--surface);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.5px;
    }

    .brand-sparkle {
      color: var(--border-accent);
      font-size: 1.3rem;
    }

    .brand-tag {
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--border-subtle);
      color: var(--text-muted);
      font-weight: 600;
    }

    .container {
      max-width: 760px;
      width: 100%;
      margin: 40px auto;
      padding: 0 20px;
      flex: 1;
    }

    .cert-card {
      background: var(--surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 36px 32px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      position: relative;
      overflow: hidden;
    }

    .cert-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #C8A86B, #E5E4DE, #C8A86B);
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .badge-valid {
      background: var(--success-bg);
      color: var(--success-green);
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .badge-invalid {
      background: var(--danger-bg);
      color: var(--danger-red);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .cert-title {
      font-family: 'Newsreader', serif;
      font-size: 2.1rem;
      line-height: 1.25;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .cert-subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 28px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 32px;
      padding: 20px;
      background: var(--bg-warm);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
    }

    @media (max-width: 600px) {
      .info-grid {
        grid-template-columns: 1fr;
        padding: 16px;
      }
      .cert-card {
        padding: 24px 20px;
      }
      .cert-title {
        font-size: 1.7rem;
      }
    }

    .info-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      font-weight: 600;
      margin-bottom: 4px;
    }

    .info-value {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-main);
      word-break: break-word;
    }

    .info-value.serif {
      font-family: 'Newsreader', serif;
      font-size: 1.25rem;
    }

    .code-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88rem;
      background: var(--surface);
      border: 1px solid var(--border-subtle);
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      display: inline-block;
    }

    .action-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      cursor: pointer;
      min-height: 44px;
      transition: all 0.15s ease-in-out;
    }

    .btn-primary {
      background: var(--text-main);
      color: var(--surface);
      border: 1px solid var(--text-main);
    }

    .btn-primary:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-warm);
    }

    .endorsement-box {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .endorsement-text {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .endorsement-author {
      font-weight: 600;
      color: var(--text-main);
    }

    .footer {
      border-top: 1px solid var(--border-subtle);
      padding: 24px 20px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.82rem;
      margin-top: auto;
    }
  </style>
</head>
<body>

  <!-- Top Header Navigation -->
  <header class="header-bar">
    <a href="/" class="brand-logo">
      <span class="brand-sparkle">✦</span>
      <span>SkillSphere AI</span>
      <span class="brand-tag">Registry</span>
    </a>
    <a href="/catalog" class="btn btn-outline" style="min-height: 36px; padding: 6px 14px; font-size: 0.82rem;">
      Katalog Kursus
    </a>
  </header>

  <main class="container">
    <div class="cert-card">

      <% if (isValid && certificate) { %>
        <!-- Status Badge: Valid -->
        <div class="badge-status badge-valid">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Sertifikat Asli & Terverifikasi Resmi
        </div>

        <h1 class="cert-title">Sertifikat Kelulusan Resmi</h1>
        <p class="cert-subtitle">Dokumen kompetensi akademik dan teknis terdaftar resmi pada basis data SkillSphere AI.</p>

        <!-- Information Grid -->
        <div class="info-grid">
          <div>
            <div class="info-label">Nama Penerima</div>
            <div class="info-value serif"><%= certificate.student_name %></div>
          </div>

          <div>
            <div class="info-label">Nomor Sertifikat</div>
            <div class="code-pill"><%= certificate.certificate_code %></div>
          </div>

          <div>
            <div class="info-label">Kursus yang Diselesaikan</div>
            <div class="info-value"><%= certificate.course_title %></div>
          </div>

          <div>
            <div class="info-label">Instruktur Utama</div>
            <div class="info-value"><%= certificate.tutor_name %></div>
          </div>

          <div>
            <div class="info-label">Nilai Kelulusan Ujian</div>
            <div class="info-value" style="color: var(--success-green);"><%= certificate.score %>% (Lulus)</div>
          </div>

          <div>
            <div class="info-label">Tanggal Penerbitan</div>
            <div class="info-value"><%= certificate.formatted_date %></div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-group">
          <a href="/api/certificates/<%= certificate.certificate_code %>/pdf" target="_blank" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Unduh Salinan PDF Resmi
          </a>

          <% if (certificate.course_slug) { %>
            <a href="/courses/<%= certificate.course_slug %>" class="btn btn-outline">
              Lihat Silabus Kursus
            </a>
          <% } %>
        </div>

        <!-- Endorsement Validation -->
        <div class="endorsement-box">
          <div class="endorsement-text">
            Otoritas Pengesahan Platform:
            <div class="endorsement-author">Arjuna Lanang, S.Kom., M.T. (PM & Lead Backend)</div>
          </div>
          <div class="code-pill" style="font-size: 0.75rem;">
            VALIDATED: ED25519-SIG-SHA256
          </div>
        </div>

      <% } else { %>
        <!-- Status Badge: Invalid -->
        <div class="badge-status badge-invalid">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          Sertifikat Tidak Ditemukan atau Tidak Valid
        </div>

        <h1 class="cert-title">Verifikasi Kredensial Gagal</h1>
        <p class="cert-subtitle">
          Kode sertifikat <span class="code-pill"><%= queryCode || 'N/A' %></span> tidak ditemukan dalam pangkalan data resmi SkillSphere AI.
          Pastikan tautan atau kode yang Anda pindai sudah benar.
        </p>

        <div class="action-group">
          <a href="/catalog" class="btn btn-primary">
            Jelajahi Katalog Kursus
          </a>
          <a href="/" class="btn btn-outline">
            Kembali ke Beranda
          </a>
        </div>
      <% } %>

    </div>
  </main>

  <footer class="footer">
    SkillSphere AI Platform. Sistem Verifikasi Kredensial dan Sertifikasi Adaptif.
  </footer>

</body>
</html>
