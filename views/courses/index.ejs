<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Katalog Kursus & Kurikulum | SkillSphere AI</title>
  <meta name="description" content="Jelajahi berbagai kursus pemrograman, AI, Cloud DevOps, dan teknologi terkini dengan kurikulum adaptif dan pengajar ahli terverifikasi.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">

  <style>
    .catalog-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    /* Navbar styling */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-main-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 20px;
    }

    .desktop-only {
      display: flex;
    }

    .mobile-only {
      display: none;
    }

    /* Hero Banner Area */
    .catalog-hero {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 48px 24px 40px;
      text-align: center;
    }

    .catalog-hero-inner {
      max-width: 820px;
      margin: 0 auto;
    }

    .catalog-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .catalog-hero-title {
      font-family: var(--font-serif);
      font-size: 38px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.2;
      margin-bottom: 14px;
    }

    .catalog-hero-desc {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 28px;
    }

    /* Search & Filter Bar */
    .search-filter-box {
      display: flex;
      max-width: 640px;
      margin: 0 auto;
      gap: 10px;
      position: relative;
    }

    .search-input-wrapper {
      position: relative;
      flex: 1;
    }

    .search-input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
      font-size: 14px;
    }

    .search-input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface-subtle);
      color: var(--text-primary);
      font-size: 14px;
      font-family: var(--font-sans);
      transition: all 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--accent-primary);
      background: var(--bg-surface);
      box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.05);
    }

    [data-theme="dark"] .search-input:focus {
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.08);
    }

    /* Category Chips Filter Bar */
    .categories-bar-wrapper {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 24px;
      position: sticky;
      top: 61px;
      z-index: 90;
    }

    .categories-scroll-list {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .categories-scroll-list::-webkit-scrollbar {
      display: none;
    }

    .category-chip {
      padding: 7px 16px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .category-chip:hover {
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .category-chip.active {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
      font-weight: 600;
    }

    /* Main Grid Area */
    .catalog-main-content {
      max-width: 1240px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 80px;
      flex: 1;
    }

    .catalog-controls-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .results-count-text {
      font-size: 14px;
      color: var(--text-secondary);
    }

    .filters-secondary-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .filter-select {
      padding: 6px 12px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      font-size: 13px;
      cursor: pointer;
    }

    .filter-select:focus {
      outline: none;
      border-color: var(--accent-primary);
    }

    /* Course Cards Grid */
    .courses-grid-layout {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    .course-card-premium {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
      text-decoration: none;
      color: inherit;
    }

    .course-card-premium:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-strong);
    }

    .course-card-thumbnail-wrap {
      width: 100%;
      height: 180px;
      position: relative;
      background: linear-gradient(135deg, #2D2B28 0%, #1A1918 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-text);
      overflow: hidden;
    }

    .course-card-thumbnail-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .course-card-premium:hover .course-card-thumbnail-img {
      transform: scale(1.04);
    }

    .course-category-pill {
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .course-level-pill {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
      color: #1F1E1D;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: var(--radius-full);
    }

    .course-card-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .course-card-title {
      font-family: var(--font-serif);
      font-size: 18px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.35;
      margin-bottom: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .course-card-desc {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin-bottom: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .course-instructor-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .instructor-avatar-xs {
      width: 24px;
      height: 24px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .instructor-name-text {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .verified-badge-icon {
      color: #3B82F6;
      font-size: 11px;
    }

    .course-card-footer {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .course-price-label {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .btn-view-course {
      padding: 7px 14px;
      border-radius: var(--radius-md);
      background: var(--accent-primary);
      color: var(--accent-text);
      font-size: 12px;
      font-weight: 600;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: opacity 0.15s ease;
    }

    .btn-view-course:hover {
      opacity: 0.88;
    }

    /* Empty state */
    .empty-state-box {
      grid-column: 1 / -1;
      text-align: center;
      padding: 60px 24px;
      background: var(--bg-surface);
      border: 1px dashed var(--border-subtle);
      border-radius: var(--radius-xl);
    }

    @media (max-width: 860px) {
      .navbar {
        padding: 10px 16px 8px;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
      }
      .desktop-only {
        display: none !important;
      }
      .mobile-only {
        display: block !important;
        width: 100%;
      }
      .nav-mobile-row {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .nav-mobile-row::-webkit-scrollbar {
        display: none;
      }
      .nav-links-menu.mobile-scroll {
        display: flex;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 2px 0;
        width: max-content;
      }
      .nav-links-menu.mobile-scroll .nav-link-item {
        font-size: 12px;
        padding: 6px 12px;
        white-space: nowrap;
        background: var(--bg-surface-subtle);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-full);
      }
      .nav-links-menu.mobile-scroll .nav-link-item.active {
        background: var(--accent-primary);
        color: var(--accent-text);
        border-color: var(--accent-primary);
      }
      .catalog-hero-title {
        font-size: 28px;
      }
      .catalog-main-content {
        padding: 20px 16px 60px;
      }
      .courses-grid-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="catalog-layout">
    <!-- Navbar -->
    <header class="navbar">
      <div class="nav-main-row">
        <a href="/dashboard" class="brand-logo" style="text-decoration:none;">
          <div class="brand-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span>SkillSphere AI</span>
        </a>

        <!-- Desktop Navigation -->
        <ul class="nav-links-menu desktop-only">
          <li><a href="/dashboard" class="nav-link-item">Beranda</a></li>
          <li><a href="/courses" class="nav-link-item active">Katalog Kursus</a></li>
          <li><a href="/dashboard/onboarding" class="nav-link-item">Jalur Belajar AI</a></li>
          <li><a href="/profile" class="nav-link-item">Profil Saya</a></li>
        </ul>

        <div class="nav-actions">
          <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode">
            <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
            <i class="fas fa-moon" id="theme-icon-moon"></i>
            <span id="theme-text">Mode Gelap</span>
          </button>

          <a href="/login" class="btn btn-outline" id="nav-auth-btn" style="font-size:12px; padding:6px 14px;">
            Masuk
          </a>
        </div>
      </div>

      <!-- Mobile Scrollable Nav -->
      <div class="nav-mobile-row mobile-only">
        <ul class="nav-links-menu mobile-scroll">
          <li><a href="/dashboard" class="nav-link-item">Beranda</a></li>
          <li><a href="/courses" class="nav-link-item active">Katalog Kursus</a></li>
          <li><a href="/dashboard/onboarding" class="nav-link-item">Jalur Belajar AI</a></li>
          <li><a href="/profile" class="nav-link-item">Profil Saya</a></li>
        </ul>
      </div>
    </header>

    <!-- Catalog Hero Section -->
    <section class="catalog-hero">
      <div class="catalog-hero-inner">
        <div class="catalog-hero-badge">
          <i class="fas fa-graduation-cap"></i> Eksplorasi Kurikulum Terstruktur
        </div>
        <h1 class="catalog-hero-title">Katalog Kursus Berbasis Industri & AI</h1>
        <p class="catalog-hero-desc">
          Tingkatkan kompetensi Anda dengan materi multi-format (Video, Modul PPT, PDF, dan Buku Digital) yang dirancang langsung oleh praktisi berpengalaman.
        </p>

        <!-- Search Input Form -->
        <div class="search-filter-box">
          <div class="search-input-wrapper">
            <i class="fas fa-magnifying-glass search-input-icon"></i>
            <input type="text" id="catalog-search" class="search-input" placeholder="Cari topik kursus, teknologi (React, Python, Docker)...">
          </div>
        </div>
      </div>
    </section>

    <!-- Categories Scrollbar Filter -->
    <nav class="categories-bar-wrapper">
      <div class="categories-scroll-list" id="categories-container">
        <button class="category-chip active" data-id="" onclick="selectCategory(this, '')">
          <i class="fas fa-border-all"></i> Semua Bidang
        </button>
        <!-- Categories dynamic insertion -->
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="catalog-main-content">
      
      <!-- Filter & Results Controls -->
      <div class="catalog-controls-row">
        <div class="results-count-text" id="results-count-label">
          Memuat daftar kursus...
        </div>

        <div class="filters-secondary-group">
          <!-- Level Filter -->
          <select id="filter-level" class="filter-select" onchange="handleFilterChange()">
            <option value="">Semua Tingkat</option>
            <option value="beginner">Pemula (Beginner)</option>
            <option value="intermediate">Menengah (Intermediate)</option>
            <option value="advanced">Mahir (Advanced)</option>
          </select>

          <!-- Price Filter -->
          <select id="filter-price" class="filter-select" onchange="handleFilterChange()">
            <option value="">Semua Harga</option>
            <option value="free">Gratis</option>
            <option value="paid">Berbayar</option>
          </select>
        </div>
      </div>

      <!-- Courses Grid -->
      <div class="courses-grid-layout" id="courses-grid">
        <div style="grid-column: 1 / -1; text-align: center; padding: 48px; color: var(--text-secondary); font-size: 14px;">
          <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Memuat katalog kursus...
        </div>
      </div>

    </main>
  </div>

  <script>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatRupiah(amount) {
      const num = parseFloat(amount);
      if (isNaN(num) || num === 0) return 'Gratis';
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0
      }).format(num);
    }

    let currentCategoryId = '';
    let searchDebounceTimer = null;
    let allCoursesData = [];

    // Check Auth Token
    const token = localStorage.getItem('access_token');
    const authBtn = document.getElementById('nav-auth-btn');
    if (token) {
      authBtn.textContent = 'Dashboard';
      authBtn.href = '/dashboard';
    }

    // Theme Toggle Handler
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        sunIcon.style.display = 'inline-block';
        moonIcon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const nextTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('skillsphere_theme', nextTheme);
      updateThemeUI(nextTheme);
    });

    // Load Categories
    async function loadCategories() {
      try {
        const res = await fetch('/api/courses/categories');
        const json = await res.json();
        const categories = (json.success && Array.isArray(json.data)) ? json.data : [];

        const container = document.getElementById('categories-container');
        const chipsHtml = categories.map(cat => `
          <button class="category-chip" data-id="${cat.id}" onclick="selectCategory(this, '${cat.id}')">
            <i class="${escapeHtml(cat.icon || 'fas fa-code')}"></i> ${escapeHtml(cat.name)}
          </button>
        `).join('');

        container.innerHTML = `
          <button class="category-chip active" data-id="" onclick="selectCategory(this, '')">
            <i class="fas fa-border-all"></i> Semua Bidang
          </button>
          ${chipsHtml}
        `;
      } catch (err) {
        console.error('Gagal memuat kategori:', err);
      }
    }

    // Select Category
    function selectCategory(el, catId) {
      document.querySelectorAll('.category-chip').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      currentCategoryId = catId;
      fetchAndRenderCourses();
    }

    // Search Input Debounce
    document.getElementById('catalog-search').addEventListener('input', () => {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        fetchAndRenderCourses();
      }, 300);
    });

    function handleFilterChange() {
      renderCoursesGrid(allCoursesData);
    }

    // Fetch Courses from API
    async function fetchAndRenderCourses() {
      const grid = document.getElementById('courses-grid');
      const countLabel = document.getElementById('results-count-label');
      const searchQuery = document.getElementById('catalog-search').value.trim();

      grid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 48px; color: var(--text-secondary); font-size: 14px;">
          <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Memuat kursus...
        </div>
      `;

      try {
        let url = '/api/courses?limit=50';
        if (currentCategoryId) url += `&category_id=${encodeURIComponent(currentCategoryId)}`;
        if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;

        const res = await fetch(url);
        const json = await res.json();

        const courses = (json.success && json.data && Array.isArray(json.data.courses)) 
          ? json.data.courses 
          : (Array.isArray(json.data) ? json.data : []);

        allCoursesData = courses;
        renderCoursesGrid(courses);
      } catch (err) {
        console.error('Error fetching courses:', err);
        grid.innerHTML = `<div class="empty-state-box"><p style="color:var(--color-danger);">Gagal memuat kursus dari server.</p></div>`;
      }
    }

    // Render Filtered Courses to Grid
    function renderCoursesGrid(courses) {
      const grid = document.getElementById('courses-grid');
      const countLabel = document.getElementById('results-count-label');
      const levelFilter = document.getElementById('filter-level').value;
      const priceFilter = document.getElementById('filter-price').value;

      let filtered = [...courses];

      if (levelFilter) {
        filtered = filtered.filter(c => (c.level || '').toLowerCase() === levelFilter.toLowerCase());
      }

      if (priceFilter === 'free') {
        filtered = filtered.filter(c => parseFloat(c.price || 0) === 0);
      } else if (priceFilter === 'paid') {
        filtered = filtered.filter(c => parseFloat(c.price || 0) > 0);
      }

      countLabel.textContent = `Menampilkan ${filtered.length} kursus tersedia`;

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="empty-state-box">
            <i class="fas fa-folder-open" style="font-size: 38px; color: var(--text-tertiary); margin-bottom: 12px;"></i>
            <h3 style="font-family: var(--font-serif); font-size: 20px; color: var(--text-primary); margin-bottom: 6px;">Tidak Menemukan Kursus</h3>
            <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;">Coba ubah kata kunci pencarian atau sesuaikan filter kategori Anda.</p>
            <button class="btn btn-outline" onclick="resetFilters()" style="font-size: 13px; padding: 7px 16px;">
              <i class="fas fa-rotate-left" style="margin-right: 6px;"></i> Reset Semua Filter
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(course => {
        const catName = course.category ? course.category.name : 'Teknologi';
        const tutorName = course.tutor ? course.tutor.name : 'Instruktur SkillSphere';
        const priceText = formatRupiah(course.price);
        const levelText = course.level === 'advanced' ? 'Mahir' : (course.level === 'intermediate' ? 'Menengah' : 'Pemula');
        const thumbUrl = course.thumbnail_url || '';

        return `
          <a href="/courses/${course.id}" class="course-card-premium">
            <div class="course-card-thumbnail-wrap">
              ${thumbUrl ? `<img src="${escapeHtml(thumbUrl)}" alt="${escapeHtml(course.title)}" class="course-card-thumbnail-img">` : `
                <div style="font-size: 42px; color: rgba(255,255,255,0.25);">
                  <i class="fas fa-layer-group"></i>
                </div>
              `}
              <span class="course-category-pill">${escapeHtml(catName)}</span>
              <span class="course-level-pill">${escapeHtml(levelText)}</span>
            </div>

            <div class="course-card-body">
              <h2 class="course-card-title">${escapeHtml(course.title)}</h2>
              <p class="course-card-desc">${escapeHtml(course.description || 'Pelajari materi komprehensif bersama kurikulum adaptif AI.')}</p>
              
              <div class="course-instructor-row">
                <div class="instructor-avatar-xs">${escapeHtml(tutorName.charAt(0))}</div>
                <div class="instructor-name-text">
                  ${escapeHtml(tutorName)}
                  <i class="fas fa-circle-check verified-badge-icon" title="Instruktur Terverifikasi"></i>
                </div>
              </div>

              <div class="course-card-footer">
                <div>
                  <div style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; font-weight: 600;">Biaya Belajar</div>
                  <div class="course-price-label">${escapeHtml(priceText)}</div>
                </div>

                <div class="btn-view-course">
                  Lihat Kelas <i class="fas fa-arrow-right" style="font-size: 11px;"></i>
                </div>
              </div>
            </div>
          </a>
        `;
      }).join('');
    }

    function resetFilters() {
      document.getElementById('catalog-search').value = '';
      document.getElementById('filter-level').value = '';
      document.getElementById('filter-price').value = '';
      currentCategoryId = '';
      document.querySelectorAll('.category-chip').forEach(c => c.classList.remove('active'));
      const allBtn = document.querySelector('.category-chip[data-id=""]');
      if (allBtn) allBtn.classList.add('active');
      fetchAndRenderCourses();
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCategories();
      fetchAndRenderCourses();
    });
  </script>
</body>
</html>
