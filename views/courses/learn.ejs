    /* The Main Circular Aurora Orb */
    .aurora-sphere {
      width: 270px;
      height: 270px;
      border-radius: 50%;
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 50% 25%, #4C82FB 0%, #2563EB 40%, #1D4ED8 70%, #0F2D7A 100%);
      box-shadow: 
        0 0 60px rgba(59, 130, 246, 0.65),
        0 0 120px rgba(37, 99, 235, 0.4);
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      will-change: transform, box-shadow;
    }

    .aurora-sphere.loading {
      transform: scale(0.45);
      box-shadow: 
        0 0 35px rgba(59, 130, 246, 0.75),
        0 0 70px rgba(37, 99, 235, 0.45);
    }

    .aurora-sphere.speaking {
      box-shadow: 
        0 0 85px rgba(96, 165, 250, 0.85),
        0 0 160px rgba(59, 130, 246, 0.6);
      transition: transform 0.08s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.12s ease;
    }

    /* Atmosphere Ambient Radial Gradient */
    .aurora-atmosphere {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 30%, rgba(96, 165, 250, 0.45) 0%, rgba(30, 64, 175, 0) 70%);
      mix-blend-mode: screen;
      pointer-events: none;
    }

    /* Animated White Aurora Cloud / Mist Layers */
    .aurora-mist-layer {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      transition: filter 0.4s ease, opacity 0.4s ease;
    }

    .aurora-sphere.speaking .aurora-mist-layer {
      filter: blur(10px) brightness(1.25);
    }

    /* Mist Layer 1: Undulating Horizontal Wave */
    .aurora-mist-1 {
      width: 360px;
      height: 200px;
      left: -45px;
      top: 45px;
      background: radial-gradient(ellipse at 50% 50%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.72) 40%, rgba(191, 219, 254, 0.25) 70%, transparent 85%);
      filter: blur(14px);
      opacity: 0.9;
      animation: auroraWave1 6.5s ease-in-out infinite alternate;
    }

    .aurora-sphere.speaking .aurora-mist-1 {
      animation: auroraWave1 2.8s ease-in-out infinite alternate;
    }

    /* Mist Layer 2: Swirling Upward Wisps */
    .aurora-mist-2 {
      width: 310px;
      height: 180px;
      left: -20px;
      top: 75px;
      background: radial-gradient(ellipse at 55% 45%, rgba(255, 255, 255, 0.9) 0%, rgba(224, 242, 254, 0.6) 45%, transparent 75%);
      filter: blur(16px);
      opacity: 0.85;
      animation: auroraWave2 8s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

    .aurora-sphere.speaking .aurora-mist-2 {
      animation: auroraWave2 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

    /* Mist Layer 3: Lower Luminous Base Cloud */
    .aurora-mist-3 {
      width: 290px;
      height: 160px;
      left: -10px;
      bottom: -10px;
      background: radial-gradient(ellipse at 50% 70%, rgba(200, 225, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 35%, rgba(147, 197, 253, 0.3) 70%, transparent 90%);
      filter: blur(12px);
      opacity: 0.92;
      animation: auroraWave3 5.5s ease-in-out infinite alternate;
    }

    .aurora-sphere.speaking .aurora-mist-3 {
      animation: auroraWave3 2.2s ease-in-out infinite alternate;
    }

    /* Mist Layer 4: Ambient Floating Wisps */
    .aurora-mist-4 {
      width: 250px;
      height: 140px;
      left: 10px;
      top: 90px;
      background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.4) 50%, transparent 80%);
      filter: blur(10px);
      opacity: 0.75;
      animation: auroraDrift 10s ease-in-out infinite alternate;
    }

    /* Keyframes for the dynamic aurora mist motion */
    @keyframes auroraWave1 {
      0% {
        transform: translate(0px, 0px) scale(1) rotate(0deg);
      }
      50% {
        transform: translate(20px, -14px) scale(1.08, 0.92) rotate(4deg);
      }
      100% {
        transform: translate(-18px, 10px) scale(0.95, 1.06) rotate(-3deg);
      }
    }

    @keyframes auroraWave2 {
      0% {
        transform: translate(-12px, 6px) scale(0.96) rotate(-2deg);
      }
      50% {
        transform: translate(16px, -18px) scale(1.05) rotate(5deg);
      }
      100% {
        transform: translate(8px, 12px) scale(1.02) rotate(-4deg);
      }
    }

    @keyframes auroraWave3 {
      0% {
        transform: translateY(0px) scale(1);
        opacity: 0.85;
      }
      50% {
        transform: translateY(-10px) scale(1.06);
        opacity: 0.98;
      }
      100% {
        transform: translateY(5px) scale(0.96);
        opacity: 0.88;
      }
    }

    @keyframes auroraDrift {
      0% {
        transform: translate(-14px, -8px) scale(0.95);
      }
      50% {
        transform: translate(18px, 10px) scale(1.1);
      }
      100% {
        transform: translate(-10px, 14px) scale(1.02);
      }
    }

    /* ========================================================
       AURORA AUDIO EQUALIZER VISUALIZER (INSIDE SPHERE)
       ======================================================== */
    .aurora-equalizer-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5.5px;
      z-index: 6;
      pointer-events: none;
      padding: 0;
      margin: 0;
      transition: opacity 0.35s ease;
