    function dismissNextChoiceCard() {
      const card = document.getElementById('orion-next-choice-card');
      if (card) {
        card.classList.remove('visible');
      }
      stopAllAudioPlayback();
    }

    let lastHighlightedBlockIdx = -1;

    function highlightAndScrollToSection(stepIndex, totalSteps = 1, topicText = '', segmentText = '', targetText = '') {
      clearAIFocusHighlight();

      const container = document.getElementById('material-dynamic-content-area');
      if (!container) return;

      const lowerTopic = (topicText || '').toLowerCase();
      const searchRoot = container.querySelector('.prose-content') || container;
      const readerBody = document.getElementById('classroom-reader-body');

      // 1. Initial Opening Step (Step 0): strictly anchor and highlight at the top of the lesson
      if (stepIndex === 0 || lowerTopic.includes('salam pembuka') || lowerTopic.includes('orientasi') || lowerTopic.includes('pengenalan') || lowerTopic.includes('selamat datang')) {
        lastHighlightedBlockIdx = 0;
        if (readerBody) {
          readerBody.scrollTo({ top: 0, behavior: 'smooth' });
        }
        const topEl = (searchRoot ? searchRoot.querySelector('h1, h2, h3, p') : null) || document.getElementById('reader-material-title');
        if (topEl) {
          topEl.classList.add('ai-block-focus-highlight');
        }
        return;
      }

      // 2. Collect all readable content blocks strictly in order
      const rawBlocks = Array.from(searchRoot.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li, blockquote, pre'))
        .filter(el => !el.closest('[data-no-ai-focus="true"]') && !el.closest('.practice-quiz-container'));

      // If a blockquote contains child <p> elements, let the child <p> elements be the discrete focusable blocks
      const blocks = rawBlocks.filter(el => !(el.tagName === 'BLOCKQUOTE' && el.querySelector('p')));

      if (blocks.length === 0) return;

      const cleanTarget = (targetText || '').replace(/^[#\s*\->]+/, '').replace(/[*_`]/g, '').trim().toLowerCase();
      
      let bestBlock = null;
      let bestBlockIdx = -1;
      let bestScore = -1;
      let bestMatchIdx = -1;
      let bestMatchLen = 0;

      // Find the block that best matches cleanTarget
      blocks.forEach((block, bIdx) => {
        const bText = (block.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
        if (!bText || bText.length < 5) return;

        let score = 0;
        let matchIdx = -1;
        let matchLen = 0;

        if (cleanTarget && cleanTarget.length >= 4) {
          // Exact prefix match is king (e.g. "ketika seorang mahasiswa...")
          if (bText.startsWith(cleanTarget)) {
            score += 6000;
            matchIdx = 0;
            matchLen = cleanTarget.length;
          } else {
            const foundIdx = bText.indexOf(cleanTarget);
            if (foundIdx !== -1) {
              score += 4000;
              matchIdx = foundIdx;
              matchLen = cleanTarget.length;
            } else {
              // Check first 5 words of cleanTarget
              const targetWords = cleanTarget.split(' ').slice(0, 5).join(' ');
              if (targetWords.length >= 6) {
                if (bText.startsWith(targetWords)) {
                  score += 5000;
                  matchIdx = 0;
                  matchLen = targetWords.length;
                } else {
                  const wordIdx = bText.indexOf(targetWords);
                  if (wordIdx !== -1) {
                    score += 3000;
                    matchIdx = wordIdx;
                    matchLen = targetWords.length;
                  }
                }
              }
            }
          }
        }

        // Sequential progression bonus:
        // Prioritize moving forward from lastHighlightedBlockIdx
        if (lastHighlightedBlockIdx !== -1) {
          if (bIdx >= lastHighlightedBlockIdx) {
            score += 500;
          } else {
            score -= 1200; // Strong penalty for jumping backwards to an already read paragraph
          }
        }
        const expectedBlockIdx = Math.min(blocks.length - 1, Math.max(0, stepIndex));
        const distance = Math.abs(bIdx - expectedBlockIdx);
        score += Math.max(0, 200 - (distance * 20));

        if (score > bestScore) {
          bestScore = score;
          bestBlock = block;
          bestBlockIdx = bIdx;
          bestMatchIdx = matchIdx;
          bestMatchLen = matchLen;
        }
      });

      // If no confident text match found, smoothly advance to the next sequential block
      if (!bestBlock || bestScore < 200) {
        const fallbackIdx = lastHighlightedBlockIdx !== -1 
          ? Math.min(blocks.length - 1, lastHighlightedBlockIdx + 1)
          : Math.min(blocks.length - 1, Math.max(0, stepIndex));
        bestBlock = blocks[fallbackIdx];
        bestBlockIdx = fallbackIdx;
      }

      if (!bestBlock) return;

      lastHighlightedBlockIdx = bestBlockIdx;

      // Highlight the entire active paragraph/block with soft glow outline
      bestBlock.classList.add('ai-block-focus-highlight');

      // If a specific phrase was found within the block, mark the text node
      if (bestMatchIdx !== -1 && bestMatchLen >= 4 && !/^H[1-6]$/i.test(bestBlock.tagName)) {
        try {
          const walker = document.createTreeWalker(bestBlock, NodeFilter.SHOW_TEXT, null, false);
          let textNode;
          const blockFullText = (bestBlock.textContent || '').replace(/\s+/g, ' ').toLowerCase();
          const subTarget = blockFullText.substr(bestMatchIdx, bestMatchLen);

          while ((textNode = walker.nextNode())) {
            const tnVal = textNode.nodeValue || '';
            const tnLower = tnVal.toLowerCase();
            const nodeMatchIdx = tnLower.indexOf(subTarget);

            if (nodeMatchIdx !== -1) {
              const range = document.createRange();
              range.setStart(textNode, nodeMatchIdx);
              range.setEnd(textNode, nodeMatchIdx + subTarget.length);

              const mark = document.createElement('mark');
              mark.className = 'ai-live-text-mark';
              range.surroundContents(mark);
              break;
            }
          }
        } catch (e) {}
      }

      // Smoothly scroll the centered active block into viewport
      bestBlock.scrollIntoView({
        behavior: 'smooth',
        block: 'center',
        inline: 'nearest'
      });
    }

    function clearAIFocusHighlight() {
      const container = document.getElementById('material-dynamic-content-area') || document;
      
      // 1. Remove glowing cards and block focus
      const activeGlows = document.querySelectorAll('.ai-card-glow-focus, .ai-focus-highlight, .ai-diagram-glow, .ai-block-focus-highlight');
      activeGlows.forEach(el => el.classList.remove('ai-card-glow-focus', 'ai-focus-highlight', 'ai-diagram-glow', 'ai-block-focus-highlight'));

      // 2. Unwrap all marks cleanly
      const marks = document.querySelectorAll('mark.ai-live-text-mark');
      marks.forEach(mark => {
        const parent = mark.parentNode;
        if (parent) {
          while (mark.firstChild) {
            parent.insertBefore(mark.firstChild, mark);
          }
          parent.removeChild(mark);
          parent.normalize();
        }
      });
    }

    function playDecodedBuffer(audioBuffer, expectedSessionId = null) {
      return new Promise((resolve) => {
        if (expectedSessionId !== null && expectedSessionId !== activePlaybackSessionId) {
          resolve();
          return;
        }

        const audioCtx = ensureAudioContext();
        if (!audioCtx) {
          resolve();
          return;
        }

        const sphereElem = document.getElementById('aurora-sphere-elem');
        const sphereWrapper = document.getElementById('aurora-sphere-wrapper');

        try {
          if (orionBufferSource) {
            try {
              orionBufferSource.onended = null;
              orionBufferSource.stop();
              orionBufferSource.disconnect();
            } catch(e) {}
            orionBufferSource = null;
          }

          orionBufferSource = audioCtx.createBufferSource();
          orionBufferSource.buffer = audioBuffer;
          orionAnalyser = audioCtx.createAnalyser();
          orionAnalyser.fftSize = 128;
          orionAnalyser.smoothingTimeConstant = 0.55;
          orionBufferSource.connect(orionAnalyser);
          orionAnalyser.connect(audioCtx.destination);

          isOrionSpeaking = true;
          if (sphereWrapper) {
            sphereWrapper.classList.remove('loading');
            sphereWrapper.classList.add('speaking');
          }
          if (sphereElem) {
            sphereElem.classList.remove('loading');
            sphereElem.classList.add('speaking');
          }

          orionBufferSource.onended = () => {
            orionBufferSource = null;
            resolve();
          };

          orionBufferSource.start(0);
          startAudioVisualizerLoop();
        } catch (err) {
          console.warn('Audio play error:', err);
          resolve();
        }
      });
    }

    async function playOrionSpeechText(text, lang = 'id', chosenVoice = 'id-male', autoDismiss = true, expectedSessionId = null) {
      if (expectedSessionId !== null && expectedSessionId !== activePlaybackSessionId) return;

      const sphereElem = document.getElementById('aurora-sphere-elem');
      const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
      const audioCtx = ensureAudioContext();

      try {
        const res = await fetch('/api/tts/speak', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ input: text, voice: chosenVoice, speed: 0 })
        });
        if (!res.ok) throw new Error('TTS HTTP ' + res.status);
        const arrayBuffer = await res.arrayBuffer();

        if (expectedSessionId !== null && expectedSessionId !== activePlaybackSessionId) return;

        if (audioCtx) {
          const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
          if (expectedSessionId !== null && expectedSessionId !== activePlaybackSessionId) return;

          if (orionBufferSource) {
            try {
              orionBufferSource.onended = null;
              orionBufferSource.stop();
              orionBufferSource.disconnect();
            } catch(e) {}
            orionBufferSource = null;
          }

          orionBufferSource = audioCtx.createBufferSource();
          orionBufferSource.buffer = audioBuffer;
          orionAnalyser = audioCtx.createAnalyser();
          orionAnalyser.fftSize = 128;
          orionAnalyser.smoothingTimeConstant = 0.55;
          orionBufferSource.connect(orionAnalyser);
          orionAnalyser.connect(audioCtx.destination);

          isOrionSpeaking = true;
          if (sphereWrapper) sphereWrapper.classList.remove('loading');
          if (sphereElem) {
            sphereElem.classList.remove('loading');
            sphereElem.classList.add('speaking');
          }

          return new Promise((resolve) => {
            orionBufferSource.onended = () => {
              orionBufferSource = null;
              stopOrionEqualizer();
              if (autoDismiss) {
                dismissAuroraOverlay();
              }
              resolve();
            };
            orionBufferSource.start(0);
            startAudioVisualizerLoop();
          });
        } else {
          const blob = new Blob([arrayBuffer], { type: 'audio/mp3' });
          const audioUrl = URL.createObjectURL(blob);
          orionAudioElement = new Audio(audioUrl);
          return new Promise((resolve) => {
            orionAudioElement.onplay = () => {
              isOrionSpeaking = true;
              if (sphereWrapper) sphereWrapper.classList.remove('loading');
              if (sphereElem) {
                sphereElem.classList.remove('loading');
                sphereElem.classList.add('speaking');
              }
              runSimulatedSpeechVisualizer();
            };
            orionAudioElement.onended = () => {
              orionAudioElement = null;
              stopOrionEqualizer();
              if (autoDismiss) {
                dismissAuroraOverlay();
              }
              resolve();
            };
            orionAudioElement.onerror = () => {
              orionAudioElement = null;
              resolve();
            };
            orionAudioElement.play().catch(() => {
              fallbackSpeechSynthesis(text, lang, chosenVoice, autoDismiss);
              resolve();
            });
          });
        }
      } catch (err) {
        fallbackSpeechSynthesis(text, lang, chosenVoice, autoDismiss);
      }
    }

    function startAudioVisualizerLoop() {
      const sphereElem = document.getElementById('aurora-sphere-elem');
      const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
      const eqBars = document.querySelectorAll('.aurora-eq-bar');
      if (!orionAnalyser) return;

      const bufferLength = orionAnalyser.frequencyBinCount;
      const dataArray = new Uint8Array(bufferLength);
      const numBars = eqBars.length;

      function renderEqualizer() {
        if (!isOrionSpeaking) return;
        orionAnimationId = requestAnimationFrame(renderEqualizer);

        orionAnalyser.getByteFrequencyData(dataArray);

        const isDocked = sphereWrapper && (sphereWrapper.classList.contains('docked-corner') || sphereWrapper.parentElement === document.body);

        // Vocal bass resonance frequencies (bins 1 to 5: ~70Hz to 350Hz)
        const bassVal = ((dataArray[1] || 0) * 1.3 + (dataArray[2] || 0) * 1.4 + (dataArray[3] || 0) * 1.1 + (dataArray[4] || 0) * 0.9) / 4;
        const bassEnergy = Math.min(1.0, bassVal / 220);

        // Overall voice speech energy across the 12 equalizer bars
        let totalEnergy = 0;
        eqBars.forEach((bar, index) => {
          const freqBin = Math.min(bufferLength - 1, Math.floor(1 + index * 1.8));
          const rawVal = dataArray[freqBin] || 0;
          const boost = (freqBin <= 4) ? 1.4 : (freqBin <= 10 ? 1.2 : 0.9);
          const val = Math.min(255, rawVal * boost);
          totalEnergy += val;

          const percent = val / 255;
          if (isDocked) {
            // Mini equalizer bar height (2px to 14px)
            const targetHeight = Math.max(2, Math.min(14, Math.round(2 + percent * 12)));
            bar.style.height = `${targetHeight}px`;
          } else {
            // Full-size equalizer bar height (6px to 74px)
            const targetHeight = Math.max(6, Math.min(74, Math.round(6 + percent * 68)));
            bar.style.height = `${targetHeight}px`;
          }
          bar.style.opacity = (0.5 + percent * 0.5).toFixed(2);
        });

        const avgEnergy = Math.min(1.0, totalEnergy / (numBars * 180));

        // Dynamic Bass Scale & Glow Pulsing
        if (isDocked && sphereWrapper) {
          // Dynamic scale pulse on the mini floating orb while speaking
          const targetScale = 1.0 + (bassEnergy * 0.15) + (avgEnergy * 0.08);
          visualizerCurrentScale += (targetScale - visualizerCurrentScale) * 0.5;
          sphereWrapper.style.transform = `scale(${visualizerCurrentScale.toFixed(3)})`;

          if (sphereElem) {
            const glowSpread = Math.round(14 + bassEnergy * 16);
            const glowOpacity = (0.55 + bassEnergy * 0.4).toFixed(2);
            sphereElem.style.boxShadow = `0 4px 20px rgba(37, 99, 235, 0.7), 0 0 ${glowSpread}px rgba(147, 197, 253, ${glowOpacity})`;
          }
        } else if (sphereElem) {
          const targetScale = 1.0 + (bassEnergy * 0.085) + (avgEnergy * 0.04);
          visualizerCurrentScale += (targetScale - visualizerCurrentScale) * 0.45;
          sphereElem.style.transform = `scale(${visualizerCurrentScale.toFixed(3)})`;

          const glowSpread = Math.round(45 + bassEnergy * 40);
          const glowOpacity = (0.35 + bassEnergy * 0.25).toFixed(2);
          sphereElem.style.boxShadow = `0 12px 45px rgba(59, 130, 246, 0.35), 0 0 ${glowSpread}px rgba(147, 197, 253, ${glowOpacity})`;
        }
      }

      renderEqualizer();
    }

    function stopOrionEqualizer() {
      isOrionSpeaking = false;
      visualizerCurrentScale = 1.0;
      const sphereElem = document.getElementById('aurora-sphere-elem');
      const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
      if (sphereElem) {
        sphereElem.classList.remove('speaking');
        sphereElem.style.transform = 'scale(1)';
        sphereElem.style.boxShadow = '';
      }
      if (sphereWrapper) {
        sphereWrapper.classList.remove('speaking');
        if (sphereWrapper.classList.contains('docked-corner')) {
          sphereWrapper.style.transform = 'scale(1)';
        }
      }
      if (orionAnimationId) {
        cancelAnimationFrame(orionAnimationId);
        orionAnimationId = null;
      }
      const isDocked = sphereWrapper && sphereWrapper.classList.contains('docked-corner');
      const eqBars = document.querySelectorAll('.aurora-eq-bar');
      eqBars.forEach((bar) => {
        bar.style.height = isDocked ? '3px' : '6px';
        bar.style.opacity = '0.55';
      });
    }

    function runSimulatedSpeechVisualizer() {
      const sphereElem = document.getElementById('aurora-sphere-elem');
      const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
      const eqBars = document.querySelectorAll('.aurora-eq-bar');
      let simTime = 0;

      function renderSimulation() {
        if (!isOrionSpeaking) return;
        orionAnimationId = requestAnimationFrame(renderSimulation);
        simTime += 0.09;

        const isDocked = sphereWrapper && (sphereWrapper.classList.contains('docked-corner') || sphereWrapper.parentElement === document.body);

        // Simulated vocal cadence with bass transients
        const bassBeat = Math.max(0, Math.sin(simTime * 3.2) * 0.7 + Math.sin(simTime * 6.5) * 0.35);
        const speechLoudness = Math.min(1.0, bassBeat);

        eqBars.forEach((bar, index) => {
          const centerDist = Math.abs(index - (eqBars.length - 1) / 2);
          const barOsc = Math.sin(simTime * 4.8 + index * 0.7) * 0.35 + 0.65;
          const barEnergy = Math.min(1.0, speechLoudness * barOsc * (1.15 - centerDist * 0.08));
          if (isDocked) {
            const targetHeight = Math.max(2, Math.min(14, Math.round(2 + barEnergy * 12)));
            bar.style.height = `${targetHeight}px`;
          } else {
            const targetHeight = Math.max(6, Math.min(82, Math.round(6 + barEnergy * 76)));
            bar.style.height = `${targetHeight}px`;
          }
          bar.style.opacity = (0.55 + barEnergy * 0.45).toFixed(2);
        });

        if (isDocked && sphereWrapper) {
          const targetScale = 1.0 + (speechLoudness * 0.15);
          visualizerCurrentScale += (targetScale - visualizerCurrentScale) * 0.35;
          sphereWrapper.style.transform = `scale(${visualizerCurrentScale.toFixed(3)})`;

          if (sphereElem) {
            const glowSpread = Math.round(14 + speechLoudness * 16);
            sphereElem.style.boxShadow = `0 4px 20px rgba(37, 99, 235, 0.7), 0 0 ${glowSpread}px rgba(147, 197, 253, ${(0.55 + speechLoudness * 0.35).toFixed(2)})`;
          }
        } else if (sphereElem) {
          const targetScale = 1.0 + (speechLoudness * 0.095);
          visualizerCurrentScale += (targetScale - visualizerCurrentScale) * 0.35;
          sphereElem.style.transform = `scale(${visualizerCurrentScale.toFixed(3)})`;

          const glowSpread = Math.round(45 + speechLoudness * 35);
          sphereElem.style.boxShadow = `0 12px 45px rgba(59, 130, 246, 0.35), 0 0 ${glowSpread}px rgba(147, 197, 253, ${(0.35 + speechLoudness * 0.25).toFixed(2)})`;
        }
      }

      renderSimulation();
    }

    function fallbackSpeechSynthesis(text, lang = 'id', voiceId = 'id-male', shouldDismiss = false) {
      if (!('speechSynthesis' in window)) {
        if (shouldDismiss) {
          setTimeout(dismissAuroraOverlay, 2800);
        } else {
          setTimeout(showAuroraChoiceCard, 500);
        }
        return;
      }
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = lang === 'en' ? 'en-US' : 'id-ID';
      utterance.rate = 1.0;
      utterance.pitch = voiceId.includes('female') ? 1.05 : 0.95;

      const voices = window.speechSynthesis.getVoices();
      if (voices && voices.length > 0) {
        const isMale = voiceId.includes('male');
        const targetLang = lang === 'en' ? 'en' : 'id';
        const matched = voices.find(v => v.lang.toLowerCase().includes(targetLang) && (isMale ? (v.name.toLowerCase().includes('male') || v.name.toLowerCase().includes('david') || v.name.toLowerCase().includes('pria')) : true));
        if (matched) utterance.voice = matched;
      }

      const sphereElem = document.getElementById('aurora-sphere-elem');

      utterance.onstart = () => {
        isOrionSpeaking = true;
        const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
        if (sphereWrapper) {
          sphereWrapper.classList.remove('loading');
        }
        if (sphereElem) {
          sphereElem.classList.remove('loading');
          sphereElem.classList.add('speaking');
        }
        runSimulatedSpeechVisualizer();
      };
      utterance.onend = () => {
        stopOrionEqualizer();
        if (shouldDismiss) {
          dismissAuroraOverlay();
        } else {
          setTimeout(showAuroraChoiceCard, 500);
        }
      };
      utterance.onerror = () => {
        stopOrionEqualizer();
        if (shouldDismiss) {
          dismissAuroraOverlay();
        } else {
          setTimeout(showAuroraChoiceCard, 500);
        }
      };

      window.speechSynthesis.speak(utterance);
    }

    function handleAuroraOverlayClick() {
      // Prologue cannot be skipped by click - must finish naturally
    }

    let isDismissingAurora = false;

    function dismissAuroraOverlay() {
      if (isDismissingAurora) return;
      isDismissingAurora = true;

      if (orionBufferSource) {
        try { orionBufferSource.stop(); } catch(e) {}
      }
      if (orionAudioElement) {
        orionAudioElement.pause();
      }
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      stopOrionEqualizer();

      const overlay = document.getElementById('aurora-orb-overlay');
      const sphereWrapper = document.getElementById('aurora-sphere-wrapper');
      const sphereElem = document.getElementById('aurora-sphere-elem');
      const choiceCard = document.getElementById('aurora-choice-card');
      const targetBtn = document.getElementById('btn-ai-header-toggle');

      if (choiceCard) {
        choiceCard.classList.remove('visible');
      }

      if (overlay) {
        overlay.classList.add('fading-backdrop');
      }

      if (sphereWrapper && targetBtn && overlay) {
        // Disable keyframe floating & bouncing animations
        sphereWrapper.classList.remove('loading');
        sphereWrapper.classList.add('flying-to-target');
        sphereWrapper.style.animation = 'none';
        if (sphereElem) {
          sphereElem.classList.remove('loading', 'speaking');
          sphereElem.style.animation = 'none';
        }
        const outerGlow = sphereWrapper.querySelector('.aurora-outer-glow');
        if (outerGlow) {
          outerGlow.style.opacity = '0';
        }

        // Compute delta position to the exact center of "Tanya AI" header button
        const sphereRect = sphereWrapper.getBoundingClientRect();
        const targetRect = targetBtn.getBoundingClientRect();

        const sphereCenterX = sphereRect.left + sphereRect.width / 2;
        const sphereCenterY = sphereRect.top + sphereRect.height / 2;
        const targetCenterX = targetRect.left + targetRect.width / 2;
        const targetCenterY = targetRect.top + targetRect.height / 2;

        const deltaX = Math.round(targetCenterX - sphereCenterX);
        const deltaY = Math.round(targetCenterY - sphereCenterY);

        // Force browser layout reflow to register starting point
        void sphereWrapper.offsetWidth;

        // Transform into brilliant glowing star & fly smoothly across screen to Tanya AI button
        sphereWrapper.style.transition = 'transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1)';
        sphereWrapper.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(0.06)`;

        if (sphereElem) {
          sphereElem.style.transition = 'box-shadow 0.45s ease, filter 0.45s ease';
          sphereElem.style.boxShadow = '0 0 35px #60A5FA, 0 0 70px #93C5FD, 0 0 100px #FFFFFF';
          sphereElem.style.filter = 'brightness(2.5)';
        }

        // When star reaches Tanya AI button
        setTimeout(() => {
          sphereWrapper.style.opacity = '0';

          // Trigger brilliant radiant shine on Tanya AI button
          targetBtn.classList.add('tanya-ai-shine');
          setTimeout(() => {
            targetBtn.classList.remove('tanya-ai-shine');
          }, 1400);

          // Completely teardown overlay
          setTimeout(() => {
            overlay.classList.add('dismissed');
            overlay.style.display = 'none';
          }, 300);
        }, 900);
      } else if (overlay) {
        overlay.classList.add('dismissed');
        setTimeout(() => {
          overlay.style.display = 'none';
        }, 400);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadClassroom();
    });
  </script>

