      const textEl = card.querySelector('.orion-next-card-text');
      const yesBtn = card.querySelector('.aurora-btn-yes');

      if (promptMode === 'on_module_change' || promptMode === 'mid_explanation_next') {
        if (tagEl) tagEl.innerHTML = `<i class="fas fa-sparkles"></i> Orion Mentor AI`;
        if (textEl) textEl.textContent = `Apakah materi "${matTitle}" ini mau dijelaskan?`;
        if (yesBtn) {
          yesBtn.innerHTML = `<span>Iya, Jelaskan</span> <i class="fas fa-play" style="font-size:10px;"></i>`;
          yesBtn.onclick = () => {
