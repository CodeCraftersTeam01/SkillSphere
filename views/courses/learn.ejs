    }

    /* Mist Layer 4: Ambient Floating Wisps */
    .aurora-mist-4 {
      width: 250px;
      height: 140px;
      left: 10px;
      top: 90px;
      background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.4) 50%, transparent 80%);
      filter: blur(10px);
      opacity: 0.75;
      animation: auroraDrift 10s ease-in-out infinite alternate;
    }

    /* Keyframes for the dynamic aurora mist motion */
    @keyframes auroraWave1 {
      0% {
        transform: translate(0px, 0px) scale(1) rotate(0deg);
      }
      50% {
        transform: translate(20px, -14px) scale(1.08, 0.92) rotate(4deg);
      }
      100% {
        transform: translate(-18px, 10px) scale(0.95, 1.06) rotate(-3deg);
      }
    }

    @keyframes auroraWave2 {
      0% {
        transform: translate(-12px, 6px) scale(0.96) rotate(-2deg);
      }
      50% {
        transform: translate(16px, -18px) scale(1.05) rotate(5deg);
      }
      100% {
        transform: translate(8px, 12px) scale(1.02) rotate(-4deg);
      }
    }

    @keyframes auroraWave3 {
      0% {
        transform: translateY(0px) scale(1);
        opacity: 0.85;
      }
      50% {
        transform: translateY(-10px) scale(1.06);
        opacity: 0.98;
