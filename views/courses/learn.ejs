  <!-- JavaScript Logic -->
  <script>
    const token = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('access_token');
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const serverCourseId = '<%= (typeof courseId !== "undefined" ? courseId : "") %>';
    const courseIdParam = serverCourseId || pathSegments[1] || 'mastering-modern-html5-expert';

    let courseData = null;
    let flatMaterials = [];
    let currentMaterialIndex = 0;
    let completedMaterialIds = new Set();
    let isAIPanelOpen = false;
    let activePlaybackSessionId = 0;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Theme Management
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        if (sunIcon) sunIcon.style.display = 'inline-block';
        if (moonIcon) moonIcon.style.display = 'none';
        if (themeText) themeText.textContent = 'Mode Terang';
      } else {
        if (sunIcon) sunIcon.style.display = 'none';
        if (moonIcon) moonIcon.style.display = 'inline-block';
        if (themeText) themeText.textContent = 'Mode Gelap';
      }
    }

    const savedTheme = localStorage.getItem('skillsphere_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeUI(savedTheme);

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const nextTheme = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('skillsphere_theme', nextTheme);
        updateThemeUI(nextTheme);
      });
    }

    function toggleSidebar(force) {
      const sidebar = document.getElementById('classroom-sidebar');
      if (typeof force === 'boolean') {
        if (force) sidebar.classList.remove('collapsed');
        else sidebar.classList.add('collapsed');
      } else {
        sidebar.classList.toggle('collapsed');
      }
    }

    // Split AI Panel Toggle
    function toggleAISplitPanel(force) {
      const workspace = document.getElementById('classroom-split-workspace');
      const headerBtn = document.getElementById('btn-ai-header-toggle');
      
      if (typeof force === 'boolean') {
        isAIPanelOpen = force;
      } else {
        isAIPanelOpen = !isAIPanelOpen;
      }

      if (isAIPanelOpen) {
        workspace.classList.add('ai-open');
        document.body.classList.add('ai-panel-open');
        headerBtn.classList.add('active');
        setTimeout(() => {
          const input = document.getElementById('ai-chat-input');
          if (input) input.focus();
        }, 150);
      } else {
        workspace.classList.remove('ai-open');
        document.body.classList.remove('ai-panel-open');
        headerBtn.classList.remove('active');
      }
    }

    // Load Course & Curriculum Structure
    async function loadClassroom() {
      if (!token) {
        showCustomAlert({
          title: 'Perlu Masuk Akun',
          message: 'Silakan masuk (login) terlebih dahulu untuk mengakses ruang belajar.',
          type: 'warning',
          buttonText: 'Masuk Sekarang'
        }).then(() => {
          window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        });
        return;
      }

      try {
        const res = await fetch(`/api/courses/${courseIdParam}`, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data) {
          showCustomAlert({
            title: 'Kelas Tidak Ditemukan',
            message: 'Kursus tidak ditemukan atau belum dipublikasikan.',
            type: 'error',
            buttonText: 'Kembali'
          }).then(() => {
            window.location.href = '/dashboard';
          });
          return;
        }

        courseData = json.data;
        document.getElementById('sidebar-course-title').textContent = courseData.title;

        // Build flat material array
        flatMaterials = [];
        const sections = courseData.sections || [];
        sections.forEach((sec, sIdx) => {
          (sec.materials || []).forEach((mat, mIdx) => {
            flatMaterials.push({
              ...mat,
              section_title: sec.title,
              section_index: sIdx + 1,
              material_index: mIdx + 1,
            });
          });
        });

        // Load saved local completed materials
        const localKey = `skillsphere_completed_${courseData.id}`;
        try {
          const saved = JSON.parse(localStorage.getItem(localKey) || '[]');
          saved.forEach(id => completedMaterialIds.add(id));
        } catch (e) {}

        renderCurriculumTree();
        updateProgressUI();

        if (flatMaterials.length > 0) {
          // Dynamic initial material resolution on page load / reload:
          // 1. URL search params (?m=index or ?material_id=id)
          const urlParams = new URLSearchParams(window.location.search);
          const qMatId = urlParams.get('material_id') || urlParams.get('m_id');
          const qIndex = urlParams.get('m') !== null ? parseInt(urlParams.get('m'), 10) : null;

          let initialIdx = -1;

          if (qMatId) {
            const foundById = flatMaterials.findIndex(m => String(m.id) === String(qMatId));
            if (foundById !== -1) initialIdx = foundById;
          }

          if (initialIdx === -1 && qIndex !== null && !isNaN(qIndex) && qIndex >= 0 && qIndex < flatMaterials.length) {
            initialIdx = qIndex;
          }

          // 2. Saved last active material in localStorage
          if (initialIdx === -1) {
            const lastSaved = localStorage.getItem(`skillsphere_last_material_${courseData.id}`);
            if (lastSaved !== null) {
              const parsedIdx = parseInt(lastSaved, 10);
              if (!isNaN(parsedIdx) && parsedIdx >= 0 && parsedIdx < flatMaterials.length) {
                initialIdx = parsedIdx;
              }
            }
          }

          // 3. First unfinished module in course progression
          if (initialIdx === -1) {
            const firstUnfinished = flatMaterials.findIndex(m => !completedMaterialIds.has(m.id));
            if (firstUnfinished !== -1) {
              initialIdx = firstUnfinished;
            } else {
              initialIdx = 0;
            }
          }

          selectMaterial(Math.max(0, initialIdx));

          // Trigger instant speech and equalizer animation now that courseData is verified and loaded
          playOrionWelcomeSpeech();
        } else {
          document.getElementById('material-dynamic-content-area').innerHTML = `
            <div style="text-align:center; padding:48px; color:var(--text-secondary);">
              <p>Materi kelas ini sedang disiapkan oleh instruktur.</p>
            </div>
          `;
        }
      } catch (err) {
        console.error('Error loading classroom:', err);
        showToast('Terjadi kesalahan jaringan saat memuat kelas.', 'error');
      }
    }

    function renderCurriculumTree() {
      const container = document.getElementById('curriculum-tree-container');
      if (!courseData || !courseData.sections || courseData.sections.length === 0) {
        container.innerHTML = '<div style="padding:16px; color:var(--text-secondary); text-align:center;">Belum ada bab.</div>';
        return;
      }

      let globalIdx = 0;
      container.innerHTML = courseData.sections.map((sec, sIdx) => {
        const materials = sec.materials || [];
        const completedInSec = materials.filter(m => completedMaterialIds.has(m.id)).length;

        const itemsHtml = materials.map((mat) => {
          const thisIndex = globalIdx++;
          const isCompleted = completedMaterialIds.has(mat.id);
          const isActive = thisIndex === currentMaterialIndex;

          let statusIcon = `<i class="fas fa-circle-check module-status-icon completed"></i>`;
          if (!isCompleted) {
            statusIcon = isActive 
              ? `<i class="fas fa-circle-play module-status-icon active"></i>`
              : `<i class="far fa-circle module-status-icon pending"></i>`;
          }

          const badgeText = 'TEKS';

          return `
            <button class="module-item-btn ${isActive ? 'active' : ''}" onclick="selectMaterial(${thisIndex})">
              <div style="display:flex; align-items:center; gap:8px; overflow:hidden;">
                ${statusIcon}
                <span class="module-title-truncate">${escapeHtml(mat.title)}</span>
              </div>
              <span class="module-format-badge">${badgeText}</span>
            </button>
          `;
        }).join('');

        return `
          <div class="chapter-group">
            <div class="chapter-header" onclick="toggleChapterAccordion(this)">
              <div class="chapter-title-text">
                <i class="fas fa-folder-open" style="font-size:10px;"></i>
                <span>Bab ${sIdx + 1}: ${escapeHtml(sec.title.replace(/^Bab\s*\d+\s*:\s*/i, ''))}</span>
              </div>
              <span class="chapter-meta-count">${completedInSec}/${materials.length}</span>
            </div>
            <div class="chapter-body" style="padding-left:4px; margin-top:2px;">
              ${itemsHtml}
            </div>
          </div>
        `;
      }).join('');
    }

    function toggleChapterAccordion(el) {
      const body = el.nextElementSibling;
      if (body) {
        body.style.display = body.style.display === 'none' ? 'block' : 'none';
      }
    }

    function selectMaterial(index) {
      if (index < 0 || index >= flatMaterials.length) return;
      currentMaterialIndex = index;
      const mat = flatMaterials[index];

      // Save last active material to localStorage & update URL state
      if (courseData) {
        localStorage.setItem(`skillsphere_last_material_${courseData.id}`, index);
        try {
          const currentUrl = new URL(window.location.href);
          currentUrl.searchParams.set('m', index);
          if (mat.id) currentUrl.searchParams.set('material_id', mat.id);
          window.history.replaceState({ materialIndex: index }, '', currentUrl.toString());
        } catch (e) {}
      }

      // Update Topbar and Header
      document.getElementById('topbar-chapter-title').textContent = mat.section_title || 'Materi Belajar';
      document.getElementById('reader-chapter-badge').textContent = `BAB ${mat.section_index} • MODUL ${index + 1} DARI ${flatMaterials.length}`;
      document.getElementById('reader-material-title').textContent = mat.title;
      document.getElementById('reader-duration').textContent = `${mat.duration_minutes || 15} Menit`;
      document.getElementById('reader-format').textContent = mat.diagram_svg ? 'Materi Teks & Diagram' : (mat.content_type === 'ppt' ? 'Slide Presentasi' : 'Materi Bacaan');
      document.getElementById('ai-panel-active-topic').textContent = `Topik: ${mat.title}`;

      // Update Status tag
      const isCompleted = completedMaterialIds.has(mat.id);
      const statusTag = document.getElementById('reader-status-tag');
      if (isCompleted) {
        statusTag.innerHTML = `<i class="fas fa-circle-check" style="color:var(--color-success);"></i> Selesai Dipelajari`;
      } else {
        statusTag.innerHTML = `<i class="fas fa-book-open-reader"></i> Sedang Dipelajari`;
      }

      // Render Dedicated Rich Text Content & Supporting Media per Bab
      renderChapterSpecificArticle(mat);

      // Bottom bar updates
      document.getElementById('bottom-module-counter').textContent = `Modul ${index + 1} dari ${flatMaterials.length}`;
      document.getElementById('btn-prev-module').disabled = index === 0;
      
      const nextBtn = document.getElementById('btn-next-module');
      if (index === flatMaterials.length - 1) {
        nextBtn.innerHTML = `<span>Tuntaskan Kursus</span> <i class="fas fa-trophy"></i>`;
      } else {
        nextBtn.innerHTML = `<span>Tandai Selesai & Lanjut</span> <i class="fas fa-arrow-right"></i>`;
      }

      // Refresh sidebar active highlight
      renderCurriculumTree();

      // Scroll reader to top smoothly
      document.getElementById('classroom-reader-body').scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Helper Markdown-to-HTML parser for Dynamic Database Text Content
    function parseMarkdownArticle(md) {
      if (!md) return '';
      let text = md.trim();

      // 1. Extract and preserve multiline code blocks
      const codeBlocks = [];
      text = text.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, (match, lang, code) => {
        const placeholder = `___CODE_BLOCK_${codeBlocks.length}___`;
        codeBlocks.push({
          lang: lang || 'html',
          code: code.trim()
        });
        return placeholder;
      });

      // 2. Extract and preserve inline code snippets (e.g. `<ul>`, `<ol>`, `<code>`)
      const inlineCodes = [];
      text = text.replace(/`([^`\n]+)`/g, (match, code) => {
        const placeholder = `___INLINE_CODE_${inlineCodes.length}___`;
        inlineCodes.push(code);
        return placeholder;
      });

      // 3. Headings
      text = text.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      text = text.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      text = text.replace(/^# (.*$)/gim, '<h1>$1</h1>');

      // 4. Blockquotes / Callouts
      text = text.replace(/^\> (.*$)/gim, '<div class="callout-box"><p>$1</p></div>');

      // 5. Bold & Italic
      text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      text = text.replace(/\*(.*?)\*/g, '<em>$1</em>');

      // 6. Lists (Unordered and Ordered)
      // Ordered lists (1. 2. 3.)
      text = text.replace(/^\s*\d+\.\s+(.*)$/gim, '<oli>$1</oli>');
      text = text.replace(/(<oli>.*<\/oli>(\n|(?=<oli>))*)/gim, '<ol>$1</ol>');
      text = text.replace(/<oli>/g, '<li>').replace(/<\/oli>/g, '</li>');

      // Unordered lists (- or *)
      text = text.replace(/^\s*[\-\*]\s+(.*)$/gim, '<li>$1</li>');
      text = text.replace(/(<li>.*<\/li>(\n|(?=<li>))*)/gim, '<ul>$1</ul>');

      // 7. Paragraphs
      const sections = text.split(/\n\n+/);
      text = sections.map(sec => {
        sec = sec.trim();
        if (!sec) return '';
        if (sec.startsWith('<h') || sec.startsWith('<ul') || sec.startsWith('<ol') || sec.startsWith('<div') || sec.startsWith('<table') || sec.startsWith('___CODE_BLOCK_')) {
          return sec;
        }
        return `<p>${sec.replace(/\n/g, '<br>')}</p>`;
      }).join('\n');

      // 8. Restore Inline Code Snippets safely
      inlineCodes.forEach((code, idx) => {
        const placeholder = `___INLINE_CODE_${idx}___`;
        text = text.split(placeholder).join(`<code>${escapeHtml(code)}</code>`);
      });

      // 9. Restore Code Blocks
      codeBlocks.forEach((block, idx) => {
        const placeholder = `___CODE_BLOCK_${idx}___`;
        const escapedCode = escapeHtml(block.code);
        const htmlBlock = `
          <div class="code-editor-box">
            <div class="code-editor-header">
              <span>${escapeHtml(block.lang)}.example</span>
              <button class="code-copy-btn" onclick="copySnippetCode(this)">Salin Kode</button>
            </div>
            <pre class="code-editor-body"><code>${escapedCode}</code></pre>
          </div>
        `;
        text = text.split(placeholder).join(htmlBlock);
      });

      return text;
    }

    // Dynamic Database-Driven Material Content Renderer
    function renderChapterSpecificArticle(mat) {
      const container = document.getElementById('material-dynamic-content-area');
      const title = mat.title;
      const sIdx = mat.section_index || 1;

      let html = '';

      const courseTitleLower = ((courseData && courseData.title) || '').toLowerCase();
      const courseSlugLower = ((courseData && courseData.slug) || '').toLowerCase();
      const isDbCourse = courseTitleLower.includes('basis data') || courseTitleLower.includes('database') || courseTitleLower.includes('normalisasi') || courseSlugLower.includes('data');

      // Render diagram only if explicitly provided in material data
      if (mat.diagram_svg) {
        html += `
          <div class="diagram-visual-card">
            <div class="diagram-visual-header">
              <span class="diagram-visual-title"><i class="fas fa-diagram-project"></i> ${escapeHtml(mat.diagram_title || 'Diagram Visual')}</span>
            </div>
            <div class="diagram-svg-wrapper">
              ${mat.diagram_svg}
            </div>
          </div>
        `;
      }

      // Dynamic text content from Database Record
      const rawText = mat.content_text || `## ${escapeHtml(title)}\n\nMateri ini memuat konsep standar industri. Tanyakan kepada Asisten AI jika ingin meminta elaborasi tambahan.`;
      const parsedArticleHtml = parseMarkdownArticle(rawText);

      html += `
        <article class="prose-content">
          ${parsedArticleHtml}
        </article>
      `;

      // Dynamic Practice Quiz adapted to Course Content
      let quizQuestion = `Pertanyaan: Berdasarkan materi pada <strong>${escapeHtml(title)}</strong>, manakah praktik terbaik yang direkomendasikan di standar industri?`;
      let optA = 'Menggunakan elemen semantik yang tepat, atribut eksplisit (seperti lang &amp; alt), serta mengoptimalkan kinerja CRP';
      let optB = 'Membungkus semua struktur dalam &lt;div&gt; tanpa atribut semantik sama sekali';
      let optC = 'Menghilangkan tag &lt;!DOCTYPE html&gt; agar browser masuk ke Quirks Mode';

      if (isDbCourse) {
        quizQuestion = `Pertanyaan: Berdasarkan materi pada <strong>${escapeHtml(title)}</strong>, manakah prinsip normalisasi relasional yang tepat?`;
        optA = 'Memastikan nilai atomik (1NF), mengeliminasi ketergantungan parsial (2NF), dan menghilangkan ketergantungan transitif (3NF) guna mencegah anomali data';
        optB = 'Menyimpan seluruh data entitas dalam satu tabel raksasa universal tanpa primary key';
        optC = 'Membiarkan data terduplikasi di banyak baris agar pencarian data tidak memerlukan relasi JOIN';
      }

      html += `
        <div class="practice-quiz-container" data-no-ai-focus="true" style="background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:22px; margin:28px 0; box-shadow:var(--shadow-sm);">
          <div style="display:flex; align-items:center; gap:8px; font-weight:700; font-size:14px; margin-bottom:12px; color:var(--text-primary);">
            <i class="fas fa-circle-question" style="color:var(--accent-primary);"></i> Kuis Evaluasi Pemahaman Modul
          </div>
          <p style="font-size:13.5px; margin-bottom:14px; color:var(--text-primary);">
            ${quizQuestion}
          </p>
          <div style="display:flex; flex-direction:column; gap:10px;">
            <label style="font-size:13px; display:flex; align-items:center; gap:10px; cursor:pointer; padding:8px 12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
              <input type="radio" name="practice_quiz" value="a"> ${optA}
            </label>
            <label style="font-size:13px; display:flex; align-items:center; gap:10px; cursor:pointer; padding:8px 12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
              <input type="radio" name="practice_quiz" value="b"> ${optB}
            </label>
            <label style="font-size:13px; display:flex; align-items:center; gap:10px; cursor:pointer; padding:8px 12px; background:var(--bg-surface-subtle); border-radius:var(--radius-md); border:1px solid var(--border-subtle);">
              <input type="radio" name="practice_quiz" value="c"> ${optC}
            </label>
          </div>
          <div style="display:flex; align-items:center; gap:12px; margin-top:16px;">
            <button class="btn btn-outline" style="font-size:12px; padding:6px 16px;" onclick="checkPracticeQuiz()">
              Periksa Jawaban
            </button>
            <button class="btn btn-outline" style="font-size:12px; padding:6px 14px;" onclick="quickAskAI('Jelaskan jawaban yang benar dan pembahasan detail dari kuis modul ini.')">
              <i class="fas fa-sparkles" style="color:var(--accent-primary);"></i> Bahas Bersama AI
            </button>
          </div>
          <div id="quiz-feedback" style="margin-top:12px; font-size:13px; display:none; padding:10px 14px; border-radius:var(--radius-md);"></div>
        </div>
      `;

      container.innerHTML = html;
    }

    function checkPracticeQuiz() {
      const selected = document.querySelector('input[name="practice_quiz"]:checked');
      const feedback = document.getElementById('quiz-feedback');
      if (!selected) {
        showToast('Pilih salah satu opsi jawaban terlebih dahulu.', 'warning');
        return;
      }
      const courseTitleLower = ((courseData && courseData.title) || '').toLowerCase();
      const isDb = courseTitleLower.includes('basis data') || courseTitleLower.includes('database') || courseTitleLower.includes('normalisasi');
      
      feedback.style.display = 'block';
      if (selected.value === 'a') {
        feedback.style.background = 'rgba(16, 185, 129, 0.12)';
        feedback.style.border = '1px solid var(--color-success)';
        const correctMsg = isDb 
          ? 'Praktik ini menjamin integritas relasional, pencegahan anomali (insert/update/delete), dan efisiensi penyimpanan database.'
          : 'Praktik ini menjamin aksesibilitas universal, performa tinggi, dan indeks SEO optimal.';
        feedback.innerHTML = `<span style="color:var(--color-success); font-weight:700;"><i class="fas fa-circle-check"></i> Jawaban Anda Tepat!</span> ${correctMsg}`;
      } else {
        feedback.style.background = 'rgba(239, 68, 68, 0.12)';
        feedback.style.border = '1px solid var(--color-danger)';
        feedback.innerHTML = `<span style="color:var(--color-danger); font-weight:700;"><i class="fas fa-circle-xmark"></i> Kurang Tepat.</span> Opsi A adalah jawaban standar industri. Anda dapat mengecek penjelasan lengkap melalui panel AI.`;
      }
    }


