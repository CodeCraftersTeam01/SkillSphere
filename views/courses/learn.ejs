    .aurora-sphere.loading .aurora-equalizer-container {
      opacity: 0;
    }

    .aurora-eq-bar {
      width: 4px;
      min-height: 6px;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(to top, rgba(255, 255, 255, 1) 0%, rgba(224, 242, 254, 0.95) 60%, rgba(147, 197, 253, 0.75) 100%);
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.9), 0 0 18px rgba(147, 197, 253, 0.7);
      transition: height 0.05s ease-out, opacity 0.12s ease-out;
      opacity: 0.6;
      transform-origin: center;
    }

    .aurora-sphere.speaking .aurora-eq-bar {
      opacity: 0.95;
    }

    /* 3D Rim Glare & Specular Reflection */
    .aurora-sphere-glare {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 
        inset 0 4px 10px rgba(255, 255, 255, 0.7),
        inset 0 -4px 12px rgba(255, 255, 255, 0.2);
      pointer-events: none;
      z-index: 7;
    }

    /* Outer Ambient Ring Glow */
    .aurora-outer-glow {

<!-- Curriculum sidebar loaded -->
