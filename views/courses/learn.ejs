    // Realtime Multi-Turn Conversation History for Orion AI
    let aiConversationHistory = [];

    // Helper to format Orion's markdown replies nicely inside chat bubbles
    function formatAIChatMarkdown(md) {
      if (!md) return '';
      let text = escapeHtml(md);

      // Code blocks
      text = text.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, (match, lang, code) => {
        return `<pre class="code-editor-body" style="margin:8px 0; padding:10px; font-size:12px; border-radius:6px; background:#181816; color:#ECEBE8; overflow-x:auto;"><code>${code}</code></pre>`;
      });

      // Bold & Italic & Inline code
      text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      text = text.replace(/\*(.*?)\*/g, '<em>$1</em>');
      text = text.replace(/`([^`]+)`/g, '<code style="background:var(--bg-surface-subtle); padding:2px 5px; border-radius:4px; font-family:var(--font-mono); font-size:12px;">$1</code>');

      // Unordered lists
      text = text.replace(/^\s*[\-\*]\s+(.*)$/gim, '<li style="margin-left:14px;">$1</li>');

      // Line breaks
      text = text.replace(/\n\n+/g, '<br><br>');
      text = text.replace(/\n/g, '<br>');

      return text;
    }

