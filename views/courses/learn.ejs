      filter: blur(16px);
      opacity: 0.85;
      animation: auroraWave2 8s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

    .aurora-sphere.speaking .aurora-mist-2 {
      animation: auroraWave2 3.2s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    }

