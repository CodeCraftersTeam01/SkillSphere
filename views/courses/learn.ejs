    async function proceedToNextModuleAndExplain() {
      dismissNextChoiceCard();
      
      if (currentMaterialIndex < flatMaterials.length - 1) {
        // Mark current material completed
        const currentMat = flatMaterials[currentMaterialIndex];
        if (currentMat) {
