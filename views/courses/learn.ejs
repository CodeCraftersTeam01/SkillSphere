    async function completeAndNextModule() {
      if (flatMaterials.length === 0) return;
      const currentMat = flatMaterials[currentMaterialIndex];

      // Stop any ongoing speech and highlights immediately
      stopAllAudioPlayback();
      clearAIFocusHighlight();
      dismissNextChoiceCard();

      // Mark current material completed
      completedMaterialIds.add(currentMat.id);

      // Save locally
      if (courseData) {
        localStorage.setItem(`skillsphere_completed_${courseData.id}`, JSON.stringify(Array.from(completedMaterialIds)));
      }

      // Sync progress with backend
      updateProgressUI();
      const progressPercent = Math.round((completedMaterialIds.size / flatMaterials.length) * 100);

      try {
        fetch(`/api/courses/${courseData.id}/progress`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify({
            progress_percentage: progressPercent,
            status: progressPercent >= 100 ? 'completed' : 'active'
          })
        }).catch(e => console.warn('Progress sync warning:', e));
      } catch (e) {}

      showToast(`Modul "${currentMat.title}" selesai dipelajari!`, 'success');

      // Advance to next module or finish
      if (currentMaterialIndex < flatMaterials.length - 1) {
        selectMaterial(currentMaterialIndex + 1);

        // In docked mini orb mode in the bottom-right, ask if student wants Orion to explain this new module
        dockAuroraToCorner();
        setTimeout(() => {
          showNextModuleChoiceCard('on_module_change');
        }, 400);
      } else {
        showCustomAlert({
          title: 'Selamat! Anda Telah Menuntaskan Seluruh Modul',
          message: 'Seluruh bab dan materi telah berhasil Anda kuasai. Sertifikat kelulusan digital Anda siap diakses di dashboard.',
          type: 'success',
          buttonText: 'Kembali ke Dashboard'
        }).then(() => {
          window.location.href = '/dashboard';
        });
      }
    }

    function updateProgressUI() {
      if (flatMaterials.length === 0) return;
      const count = completedMaterialIds.size;
      const total = flatMaterials.length;
      const percent = Math.min(100, Math.round((count / total) * 100));

      const labelEl = document.getElementById('sidebar-progress-label');
      const percentEl = document.getElementById('sidebar-progress-percent');
      const fillEl = document.getElementById('sidebar-progress-fill');

      if (labelEl) labelEl.textContent = `${count} / ${total} modul`;
      if (percentEl) percentEl.textContent = `${percent}%`;
      if (fillEl) fillEl.style.width = `${percent}%`;
    }

