        if (tagEl) tagEl.innerHTML = `<i class="fas fa-circle-check"></i> Selesai Dibahas`;
        if (textEl) textEl.textContent = `Modul ini telah selesai! Ingin lanjut ke materi berikutnya dan saya bantu jelaskan lagi?`;
        if (yesBtn) {
          yesBtn.innerHTML = `<span>Iya, Lanjut</span> <i class="fas fa-arrow-right" style="font-size:10px;"></i>`;
          yesBtn.onclick = () => {
