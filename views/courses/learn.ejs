        ? ((lang === 'en' || chosenVoice.startsWith('en-')) ? 'Would you like me to explain this module?' : 'Apakah materi ini mau dijelaskan?')
        : ((lang === 'en' || chosenVoice.startsWith('en-')) ? 'This module is complete! Would you like to proceed to the next lesson?' : 'Modul ini telah selesai. Apakah Anda ingin lanjut ke materi berikutnya dan saya bantu jelaskan lagi?');

      await playOrionSpeechText(nextQuestionSpeech, lang, chosenVoice, false);
