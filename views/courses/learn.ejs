        transform: translate(-14px, -8px) scale(0.95);
      }
      50% {
        transform: translate(18px, 10px) scale(1.1);
      }
      100% {
        transform: translate(-10px, 14px) scale(1.02);
      }
    }

    /* ========================================================
       AURORA AUDIO EQUALIZER VISUALIZER (INSIDE SPHERE)
       ======================================================== */
    .aurora-equalizer-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      justify-content: center;
