      overflow: hidden;
      background: radial-gradient(circle at 50% 25%, #4C82FB 0%, #2563EB 40%, #1D4ED8 70%, #0F2D7A 100%);
      box-shadow: 
        0 0 60px rgba(59, 130, 246, 0.65),
        0 0 120px rgba(37, 99, 235, 0.4);
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      will-change: transform, box-shadow;
