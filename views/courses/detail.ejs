<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Kursus & Kurikulum | SkillSphere AI</title>
  <meta name="description" content="Pelajari kurikulum lengkap, silabus materi, profil instruktur terverifikasi, dan daftar ke kelas impian Anda di SkillSphere AI.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <!-- Accessibility & Head Tracking Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/accessibility.css">

  <style>
    :root {
      --navbar-height: 56px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      max-width: 100vw;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }

    .course-detail-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
      width: 100%;
      overflow-x: hidden;
    }

    /* Navbar styling */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 24px;
      height: var(--navbar-height);
      min-height: var(--navbar-height);
      max-height: var(--navbar-height);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-sizing: border-box;
      width: 100%;
    }

    .nav-main-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 16px;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 20px;
      min-width: 0;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.01em;
      flex-shrink: 0;
    }

    .brand-icon {
      width: 28px;
      height: 28px;
      color: var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .nav-links-menu {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link-item {
      padding: 6px 12px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .nav-link-item:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-link-item.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .theme-toggle-btn {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 7px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
      white-space: nowrap;
    }

    .theme-toggle-btn:hover {
      background: var(--bg-surface);
      color: var(--text-primary);
      border-color: var(--border-strong);
    }

    .desktop-only {
      display: flex !important;
    }

    .mobile-only {
      display: none !important;
    }

    /* Course Detail Hero */
    .detail-hero-section {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 36px 24px;
      width: 100%;
    }

    .detail-hero-container {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 36px;
      align-items: start;
      width: 100%;
    }

    .hero-main-col {
      min-width: 0;
      width: 100%;
    }

    .breadcrumb-nav {
      display: flex;
      align-items: center;
      gap: 6px 8px;
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 16px;
      flex-wrap: wrap;
      line-height: 1.4;
      word-break: break-word;
    }

    .breadcrumb-nav a {
      color: var(--text-secondary);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .breadcrumb-nav a:hover {
      color: var(--text-primary);
    }

    .course-badges-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .badge-pill {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .badge-pill.category {
      background: var(--accent-primary);
      color: var(--accent-text);
    }

    .badge-pill.level {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
    }

    .detail-course-title {
      font-family: var(--font-serif);
      font-size: 32px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.25;
      margin-bottom: 14px;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .detail-course-summary {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 20px;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .instructor-hero-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-top: 14px;
      border-top: 1px solid var(--border-subtle);
      flex-wrap: wrap;
    }

    .instructor-avatar-md {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .instructor-hero-meta {
      min-width: 0;
      flex: 1;
    }

    .instructor-hero-meta h4 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 2px;
      word-break: break-word;
    }

    .instructor-hero-meta p {
      font-size: 12px;
      color: var(--text-secondary);
      margin: 0;
      word-break: break-word;
    }

    /* Sticky Sidebar Purchase Box */
    .sidebar-enroll-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-floating);
      position: sticky;
      top: 80px;
      width: 100%;
      box-sizing: border-box;
    }

    .enroll-video-preview {
      width: 100%;
      height: 200px;
      border-radius: var(--radius-lg);
      background: linear-gradient(135deg, #2D2B28 0%, #1A1918 100%);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      cursor: pointer;
    }

    .enroll-video-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .preview-play-btn {
      position: absolute;
      width: 52px;
      height: 52px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.9);
      color: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      transition: transform 0.2s ease;
    }

    .preview-play-btn:hover {
      transform: scale(1.1);
    }

    .enroll-price-display {
      font-size: 28px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 16px;
      word-break: break-word;
    }

    .btn-enroll-action {
      width: 100%;
      padding: 14px;
      font-size: 15px;
      font-weight: 600;
      border-radius: var(--radius-md);
      background: var(--accent-primary);
      color: var(--accent-text);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 8px;
      transition: opacity 0.15s ease;
      margin-bottom: 16px;
      box-sizing: border-box;
      text-decoration: none;
    }

    .btn-enroll-action:hover {
      opacity: 0.88;
    }

    .enroll-benefits-list {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .enroll-benefit-item {
      font-size: 13px;
      color: var(--text-secondary);
      display: flex;
      align-items: flex-start;
      gap: 10px;
      word-break: break-word;
    }

    .enroll-benefit-item i {
      color: var(--color-success);
      font-size: 14px;
      margin-top: 2px;
      flex-shrink: 0;
    }

    /* Main Tabs and Content */
    .detail-body-container {
      max-width: 1240px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 80px;
      box-sizing: border-box;
    }

    .detail-body-wrapper {
      max-width: 820px;
      width: 100%;
    }

    .detail-tabs-bar {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 28px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      width: 100%;
      padding-bottom: 2px;
    }

    .detail-tabs-bar::-webkit-scrollbar {
      display: none;
    }

    .detail-tab-btn {
      padding: 12px 18px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-secondary);
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .detail-tab-btn:hover {
      color: var(--text-primary);
    }

    .detail-tab-btn.active {
      color: var(--text-primary);
      font-weight: 600;
      border-bottom-color: var(--accent-primary);
    }

    .detail-tab-pane {
      display: none;
      width: 100%;
    }

    .detail-tab-pane.active {
      display: block;
      animation: framerFadeIn 0.25s ease-out;
    }

    @keyframes framerFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .content-card-section {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: var(--shadow-sm);
      width: 100%;
      box-sizing: border-box;
    }

    .section-title-sm {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      word-break: break-word;
    }

    /* Curriculum Accordion */
    .curriculum-accordion {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }

    .section-accordion-item {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      background: var(--bg-surface);
      overflow: hidden;
      width: 100%;
    }

    .section-accordion-header {
      padding: 16px 20px;
      background: var(--bg-surface-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      user-select: none;
      font-weight: 600;
      font-size: 14px;
      color: var(--text-primary);
      width: 100%;
      box-sizing: border-box;
    }

    .section-header-title {
      min-width: 0;
      flex: 1;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .section-header-meta {
      font-size: 12px;
      color: var(--text-secondary);
      font-weight: 500;
      white-space: nowrap;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .section-accordion-body {
      padding: 0;
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .material-unit-row {
      padding: 12px 20px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 13px;
      transition: background-color 0.15s ease;
      width: 100%;
      box-sizing: border-box;
    }

    .material-unit-row:hover {
      background: var(--bg-surface-subtle);
    }

    .material-meta-left {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-primary);
      flex: 1;
      min-width: 0;
    }

    .material-unit-title {
      min-width: 0;
      word-break: break-word;
      overflow-wrap: break-word;
      line-height: 1.4;
    }

    .material-meta-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .material-type-icon {
      color: var(--text-secondary);
      font-size: 14px;
      width: 18px;
      text-align: center;
      flex-shrink: 0;
    }

    .material-badge-preview {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: var(--color-success-bg);
      border: 1px solid var(--color-success);
      color: var(--color-success);
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      transition: opacity 0.15s ease;
    }

    .material-badge-preview:hover {
      opacity: 0.85;
    }

    .material-badge-locked {
      font-size: 11px;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Modal Player */
    .preview-modal-overlay {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      box-sizing: border-box;
    }

    .preview-modal-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 780px;
      width: 100%;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: var(--shadow-floating);
      animation: framerFadeIn 0.2s ease-out;
    }

    .preview-modal-header {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .preview-modal-body {
      padding: 16px;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      min-height: 240px;
      max-height: 65vh;
      overflow-y: auto;
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
      .navbar {
        padding: 0 16px;
      }
      .desktop-only {
        display: none !important;
      }
      .mobile-only {
        display: flex !important;
      }
      .brand-logo span {
        font-size: 15px;
      }
      .brand-icon {
        width: 24px;
        height: 24px;
      }
      .nav-actions {
        gap: 8px;
      }
      .theme-toggle-btn {
        width: 36px;
        height: 36px;
        padding: 0;
        border-radius: var(--radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .theme-toggle-btn #theme-text {
        display: none !important;
      }

      /* Hero responsive */
      .detail-hero-section {
        padding: 20px 16px 24px;
      }
      .detail-hero-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .detail-course-title {
        font-size: 22px;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 10px;
      }
      .detail-course-summary {
        font-size: 13.5px;
        line-height: 1.55;
        margin-bottom: 16px;
      }
      .instructor-hero-card {
        padding-top: 12px;
      }
      .instructor-avatar-md {
        width: 40px;
        height: 40px;
        font-size: 15px;
      }

      /* Sidebar Card stacked under Hero on Mobile */
      .sidebar-enroll-card {
        position: static;
        width: 100%;
        margin-top: 4px;
        padding: 18px 16px;
        border-radius: var(--radius-lg);
      }
      .enroll-video-preview {
        height: 175px;
        margin-bottom: 14px;
      }
      .enroll-price-display {
        font-size: 24px;
        margin-bottom: 12px;
      }
      .btn-enroll-action {
        padding: 12px;
        font-size: 14px;
        margin-bottom: 14px;
      }
      .enroll-benefits-list {
        margin: 0 0 16px;
        gap: 8px;
      }
      .enroll-benefit-item {
        font-size: 12px;
      }

      /* Body & Tabs responsive */
      .detail-body-container {
        padding: 20px 16px 60px;
      }
      .detail-tabs-bar {
        gap: 6px;
        margin-bottom: 20px;
      }
      .detail-tab-btn {
        font-size: 13px;
        padding: 10px 14px;
      }
      .content-card-section {
        padding: 18px 16px;
        border-radius: var(--radius-lg);
        margin-bottom: 16px;
      }
      .section-accordion-header {
        padding: 14px 16px;
        font-size: 13.5px;
      }
      .material-unit-row {
        padding: 12px 14px;
        gap: 8px;
        font-size: 12.5px;
      }
      .material-meta-left {
        font-size: 12.5px;
      }
    }

    @media (max-width: 480px) {
      .navbar {
        padding: 0 12px;
      }
      .brand-logo span {
        font-size: 14.5px;
      }
      .brand-icon {
        width: 22px;
        height: 22px;
      }
      .theme-toggle-btn {
        width: 32px;
        height: 32px;
      }
      .detail-hero-section {
        padding: 16px 12px 20px;
      }
      .sidebar-enroll-card {
        padding: 16px 12px;
      }
      .detail-body-container {
        padding: 16px 12px 60px;
      }
      .content-card-section {
        padding: 16px 12px;
      }
      .section-accordion-header {
        padding: 12px 14px;
        font-size: 13px;
      }
      .material-unit-row {
        padding: 10px 12px;
        font-size: 12px;
      }
      .material-badge-preview {
        padding: 3px 8px;
        font-size: 10px;
      }
    }
  </style>

  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="course-detail-layout">
    <!-- Navbar -->
    <header class="navbar">
      <div class="nav-main-row">
        <div class="nav-brand-group">
          <a href="/dashboard" class="brand-logo">
            <div class="brand-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
              </svg>
            </div>
            <span>SkillSphere AI</span>
          </a>

          <nav class="desktop-only">
            <ul class="nav-links-menu">
              <li><a href="/courses" class="nav-link-item active"><i class="fas fa-compass"></i> Katalog</a></li>
              <li><a href="/dashboard" class="nav-link-item"><i class="fas fa-graduation-cap"></i> Belajar</a></li>
            </ul>
          </nav>
        </div>

        <div class="nav-actions">
          <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Toggle dark/light mode">
            <i class="fas fa-sun" id="theme-icon-sun" style="display:none;"></i>
            <i class="fas fa-moon" id="theme-icon-moon"></i>
            <span id="theme-text">Mode Gelap</span>
          </button>

          <a href="/login" class="btn btn-outline" id="nav-auth-btn" style="font-size:12px; padding:6px 14px;">
            Masuk
          </a>
        </div>
      </div>
    </header>

    <!-- Detail Hero Section -->
    <section class="detail-hero-section">
      <div class="detail-hero-container">
        
        <!-- Left Hero Details -->
        <div class="hero-main-col">
          <nav class="breadcrumb-nav">
            <a href="/dashboard"><i class="fas fa-home"></i></a>
            <span>/</span>
            <a href="/courses">Katalog Kursus</a>
            <span>/</span>
            <span id="breadcrumb-category">Memuat Kategori...</span>
          </nav>

          <div class="course-badges-row">
            <span class="badge-pill category" id="badge-category">Kategori</span>
            <span class="badge-pill level" id="badge-level">Tingkat</span>
          </div>

          <h1 class="detail-course-title" id="course-title">Memuat Informasi Kursus...</h1>
          <p class="detail-course-summary" id="course-description">
            Deskripsi lengkap materi dan kurikulum adaptif sedang dimuat.
          </p>

          <div class="instructor-hero-card">
            <div class="instructor-avatar-md" id="tutor-avatar">T</div>
            <div class="instructor-hero-meta">
              <h4 id="tutor-name">Instruktur Pengajar <i class="fas fa-circle-check" style="color:#3B82F6;" title="Terverifikasi"></i></h4>
              <p id="tutor-role-title">Pengajar Ahli Terverifikasi SkillSphere AI</p>
            </div>
          </div>
        </div>

        <!-- Sticky Sidebar Card Desktop & Stacked on Mobile -->
        <aside class="sidebar-enroll-card">
          <div class="enroll-video-preview" id="preview-box" onclick="handleOpenPreviewModal()">
            <img id="course-cover-img" src="" alt="Thumbnail Kursus" style="display:none;">
            <div class="preview-play-btn">
              <i class="fas fa-play" style="margin-left:3px;"></i>
            </div>
          </div>

          <div style="font-size:12px; color:var(--text-secondary); text-transform:uppercase; font-weight:600; margin-bottom:2px;">Biaya Pendaftaran</div>
          <div class="enroll-price-display" id="course-price-tag">Rp 0</div>

          <button class="btn-enroll-action" id="btn-enroll-main" onclick="handleEnrollCourse()">
            <i class="fas fa-graduation-cap"></i> Daftar & Masuk Kelas
          </button>

          <ul class="enroll-benefits-list">
            <li class="enroll-benefit-item"><i class="fas fa-circle-check"></i> Akses materi penuh seumur hidup</li>
            <li class="enroll-benefit-item"><i class="fas fa-circle-check"></i> Sertifikat kompetensi digital resmi</li>
            <li class="enroll-benefit-item"><i class="fas fa-circle-check"></i> Tanya jawab asisten belajar Gemini AI</li>
            <li class="enroll-benefit-item"><i class="fas fa-circle-check"></i> Garansi 7 hari kepuasan materi</li>
          </ul>

          <button class="btn btn-outline" style="width:100%; font-size:12px; padding:8px 12px;" onclick="copyCourseShareLink()">
            <i class="fas fa-share-nodes" style="margin-right:6px;"></i> Bagikan Tautan Kelas
          </button>
        </aside>

      </div>
    </section>

    <!-- Main Content Tabs -->
    <main class="detail-body-container">
      <div class="detail-body-wrapper">
        
        <!-- Tabs Header -->
        <div class="detail-tabs-bar">
          <button class="detail-tab-btn active" data-tab="tab-overview">
            <i class="fas fa-circle-info"></i> Tentang Kursus
          </button>
          <button class="detail-tab-btn" data-tab="tab-curriculum">
            <i class="fas fa-layer-group"></i> Silabus & Kurikulum
          </button>
          <button class="detail-tab-btn" data-tab="tab-instructor">
            <i class="fas fa-chalkboard-user"></i> Instruktur
          </button>
        </div>

        <!-- TAB 1: TENTANG KURSUS -->
        <section id="tab-overview" class="detail-tab-pane active">
          <div class="content-card-section">
            <h2 class="section-title-sm"><i class="fas fa-list-check"></i> Apa yang Akan Anda Pelajari</h2>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:20px;">
              <div style="display:flex; align-items:start; gap:10px; font-size:13px; color:var(--text-secondary);">
                <i class="fas fa-check" style="color:var(--color-success); margin-top:3px; flex-shrink:0;"></i>
                <span>Pemahaman fundamental hingga implementasi arsitektur nyata.</span>
              </div>
              <div style="display:flex; align-items:start; gap:10px; font-size:13px; color:var(--text-secondary);">
                <i class="fas fa-check" style="color:var(--color-success); margin-top:3px; flex-shrink:0;"></i>
                <span>Studi kasus relevan dengan kebutuhan industri teknologi saat ini.</span>
              </div>
              <div style="display:flex; align-items:start; gap:10px; font-size:13px; color:var(--text-secondary);">
                <i class="fas fa-check" style="color:var(--color-success); margin-top:3px; flex-shrink:0;"></i>
                <span>Pemanfaatan AI untuk mempercepat alur belajar & pemecahan error.</span>
              </div>
              <div style="display:flex; align-items:start; gap:10px; font-size:13px; color:var(--text-secondary);">
                <i class="fas fa-check" style="color:var(--color-success); margin-top:3px; flex-shrink:0;"></i>
                <span>Kesiapan menghadapi uji kompetensi dan sertifikasi resmi.</span>
              </div>
            </div>

            <h2 class="section-title-sm" style="margin-top:28px;"><i class="fas fa-book-bookmark"></i> Prasyarat Belajar</h2>
            <p style="font-size:13px; color:var(--text-secondary); line-height:1.6; margin:0;">
              Memiliki komputer/laptop dengan koneksi internet stabil serta kemauan untuk berlatih secara konsisten setiap hari. Tidak ada batasan usia atau latar belakang khusus untuk memulai.
            </p>
          </div>
        </section>

        <!-- TAB 2: KURIKULUM & SILABUS -->
        <section id="tab-curriculum" class="detail-tab-pane">
          <div class="content-card-section">
            <h2 class="section-title-sm"><i class="fas fa-list-ol"></i> Struktur Bab & Unit Materi</h2>
            <p style="font-size:13px; color:var(--text-secondary); margin-bottom:20px;">
              Kurikulum disusun bertahap untuk memastikan pemahaman teori dan praktek berjalan selaras.
            </p>

            <div class="curriculum-accordion" id="curriculum-container">
              <div style="text-align: center; padding: 24px; color: var(--text-secondary); font-size: 13px;">
                <i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i> Memuat kurikulum...
              </div>
            </div>
          </div>
        </section>

        <!-- TAB 3: PROFIL INSTRUKTUR -->
        <section id="tab-instructor" class="detail-tab-pane">
          <div class="content-card-section">
            <div style="display:flex; align-items:center; gap:16px; margin-bottom:16px; flex-wrap:wrap;">
              <div class="instructor-avatar-md" id="tab-tutor-avatar" style="width:54px; height:54px; font-size:20px;">T</div>
              <div style="min-width:0; flex:1;">
                <h3 style="font-family:var(--font-serif); font-size:20px; color:var(--text-primary); margin:0 0 4px;" id="tab-tutor-name">Nama Instruktur</h3>
                <p style="font-size:13px; color:var(--text-secondary); margin:0;">Tutor Terverifikasi SkillSphere AI</p>
              </div>
            </div>
            <p style="font-size:13px; color:var(--text-secondary); line-height:1.6; margin:0;">
              Instruktur berpengalaman di bidangnya dan telah lulus proses verifikasi portofolio sertifikasi oleh Administrator SkillSphere.
            </p>
          </div>
        </section>

      </div>
    </main>

    <!-- Preview Modal -->
    <div class="preview-modal-overlay" id="preview-modal" onclick="handleClosePreviewModal(event)">
      <div class="preview-modal-box" onclick="event.stopPropagation()">
        <div class="preview-modal-header">
          <h3 style="font-family:var(--font-serif); font-size:18px; color:var(--text-primary); margin:0;" id="modal-preview-title">Preview Materi Kelas</h3>
          <button class="btn btn-outline" style="padding:4px 8px; border-radius:var(--radius-full);" onclick="closePreviewModalDirect()">
            <i class="fas fa-xmark"></i>
          </button>
        </div>
        <div class="preview-modal-body" id="modal-preview-content">
          <!-- Video or material preview dynamic frame -->
        </div>
      </div>
    </div>

  </div>

  <script>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatRupiah(amount) {
      const num = parseFloat(amount);
      if (isNaN(num) || num === 0) return 'Gratis';
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0
      }).format(num);
    }

    // Get Course ID from URL
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const courseId = pathSegments[pathSegments.length - 1];

    let currentCourse = null;
    let firstPreviewUrl = '';

    // Check Auth Token
    const token = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('access_token');
    const authBtn = document.getElementById('nav-auth-btn');
    if (token && authBtn) {
      authBtn.textContent = 'Dashboard';
      authBtn.href = '/dashboard';
    }

    // Tab Navigation Logic
    const tabButtons = document.querySelectorAll('.detail-tab-btn');
    const tabPanels = document.querySelectorAll('.detail-tab-pane');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        tabButtons.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const activePane = document.getElementById(target);
        if (activePane) activePane.classList.add('active');
      });
    });

    // Theme Toggle Handler
    const themeBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        sunIcon.style.display = 'inline-block';
        moonIcon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const nextTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('skillsphere_theme', nextTheme);
      updateThemeUI(nextTheme);
    });

    // Fetch Course Detail
    async function loadCourseDetail() {
      if (!courseId) {
        window.location.href = '/courses';
        return;
      }

      try {
        const headers = {};
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }

        const res = await fetch(`/api/courses/${courseId}`, { headers });
        const json = await res.json();

        if (!json.success || !json.data) {
          alert('Kursus tidak ditemukan atau belum dipublikasikan.');
          window.location.href = '/courses';
          return;
        }

        const course = json.data;
        currentCourse = course;

        const catName = course.category ? course.category.name : 'Teknologi';
        const tutorName = course.tutor ? course.tutor.name : 'Instruktur SkillSphere';
        const priceFormatted = formatRupiah(course.price);
        const levelFormatted = course.level === 'advanced' ? 'Mahir' : (course.level === 'intermediate' ? 'Menengah' : 'Pemula');

        // Populate Hero
        document.getElementById('breadcrumb-category').textContent = catName;
        document.getElementById('badge-category').textContent = catName;
        document.getElementById('badge-level').textContent = levelFormatted;
        document.getElementById('course-title').textContent = course.title;
        document.getElementById('course-description').textContent = course.description || 'Pelajari materi terstruktur dan kuasai keahlian baru bersama instruktur ahli.';
        
        document.getElementById('tutor-name').innerHTML = `${escapeHtml(tutorName)} <i class="fas fa-circle-check" style="color:#3B82F6;" title="Terverifikasi"></i>`;
        document.getElementById('tutor-avatar').textContent = tutorName.charAt(0).toUpperCase();

        document.getElementById('tab-tutor-name').textContent = tutorName;
        document.getElementById('tab-tutor-avatar').textContent = tutorName.charAt(0).toUpperCase();

        document.getElementById('course-price-tag').textContent = priceFormatted;

        if (course.thumbnail_url) {
          const img = document.getElementById('course-cover-img');
          if (img) {
            img.src = course.thumbnail_url;
            img.style.display = 'block';
          }
        }

        // Adjust Enroll Button Based on Auth & Enrollment
        const enrollBtn = document.getElementById('btn-enroll-main');
        if (enrollBtn) {
          if (course.is_owner) {
            enrollBtn.outerHTML = `
              <a href="/tutor/materials?courseId=${course.id}" class="btn-enroll-action" style="background:var(--accent-primary); color:var(--accent-text); text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
                <i class="fas fa-screwdriver-wrench"></i> Kelola Materi & Silabus Kelas
              </a>
            `;
          } else if (course.is_enrolled) {
            enrollBtn.outerHTML = `
              <a href="/dashboard" class="btn-enroll-action" style="background:var(--color-success); color:#FFFFFF; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:8px;">
                <i class="fas fa-graduation-cap"></i> Terdaftar: Lanjutkan Belajar
              </a>
            `;
          }
        }

        // Render Curriculum Sections & Materials
        renderCurriculum(course.sections || [], course.is_enrolled || course.is_owner);

      } catch (err) {
        console.error('Error loading course:', err);
      }
    }

    function renderCurriculum(sections, isEnrolledOrOwner = false) {
      const container = document.getElementById('curriculum-container');
      if (!container) return;

      if (sections.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:20px; color:var(--text-secondary);">Silabus materi sedang dipersiapkan oleh pengajar.</div>`;
        return;
      }

      const formatIcons = {
        video: 'fa-circle-play',
        pdf: 'fa-file-pdf',
        presentation: 'fa-file-powerpoint',
        ppt: 'fa-file-powerpoint',
        doc: 'fa-file-word',
        book: 'fa-book-open',
      };

      container.innerHTML = sections.map((sec, index) => {
        const materials = sec.materials || [];
        return `
          <div class="section-accordion-item">
            <div class="section-accordion-header" onclick="toggleSectionAccordion(this)">
              <span class="section-header-title">Bab ${index + 1}: ${escapeHtml(sec.title)}</span>
              <span class="section-header-meta">
                ${materials.length} Unit Materi <i class="fas fa-chevron-down" style="margin-left:4px;"></i>
              </span>
            </div>
            <div class="section-accordion-body">
              ${materials.length === 0 ? `<div style="padding:12px 20px; font-size:12px; color:var(--text-secondary);">Materi bab ini akan segera hadir.</div>` : materials.map(mat => {
                const iconClass = formatIcons[mat.content_type] || 'fa-file-lines';
                const isAccessible = isEnrolledOrOwner || mat.is_preview;
                const fileUrl = mat.file_url || '';

                if (mat.is_preview && !firstPreviewUrl && fileUrl) {
                  firstPreviewUrl = fileUrl;
                }

                let actionBadge = '';
                if (isAccessible) {
                  actionBadge = `
                    <button class="material-badge-preview" onclick="openMaterialPreview('${escapeHtml(mat.title)}', '${escapeHtml(fileUrl)}', '${mat.content_type}')">
                      <i class="fas fa-play" style="font-size:9px;"></i> ${mat.is_preview && !isEnrolledOrOwner ? 'Preview Gratis' : 'Buka Materi'}
                    </button>
                  `;
                } else {
                  actionBadge = `<span class="material-badge-locked"><i class="fas fa-lock"></i> Terkunci</span>`;
                }

                return `
                  <div class="material-unit-row">
                    <div class="material-meta-left">
                      <i class="fas ${iconClass} material-type-icon"></i>
                      <span class="material-unit-title">${escapeHtml(mat.title)}</span>
                    </div>
                    <div class="material-meta-right">
                      <span style="font-size:12px; color:var(--text-secondary);">${mat.duration_minutes || 5} mnt</span>
                      ${actionBadge}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('');
    }

    function toggleSectionAccordion(headerEl) {
      const body = headerEl.nextElementSibling;
      const icon = headerEl.querySelector('.fa-chevron-down, .fa-chevron-up');
      if (body.style.display === 'none') {
        body.style.display = 'flex';
        if (icon) { icon.classList.remove('fa-chevron-down'); icon.classList.add('fa-chevron-up'); }
      } else {
        body.style.display = 'none';
        if (icon) { icon.classList.remove('fa-chevron-up'); icon.classList.add('fa-chevron-down'); }
      }
    }

    // Modal Preview Controls
    function handleOpenPreviewModal() {
      if (firstPreviewUrl) {
        openMaterialPreview('Preview Pelajaran', firstPreviewUrl, 'video');
      } else {
        openMaterialPreview('Trailer Kursus', '', 'video');
      }
    }

    function openMaterialPreview(title, fileUrl, type) {
      const modal = document.getElementById('preview-modal');
      const titleEl = document.getElementById('modal-preview-title');
      const bodyEl = document.getElementById('modal-preview-content');

      titleEl.textContent = title;
      if (fileUrl && (type === 'video' || fileUrl.endsWith('.mp4'))) {
        bodyEl.innerHTML = `
          <video controls autoplay style="width:100%; max-height:420px; border-radius:var(--radius-md); background:#000;">
            <source src="${escapeHtml(fileUrl)}" type="video/mp4">
            Browser Anda tidak mendukung pemutar video.
          </video>
        `;
      } else if (fileUrl && (type === 'pdf' || fileUrl.endsWith('.pdf'))) {
        bodyEl.innerHTML = `
          <iframe src="${escapeHtml(fileUrl)}" style="width:100%; height:450px; border-radius:var(--radius-md); border:none;" title="Dokumen PDF"></iframe>
        `;
      } else if (fileUrl) {
        bodyEl.innerHTML = `
          <div style="text-align:center; padding:40px; color:#FFFFFF;">
            <i class="fas fa-file-arrow-down" style="font-size:48px; margin-bottom:14px; opacity:0.8;"></i>
            <h4 style="font-family:var(--font-serif); font-size:18px; margin-bottom:8px;">${escapeHtml(title)}</h4>
            <p style="font-size:13px; color:#A8A29A; margin-bottom:16px;">Format file: ${escapeHtml((type || 'Materi').toUpperCase())}</p>
            <a href="${escapeHtml(fileUrl)}" target="_blank" download class="btn btn-primary" style="font-size:13px; padding:8px 20px; text-decoration:none; display:inline-flex; align-items:center; gap:8px;">
              <i class="fas fa-download"></i> Unduh / Buka Materi
            </a>
          </div>
        `;
      } else {
        bodyEl.innerHTML = `
          <div style="text-align:center; padding:40px; color:#FFFFFF;">
            <i class="fas fa-circle-play" style="font-size:48px; margin-bottom:14px; opacity:0.8;"></i>
            <h4 style="font-family:var(--font-serif); font-size:18px; margin-bottom:6px;">Preview Pelajaran Terpilih</h4>
            <p style="font-size:13px; color:#A8A29A;">Daftarkan diri Anda ke kelas ini untuk mengakses kurikulum lengkap dan materi belajar.</p>
          </div>
        `;
      }
      modal.style.display = 'flex';
    }

    function handleClosePreviewModal(e) {
      if (e.target.id === 'preview-modal') {
        closePreviewModalDirect();
      }
    }

    function closePreviewModalDirect() {
      const modal = document.getElementById('preview-modal');
      const bodyEl = document.getElementById('modal-preview-content');
      bodyEl.innerHTML = '';
      modal.style.display = 'none';
    }

    // Enroll Action
    async function handleEnrollCourse() {
      const activeToken = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('access_token');
      if (!activeToken) {
        alert('Silakan masuk (login) terlebih dahulu untuk mendaftar kelas ini.');
        window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        return;
      }

      const btn = document.getElementById('btn-enroll-main');
      let originalText = '';
      if (btn) {
        originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses Pendaftaran...';
      }

      try {
        const res = await fetch(`/api/courses/${courseId}/enroll`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${activeToken}`
          }
        });

        const json = await res.json();
        if (json.success) {
          alert(json.message || 'Pendaftaran kelas berhasil! Anda akan diarahkan ke ruang belajar.');
          window.location.href = '/dashboard';
        } else {
          alert(json.message || 'Pendaftaran tidak dapat diproses.');
        }
      } catch (err) {
        alert('Terjadi kesalahan jaringan saat mendaftar kelas.');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      }
    }

    function copyCourseShareLink() {
      navigator.clipboard.writeText(window.location.href);
      alert('Tautan kursus berhasil disalin ke clipboard!');
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCourseDetail();
    });
  </script>
  <!-- Inclusive Accessibility, TTS, & Head Tracking Script -->
  <script src="/javascripts/accessibility.js"></script>
</body>
</html>
