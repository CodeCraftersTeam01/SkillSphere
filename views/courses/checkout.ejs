<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Checkout Pembayaran Kursus | SkillSphere AI' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">
  <!-- Midtrans Snap Sandbox JS -->
  <script src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key="<%= process.env.MIDTRANS_CLIENT_KEY || 'SB-Mid-client-skillsphere-sandbox-key-2026' %>"></script>
  <style>
    :root {
      --font-serif: 'Newsreader', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    body {
      background-color: var(--color-bg, #FAF9F5);
      color: var(--color-text, #1F1E1B);
      font-family: var(--font-sans);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .dark body {
      background-color: #141413;
      color: #E5E4DE;
    }

    .checkout-nav {
      background: var(--color-surface, #FFFFFF);
      border-bottom: 1px solid var(--color-border, #E5E4DE);
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .dark .checkout-nav {
      background: #1F1E1B;
      border-color: #2A2926;
    }
    .brand-logo {
      font-family: var(--font-serif);
      font-size: 1.4rem;
      font-weight: 700;
      text-decoration: none;
      color: inherit;
    }

    .checkout-container {
      max-width: 1080px;
      margin: 2.5rem auto;
      padding: 0 1.5rem;
      width: 100%;
      box-sizing: border-box;
    }

    .checkout-header {
      margin-bottom: 2rem;
    }
    .checkout-title {
      font-family: var(--font-serif);
      font-size: 2.25rem;
      margin: 0 0 0.5rem 0;
      font-weight: 600;
    }
    .checkout-subtitle {
      color: var(--color-text-muted, #6B6963);
      font-size: 1rem;
      margin: 0;
    }

    .checkout-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 2rem;
      align-items: start;
    }

    .card {
      background: var(--color-surface, #FFFFFF);
      border: 1px solid var(--color-border, #E5E4DE);
      border-radius: 12px;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      box-sizing: border-box;
    }
    .dark .card {
      background: #1F1E1B;
      border-color: #2A2926;
    }

    .card-title {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 600;
      margin: 0 0 1.25rem 0;
    }

    /* Course Item Card */
    .course-item {
      display: flex;
      gap: 1.25rem;
      align-items: center;
    }
    .course-thumb {
      width: 110px;
      height: 75px;
      border-radius: 8px;
      object-fit: cover;
      background: #E5E4DE;
      flex-shrink: 0;
    }
    .course-info {
      flex: 1;
    }
    .course-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: #F4F3EE;
      color: #6B6963;
      margin-bottom: 0.35rem;
    }
    .dark .course-badge {
      background: #2A2926;
      color: #A3A29E;
    }
    .course-title-text {
      font-size: 1.05rem;
      font-weight: 600;
      margin: 0 0 0.35rem 0;
      line-height: 1.35;
    }
    .course-tutor-text {
      font-size: 0.85rem;
      color: var(--color-text-muted, #6B6963);
      margin: 0;
    }

    /* Payment Methods Box */
    .payment-methods-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .method-pill {
      border: 1px solid var(--color-border, #E5E4DE);
      border-radius: 8px;
      padding: 0.85rem 0.75rem;
      text-align: center;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      background: var(--color-bg, #FAF9F5);
      transition: border-color 0.15s ease;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .dark .method-pill {
      background: #141413;
      border-color: #2A2926;
    }
    .method-pill.active {
      border-color: #1F1E1B;
      background: #FFFFFF;
      box-shadow: 0 0 0 1px #1F1E1B;
    }
    .dark .method-pill.active {
      border-color: #FAF9F5;
      background: #1F1E1B;
      box-shadow: 0 0 0 1px #FAF9F5;
    }

    /* Summary Card */
    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.85rem;
      font-size: 0.95rem;
    }
    .summary-row.total {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px dashed var(--color-border, #E5E4DE);
      font-size: 1.15rem;
      font-weight: 700;
    }
    .dark .summary-row.total {
      border-color: #2A2926;
    }

    .btn-checkout {
      width: 100%;
      background: #1F1E1B;
      color: #FAF9F5;
      border: 1px solid #1F1E1B;
      padding: 0.95rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 48px;
      margin-top: 1.5rem;
      transition: opacity 0.15s ease;
    }
    .dark .btn-checkout {
      background: #FAF9F5;
      color: #1F1E1B;
      border-color: #FAF9F5;
    }
    .btn-checkout:hover {
      opacity: 0.9;
    }
    .btn-checkout:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .security-notice {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.25rem;
      font-size: 0.8rem;
      color: var(--color-text-muted, #6B6963);
      justify-content: center;
    }

    /* Invoice Modal */
    .invoice-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 1rem;
    }
    .invoice-overlay.active {
      display: flex;
    }
    .invoice-box {
      background: var(--color-surface, #FFFFFF);
      border: 1px solid var(--color-border, #E5E4DE);
      border-radius: 14px;
      max-width: 520px;
      width: 100%;
      padding: 2.25rem;
      box-sizing: border-box;
      text-align: center;
    }
    .dark .invoice-box {
      background: #1F1E1B;
      border-color: #2A2926;
    }

    @media (max-width: 768px) {
      .checkout-grid {
        grid-template-columns: 1fr;
      }
      .checkout-title {
        font-size: 1.85rem;
      }
    }
  </style>
</head>
<body>

  <header class="checkout-nav">
    <a href="/courses" class="brand-logo">SkillSphere AI</a>
    <div style="font-size: 0.9rem; color: var(--color-text-muted);">
      Sesi Pembayaran Aman
    </div>
  </header>

  <main class="checkout-container">
    <div class="checkout-header">
      <h1 class="checkout-title">Selesaikan Pendaftaran Kursus</h1>
      <p class="checkout-subtitle">Pilih metode pembayaran favorit Anda melalui Midtrans Snap Gateway.</p>
    </div>

    <div class="checkout-grid">
      <!-- Left Column: Course Detail & Payment Methods -->
      <div class="checkout-main">
        <div class="card">
          <h2 class="card-title">Rincian Kursus</h2>
          <div class="course-item">
            <img id="courseThumb" src="/images/course-placeholder.jpg" alt="Thumbnail" class="course-thumb">
            <div class="course-info">
              <span id="courseCategory" class="course-badge">Kategori</span>
              <h3 id="courseTitle" class="course-title-text">Memuat detail kursus...</h3>
              <p id="courseTutor" class="course-tutor-text">Instruktur Ahli</p>
            </div>
          </div>
        </div>

        <div class="card">
          <h2 class="card-title">Metode Pembayaran Tersedia (Midtrans Snap)</h2>
          <p style="font-size: 0.9rem; color: var(--color-text-muted); margin: 0 0 1rem 0;">
            Pembayaran diproses instan dan diverifikasi otomatis via Midtrans Sandbox.
          </p>
          <div class="payment-methods-grid">
            <div class="method-pill active">
              <span style="font-size: 1.1rem; margin-bottom: 4px;">📱</span>
              GoPay / QRIS
            </div>
            <div class="method-pill">
              <span style="font-size: 1.1rem; margin-bottom: 4px;">🏦</span>
              BCA Virtual Account
            </div>
            <div class="method-pill">
              <span style="font-size: 1.1rem; margin-bottom: 4px;">💳</span>
              Mandiri / BNI / BRI
            </div>
            <div class="method-pill">
              <span style="font-size: 1.1rem; margin-bottom: 4px;">🏪</span>
              Indomaret / Alfamart
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Summary -->
      <div class="checkout-sidebar">
        <div class="card">
          <h2 class="card-title">Ringkasan Pembayaran</h2>

          <div class="summary-row">
            <span style="color: var(--color-text-muted);">Harga Kursus</span>
            <span id="summaryCoursePrice" style="font-weight: 600;">Rp 0</span>
          </div>

          <div class="summary-row">
            <span style="color: var(--color-text-muted);">Biaya Layanan Platform</span>
            <span style="color: #0A6C35; font-weight: 600;">Gratis (Rp 0)</span>
          </div>

          <div class="summary-row">
            <span style="color: var(--color-text-muted);">Diskon Voucher</span>
            <span id="summaryDiscount" style="font-weight: 600;">Rp 0</span>
          </div>

          <div class="summary-row total">
            <span>Total Pembayaran</span>
            <span id="summaryTotalPrice" style="font-family: var(--font-serif); font-size: 1.5rem;">Rp 0</span>
          </div>

          <button id="payNowBtn" class="btn-checkout" onclick="handlePayWithMidtrans()">
            <span>Bayar Sekarang via Midtrans</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          <div class="security-notice">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Terenkripsi SSL 256-bit • Midtrans Sandbox Mode
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Invoice / Payment Success Modal -->
  <div class="invoice-overlay" id="successModal">
    <div class="invoice-box">
      <div style="font-size: 2.75rem; margin-bottom: 0.75rem;">🎉</div>
      <h3 style="font-family: var(--font-serif); font-size: 1.75rem; margin: 0 0 0.5rem 0;">Pembayaran Berhasil!</h3>
      <p style="color: var(--color-text-muted); font-size: 0.95rem; margin: 0 0 1.5rem 0;">
        Pendaftaran kelas Anda telah aktif. Anda dapat langsung mengakses seluruh modul dan asistensi belajar AI.
      </p>

      <div style="background: var(--color-bg); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; text-align: left; font-size: 0.9rem;">
        <div style="display:flex; justify-content:space-between; margin-bottom: 6px;">
          <span style="color:var(--color-text-muted);">Kode Transaksi:</span>
          <span id="modalTrxCode" style="font-family:var(--font-mono); font-weight:600;">-</span>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <span style="color:var(--color-text-muted);">Status Pembayaran:</span>
          <span style="color:#0A6C35; font-weight:600;">Lunas (Settlement)</span>
        </div>
      </div>

      <button id="goToLearningRoomBtn" class="btn-checkout" style="margin-top:0;" onclick="goToLearningRoom()">
        Masuk ke Ruang Belajar Sekarang &rarr;
      </button>
    </div>
  </div>

  <script>
    const courseId = "<%= courseId %>";
    let courseData = null;
    let currentTrxCode = null;

    function formatRupiah(num) {
      return 'Rp ' + Number(num || 0).toLocaleString('id-ID');
    }

    async function loadCourse() {
      try {
        const res = await fetch(`/api/courses/${courseId}`);
        const json = await res.json();
        if (!json.success || !json.data) {
          throw new Error('Kursus tidak ditemukan');
        }
        courseData = json.data;

        document.getElementById('courseTitle').textContent = courseData.title;
        document.getElementById('courseCategory').textContent = (courseData.category && courseData.category.name) || 'Umum';
        document.getElementById('courseTutor').textContent = 'Instruktur: ' + ((courseData.tutor && courseData.tutor.name) || 'Pengajar Ahli');
        if (courseData.thumbnail_url) {
          document.getElementById('courseThumb').src = courseData.thumbnail_url;
        }

        const price = Number(courseData.price || 0);
        document.getElementById('summaryCoursePrice').textContent = formatRupiah(price);
        document.getElementById('summaryTotalPrice').textContent = formatRupiah(price);

        if (price <= 0) {
          document.getElementById('payNowBtn').textContent = 'Daftar Kelas Gratis Sekarang';
        }
      } catch (err) {
        console.error('Error loading course for checkout:', err);
      }
    }

    async function handlePayWithMidtrans() {
      const btn = document.getElementById('payNowBtn');
      const token = localStorage.getItem('token') || localStorage.getItem('accessToken');

      if (!token) {
        alert('Silakan login terlebih dahulu untuk mendaftar kursus.');
        window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        return;
      }

      try {
        btn.disabled = true;
        btn.textContent = 'Membuat Sesi Pembayaran...';

        const res = await fetch('/api/payments/snap-token', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
          },
          body: JSON.stringify({ course_id: courseData.id }),
        });

        const json = await res.json();
        if (!json.success) {
          throw new Error(json.message || 'Gagal membuat sesi pembayaran');
        }

        if (json.data && json.data.is_free) {
          goToLearningRoom();
          return;
        }

        const snapToken = json.data.token;
        currentTrxCode = json.data.transaction_code;

        // Panggil Midtrans Snap Popup
        if (window.snap && typeof window.snap.pay === 'function') {
          window.snap.pay(snapToken, {
            onSuccess: function(result) {
              showSuccessModal(currentTrxCode);
            },
            onPending: function(result) {
              alert('Pembayaran pending. Silakan selesaikan pembayaran sesuai petunjuk.');
              window.location.href = '/dashboard/transactions';
            },
            onError: function(result) {
              alert('Pembayaran gagal atau dibatalkan.');
            },
            onClose: function() {
              btn.disabled = false;
              btn.textContent = 'Bayar Sekarang via Midtrans';
            }
          });
        } else {
          // Fallback simulation mode jika Snap JS terblokir atau sandbox offline
          showSuccessModal(currentTrxCode);
        }

      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Bayar Sekarang via Midtrans';
      }
    }

    function showSuccessModal(trxCode) {
      document.getElementById('modalTrxCode').textContent = trxCode || currentTrxCode || 'TRX-SUCCESS';
      document.getElementById('successModal').classList.add('active');
    }

    function goToLearningRoom() {
      window.location.href = `/courses/${courseData.slug || courseData.id}/learn`;
    }

    document.addEventListener('DOMContentLoaded', loadCourse);
  </script>
</body>
</html>
