<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= title || 'Checkout Pembayaran Kursus | SkillSphere AI' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <!-- Midtrans Snap Sandbox JS -->
  <script src="https://app.sandbox.midtrans.com/snap/snap.js" data-client-key="<%= process.env.MIDTRANS_CLIENT_KEY || 'SB-Mid-client-skillsphere-sandbox-key-2026' %>"></script>

  <style>
    :root {
      --navbar-height: 56px;
    }

    body {
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Sticky Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 24px;
      height: var(--navbar-height);
      min-height: var(--navbar-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-main-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 20px;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 16px;
    }

    .brand-icon {
      width: 24px;
      height: 24px;
      color: var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-links-menu {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link-item {
      padding: 6px 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-full);
      transition: all 0.15s ease;
    }

    .nav-link-item:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .theme-toggle-btn {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 6px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 12px 4px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
    }

    .user-avatar-sm {
      width: 26px;
      height: 26px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
    }

    .user-name-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 6px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    /* Checkout Page Layout */
    .checkout-page-container {
      max-width: 1080px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 100%;
      box-sizing: border-box;
      flex: 1;
    }

    .breadcrumb-nav {
      font-size: 12px;
      color: var(--text-tertiary);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .breadcrumb-link {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .breadcrumb-link:hover {
      color: var(--text-primary);
      text-decoration: underline;
    }

    .checkout-hero-title {
      font-family: var(--font-serif, 'Newsreader', Georgia, serif);
      font-size: 32px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 6px;
    }

    .checkout-hero-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 0 0 32px;
      line-height: 1.5;
    }

    .checkout-two-columns {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 28px;
      align-items: start;
    }

    .content-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .content-card:last-child {
      margin-bottom: 0;
    }

    .card-heading {
      font-family: var(--font-serif, 'Newsreader', Georgia, serif);
      font-size: 19px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Course Item Detail */
    .course-summary-flex {
      display: flex;
      gap: 18px;
      align-items: center;
    }

    .course-thumb-box {
      width: 120px;
      height: 80px;
      border-radius: var(--radius-md);
      object-fit: cover;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      flex-shrink: 0;
    }

    .course-meta-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .course-name-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 4px;
      line-height: 1.35;
    }

    .course-tutor-name {
      font-size: 12px;
      color: var(--text-secondary);
      margin: 0;
    }

    /* Security Trust Badges */
    .trust-badges-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 18px;
    }

    .trust-badge-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      font-size: 12px;
      color: var(--text-secondary);
    }

    .trust-badge-item i {
      color: #059669;
      font-size: 16px;
    }

    /* Payment Summary Side */
    .summary-line-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      padding: 10px 0;
      border-bottom: 1px dashed var(--border-subtle);
      color: var(--text-secondary);
    }

    .summary-line-item:last-of-type {
      border-bottom: 1px solid var(--border-subtle);
    }

    .summary-total-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0 20px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .total-amount-display {
      font-family: var(--font-mono, monospace);
      font-size: 24px;
      font-weight: 700;
      color: var(--accent-primary);
    }

    .btn-pay-action {
      width: 100%;
      background: var(--accent-primary);
      color: var(--accent-text);
      border: none;
      padding: 14px 20px;
      border-radius: var(--radius-md);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: opacity 0.15s ease;
    }

    .btn-pay-action:hover {
      opacity: 0.92;
    }

    .btn-pay-action:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* Modal Success */
    .success-modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 16px;
      backdrop-filter: blur(4px);
    }

    .success-modal-backdrop.active {
      display: flex;
    }

    .success-modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      max-width: 480px;
      width: 100%;
      padding: 32px 28px;
      text-align: center;
      box-shadow: var(--shadow-lg, 0 12px 36px rgba(0,0,0,0.3));
    }

    .success-icon-wrap {
      width: 68px;
      height: 68px;
      background: rgba(16, 185, 129, 0.15);
      border: 2px solid #059669;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
      font-size: 32px;
      color: #059669;
    }

    @media (max-width: 860px) {
      .checkout-two-columns {
        grid-template-columns: 1fr;
      }
      .course-summary-flex {
        flex-direction: column;
        align-items: flex-start;
      }
      .course-thumb-box {
        width: 100%;
        height: 160px;
      }
    }
  </style>
</head>
<body>
  <!-- Top Navigation Header -->
  <header class="navbar" role="banner">
    <div class="nav-main-row">
      <div class="nav-brand-group">
        <a href="/dashboard" class="brand-logo" aria-label="SkillSphere AI Beranda">
          <div class="brand-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path opacity="0.38" d="M12 7.6L17.3 4.7L14.4 10L17.3 15.3L12 12.4L6.7 15.3L9.6 10L6.7 4.7Z" />
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span>SkillSphere AI</span>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="desktop-only" aria-label="Navigasi Utama">
          <ul class="nav-links-menu">
            <li><a href="/dashboard" class="nav-link-item">Beranda</a></li>
            <li><a href="/courses" class="nav-link-item">Katalog Kursus</a></li>
            <li><a href="/dashboard/roadmap" class="nav-link-item">Jalur Belajar AI</a></li>
            <li><a href="/dashboard/wishlist" class="nav-link-item">Wishlist</a></li>
            <li><a href="/dashboard/transactions" class="nav-link-item">Riwayat Transaksi</a></li>
          </ul>
        </nav>
      </div>

      <div class="nav-actions">
        <!-- Theme Toggle -->
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Ganti mode gelap atau terang">
          <i class="fas fa-moon" id="theme-icon"></i>
          <span id="theme-text">Mode Gelap</span>
        </button>

        <!-- User Profile Pill -->
        <div class="user-profile-badge" onclick="window.location.href='/profile'" title="Profil Saya">
          <div class="user-avatar-sm" id="nav-avatar">S</div>
          <span class="user-name-label" id="nav-user-name">Memuat...</span>
        </div>

        <!-- Logout Button -->
        <button class="logout-btn" id="logout-btn" type="button" title="Keluar">
          <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
          <span>Keluar</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Checkout Page Container -->
  <main class="checkout-page-container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/courses" class="breadcrumb-link">Katalog Kursus</a>
      <i class="fas fa-chevron-right" style="font-size:10px;"></i>
      <a href="javascript:history.back()" class="breadcrumb-link" id="bcCourseName">Detail Kursus</a>
      <i class="fas fa-chevron-right" style="font-size:10px;"></i>
      <span>Pendaftaran & Pembayaran</span>
    </nav>

    <h1 class="checkout-hero-title">Checkout Pendaftaran Kursus</h1>
    <p class="checkout-hero-subtitle">
      Selesaikan proses pendaftaran dengan gateway pembayaran terenkripsi Midtrans Sandbox.
    </p>

    <div class="checkout-two-columns">
      <!-- Left Column: Course Detail & Guarantees -->
      <div>
        <section class="content-card" aria-labelledby="courseCardTitle">
          <h2 class="card-heading" id="courseCardTitle">
            <i class="fas fa-graduation-cap" style="color:var(--accent-primary);"></i>
            Rincian Kelas yang Dipilih
          </h2>

          <div class="course-summary-flex">
            <img src="/images/course-default.jpg" alt="Thumbnail Kursus" id="courseThumb" class="course-thumb-box">
            <div>
              <span class="course-meta-badge" id="courseCategory">Memuat Kategori...</span>
              <h3 class="course-name-title" id="courseTitle">Memuat Judul Kursus...</h3>
              <p class="course-tutor-name" id="courseTutor">Instruktur: Pengajar Terverifikasi</p>
            </div>
          </div>

          <div class="trust-badges-grid">
            <div class="trust-badge-item">
              <i class="fas fa-certificate"></i>
              <span>Sertifikat Digital Resmi</span>
            </div>
            <div class="trust-badge-item">
              <i class="fas fa-infinity"></i>
              <span>Akses Materi Seumur Hidup</span>
            </div>
            <div class="trust-badge-item">
              <i class="fas fa-comments"></i>
              <span>Konsultasi AI Mentor 24/7</span>
            </div>
            <div class="trust-badge-item">
              <i class="fas fa-shield-halved"></i>
              <span>Garansi Sengketa 7 Hari</span>
            </div>
          </div>
        </section>

        <!-- Payment Gateway Info -->
        <section class="content-card" aria-labelledby="gatewayTitle">
          <h2 class="card-heading" id="gatewayTitle">
            <i class="fas fa-lock" style="color:var(--accent-primary);"></i>
            Gateway Pembayaran Aman
          </h2>
          <p style="font-size:13px; color:var(--text-secondary); line-height:1.6; margin:0 0 16px;">
            Transaksi diproses melalui Midtrans Snap. Anda dapat memilih metode pembayaran instan seperti <strong>GoPay, QRIS, Virtual Account BCA, Mandiri, BRI, BNI</strong>, atau transfer antarbank.
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
            <span class="preset-pill" style="font-size:11px; font-weight:700;"><i class="fas fa-qrcode"></i> QRIS</span>
            <span class="preset-pill" style="font-size:11px; font-weight:700;"><i class="fas fa-wallet"></i> GoPay / ShopeePay</span>
            <span class="preset-pill" style="font-size:11px; font-weight:700;"><i class="fas fa-building-columns"></i> Virtual Account Bank</span>
            <span class="preset-pill" style="font-size:11px; font-weight:700;"><i class="fas fa-credit-card"></i> Kartu Kredit / Debit</span>
          </div>
        </section>
      </div>

      <!-- Right Column: Order Summary & Pay Action -->
      <aside aria-label="Ringkasan Pesanan">
        <div class="content-card">
          <h2 class="card-heading">
            <i class="fas fa-receipt" style="color:var(--accent-primary);"></i>
            Ringkasan Biaya
          </h2>

          <div class="summary-line-item">
            <span>Harga Kursus</span>
            <span id="summaryCoursePrice" style="font-family:var(--font-mono); font-weight:600;">Rp 0</span>
          </div>

          <div class="summary-line-item">
            <span>Biaya Layanan Platform (20%)</span>
            <span style="color:#059669; font-weight:600;">Termasuk (Rp 0 Tambahan)</span>
          </div>

          <div class="summary-line-item">
            <span>PPN 11%</span>
            <span style="color:#059669; font-weight:600;">Dibebaskan</span>
          </div>

          <div class="summary-total-item">
            <span>Total Pembayaran</span>
            <span class="total-amount-display" id="summaryTotalPrice">Rp 0</span>
          </div>

          <button type="button" class="btn-pay-action" id="payNowBtn" onclick="handlePayWithMidtrans()">
            <i class="fas fa-shield-check"></i>
            <span>Bayar Sekarang via Midtrans</span>
          </button>

          <p style="font-size:11px; color:var(--text-tertiary); text-align:center; margin:14px 0 0; line-height:1.4;">
            Dengan mengklik tombol di atas, Anda menyetujui Ketentuan Layanan dan Kebijakan Privasi SkillSphere AI.
          </p>
        </div>
      </aside>
    </div>
  </main>

  <!-- Success Modal Popup -->
  <div class="success-modal-backdrop" id="successModal" role="dialog" aria-modal="true" aria-labelledby="successTitle">
    <div class="success-modal-card">
      <div class="success-icon-wrap">
        <i class="fas fa-check"></i>
      </div>
      <h2 style="font-family:var(--font-serif); font-size:24px; margin:0 0 8px;" id="successTitle">Pembayaran Berhasil!</h2>
      <p style="font-size:13px; color:var(--text-secondary); margin:0 0 20px;">
        Pendaftaran kelas Anda telah terverifikasi secara instan. Selamat mulai belajar!
      </p>

      <div style="background:var(--bg-surface-subtle); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:14px; margin-bottom:24px; text-align:left; font-size:12px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
          <span style="color:var(--text-secondary);">ID Transaksi:</span>
          <span id="modalTrxCode" style="font-family:var(--font-mono); font-weight:700;">-</span>
        </div>
        <div style="display:flex; justify-content:space-between;">
          <span style="color:var(--text-secondary);">Status:</span>
          <span style="color:#059669; font-weight:700;">Lunas (Verified Settlement)</span>
        </div>
      </div>

      <button type="button" class="btn-pay-action" onclick="goToLearningRoom()">
        <i class="fas fa-play"></i>
        <span>Masuk ke Ruang Belajar Sekarang</span>
      </button>
    </div>
  </div>

  <!-- Inclusive Accessibility Script -->
  <script src="/javascripts/accessibility.js"></script>

  <script>
    const courseId = "<%= courseId %>";
    let courseData = null;
    let currentTrxCode = null;

    // Theme Management
    function initTheme() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('skillsphere_theme', next);
      updateThemeUI(next);
    }

    function updateThemeUI(theme) {
      const icon = document.getElementById('theme-icon');
      const text = document.getElementById('theme-text');
      if (theme === 'dark') {
        if (icon) icon.className = 'fas fa-sun';
        if (text) text.innerText = 'Mode Terang';
      } else {
        if (icon) icon.className = 'fas fa-moon';
        if (text) text.innerText = 'Mode Gelap';
      }
    }

    document.getElementById('theme-toggle-btn').addEventListener('click', toggleTheme);

    function formatRupiah(num) {
      if (!num || Number(num) === 0) return 'Gratis';
      return 'Rp ' + Number(num).toLocaleString('id-ID');
    }

    async function loadUserProfile() {
      const token = localStorage.getItem('accessToken');
      if (!token) return;
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const u = json.data;
          document.getElementById('nav-user-name').innerText = u.name;
          const initials = u.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
          document.getElementById('nav-avatar').innerText = initials;
        }
      } catch (err) {
        console.error('Failed to load profile:', err);
      }
    }

    async function loadCourse() {
      try {
        const res = await fetch(`/api/courses/${courseId}`);
        const json = await res.json();
        if (!json.success || !json.data) {
          throw new Error('Data kursus tidak dapat dimuat.');
        }
        courseData = json.data;

        document.getElementById('courseTitle').textContent = courseData.title;
        document.getElementById('bcCourseName').textContent = courseData.title;
        document.getElementById('courseCategory').textContent = (courseData.category && courseData.category.name) || 'Teknologi & AI';
        document.getElementById('courseTutor').textContent = 'Instruktur: ' + ((courseData.tutor && courseData.tutor.name) || 'Pengajar Terverifikasi');
        if (courseData.thumbnail_url) {
          document.getElementById('courseThumb').src = courseData.thumbnail_url;
        }

        const price = Number(courseData.price || 0);
        document.getElementById('summaryCoursePrice').textContent = formatRupiah(price);
        document.getElementById('summaryTotalPrice').textContent = formatRupiah(price);

        if (price <= 0) {
          document.getElementById('payNowBtn').innerHTML = '<i class="fas fa-play"></i> <span>Daftar Kelas Gratis Sekarang</span>';
        }
      } catch (err) {
        console.error('Error loading course for checkout:', err);
      }
    }

    async function handlePayWithMidtrans() {
      const btn = document.getElementById('payNowBtn');
      const token = localStorage.getItem('token') || localStorage.getItem('accessToken');

      if (!token) {
        alert('Silakan masuk ke akun Anda terlebih dahulu untuk mendaftar kursus.');
        window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
        return;
      }

      try {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Membuka Sesi Pembayaran...</span>';

        const res = await fetch('/api/payments/snap-token', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
          },
          body: JSON.stringify({ course_id: courseData.id }),
        });

        const json = await res.json();
        if (!json.success) {
          throw new Error(json.message || 'Gagal memproses pembayaran.');
        }

        if (json.data && json.data.is_free) {
          goToLearningRoom();
          return;
        }

        const snapToken = json.data.token;
        currentTrxCode = json.data.transaction_code;

        if (window.snap && typeof window.snap.pay === 'function') {
          window.snap.pay(snapToken, {
            onSuccess: function(result) {
              showSuccessModal(currentTrxCode);
            },
            onPending: function(result) {
              alert('Pembayaran tertunda. Silakan selesaikan pembayaran sesuai instruksi.');
              window.location.href = '/dashboard/transactions';
            },
            onError: function(result) {
              alert('Pembayaran gagal atau dibatalkan.');
              btn.disabled = false;
              btn.innerHTML = '<i class="fas fa-shield-check"></i> <span>Bayar Sekarang via Midtrans</span>';
            },
            onClose: function() {
              btn.disabled = false;
              btn.innerHTML = '<i class="fas fa-shield-check"></i> <span>Bayar Sekarang via Midtrans</span>';
            }
          });
        } else {
          showSuccessModal(currentTrxCode);
        }

      } catch (err) {
        alert(err.message || 'Terjadi kesalahan sistem.');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-shield-check"></i> <span>Bayar Sekarang via Midtrans</span>';
      }
    }

    function showSuccessModal(trxCode) {
      document.getElementById('modalTrxCode').textContent = trxCode || currentTrxCode || 'TRX-SUCCESS';
      document.getElementById('successModal').classList.add('active');
    }

    function goToLearningRoom() {
      window.location.href = `/courses/${courseData.slug || courseData.id}/learn`;
    }

    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('accessToken');
      localStorage.removeItem('refreshToken');
      window.location.href = '/login';
    });

    document.addEventListener('DOMContentLoaded', () => {
      initTheme();
      loadUserProfile();
      loadCourse();
    });
  </script>
</body>
</html>
