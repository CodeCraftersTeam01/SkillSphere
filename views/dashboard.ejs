    function handleResetQuiz() {
      document.getElementById('quiz-setup-pane').style.display = 'block';
      document.getElementById('quiz-active-pane').style.display = 'none';
      document.getElementById('quiz-result-pane').style.display = 'none';
      currentAIQuizData = null;
    }

    async function handleGenerateAIQuiz() {
      const topicSelect = document.getElementById('quiz-topic-select');
      const difficultySelect = document.getElementById('quiz-difficulty-select');
      const countSelect = document.getElementById('quiz-count-select');

      const topic = topicSelect.value;
      const difficulty = difficultySelect.value;
      const numberOfQuestions = parseInt(countSelect.value, 10) || 3;

      const startBtn = document.getElementById('btn-start-ai-quiz');
      const originalText = startBtn.innerHTML;
      startBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Merumuskan Soal AI...';
      startBtn.disabled = true;

      try {
        const res = await fetch('/api/ai/quiz/generate', {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            topic,
            difficulty,
            number_of_questions: numberOfQuestions,
          }),
        });

        const json = await res.json();
        if (res.ok && json.success && json.data && Array.isArray(json.data.questions)) {
          currentAIQuizData = json.data;
          renderActiveQuiz(json.data);
        } else {
          showToast(json.message || 'Gagal membuat soal kuis AI. Mencoba mode latihan cepat...', 'error');
        }
      } catch (err) {
        showToast('Terjadi kesalahan jaringan saat membuat soal AI.', 'error');
      } finally {
        startBtn.innerHTML = originalText;
        startBtn.disabled = false;
      }
    }

    function renderActiveQuiz(quizData) {
      document.getElementById('quiz-setup-pane').style.display = 'none';
      document.getElementById('quiz-active-pane').style.display = 'block';
      document.getElementById('quiz-result-pane').style.display = 'none';

      const topicBadge = document.getElementById('quiz-active-topic-badge');
      if (topicBadge) topicBadge.textContent = `${quizData.topic} • ${quizData.difficulty.toUpperCase()}`;

      const container = document.getElementById('quiz-questions-container');
      container.innerHTML = quizData.questions.map((q, qIdx) => {
        const optionsHtml = q.options.map((opt, optIdx) => `
          <label style="display:flex; align-items:center; gap:10px; padding:8px 12px; border:1px solid var(--border-subtle); border-radius:var(--radius-md); background:var(--bg-surface); cursor:pointer; font-size:13px; color:var(--text-primary); transition:background 0.15s ease;">
            <input type="radio" name="quiz_q_${q.id || qIdx}" value="${optIdx}" style="accent-color:var(--accent-primary); cursor:pointer;" required>
            <span>${escapeHtml(opt)}</span>
          </label>
        `).join('');

        return `
          <div style="background:var(--bg-surface-subtle); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:16px;">
            <div style="font-size:11px; font-weight:700; color:var(--accent-primary); text-transform:uppercase; margin-bottom:6px;">
              Pertanyaan ${qIdx + 1} dari ${quizData.questions.length}
            </div>
            <div style="font-size:14px; font-weight:600; color:var(--text-primary); margin-bottom:12px; line-height:1.45;">
              ${escapeHtml(q.question)}
            </div>
            <div style="display:flex; flex-direction:column; gap:8px;">
              ${optionsHtml}
            </div>
          </div>
        `;
      }).join('');
    }

    function handleQuizSubmit() {
      if (!currentAIQuizData || !Array.isArray(currentAIQuizData.questions)) return;

      const questions = currentAIQuizData.questions;
      let score = 0;
      const userAnswers = [];

      for (let i = 0; i < questions.length; i++) {
        const q = questions[i];
        const selected = document.querySelector(`input[name="quiz_q_${q.id || i}"]:checked`);
        if (!selected) {
          showToast(`Mohon jawab pertanyaan nomor ${i + 1} terlebih dahulu.`, 'error');
          return;
        }
        const userAnsIndex = parseInt(selected.value, 10);
        userAnswers.push(userAnsIndex);
        if (userAnsIndex === q.answer_index) {
          score += 1;
        }
      }

      const total = questions.length;
      const percentScore = Math.round((score / total) * 100);

      // Render Result Pane
      document.getElementById('quiz-setup-pane').style.display = 'none';
      document.getElementById('quiz-active-pane').style.display = 'none';
      document.getElementById('quiz-result-pane').style.display = 'block';

      const scoreText = document.getElementById('quiz-result-score-text');
      const scoreIcon = document.getElementById('quiz-result-icon');
      const summaryText = document.getElementById('quiz-result-summary');

      if (scoreText) scoreText.textContent = `Skor Anda: ${percentScore}/100 (${score} dari ${total} benar)`;
      if (scoreIcon) scoreIcon.textContent = percentScore >= 70 ? '🎉' : '💡';
      if (summaryText) {
        summaryText.textContent = percentScore >= 70 
          ? 'Selamat! Pemahaman Anda pada materi ini sudah sangat baik. Lanjutkan ke tantangan berikutnya.'
          : 'Bagus! Anda telah menyelesaikan latihan. Pelajari kembali poin pembahasan di bawah untuk memperdalam pemahaman.';
      }

      const reviewContainer = document.getElementById('quiz-review-container');
      reviewContainer.innerHTML = questions.map((q, idx) => {
        const isCorrect = userAnswers[idx] === q.answer_index;
        return `
          <div style="background:var(--bg-surface-subtle); border:1px solid ${isCorrect ? 'var(--color-success)' : 'var(--border-subtle)'}; border-radius:var(--radius-md); padding:12px 14px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-size:11px; font-weight:700; color:var(--text-secondary);">Soal ${idx + 1}</span>
              <span style="font-size:11px; font-weight:700; color:${isCorrect ? 'var(--color-success)' : 'var(--color-danger)'};">
                ${isCorrect ? '<i class="fas fa-circle-check"></i> Jawaban Benar' : '<i class="fas fa-circle-xmark"></i> Perlu Evaluasi'}
              </span>
            </div>
            <div style="font-size:13px; font-weight:600; color:var(--text-primary); margin-bottom:6px;">${escapeHtml(q.question)}</div>
            <div style="font-size:12px; color:var(--text-secondary); margin-bottom:4px;">
              Jawaban Tepat: <strong style="color:var(--text-primary);">${escapeHtml(q.options[q.answer_index])}</strong>
            </div>
            ${q.explanation ? `<div style="font-size:11.5px; color:var(--text-tertiary); font-style:italic; line-height:1.4; margin-top:4px;">Penjelasan: ${escapeHtml(q.explanation)}</div>` : ''}
          </div>
        `;
      }).join('');

      showToast(`Kuis selesai! Anda memperoleh skor ${percentScore}/100.`, 'success');
    }

  </script>

  <!-- PWA Service Worker & Install Prompt Banner -->
  <script src="/javascripts/pwa-installer.js"></script>
  <!-- Inclusive Accessibility, TTS, & Head Tracking Script -->
  <script src="/javascripts/accessibility.js"></script>
</body>
</html>

