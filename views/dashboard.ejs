      if (!select) return;
      try {
        const res = await fetch('/api/courses/categories');
        const json = await res.json();
        const categories = (json.success && Array.isArray(json.data)) ? json.data : [];
        
        select.innerHTML = '<option value="">Pilih Kategori...</option>' + categories.map(cat => `
