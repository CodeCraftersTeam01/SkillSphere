  <style>
    .dashboard-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    /* Top Main Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links-menu {
      display: flex;
      align-items: center;
      gap: 6px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link-item {
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-link-item:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-link-item.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
      border-bottom: 2px solid var(--accent-primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .streak-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      font-size: 12px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .user-profile-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 12px 5px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
    }

    .user-avatar-sm {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
    }

    .user-name-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .user-role-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 7px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .logout-btn:hover {
      background: var(--color-danger-bg);
      border-color: var(--color-danger);
      color: var(--color-danger);
    }

    /* Main Container (2-Column Grid like Dicoding) */
    .dashboard-container {
      max-width: 1240px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 80px;
      flex: 1;
    }

    .dashboard-grid-layout {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 960px) {
      .dashboard-grid-layout {
        grid-template-columns: 1fr;
      }
      .nav-links-menu {
        display: none;
      }
    }

    /* Left Sidebar Widget Cards */
    .sidebar-widgets-column {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .widget-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      position: relative;
    }

    .profile-hero-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .circular-progress-box {
      width: 64px;
      height: 64px;
      border-radius: var(--radius-full);
      border: 4px solid var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
      margin-bottom: 6px;
    }

    .profile-card-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.3;
      margin: 0;
    }

    .profile-card-desc {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin: 0;
    }

    .profile-card-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: none;
      margin-top: 4px;
      transition: gap 0.2s ease;
    }

    .profile-card-cta:hover {
      gap: 10px;
    }

    /* Streak Widget */
    .streak-day-row {
      display: flex;
      justify-content: space-between;
      gap: 6px;
      margin: 16px 0;
    }

    .streak-day-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--text-tertiary);
      font-weight: 600;
    }

    .streak-circle {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .streak-circle.active {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    /* Right Main Content Area */
    .main-activities-column {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .section-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 26px;
      box-shadow: var(--shadow-sm);
    }

    .section-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
    }

    /* AI Adaptive Recommendation Hub */
    .ai-adaptive-banner {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }

    .ai-adaptive-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .ai-adaptive-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .ai-stage-pill {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .ai-insight-quote {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.55;
      padding-left: 12px;
      border-left: 3px solid var(--accent-primary);
      margin: 0;
    }

    .ai-next-steps-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-tertiary);
      font-weight: 500;
    }

    /* Learning Activity Rows */
    .activity-course-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .activity-course-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: all 0.2s ease;
    }

    .activity-course-item:hover {
      border-color: var(--border-strong);
      background: var(--bg-surface-subtle);
      transform: translateY(-1px);
    }

    .activity-info {
      flex: 1;
      min-width: 0;
    }

    .activity-badge-text {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .activity-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .activity-progress-bar {
      width: 100%;
      height: 5px;
      background: var(--border-subtle);
      border-radius: 99px;
      overflow: hidden;
      margin-top: 8px;
    }

    .activity-progress-fill {
      height: 100%;
      background: var(--accent-primary);
      border-radius: 99px;
    }

    .btn-continue-learning {
      background: var(--accent-primary);
      color: var(--accent-text);
      border: none;
      padding: 8px 16px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: opacity 0.15s ease;
    }

    .btn-continue-learning:hover {
      opacity: 0.88;
    }

    /* Sub Activities Grid */
    .sub-activities-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    @media (max-width: 600px) {
      .sub-activities-grid {
        grid-template-columns: 1fr;
      }
    }

    .sub-activity-card {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 16px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .sub-activity-card:hover {
      border-color: var(--border-strong);
      background: var(--bg-surface);
      transform: translateY(-2px);
    }

    .sub-activity-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .sub-activity-desc {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    /* Course Catalog Grid */
    .courses-catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 14px;
    }

    .course-card-mini {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.2s ease;
    }

    .course-card-mini:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .course-mini-thumb {
      width: 100%;
      height: 120px;
