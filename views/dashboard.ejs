          </div>

          <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
            <button type="button" class="btn btn-outline" onclick="closeQuizModal()" style="font-size:12.5px; padding:7px 16px;">
              Batal
            </button>
            <button type="button" id="btn-start-ai-quiz" class="btn btn-primary" style="font-size:12.5px; padding:7px 20px;" onclick="handleGenerateAIQuiz()">
              <i class="fas fa-wand-magic-sparkles" style="margin-right:6px;"></i> Buat Soal AI & Mulai
            </button>
          </div>
        </div>

        <!-- Step 2: Live Quiz Rendering Pane -->
        <div id="quiz-active-pane" style="display:none;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--border-subtle);">
            <span style="font-size:12px; font-weight:700; color:var(--accent-primary);" id="quiz-active-topic-badge">Topik Kuis</span>
            <span style="font-size:12px; color:var(--text-secondary);" id="quiz-active-timer"><i class="fas fa-stopwatch"></i> Latihan Mandiri</span>
          </div>

          <div id="quiz-questions-container" style="display:flex; flex-direction:column; gap:18px; max-height:55vh; overflow-y:auto; padding-right:4px;"></div>

          <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px; border-top:1px solid var(--border-subtle); padding-top:14px;">
            <button type="button" class="btn btn-outline" onclick="handleResetQuiz()" style="font-size:12.5px; padding:7px 16px;">
              Ganti Topik
            </button>
            <button type="button" id="btn-submit-ai-quiz" class="btn btn-primary" style="font-size:12.5px; padding:7px 20px;" onclick="handleQuizSubmit()">
              <i class="fas fa-paper-plane" style="margin-right:6px;"></i> Kirim & Nilai Kuis
            </button>
          </div>
        </div>

        <!-- Step 3: Result & Explanations Pane -->
        <div id="quiz-result-pane" style="display:none;">
          <div style="text-align:center; padding:16px 8px 20px; border-bottom:1px solid var(--border-subtle); margin-bottom:16px;">
            <div style="font-size:36px; margin-bottom:6px;" id="quiz-result-icon">🎉</div>
            <h4 style="font-family:var(--font-serif); font-size:22px; font-weight:600; color:var(--text-primary); margin:0 0 6px;" id="quiz-result-score-text">Skor: 100/100</h4>
            <p style="font-size:13px; color:var(--text-secondary); max-width:440px; margin:0 auto;" id="quiz-result-summary">
              Luar biasa! Pemahaman Anda pada materi ini sangat solid.
            </p>
          </div>

          <div id="quiz-review-container" style="display:flex; flex-direction:column; gap:12px; max-height:45vh; overflow-y:auto; padding-right:4px;"></div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:18px; border-top:1px solid var(--border-subtle); padding-top:14px;">
            <span style="font-size:12px; color:var(--color-success); font-weight:600;"><i class="fas fa-bolt"></i> +1 Streak Latihan Bertambah</span>
            <button type="button" class="btn btn-primary" onclick="handleResetQuiz()" style="font-size:12.5px; padding:7px 18px;">
              <i class="fas fa-rotate-left"></i> Coba Topik Lain
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- Footer -->
    <footer class="login-footer" style="padding-bottom: 24px; border-top:1px solid var(--border-subtle); padding-top:24px;">
      <p>© 2026 SkillSphere AI - Platform Pembelajaran Cerdas & Kurikulum Adaptif.</p>
    </footer>
  </div>

  <!-- Global Toast Notification -->
  <div id="toast-container" style="position:fixed; bottom:24px; right:24px; z-index:9999; display:flex; flex-direction:column; gap:8px;"></div>

  <script>
    // 1. Theme Switcher Logic
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIconSun = document.getElementById('theme-icon-sun');
    const themeIconMoon = document.getElementById('theme-icon-moon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(theme) {
      if (theme === 'dark') {
        themeIconSun.style.display = 'inline-block';
        themeIconMoon.style.display = 'none';
        themeText.textContent = 'Mode Terang';
      } else {
        themeIconSun.style.display = 'none';
        themeIconMoon.style.display = 'inline-block';
        themeText.textContent = 'Mode Gelap';
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', active);
      localStorage.setItem('skillsphere_theme', active);
      updateThemeUI(active);
    });

    // 2. Check Authentication & Load Data
    const token = localStorage.getItem('skillsphere_access_token');
    let currentUser = null;

    if (!token) {
      window.location.href = '/login';
    } else {
      // Early check: if user is admin, route immediately to Admin Portal
      try {
        const savedUser = localStorage.getItem('skillsphere_user');
        if (savedUser) {
          const parsed = JSON.parse(savedUser);
          if (parsed.role === 'admin') {
            window.location.href = '/admin';
          }
        }
      } catch (e) {}

      initAppDashboard(token);
    }

    async function initAppDashboard(accessToken) {
      await loadUserProfile(accessToken);
    }

    async function loadUserProfile(accessToken) {
      try {
        const res = await fetch('/api/auth/me', {
          headers: {
            'Authorization': 'Bearer ' + accessToken,
          },
        });

        if (!res.ok) {
          localStorage.removeItem('skillsphere_access_token');
          window.location.href = '/login';
          return;
        }

        const json = await res.json();
        const user = json.data;
        currentUser = user;

        // Admin role check: Admin only uses Admin Dashboard
        if (user.role === 'admin') {
          window.location.href = '/admin';
          return;
        }

        // Enforce completed onboarding for new students, allow tutors directly
        const hasCompletedOnboarding = user.role === 'tutor' || 
          (user.profile && user.profile.study_preferences && user.profile.study_preferences.onboarding_completed);

        if (!hasCompletedOnboarding) {
          window.location.href = '/dashboard/onboarding';
          return;
        }

        const initials = user.name ? user.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';
        document.getElementById('nav-avatar').textContent = initials;
        document.getElementById('nav-user-name').textContent = user.name;
        
        let roleDisplay = 'Siswa';
        if (user.role === 'tutor') roleDisplay = 'Tutor';
        document.getElementById('nav-user-role').textContent = roleDisplay;

        // Dynamic Profile Completeness calculation
        let percent = 20; // base account
        if (user.name) percent += 10;
        if (user.email) percent += 10;
        if (user.profile) {
          if (user.profile.bio) percent += 20;
          if (user.profile.phone_number) percent += 10;
          if (user.profile.career_goal) percent += 15;
          if (user.profile.study_preferences && Object.keys(user.profile.study_preferences).length > 0) percent += 15;
        }
        percent = Math.min(percent, 100);
        const percentBadge = document.getElementById('profile-percent-badge');
        if (percentBadge) percentBadge.textContent = percent + '%';

        const heroTitle = document.getElementById('profile-hero-card-title');
        const heroDesc = document.getElementById('profile-hero-card-desc');
        const heroCta = document.getElementById('profile-hero-card-cta');
        if (percent >= 100) {
          if (heroTitle) heroTitle.textContent = 'Profil Anda Sudah Lengkap';
          if (heroDesc) heroDesc.textContent = 'Seluruh preferensi belajar Anda telah tersimpan. Nikmati rekomendasi kurikulum adaptif AI secara optimal.';
          if (heroCta) {
            heroCta.innerHTML = 'Lihat Jalur Belajar AI <i class="fas fa-arrow-right" style="font-size:11px;"></i>';
            heroCta.href = '/dashboard/roadmap';
          }
        } else {
          if (heroTitle) heroTitle.textContent = 'Kelengkapan Profil Anda';
          if (heroDesc) heroDesc.textContent = 'Lengkapi preferensi dan tujuan karir Anda untuk memaksimalkan rekomendasi kurikulum adaptif AI.';
          if (heroCta) {
            heroCta.innerHTML = 'Lengkapi Preferensi <i class="fas fa-arrow-right" style="font-size:11px;"></i>';
            heroCta.href = '/dashboard/onboarding';
          }
        }

        // Dynamic Referral Code for Student
        const refDisplay = document.getElementById('referral-code-display');
        if (refDisplay) {
          const rawName = (user.name || 'STUDENT').replace(/[^a-zA-Z]/g, '').substring(0, 4).toUpperCase();
          const userRefCode = `SKILL-${user.id}-${rawName || '2026'}`;
          refDisplay.textContent = userRefCode;
          refDisplay.setAttribute('data-code', userRefCode);
        }

        // Tutor verification bar logic
        const verifBar = document.getElementById('tutor-verification-bar');
        const topBadge = document.getElementById('top-bar-badge');
        const topText = document.getElementById('top-bar-text');
        const topCtaLabel = document.getElementById('top-bar-cta-label');
        const topCtaBtn = document.getElementById('top-bar-cta-btn');

        const apps = Array.isArray(user.tutor_applications) ? user.tutor_applications : [];
        const latestApp = apps.length > 0 ? apps[apps.length - 1] : null;
        const isVerifiedTutor = user.role === 'tutor' && latestApp && latestApp.status === 'approved';

        if (user.role === 'tutor') {
          // TUTOR ROLE VIEW: Show Google Classroom Section & Hide Student Dashboard Container
          document.getElementById('tutor-classroom-section').style.display = 'flex';
          const studentContainer = document.getElementById('student-dashboard-container');
          if (studentContainer) studentContainer.style.display = 'none';

          // Hide streak badge for tutor
          const streakBadge = document.querySelector('.streak-badge');
          if (streakBadge) streakBadge.style.display = 'none';

          // Update desktop & mobile navigation links for tutor
          updateNavLinksForRole('tutor');

          if (isVerifiedTutor) {
            if (verifBar) verifBar.style.display = 'none';
          } else {
            if (verifBar) {
              verifBar.style.display = 'flex';
              if (latestApp && latestApp.status === 'pending') {
                if (topBadge) { topBadge.className = 'top-bar-badge status-pending'; topBadge.textContent = 'Dalam Review'; }
                if (topText) topText.textContent = 'Pendaftaran Pengajar Sedang Ditinjau Admin: Berkas CV dan portofolio Anda sedang dalam proses evaluasi.';
                if (topCtaLabel) topCtaLabel.textContent = 'Lihat Status';
              } else if (latestApp && latestApp.status === 'rejected') {
                if (topBadge) { topBadge.className = 'top-bar-badge status-rejected'; topBadge.textContent = 'Perlu Revisi'; }
                if (topText) topText.textContent = `Verifikasi Pengajar Perlu Revisi: ${latestApp.rejection_reason || 'Mohon lengkapi kualifikasi Anda.'}`;
                if (topCtaLabel) topCtaLabel.textContent = 'Ajukan Ulang';
              } else {
                if (topBadge) { topBadge.className = 'top-bar-badge'; topBadge.textContent = 'Verifikasi Pengajar'; }
                if (topText) topText.textContent = 'Mohon verifikasi data kualifikasi dan portofolio Anda terlebih dahulu sebelum mengelola kurikulum di Studio Pengajar.';
                if (topCtaLabel) topCtaLabel.textContent = 'Lengkapi Sekarang';
              }
            }
          }

          // Update wallet display
          if (user.wallet) {
            const formatted = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(user.wallet.balance);
            const wElem = document.getElementById('tutor-wallet-balance-val');
            if (wElem) wElem.textContent = formatted;
          }

          // Load Google Classroom Tutor Courses & Categories
          await loadTutorClassroomCourses(accessToken);
          loadCategoriesForModal();

        } else {
          // STUDENT ROLE VIEW: Show Student Section & Hide Tutor Classroom Section
          document.getElementById('tutor-classroom-section').style.display = 'none';
          const studentContainer = document.getElementById('student-dashboard-container');
          if (studentContainer) studentContainer.style.display = 'block';
          const studentSection = document.getElementById('student-dashboard-section');
          if (studentSection) studentSection.style.display = 'grid';
          if (verifBar) verifBar.style.display = 'none';

          updateNavLinksForRole('student');
          const enrolledIds = await loadStudentActivities(accessToken);
          await loadCoursesCatalog(enrolledIds);
          initStreakAndCheckin(user.id);
        }

      } catch (err) {
        console.error('Failed to load user profile:', err);
      }
    }

    function updateNavLinksForRole(role) {
      const desktopNav = document.getElementById('desktop-nav-menu');
      const mobileNavRow = document.getElementById('mobile-nav-row');
      const sidebarToggle = document.getElementById('classroom-sidebar-toggle');
      const streakBadge = document.querySelector('.streak-badge');
      const navbar = document.querySelector('.navbar');
      
      if (role === 'tutor' || role === 'admin') {
        // Hide horizontal navbar text links for tutor (per Google Classroom design)
        if (desktopNav) {
          desktopNav.style.display = 'none';
          desktopNav.classList.add('is-hidden');
        }
        if (mobileNavRow) {
          mobileNavRow.style.display = 'none';
          mobileNavRow.classList.add('is-hidden');
        }
        if (navbar) navbar.classList.add('no-subnav');
        if (streakBadge) streakBadge.style.display = 'none';
        // Show Classroom Drawer Hamburger button
        if (sidebarToggle) sidebarToggle.style.display = 'inline-flex';
      } else {
        // Show standard navigation links for students
        if (desktopNav) {
          desktopNav.style.display = '';
          desktopNav.classList.remove('is-hidden');
        }
        if (mobileNavRow) {
          mobileNavRow.style.display = '';
          mobileNavRow.classList.remove('is-hidden');
        }
        if (navbar) navbar.classList.remove('no-subnav');
        if (streakBadge) streakBadge.style.display = '';
        // Hide Classroom Drawer Hamburger button for students
        if (sidebarToggle) sidebarToggle.style.display = 'none';
        toggleClassroomSidebar(false);
      }
    }

    function toggleClassroomSidebar(open) {
      const sidebar = document.getElementById('classroom-left-sidebar');
      const backdrop = document.getElementById('classroom-sidebar-backdrop');
      if (!sidebar) return;
      const isMobile = window.innerWidth <= 1024;
      if (isMobile) {
        const shouldOpen = (open !== undefined) ? open : !sidebar.classList.contains('drawer-open');
        if (shouldOpen) {
          sidebar.classList.add('drawer-open');
          if (backdrop) backdrop.classList.add('active');
          document.body.style.overflow = 'hidden';
        } else {
          sidebar.classList.remove('drawer-open');
          if (backdrop) backdrop.classList.remove('active');
          document.body.style.overflow = '';
        }
      } else {
        if (open === false) {
          sidebar.classList.add('collapsed');
        } else if (open === true) {
          sidebar.classList.remove('collapsed');
        } else {
          sidebar.classList.toggle('collapsed');
        }
      }
    }

    function toggleSidebarSection(sectionName) {
      const group = document.getElementById(`sidebar-${sectionName}-group`);
      const chevron = document.getElementById(`chevron-${sectionName}`);
      if (!group) return;
      if (group.style.display === 'none') {
        group.style.display = 'flex';
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      } else {
        group.style.display = 'none';
        if (chevron) chevron.style.transform = 'rotate(-90deg)';
      }
    }

    // =========================================================
    // 3. GOOGLE CLASSROOM TUTOR COURSES RENDERER
    // =========================================================
    async function loadTutorClassroomCourses(accessToken) {
      const grid = document.getElementById('tutor-courses-grid');
      const sidebarClasses = document.getElementById('sidebar-teaching-classes');

      try {
        const res = await fetch('/api/courses/tutor/my-courses', {
          headers: {
            'Authorization': 'Bearer ' + accessToken,
          },
        });

        const json = await res.json();
        const courses = (json.success && Array.isArray(json.data)) ? json.data : [];

        // Populate Left Docked Sidebar Teaching Classes List
        if (sidebarClasses) {
          if (!courses.length) {
            sidebarClasses.innerHTML = `
              <div style="padding:6px 24px; font-size:12px; color:var(--text-tertiary);">Belum ada kelas</div>
            `;
          } else {
            sidebarClasses.innerHTML = courses.map((c, idx) => {
              const themeClass = `card-theme-${idx % 7}`;
              const initial = c.title ? c.title.trim().charAt(0).toUpperCase() : 'K';
              const categoryName = c.category ? escapeHtml(c.category.name) : 'Kelas';
              return `
                <a href="#course-card-${c.id}" class="sidebar-class-row" onclick="if(window.innerWidth<=1024) toggleClassroomSidebar(false)">
                  <div class="sidebar-class-circle ${themeClass}">${initial}</div>
                  <div class="sidebar-class-text">
                    <span class="sidebar-class-title">${escapeHtml(c.title)}</span>
                    <span class="sidebar-class-subtitle">${categoryName}</span>
                  </div>
                </a>
              `;
            }).join('');
          }
        }

        if (!courses.length) {
          grid.innerHTML = `
            <div style="grid-column:1 / -1; text-align:center; padding:48px 20px; background:var(--bg-surface); border:1px dashed var(--border-subtle); border-radius:8px;">
              <div style="width:60px; height:60px; border-radius:var(--radius-full); background:var(--bg-surface-subtle); display:flex; align-items:center; justify-content:center; margin:0 auto 16px; font-size:24px; color:var(--text-secondary);">
                <i class="fas fa-chalkboard"></i>
              </div>
              <h3 style="font-family:var(--font-serif); font-size:20px; color:var(--text-primary); margin:0 0 6px;">Belum Ada Kelas Mengajar</h3>
              <p style="font-size:13.5px; color:var(--text-secondary); max-width:440px; margin:0 auto 20px; line-height:1.5;">
                Mulai buat kelas kursus pertama Anda untuk mempublikasikan materi pembelajaran terstruktur kepada siswa.
              </p>
              <button class="btn btn-primary" onclick="openCreateCourseModal()" style="font-size:13px; padding:9px 20px;">
                <i class="fas fa-plus" style="margin-right:6px;"></i> Buat Kelas Pertama
              </button>
            </div>
          `;
          return;
        }

        const themesCount = 7;
        const tutorName = currentUser && currentUser.name ? escapeHtml(currentUser.name) : 'Instruktur';
        const tutorInitial = currentUser && currentUser.name ? currentUser.name.trim().charAt(0).toUpperCase() : 'T';

        let totalEarningsAcc = 0;
        let totalStudentsAcc = 0;
        let totalModulesAcc = 0;
        let totalSectionsAcc = 0;

        grid.innerHTML = courses.map((c, idx) => {
          const themeClass = `card-theme-${idx % themesCount}`;
          const categoryName = c.category ? escapeHtml(c.category.name) : 'Teknologi';
          const thumbUrl = c.thumbnail_url || c.thumbnail || '';
          const headerBgStyle = thumbUrl 
            ? `background-image: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.78) 100%), url('${thumbUrl}'); background-size: cover; background-position: center;`
            : '';
          
          let sectionsCount = 0;
          let materialsCount = 0;
          if (c.sections && Array.isArray(c.sections)) {
            sectionsCount = c.sections.length;
            c.sections.forEach(s => {
              if (s.materials && Array.isArray(s.materials)) {
                materialsCount += s.materials.length;
              }
            });
          }

          const enrollmentsCount = (c.enrollments && Array.isArray(c.enrollments)) ? c.enrollments.length : 0;
          const priceNumber = Number(c.price) || 0;
          const courseGross = enrollmentsCount * priceNumber;
          const courseNet = courseGross * 0.8; // 80% Tutor Revenue Split

          totalEarningsAcc += courseNet;
          totalStudentsAcc += enrollmentsCount;
          totalModulesAcc += materialsCount;
          totalSectionsAcc += sectionsCount;

          const descText = c.description ? escapeHtml(c.description) : 'Belum ada tugas tenggat waktu.';
          const levelMap = { 'beginner': 'Pemula', 'intermediate': 'Menengah', 'advanced': 'Mahir' };
          const levelLabel = levelMap[c.level] || 'Semua Tingkat';
          const priceFormatted = (c.price && c.price > 0) ? 'Rp ' + Number(c.price).toLocaleString('id-ID') : 'Gratis';
          const courseEarningsFormatted = priceNumber > 0 ? ('Rp ' + Math.round(courseNet).toLocaleString('id-ID')) : 'Rp 0 (Gratis)';

          return `
            <div class="classroom-card" id="course-card-${c.id}">
              <!-- Header Banner -->
              <div class="classroom-card-header ${themeClass}" style="${headerBgStyle}">
                <button class="classroom-card-menu-btn" title="Opsi lainnya" onclick="openCourseMenu(${c.id}, event)">
                  <i class="fas fa-ellipsis-vertical"></i>
                </button>
                <div class="classroom-card-titles">
                  <a href="/tutor/materials?courseId=${c.id}" class="classroom-card-title" title="${escapeHtml(c.title)}">${escapeHtml(c.title)}</a>
                  <div class="classroom-card-subtitle">${categoryName} • ${levelLabel}</div>
                  <div class="classroom-card-tutor">${tutorName}</div>
                </div>
                <!-- Overlapping Avatar -->
                <div class="classroom-card-avatar" title="${tutorName}">
                  ${tutorInitial}
                </div>
              </div>

              <!-- Middle Body -->
              <div class="classroom-card-body">
                <p class="classroom-card-body-text">${descText}</p>
                <div class="classroom-card-body-meta">
                  <span>${sectionsCount} Bab • ${enrollmentsCount} Siswa</span>
                  <span style="font-weight:600; color:var(--text-primary);">${priceFormatted}</span>
                </div>
                <div style="margin-top:6px; padding-top:6px; border-top:1px dashed var(--border-subtle); display:flex; justify-content:space-between; align-items:center; font-size:11.5px;">
                  <span style="color:var(--text-secondary);"><i class="fas fa-coins" style="color:var(--accent-primary); margin-right:4px;"></i> Hasil Tutor (80%):</span>
                  <span style="font-family:var(--font-mono, monospace); font-weight:700; color:var(--text-primary);">${courseEarningsFormatted}</span>
                </div>
              </div>

              <!-- Bottom Footer -->
              <div class="classroom-card-footer">
                <a href="/courses/${c.id}" class="classroom-card-footer-icon" title="Lihat Pratinjau Publik Kursus">
                  <i class="fa-regular fa-address-card"></i>
                </a>
                <a href="/tutor/materials?courseId=${c.id}" class="classroom-card-footer-icon" title="Buka Folder Modul Materi">
                  <i class="fa-regular fa-folder-open"></i>
                </a>
                <button class="classroom-card-footer-icon" title="Opsi lainnya" onclick="openCourseMenu(${c.id}, event)">
                  <i class="fas fa-ellipsis-vertical"></i>
                </button>
              </div>
            </div>
          `;
        }).join('');

        // Populate Tutor Financial Overview Banner
        const wallet = currentUser && currentUser.wallet ? currentUser.wallet : null;
        const walletBalance = wallet ? (Number(wallet.balance) || 0) : 0;
        const walletPending = wallet ? (Number(wallet.pending_balance) || 0) : 0;
        const totalRevenueDisplay = (totalEarningsAcc > 0) ? totalEarningsAcc : (walletBalance + walletPending);

        const elBalance = document.getElementById('tutor-wallet-balance');
        const elPending = document.getElementById('tutor-wallet-pending');
        const elTotal = document.getElementById('tutor-total-earnings');
        const elStudents = document.getElementById('tutor-total-students-count');
        const elCourses = document.getElementById('tutor-total-courses');
        const elModules = document.getElementById('tutor-total-modules-count');

        if (elBalance) elBalance.textContent = 'Rp ' + Math.round(walletBalance).toLocaleString('id-ID');
        if (elPending) elPending.textContent = 'Rp ' + Math.round(walletPending).toLocaleString('id-ID');
        if (elTotal) elTotal.textContent = 'Rp ' + Math.round(totalRevenueDisplay).toLocaleString('id-ID');
        if (elStudents) elStudents.textContent = `${totalStudentsAcc} Siswa Terdaftar`;
        if (elCourses) elCourses.textContent = `${courses.length} Kelas`;
        if (elModules) elModules.textContent = `${totalSectionsAcc} Bab • ${totalModulesAcc} Modul`;

      } catch (err) {
        console.error('Failed to load tutor classroom courses:', err);
        grid.innerHTML = `
