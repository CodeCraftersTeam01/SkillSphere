    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.style.cssText = `
        background: var(--bg-surface);
        color: var(--text-primary);
        padding: 12px 18px;
        border-radius: var(--radius-md);
        border: 1px solid ${type === 'error' ? 'var(--color-danger, #ef4444)' : 'var(--border-subtle)'};
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: slideIn 0.2s ease-out;
      `;
      const icon = type === 'error' ? '<i class="fas fa-circle-exclamation" style="color:var(--color-danger,#ef4444);"></i>' : '<i class="fas fa-circle-check" style="color:var(--color-success,#10b981);"></i>';
      toast.innerHTML = `${icon} <span>${escapeHtml(message)}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

