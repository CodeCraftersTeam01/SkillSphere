      border: none;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s ease;
      z-index: 6;
      font-size: 15px;
    }

    .classroom-card-menu-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .classroom-card-titles {
      padding-right: 36px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .classroom-card-title {
      font-size: 17px;
      font-weight: 600;
      color: #FFFFFF;
      margin: 0;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      cursor: pointer;
    }

    .classroom-card-title:hover {
      text-decoration: underline;
    }

    .classroom-card-subtitle {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.88);
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .classroom-card-tutor {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.88);
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Floating Circle Avatar */
    .classroom-card-avatar {
      position: absolute;
      bottom: -30px;
      right: 16px;
      width: 60px;
      height: 60px;
      border-radius: var(--radius-full);
