<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Belajar | SkillSphere AI</title>
  <meta name="description" content="Dashboard belajar personal peserta dan portal studio pengajar SkillSphere AI.">
  
  <!-- PWA Manifest & App Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1F1E1B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="SkillSphere">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  
  <!-- Google Fonts: Newsreader (Editorial Serif) & Plus Jakarta Sans (Modern Sans) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Claude Design System Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <!-- Accessibility & Head Tracking Stylesheet -->
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <!-- Custom Alert & Toast Stylesheet & Script -->
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    .dashboard-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-app);
    }

    /* Top Main Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links-menu {
      display: flex;
      align-items: center;
      gap: 6px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link-item {
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-link-item:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-link-item.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
      border-bottom: 2px solid var(--accent-primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .streak-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      font-size: 12px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .user-profile-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 12px 5px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
    }

    .user-avatar-sm {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
    }

    .user-name-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .user-role-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 7px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .logout-btn:hover {
      background: var(--color-danger-bg);
      border-color: var(--color-danger);
      color: var(--color-danger);
    }

    /* Main Container (2-Column Grid like Dicoding) */
    .dashboard-container {
      max-width: 1240px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 80px;
      flex: 1;
    }

    .dashboard-grid-layout {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 960px) {
      .dashboard-grid-layout {
        grid-template-columns: 1fr;
      }
      .nav-links-menu {
        display: none;
      }
    }

    /* Left Sidebar Widget Cards */
    .sidebar-widgets-column {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .widget-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      position: relative;
    }

    .profile-hero-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .circular-progress-box {
      width: 64px;
      height: 64px;
      border-radius: var(--radius-full);
      border: 4px solid var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
      margin-bottom: 6px;
    }

    .profile-card-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.3;
      margin: 0;
    }

    .profile-card-desc {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.5;
      margin: 0;
    }

    .profile-card-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: none;
      margin-top: 4px;
      transition: gap 0.2s ease;
    }

    .profile-card-cta:hover {
      gap: 10px;
    }

    /* Streak Widget */
    .streak-day-row {
      display: flex;
      justify-content: space-between;
      gap: 6px;
      margin: 16px 0;
    }

    .streak-day-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--text-tertiary);
      font-weight: 600;
    }

    .streak-circle {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .streak-circle.active {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    /* Right Main Content Area */
    .main-activities-column {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .section-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 26px;
      box-shadow: var(--shadow-sm);
    }

    .section-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 500;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
    }

    /* AI Adaptive Recommendation Hub */
    .ai-adaptive-banner {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }

    .ai-adaptive-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .ai-adaptive-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .ai-stage-pill {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .ai-insight-quote {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.55;
      padding-left: 12px;
      border-left: 3px solid var(--accent-primary);
      margin: 0;
    }

    .ai-next-steps-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-tertiary);
      font-weight: 500;
    }

    /* Learning Activity Rows */
    .activity-course-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .activity-course-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      transition: all 0.2s ease;
    }

    .activity-course-item:hover {
      border-color: var(--border-strong);
      background: var(--bg-surface-subtle);
      transform: translateY(-1px);
    }

    .activity-info {
      flex: 1;
      min-width: 0;
    }

    .activity-badge-text {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .activity-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .activity-progress-bar {
      width: 100%;
      height: 5px;
      background: var(--border-subtle);
      border-radius: 99px;
      overflow: hidden;
      margin-top: 8px;
    }

    .activity-progress-fill {
      height: 100%;
      background: var(--accent-primary);
      border-radius: 99px;
    }

    .btn-continue-learning {
      background: var(--accent-primary);
      color: var(--accent-text);
      border: none;
      padding: 8px 16px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: opacity 0.15s ease;
    }

    .btn-continue-learning:hover {
      opacity: 0.88;
    }

    /* Sub Activities Grid */
    .sub-activities-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    @media (max-width: 600px) {
      .sub-activities-grid {
        grid-template-columns: 1fr;
      }
    }

    .sub-activity-card {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 16px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .sub-activity-card:hover {
      border-color: var(--border-strong);
      background: var(--bg-surface);
      transform: translateY(-2px);
    }

    .sub-activity-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .sub-activity-desc {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    /* Course Catalog Grid */
    .courses-catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 16px;
      margin-top: 14px;
    }

    .course-card-mini {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.2s ease;
    }

    .course-card-mini:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .course-mini-thumb {
      width: 100%;
      height: 120px;
      background: var(--bg-surface-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-tertiary);
      font-size: 24px;
      object-fit: cover;
    }

    .course-mini-body {
      padding: 14px;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }

    .course-mini-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.35;
      margin-bottom: 6px;
    }

    .course-mini-tutor {
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }

    .course-mini-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle);
      padding-top: 8px;
      margin-top: auto;
    }

    .course-mini-price {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-primary);
    }

    /* Top Full-Width Announcement Bar (Dicoding / Claude Warm Paper Aesthetic) */
    .top-announcement-bar {
      background: #1C1B18;
      color: #FAF9F5;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 13px;
      font-weight: 500;
      padding: 10px 24px;
      display: none;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 105;
      line-height: 1.4;
      transition: background-color 0.2s ease;
    }

    [data-theme="dark"] .top-announcement-bar {
      background: #141312;
      border-bottom: 1px solid var(--border-subtle);
    }

    .top-announcement-content {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      text-align: center;
      max-width: 1200px;
      margin: 0 auto;
    }

    .top-bar-badge {
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 2px 7px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
      display: inline-block;
    }

    .top-bar-badge.status-pending {
      background: rgba(245, 158, 11, 0.3);
      color: #FDE68A;
    }

    .top-bar-badge.status-rejected {
      background: rgba(239, 68, 68, 0.3);
      color: #FECACA;
    }

    .top-bar-text {
      color: rgba(255, 255, 255, 0.92);
      font-size: 13px;
    }

    .top-bar-divider {
      color: rgba(255, 255, 255, 0.35);
      font-size: 13px;
      user-select: none;
    }

    .top-bar-cta {
      background: none;
      border: none;
      color: #FFFFFF;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 0;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.15s ease;
      font-family: inherit;
    }

    .top-bar-cta:hover {
      opacity: 0.82;
    }

    @media (max-width: 768px) {
      .top-announcement-bar {
        padding: 8px 16px;
        font-size: 12px;
      }
      .top-bar-text {
        font-size: 12px;
      }
      .top-bar-cta {
        font-size: 12px;
      }
      .top-announcement-content {
        gap: 6px;
      }
      .top-bar-divider {
        display: none;
      }
    }
    /* Tutor Mode Specific Banner */
    .tutor-studio-banner {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      padding: 24px;
      margin-bottom: 24px;
      display: none;
    }

    /* ========================================================= */
    /* --- CREATE COURSE MODAL STYLES -------------------------- */
    /* ========================================================= */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-xl);
      max-width: 540px;
      width: 100%;
      padding: 28px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      transform: scale(0.96);
      transition: transform 0.2s ease;
    }

    .modal-overlay.active .modal-card {
      transform: scale(1);
    }

    .form-group-custom {
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label-custom {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .form-control-custom {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 9px 12px;
      font-size: 13.5px;
      color: var(--text-primary);
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .form-control-custom:focus {
      border-color: var(--accent-primary);
      background: var(--bg-surface);
    }

    /* ========================================================= */
    /* --- GOOGLE CLASSROOM FULL LAYOUT & DOCKED SIDEBAR ------- */
    /* ========================================================= */
    .classroom-sidebar-toggle-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: none;
      background: transparent;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      cursor: pointer;
      transition: background 0.15s ease;
      flex-shrink: 0;
    }

    .classroom-sidebar-toggle-btn:hover {
      background: var(--bg-surface-subtle);
    }

    .classroom-app-container {
      display: flex;
      width: 100%;
      min-height: calc(100vh - 60px);
    }

    /* Left Sidebar (Docked on Desktop, Drawer on Mobile) */
    .classroom-left-sidebar {
      width: 270px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 60px);
      position: sticky;
      top: 60px;
      transition: width 0.2s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      z-index: 90;
    }

    .classroom-left-sidebar.collapsed {
      width: 0;
      overflow: hidden;
      border-right: none;
    }

    .sidebar-scroll-body {
      padding: 12px 0 32px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .sidebar-nav-group {
      display: flex;
      flex-direction: column;
      padding-right: 12px;
    }

    .sidebar-nav-pill {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 24px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 0 24px 24px 0;
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .sidebar-nav-pill:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-pill.active {
      color: var(--text-primary);
      font-weight: 600;
      background: var(--bg-surface-subtle);
    }

    .sidebar-nav-icon {
      font-size: 16px;
      width: 22px;
      text-align: center;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .sidebar-nav-pill.active .sidebar-nav-icon {
      color: var(--text-primary);
    }

    .sidebar-divider-line {
      height: 1px;
      background: var(--border-subtle);
      margin: 8px 0;
    }

    .sidebar-section-header {
      padding: 10px 24px 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
    }

