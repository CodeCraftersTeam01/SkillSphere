      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
      z-index: 5;
      text-transform: uppercase;
      user-select: none;
    }

    /* Card Middle Body */
    .classroom-card-body {
      min-height: 144px;
      height: auto;
      padding: 32px 18px 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--bg-surface);
      box-sizing: border-box;
      gap: 8px;
