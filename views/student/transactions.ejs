<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= title || 'Riwayat Transaksi Belajar | SkillSphere AI' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/claude-theme.css">
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    :root {
      --navbar-height: 56px;
    }

    body {
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Sticky Navigation Bar matching Dashboard exactly */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 24px;
      height: var(--navbar-height);
      min-height: var(--navbar-height);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-main-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 20px;
    }

    .nav-brand-group {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 16px;
    }

    .brand-icon {
      width: 24px;
      height: 24px;
      color: var(--accent-primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-links-menu {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link-item {
      padding: 6px 12px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-full);
      transition: all 0.15s ease;
    }

    .nav-link-item:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-link-item.active {
      color: var(--accent-text);
      background: var(--accent-primary);
      font-weight: 600;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .theme-toggle-btn {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 6px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 12px 4px 6px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
    }

    .user-avatar-sm {
      width: 26px;
      height: 26px;
      border-radius: var(--radius-full);
      background: var(--accent-primary);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
    }

    .user-name-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .logout-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 6px 12px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    /* Mobile Subnav Row */
    .nav-mobile-row {
      display: none;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 8px 16px;
      overflow-x: auto;
      white-space: nowrap;
    }

    .nav-mobile-row::-webkit-scrollbar {
      display: none;
    }

    @media (max-width: 860px) {
      .desktop-only {
        display: none !important;
      }
      .nav-mobile-row {
        display: block;
      }
    }

    /* Page Main Container */
    .page-main-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px 64px;
      width: 100%;
      box-sizing: border-box;
      flex: 1;
    }

    .hero-header-box {
      margin-bottom: 28px;
    }

    .hero-pretitle {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .hero-main-title {
      font-family: var(--font-serif, 'Newsreader', Georgia, serif);
      font-size: 32px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 8px;
    }

    .hero-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin: 0;
      line-height: 1.5;
    }

    /* Stats Quick Summary */
    .stats-summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }

    .stat-card-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      box-shadow: var(--shadow-sm);
    }

    .stat-card-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .stat-card-val {
      font-size: 26px;
      font-weight: 700;
      font-family: var(--font-mono, monospace);
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .stat-card-sub {
      font-size: 11px;
      color: var(--text-tertiary);
    }

    /* Transactions Table Card */
    .table-main-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .table-top-bar {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .table-title {
      font-family: var(--font-serif, 'Newsreader', Georgia, serif);
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0;
    }

    .table-responsive-wrapper {
      overflow-x: auto;
      width: 100%;
    }

    .custom-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }

    .custom-table th {
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 12px 18px;
      border-bottom: 1px solid var(--border-subtle);
      white-space: nowrap;
    }

    .custom-table td {
      padding: 16px 18px;
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-primary);
      vertical-align: middle;
    }

    .custom-table tr:last-child td {
      border-bottom: none;
    }

    .custom-table tr:hover td {
      background: var(--bg-surface-subtle);
    }

    /* Badges */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    .status-success {
      background: rgba(16, 185, 129, 0.15);
      color: #059669;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-pending {
      background: rgba(245, 158, 11, 0.15);
      color: #D97706;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .status-failed {
      background: rgba(239, 68, 68, 0.15);
      color: #DC2626;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* Actions */
    .btn-action-sm {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: var(--radius-md);
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      transition: all 0.15s ease;
    }

    .btn-action-sm:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--text-tertiary);
    }

    .btn-action-primary {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .btn-action-primary:hover {
      opacity: 0.92;
    }

    /* Empty State */
    .empty-state-pane {
      text-align: center;
      padding: 60px 20px;
    }

    .empty-icon-wrap {
      width: 64px;
      height: 64px;
      margin: 0 auto 16px;
      background: var(--bg-surface-subtle);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: var(--text-tertiary);
    }

    .empty-title {
      font-family: var(--font-serif, 'Newsreader', Georgia, serif);
      font-size: 20px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 6px;
    }

    .empty-desc {
      font-size: 13px;
      color: var(--text-secondary);
      max-width: 440px;
      margin: 0 auto 20px;
      line-height: 1.5;
    }

    /* Invoice Modal */
    .invoice-modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 16px;
      backdrop-filter: blur(3px);
    }

    .invoice-modal-backdrop.active {
      display: flex;
    }

    .invoice-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      max-width: 580px;
      width: 100%;
      padding: 28px;
      box-shadow: var(--shadow-lg, 0 10px 30px rgba(0,0,0,0.25));
      max-height: 90vh;
      overflow-y: auto;
    }

    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 16px;
    }

    .invoice-brand {
      font-family: var(--font-serif);
      font-size: 20px;
      font-weight: 700;
    }

    .invoice-close-btn {
      background: transparent;
      border: none;
      font-size: 18px;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .invoice-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-size: 13px;
      border-bottom: 1px dashed var(--border-subtle);
    }

    .invoice-row:last-child {
      border-bottom: none;
      font-weight: 700;
      font-size: 15px;
      padding-top: 12px;
    }
  </style>
</head>
<body>
  <!-- Top Navigation Bar -->
  <header class="navbar" role="banner">
    <div class="nav-main-row">
      <div class="nav-brand-group">
        <a href="/dashboard" class="brand-logo" aria-label="SkillSphere AI Beranda">
          <div class="brand-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path opacity="0.38" d="M12 7.6L17.3 4.7L14.4 10L17.3 15.3L12 12.4L6.7 15.3L9.6 10L6.7 4.7Z" />
              <path d="M12 0L13.8 8.2L22 10L13.8 11.8L12 20L10.2 11.8L2 10L10.2 8.2L12 0Z" />
            </svg>
          </div>
          <span>SkillSphere AI</span>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="desktop-only" aria-label="Navigasi Utama">
          <ul class="nav-links-menu">
            <li><a href="/dashboard" class="nav-link-item">Beranda</a></li>
            <li><a href="/courses" class="nav-link-item">Katalog Kursus</a></li>
            <li><a href="/dashboard/roadmap" class="nav-link-item">Jalur Belajar AI</a></li>
            <li><a href="/dashboard/wishlist" class="nav-link-item">Wishlist</a></li>
            <li><a href="/dashboard/transactions" class="nav-link-item active">Riwayat Transaksi</a></li>
          </ul>
        </nav>
      </div>

      <div class="nav-actions">
        <!-- Theme Toggle -->
        <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Ganti tema gelap atau terang">
          <i class="fas fa-moon" id="theme-icon"></i>
          <span id="theme-text">Mode Gelap</span>
        </button>

        <!-- User Profile Pill -->
        <div class="user-profile-badge" onclick="window.location.href='/profile'" title="Buka Profil Saya">
          <div class="user-avatar-sm" id="nav-avatar">S</div>
          <span class="user-name-label" id="nav-user-name">Memuat...</span>
        </div>

        <!-- Logout Button -->
        <button class="logout-btn" id="logout-btn" type="button" title="Keluar">
          <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
          <span>Keluar</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Scrollable Subnav Menu -->
  <div class="nav-mobile-row" aria-label="Navigasi Ponsel">
    <div style="display:flex; gap:6px;">
      <a href="/dashboard" class="nav-link-item">Beranda</a>
      <a href="/courses" class="nav-link-item">Katalog Kursus</a>
      <a href="/dashboard/roadmap" class="nav-link-item">Jalur Belajar AI</a>
      <a href="/dashboard/wishlist" class="nav-link-item">Wishlist</a>
      <a href="/dashboard/transactions" class="nav-link-item active">Riwayat Transaksi</a>
    </div>
  </div>

  <!-- Main Content Layout -->
  <main class="page-main-container">
    <div class="hero-header-box">
      <div class="hero-pretitle">
        <i class="fas fa-receipt" style="color:var(--accent-primary);"></i>
        Aktivitas Finansial Pembelajaran
      </div>
      <h1 class="hero-main-title">Riwayat Transaksi Belajar</h1>
      <p class="hero-subtitle">
        Pantau seluruh status pendaftaran kursus, kuitansi digital, dan selesaikan pembayaran tertunda dengan aman.
      </p>
    </div>

    <!-- Quick Stats Summary -->
    <section class="stats-summary-grid" aria-label="Ringkasan Transaksi">
      <div class="stat-card-box">
        <div class="stat-card-label">Total Transaksi</div>
        <div class="stat-card-val" id="statTotalTrx">0</div>
        <div class="stat-card-sub">Keseluruhan order kelas</div>
      </div>
      <div class="stat-card-box">
        <div class="stat-card-label">Kelas Aktif Berhasil</div>
        <div class="stat-card-val" id="statCompletedTrx" style="color:#059669;">0</div>
        <div class="stat-card-sub">Siap diakses kapan saja</div>
      </div>
      <div class="stat-card-box">
        <div class="stat-card-label">Menunggu Pembayaran</div>
        <div class="stat-card-val" id="statPendingTrx" style="color:#D97706;">0</div>
        <div class="stat-card-sub">Batas bayar 24 jam</div>
      </div>
    </section>

    <!-- Table Main Card -->
    <section class="table-main-card" aria-labelledby="tableHeading">
      <div class="table-top-bar">
        <h2 class="table-title" id="tableHeading">Daftar Faktur Pembelian</h2>
        <button type="button" class="btn-action-sm" onclick="loadTransactions()">
          <i class="fas fa-rotate"></i> Muat Ulang
        </button>
      </div>

      <div class="table-responsive-wrapper">
        <table class="custom-table" role="table" aria-label="Tabel Riwayat Transaksi">
          <thead>
            <tr>
              <th scope="col">Kode Order</th>
              <th scope="col">Nama Kursus</th>
              <th scope="col">Tanggal Order</th>
              <th scope="col">Metode Bayar</th>
              <th scope="col">Total Nominal</th>
              <th scope="col">Status</th>
              <th scope="col" style="text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="trxTableBody">
            <tr>
              <td colspan="7" class="empty-state-pane">
                <i class="fas fa-spinner fa-spin" style="font-size:24px; color:var(--text-tertiary);"></i>
                <div style="margin-top:8px; font-size:13px; color:var(--text-secondary);">Memuat riwayat transaksi...</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Interactive Invoice Modal -->
  <div class="invoice-modal-backdrop" id="invoiceModal" onclick="closeInvoiceModal(event)" role="dialog" aria-modal="true" aria-labelledby="modalInvoiceTitle">
    <div class="invoice-card" onclick="event.stopPropagation()">
      <div class="invoice-header">
        <div>
          <div class="invoice-brand">SkillSphere AI</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">Faktur Resmi Pembayaran Kursus</div>
        </div>
        <button type="button" class="invoice-close-btn" onclick="toggleInvoiceModal(false)" aria-label="Tutup Faktur">&times;</button>
      </div>

      <div id="invoiceDetailsBody">
        <!-- Rendered dynamically via JS -->
      </div>

      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:24px;">
        <button type="button" class="btn-action-sm" onclick="window.print()">
          <i class="fas fa-print"></i> Cetak Faktur
        </button>
        <button type="button" class="btn-action-sm btn-action-primary" onclick="toggleInvoiceModal(false)">
          Tutup
        </button>
      </div>
    </div>
  </div>

  <!-- Inclusive Accessibility Script -->
  <script src="/javascripts/accessibility.js"></script>

  <script>
    let cachedTransactions = [];

    // Theme Management
    function initTheme() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('skillsphere_theme', next);
      updateThemeUI(next);
    }

    function updateThemeUI(theme) {
      const icon = document.getElementById('theme-icon');
      const text = document.getElementById('theme-text');
      if (theme === 'dark') {
        if (icon) icon.className = 'fas fa-sun';
        if (text) text.innerText = 'Mode Terang';
      } else {
        if (icon) icon.className = 'fas fa-moon';
        if (text) text.innerText = 'Mode Gelap';
      }
    }

    document.getElementById('theme-toggle-btn').addEventListener('click', toggleTheme);

    function formatRupiah(num) {
      if (!num || num === 0) return 'Gratis';
      return 'Rp ' + Number(num).toLocaleString('id-ID');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function getAuthToken() {
      const t = localStorage.getItem('skillsphere_access_token') || localStorage.getItem('accessToken') || localStorage.getItem('token');
      if (t) {
        if (!localStorage.getItem('skillsphere_access_token')) localStorage.setItem('skillsphere_access_token', t);
        if (!localStorage.getItem('accessToken')) localStorage.setItem('accessToken', t);
        if (!localStorage.getItem('token')) localStorage.setItem('token', t);
      }
      return t;
    }

    async function loadUserProfile() {
      const token = getAuthToken();
      if (!token) {
        window.location.href = '/login?redirect=/dashboard/transactions';
        return;
      }
      try {
        const res = await fetch('/api/auth/me', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();
        if (json.success && json.data) {
          const u = json.data;
          document.getElementById('nav-user-name').innerText = u.name;
          const initials = u.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
          document.getElementById('nav-avatar').innerText = initials;
        }
      } catch (err) {
        console.error('Failed to load profile:', err);
      }
    }

    async function loadTransactions() {
      const token = getAuthToken();
      const tbody = document.getElementById('trxTableBody');
      if (!token) return;

      try {
        let res = await fetch('/api/payments/transactions', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        if (!res.ok) {
          res = await fetch('/api/payments/history', {
            headers: { 'Authorization': 'Bearer ' + token }
          });
        }
        const json = await res.json();
        
        let items = [];
        if (json.success && json.data) {
          items = Array.isArray(json.data.items) ? json.data.items : (Array.isArray(json.data) ? json.data : []);
        }

        cachedTransactions = items;
        renderTransactions(items);
        updateStats(items);
      } catch (err) {
        console.error('Failed to load transactions:', err);
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="empty-state-pane">
              <i class="fas fa-circle-exclamation" style="font-size:28px; color:#DC2626; margin-bottom:8px;"></i>
              <div style="font-size:14px; font-weight:600;">Gagal memuat transaksi</div>
              <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">Silakan coba muat ulang halaman atau periksa koneksi.</div>
            </td>
          </tr>
        `;
      }
    }

    function updateStats(items) {
      document.getElementById('statTotalTrx').innerText = items.length;
      const completed = items.filter(i => {
        const s = (i.payment_status || i.status || '').toLowerCase();
        return s === 'success' || s === 'settlement' || s === 'capture';
      }).length;
      document.getElementById('statCompletedTrx').innerText = completed;
      const pending = items.filter(i => {
        const s = (i.payment_status || i.status || '').toLowerCase();
        return s === 'pending';
      }).length;
      document.getElementById('statPendingTrx').innerText = pending;
    }

    function renderTransactions(items) {
      const tbody = document.getElementById('trxTableBody');
      if (!items || items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="empty-state-pane">
              <div class="empty-icon-wrap">
                <i class="fas fa-receipt"></i>
              </div>
              <h3 class="empty-title">Belum Ada Riwayat Transaksi</h3>
              <p class="empty-desc">
                Anda belum pernah melakukan pemesanan kursus. Jelajahi katalog kursus kami dan mulai tingkatkan kompetensi Anda sekarang.
              </p>
              <a href="/courses" class="btn-action-sm btn-action-primary" style="display:inline-flex;">
                <i class="fas fa-compass"></i> Jelajahi Katalog Kursus
              </a>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = items.map(t => {
        const orderId = t.transaction_code || t.order_id || ('#TRX-' + t.id);
        const status = (t.payment_status || t.status || 'pending').toLowerCase();
        const courseObj = t.course || t.Course || {};
        const courseTitle = courseObj.title || t.course_title || 'Kursus SkillSphere';
        const courseSlug = courseObj.slug || courseObj.id || t.course_id || 1;
        const paymentType = t.payment_method || t.payment_type || 'Midtrans Snap';
        const dateRaw = t.created_at || t.createdAt;

        let statusBadge = '<span class="status-pill status-success"><i class="fas fa-check-circle"></i> Berhasil</span>';
        let actionBtn = `
          <a href="/courses/${encodeURIComponent(courseSlug)}/learn" class="btn-action-sm btn-action-primary" style="margin-right:6px;" title="Mulai Belajar">
            <i class="fas fa-play"></i> Belajar
          </a>
          <button type="button" class="btn-action-sm" onclick="openInvoice('${escapeHtml(orderId)}')" title="Lihat Faktur">
            <i class="fas fa-file-invoice"></i> Faktur
          </button>
        `;

        if (status === 'pending') {
          statusBadge = '<span class="status-pill status-pending"><i class="fas fa-clock"></i> Menunggu Bayar</span>';
          actionBtn = `
            <a href="/courses/${encodeURIComponent(courseSlug)}/checkout" class="btn-action-sm btn-action-primary" title="Selesaikan Pembayaran">
              <i class="fas fa-credit-card"></i> Bayar Sekarang
            </a>
          `;
        } else if (status === 'failed' || status === 'expire' || status === 'expired' || status === 'cancel') {
          statusBadge = '<span class="status-pill status-failed"><i class="fas fa-ban"></i> Dibatalkan</span>';
          actionBtn = `
            <a href="/courses/${encodeURIComponent(courseSlug)}/checkout" class="btn-action-sm" title="Pesan Ulang">
              <i class="fas fa-redo"></i> Pesan Ulang
            </a>
          `;
        }

        const dateStr = dateRaw ? new Date(dateRaw).toLocaleDateString('id-ID', {
          day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
        }) : '-';

        return `
          <tr>
            <td style="font-family:var(--font-mono); font-weight:600; font-size:12px;">${escapeHtml(orderId)}</td>
            <td><strong>${escapeHtml(courseTitle)}</strong></td>
            <td style="font-size:12px; color:var(--text-secondary);">${dateStr}</td>
            <td><span style="font-size:12px; font-weight:600;">${escapeHtml(paymentType)}</span></td>
            <td style="font-family:var(--font-mono); font-weight:700;">${formatRupiah(t.amount)}</td>
            <td>${statusBadge}</td>
            <td style="text-align:right;">${actionBtn}</td>
          </tr>
        `;
      }).join('');
    }

    function openInvoice(orderId) {
      const item = cachedTransactions.find(t => (t.transaction_code === orderId || t.order_id === orderId));
      if (!item) return;

      const courseObj = item.course || item.Course || {};
      const courseTitle = courseObj.title || item.course_title || 'Kursus Teknologi';
      const dateRaw = item.created_at || item.createdAt;
      const status = (item.payment_status || item.status || 'pending').toLowerCase();

      let statusHtml = '<span style="color:#059669; font-weight:600;"><i class="fas fa-check-circle"></i> Lunas (Verified)</span>';
      if (status === 'pending') {
        statusHtml = '<span style="color:#EA580C; font-weight:600;"><i class="fas fa-clock"></i> Menunggu Pembayaran</span>';
      } else if (status === 'failed' || status === 'expire' || status === 'expired' || status === 'cancel') {
        statusHtml = '<span style="color:#DC2626; font-weight:600;"><i class="fas fa-ban"></i> Dibatalkan / Kedaluwarsa</span>';
      }

      const dateStr = dateRaw ? new Date(dateRaw).toLocaleDateString('id-ID', {
        day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'
      }) : '-';

      const html = `
        <div style="margin-bottom:16px;">
          <div style="font-size:12px; color:var(--text-secondary);">Nomor Faktur:</div>
          <div style="font-family:var(--font-mono); font-weight:700; font-size:15px; color:var(--text-primary);">${escapeHtml(orderId)}</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">Waktu Transaksi: ${dateStr}</div>
        </div>

        <div class="invoice-row">
          <span>Deskripsi Kursus</span>
          <strong>${escapeHtml(courseTitle)}</strong>
        </div>
        <div class="invoice-row">
          <span>Metode Pembayaran</span>
          <span>${escapeHtml(item.payment_method || item.payment_type || 'Midtrans Sandbox')}</span>
        </div>
        <div class="invoice-row">
          <span>Status Pembayaran</span>
          ${statusHtml}
        </div>
        <div class="invoice-row">
          <span>Biaya Layanan & PPN</span>
          <span>Gratis (Rp 0)</span>
        </div>
        <div class="invoice-row">
          <span>Total Pembayaran</span>
          <span style="color:var(--accent-primary); font-family:var(--font-mono);">${formatRupiah(item.amount)}</span>
        </div>
      `;

      document.getElementById('invoiceDetailsBody').innerHTML = html;
      toggleInvoiceModal(true);
    }

    function toggleInvoiceModal(open) {
      const m = document.getElementById('invoiceModal');
      if (open) m.classList.add('active');
      else m.classList.remove('active');
    }

    function closeInvoiceModal(e) {
      if (e.target.id === 'invoiceModal') toggleInvoiceModal(false);
    }

    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('skillsphere_access_token');
      localStorage.removeItem('skillsphere_refresh_token');
      localStorage.removeItem('accessToken');
      localStorage.removeItem('token');
      localStorage.removeItem('refreshToken');
      localStorage.removeItem('skillsphere_user');
      window.location.href = '/login';
    });

    document.addEventListener('DOMContentLoaded', () => {
      initTheme();
      loadUserProfile();
      loadTransactions();
    });
  </script>
</body>
</html>
