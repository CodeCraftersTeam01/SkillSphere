<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ruang Ujian Zen Mode | SkillSphere AI</title>
  <meta name="description" content="Antarmuka pengerjaan ujian akhir kelulusan interaktif bebas gangguan (Zen Mode) dengan countdown timer dan evaluasi instan.">

  <!-- Immediate Theme Initializer -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts: Newsreader, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Claude Design System Stylesheet & Accessibility Toolkit -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      font-family: var(--font-sans);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      user-select: none;
    }

    /* Top Zen Bar */
    .zen-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: var(--shadow-sm);
      gap: 16px;
    }

    .zen-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: -0.3px;
    }

    .zen-pill {
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      background: var(--bg-surface-subtle);
      color: var(--text-secondary);
      font-weight: 600;
      border: 1px solid var(--border-subtle);
    }

    .timer-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-subtle);
      padding: 6px 16px;
      border-radius: var(--radius-full);
      font-family: var(--font-mono);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      transition: all 0.2s ease-out;
    }

    .timer-badge.urgent {
      background: var(--color-danger-bg);
      border-color: var(--color-danger);
      color: var(--color-danger);
      animation: pulse 1s infinite alternate;
    }

    @keyframes pulse {
      from { transform: scale(1); }
      to { transform: scale(1.03); }
    }

    .icon-btn {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease-out;
    }

    .icon-btn:hover {
      background: var(--bg-surface-subtle);
      transform: translateY(-1px);
    }

    /* Main Grid Layout */
    .exam-container {
      max-width: 1140px;
      width: 100%;
      margin: 28px auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 24px;
      flex: 1;
      align-items: start;
    }

    @media (max-width: 920px) {
      .exam-container {
        grid-template-columns: 1fr;
        margin: 16px auto;
      }
    }

    /* Question Panel */
    .question-panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 32px 28px;
      box-shadow: var(--shadow-sm);
      position: relative;
    }

    @media (max-width: 600px) {
      .question-panel {
        padding: 20px 16px;
      }
      .zen-header {
        padding: 10px 14px;
      }
    }

    .q-meta-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .q-number-tag {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--accent-amber);
    }

    .q-points-tag {
      font-size: 0.8rem;
      color: var(--text-secondary);
      background: var(--bg-surface-subtle);
      padding: 3px 10px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
    }

    .q-text {
      font-family: var(--font-serif);
      font-size: 1.45rem;
      font-weight: 500;
      line-height: 1.45;
      margin-bottom: 28px;
      color: var(--text-primary);
    }

    .answers-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 32px;
    }

    .answer-card {
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      cursor: pointer;
      transition: all 0.15s ease-out;
      min-height: 48px;
      box-sizing: border-box;
    }

    .answer-card:hover {
      border-color: var(--border-strong);
      background: var(--bg-surface-subtle);
    }

    .answer-card.selected {
      border-color: var(--text-primary);
      background: var(--bg-surface);
      box-shadow: 0 0 0 2px var(--text-primary);
    }

    .answer-card:focus-visible {
      outline: 2px solid var(--text-primary);
      outline-offset: 2px;
    }

    .answer-letter {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.95rem;
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--text-secondary);
      transition: all 0.15s ease-out;
    }

    .answer-card.selected .answer-letter {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .answer-body {
      font-size: 0.95rem;
      color: var(--text-primary);
      padding-top: 2px;
    }

    /* Question Footer Buttons */
    .q-nav-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s ease-out;
      min-height: 44px;
      box-sizing: border-box;
      text-decoration: none;
    }

    .btn-outline {
      background: transparent;
      color: var(--text-primary);
      border-color: var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
    }

    .btn-doubt {
      background: rgba(217, 119, 6, 0.1);
      color: var(--accent-amber);
      border-color: rgba(217, 119, 6, 0.3);
    }

    .btn-doubt.active {
      background: var(--accent-amber);
      color: #FFFFFF;
      border-color: var(--accent-amber);
    }

    .btn-primary {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .btn-primary:hover {
      background: var(--accent-primary-hover);
      transform: translateY(-1px);
    }

    .btn-success {
      background: var(--color-success);
      color: #FFFFFF;
      border-color: var(--color-success);
    }

    .btn-success:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    /* Right Sidebar: Navigator & Status */
    .navigator-panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 22px 18px;
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 86px;
    }

    .nav-title {
      font-size: 0.88rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      margin-bottom: 14px;
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 20px;
    }

    .nav-btn {
      aspect-ratio: 1;
      border-radius: var(--radius-sm);
      background: var(--bg-app);
      border: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease-out;
      min-height: 40px;
    }

    .nav-btn:hover {
      border-color: var(--border-strong);
    }

    .nav-btn.active {
      border-color: var(--text-primary);
      box-shadow: 0 0 0 2px var(--text-primary);
    }

    .nav-btn.answered {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .nav-btn.doubt {
      background: var(--accent-amber);
      color: #FFFFFF;
      border-color: var(--accent-amber);
    }

    .legend-box {
      border-top: 1px solid var(--border-subtle);
      padding-top: 14px;
      font-size: 0.78rem;
      color: var(--text-secondary);
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 20px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .finish-box {
      border-top: 1px solid var(--border-subtle);
      padding-top: 18px;
    }

    /* Result Modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-content {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      max-width: 500px;
      width: 100%;
      padding: 34px 28px;
      text-align: center;
      box-shadow: var(--shadow-md);
      position: relative;
    }

    .modal-icon {
      width: 60px;
      height: 60px;
      border-radius: var(--radius-full);
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }

    .modal-icon.pass {
      background: var(--color-success-bg);
      color: var(--color-success);
    }

    .modal-icon.fail {
      background: var(--color-danger-bg);
      color: var(--color-danger);
    }

    .modal-title {
      font-family: var(--font-serif);
      font-size: 1.85rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--text-primary);
    }

    .score-circle {
      font-family: var(--font-mono);
      font-size: 2.3rem;
      font-weight: 700;
      margin: 16px 0 6px;
    }

    .score-circle.pass { color: var(--color-success); }
    .score-circle.fail { color: var(--color-danger); }
  </style>
</head>
<body>

  <!-- Top Zen Bar Header -->
  <header class="zen-header" role="banner">
    <div class="zen-brand">
      <i class="fa-solid fa-sparkles" style="color: var(--accent-amber);"></i>
      <span id="headerCourseTitle">Ujian Kelulusan Resmi</span>
      <span class="zen-pill">Zen Mode</span>
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
      <div id="timerDisplay" class="timer-badge" role="timer" aria-live="polite">
        <i class="fa-regular fa-clock"></i>
        <span id="timerText">--:--</span>
      </div>

      <button type="button" class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Ganti Tema Tampilan" title="Ganti Tema">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>

      <button type="button" class="btn btn-outline" style="min-height: 38px; padding: 4px 14px; font-size: 0.82rem;" onclick="exitExamWarning()">
        <i class="fa-solid fa-xmark"></i>
        <span>Keluar</span>
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="exam-container" role="main">
    <!-- Left: Question Area -->
    <div class="question-panel" id="questionPanel" aria-labelledby="currentQTag">
      <div class="q-meta-bar">
        <div class="q-number-tag" id="currentQTag">Soal #1</div>
        <div class="q-points-tag">10 Poin</div>
      </div>

      <div class="q-text" id="questionText">
        Memuat butir pertanyaan ujian kelulusan Anda...
      </div>

      <div class="answers-list" id="answersList" role="radiogroup" aria-label="Pilihan Jawaban">
        <!-- Opsi Jawaban Dinamis -->
      </div>

      <div class="q-nav-actions">
        <button type="button" class="btn btn-outline" id="prevBtn" onclick="prevQuestion()" aria-label="Soal Sebelumnya">
          <i class="fa-solid fa-arrow-left"></i>
          <span>Sebelumnya</span>
        </button>

        <button type="button" class="btn btn-doubt" id="doubtBtn" onclick="toggleDoubt()" aria-label="Tandai Soal Ragu-ragu">
          <i class="fa-regular fa-star"></i>
          <span>Tandai Ragu</span>
        </button>

        <button type="button" class="btn btn-primary" id="nextBtn" onclick="nextQuestion()" aria-label="Soal Selanjutnya">
          <span>Selanjutnya</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    <!-- Right: Number Grid Navigator -->
    <aside class="navigator-panel" aria-label="Navigasi Nomor Soal">
      <div class="nav-title">Navigasi Butir Soal</div>

      <div class="nav-grid" id="navGrid" role="group" aria-label="Daftar Nomor Soal">
        <!-- Tombol nomor 1..N dinamis -->
      </div>

      <div class="legend-box">
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--text-primary);"></span>
          <span>Sudah Terjawab</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--accent-amber);"></span>
          <span>Ditandai Ragu-Ragu</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background: var(--bg-app); border: 1px solid var(--border-subtle);"></span>
          <span>Belum Dijawab</span>
        </div>
      </div>

      <div class="finish-box">
        <button type="button" class="btn btn-success" style="width: 100%; min-height: 44px;" onclick="confirmSubmitExam()">
          <i class="fa-solid fa-check"></i>
          <span>Kumpulkan Jawaban</span>
        </button>
      </div>
    </aside>
  </main>

  <!-- Result Modal -->
  <div class="modal-overlay" id="resultModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-content">
      <div class="modal-icon" id="modalIcon"></div>
      <h2 class="modal-title" id="modalTitle">Hasil Ujian</h2>
      <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.5;" id="modalDesc"></p>

      <div class="score-circle" id="modalScore">0%</div>
      <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 24px;" id="modalPassingInfo"></div>

      <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;" id="modalActions">
        <!-- Tombol dinamis -->
      </div>
    </div>
  </div>

  <script>
    const examId = '<%= examId %>';
    let examData = null;
    let questions = [];
    let currentIndex = 0;
    let studentAnswers = {};
    let doubts = {};
    let timerInterval = null;
    let remainingSeconds = 3600;
    let isSubmitting = false;

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const target = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      localStorage.setItem('skillsphere_theme', target);
      localStorage.setItem('theme', target);
      updateThemeIcon(target);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }
    }

    async function initExam() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/exams/' + examId, {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        if (!json.success || !json.data) {
          alert(json.message || 'Gagal memuat ujian kelulusan.');
          window.location.href = '/dashboard';
          return;
        }

        examData = json.data;
        questions = examData.questions || [];

        if (questions.length === 0) {
          alert('Ujian ini belum memiliki pertanyaan.');
          window.location.href = '/dashboard';
          return;
        }

        if (examData.course && examData.course.title) {
          document.getElementById('headerCourseTitle').textContent = examData.course.title;
        }

        remainingSeconds = (examData.duration_minutes || 60) * 60;
        startTimer();
        renderNavGrid();
        renderQuestion(0);
      } catch (err) {
        console.error('Error init exam:', err);
        alert('Gagal memuat data ujian.');
      }
    }

    function startTimer() {
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        remainingSeconds--;
        updateTimerDisplay();

        if (remainingSeconds <= 0) {
          clearInterval(timerInterval);
          alert('Batas waktu ujian telah habis! Jawaban Anda akan otomatis dikumpulkan.');
          submitExam();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const minutes = Math.floor(remainingSeconds / 60);
      const seconds = remainingSeconds % 60;
      const display = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

      const el = document.getElementById('timerText');
      el.textContent = display;

      const badge = document.getElementById('timerDisplay');
      if (remainingSeconds <= 300) {
        badge.classList.add('urgent');
      }
    }

    function renderNavGrid() {
      const grid = document.getElementById('navGrid');
      grid.innerHTML = '';

      questions.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nav-btn';
        btn.textContent = idx + 1;
        btn.id = 'navBtn_' + idx;
        btn.setAttribute('aria-label', `Pindah ke Soal Nomor ${idx + 1}`);

        if (idx === currentIndex) btn.classList.add('active');
        if (studentAnswers[String(q.id || idx + 1)]) btn.classList.add('answered');
        if (doubts[idx]) btn.classList.add('doubt');

        btn.onclick = () => renderQuestion(idx);
        grid.appendChild(btn);
      });
    }

    function renderQuestion(idx) {
      if (idx < 0 || idx >= questions.length) return;
      currentIndex = idx;

      const q = questions[idx];
      const qId = String(q.id || idx + 1);

      document.getElementById('currentQTag').textContent = 'Soal #' + (idx + 1) + ' dari ' + questions.length;
      document.getElementById('questionText').textContent = q.question;

      // Update Opsi Jawaban
      const list = document.getElementById('answersList');
      list.innerHTML = '';

      const optionLetters = ['A', 'B', 'C', 'D'];
      (q.options || []).forEach((optText, optIdx) => {
        const letter = optionLetters[optIdx] || String(optIdx + 1);
        const card = document.createElement('div');
        const isSelected = studentAnswers[qId] === letter;

        card.className = 'answer-card ' + (isSelected ? 'selected' : '');
        card.setAttribute('role', 'radio');
        card.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        card.setAttribute('tabindex', '0');

        card.innerHTML = `
          <div class="answer-letter">${letter}</div>
          <div class="answer-body">${escapeHtml(optText)}</div>
        `;

        card.onclick = () => selectAnswer(qId, letter);
        card.onkeydown = (e) => {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            selectAnswer(qId, letter);
          }
        };

        list.appendChild(card);
      });

      // Tombol Ragu
      const doubtBtn = document.getElementById('doubtBtn');
      if (doubts[idx]) {
        doubtBtn.classList.add('active');
        doubtBtn.innerHTML = '<i class="fa-solid fa-star"></i> <span>Ragu (Aktif)</span>';
      } else {
        doubtBtn.classList.remove('active');
        doubtBtn.innerHTML = '<i class="fa-regular fa-star"></i> <span>Tandai Ragu</span>';
      }

      // Tombol Navigasi Prev/Next
      document.getElementById('prevBtn').style.visibility = idx === 0 ? 'hidden' : 'visible';
      const nextBtn = document.getElementById('nextBtn');
      if (idx === questions.length - 1) {
        nextBtn.innerHTML = '<span>Kumpulkan Jawaban</span> <i class="fa-solid fa-check"></i>';
        nextBtn.onclick = confirmSubmitExam;
      } else {
        nextBtn.innerHTML = '<span>Selanjutnya</span> <i class="fa-solid fa-arrow-right"></i>';
        nextBtn.onclick = nextQuestion;
      }

      updateNavButtonsState();
    }

    function selectAnswer(qId, letter) {
      studentAnswers[qId] = letter;
      renderQuestion(currentIndex);
    }

    function toggleDoubt() {
      doubts[currentIndex] = !doubts[currentIndex];
      renderQuestion(currentIndex);
    }

    function prevQuestion() {
      if (currentIndex > 0) renderQuestion(currentIndex - 1);
    }

    function nextQuestion() {
      if (currentIndex < questions.length - 1) renderQuestion(currentIndex + 1);
    }

    function updateNavButtonsState() {
      questions.forEach((q, idx) => {
        const btn = document.getElementById('navBtn_' + idx);
        if (!btn) return;

        btn.className = 'nav-btn';
        if (idx === currentIndex) btn.classList.add('active');
        if (studentAnswers[String(q.id || idx + 1)]) btn.classList.add('answered');
        if (doubts[idx]) btn.classList.add('doubt');
      });
    }

    function confirmSubmitExam() {
      const answeredCount = Object.keys(studentAnswers).length;
      const totalCount = questions.length;
      const unanswered = totalCount - answeredCount;

      let msg = `Anda telah menjawab ${answeredCount} dari total ${totalCount} butir soal.`;
      if (unanswered > 0) {
        msg += `\nMasih terdapat ${unanswered} soal yang belum dijawab. Apakah Anda yakin ingin mengumpulkan sekarang?`;
      } else {
        msg += '\nApakah Anda sudah yakin dengan seluruh jawaban Anda?';
      }

      if (confirm(msg)) {
        submitExam();
      }
    }

    async function submitExam() {
      if (isSubmitting) return;
      isSubmitting = true;
      clearInterval(timerInterval);

      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/exams/' + examId + '/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify({
            answers: studentAnswers,
            time_spent_seconds: ((examData.duration_minutes || 60) * 60) - remainingSeconds
          })
        });

        const json = await res.json();
        if (json.success && json.data) {
          showResultModal(json.data);
        } else {
          alert(json.message || 'Gagal mengirimkan jawaban.');
          isSubmitting = false;
        }
      } catch (err) {
        console.error('Error submitting exam:', err);
        alert('Terjadi kendala jaringan saat mengumpulkan jawaban.');
        isSubmitting = false;
      }
    }

    function showResultModal(data) {
      const modal = document.getElementById('resultModal');
      const icon = document.getElementById('modalIcon');
      const title = document.getElementById('modalTitle');
      const desc = document.getElementById('modalDesc');
      const score = document.getElementById('modalScore');
      const info = document.getElementById('modalPassingInfo');
      const actions = document.getElementById('modalActions');

      score.textContent = data.score + '%';
      info.textContent = `Passing Grade: ${data.passing_score}% • Jawaban Benar: ${data.correct_count} / ${data.total_questions}`;

      if (data.is_passed) {
        icon.className = 'modal-icon pass';
        icon.innerHTML = `<i class="fa-solid fa-award"></i>`;
        title.textContent = 'Selamat! Anda Dinyatakan Lulus';
        desc.textContent = 'Kompetensi teknis Anda telah terverifikasi secara resmi. Sertifikat kelulusan digital Anda telah diterbitkan secara otomatis oleh sistem.';

        score.className = 'score-circle pass';

        const certCode = data.certificate ? data.certificate.certificate_code : '';
        actions.innerHTML = `
          ${certCode ? `
            <a href="/verify-cert/${certCode}" class="btn btn-primary" target="_blank">
              <i class="fa-solid fa-certificate"></i>
              <span>Buka Sertifikat</span>
            </a>
            <a href="/api/certificates/${certCode}/pdf" class="btn btn-outline" target="_blank">
              <i class="fa-solid fa-file-pdf"></i>
              <span>Unduh PDF</span>
            </a>
          ` : ''}
          <a href="/dashboard" class="btn btn-outline">
            <i class="fa-solid fa-house"></i>
            <span>Kembali ke Dashboard</span>
          </a>
        `;
      } else {
        icon.className = 'modal-icon fail';
        icon.innerHTML = `<i class="fa-solid fa-rotate-right"></i>`;
        title.textContent = 'Belum Mencapai Passing Grade';
        desc.textContent = 'Pelajari kembali materi kurikulum yang belum dikuasai dengan panduan AI Mentor, lalu coba kembali ujian ini.';

        score.className = 'score-circle fail';
        actions.innerHTML = `
          <a href="/dashboard" class="btn btn-primary">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Kembali ke Silabus Materi</span>
          </a>
        `;
      }

      modal.style.display = 'flex';
    }

    function exitExamWarning() {
      if (confirm('Apakah Anda yakin ingin keluar dari sesi ujian? Jawaban Anda yang belum dikumpulkan tidak akan tersimpan.')) {
        window.location.href = '/dashboard';
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeIcon(currentTheme);
      initExam();
    });
  </script>
</body>
</html>
