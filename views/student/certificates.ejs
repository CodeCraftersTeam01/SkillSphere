<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sertifikat & Milestone Belajar | SkillSphere AI</title>
  <meta name="description" content="Portofolio sertifikat kompetensi resmi dan voucher diskon milestone belajar siswa SkillSphere AI.">

  <!-- Immediate Theme Initializer -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('skillsphere_theme') || localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts: Newsreader, Plus Jakarta Sans, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Claude Design System Stylesheet & Accessibility Toolkit -->
  <link rel="stylesheet" href="/stylesheets/claude-theme.css?v=2.0">
  <link rel="stylesheet" href="/stylesheets/accessibility.css">
  <link rel="stylesheet" href="/stylesheets/custom-alert.css">
  <script src="/javascripts/custom-alert.js"></script>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      font-family: var(--font-sans);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Navigation Bar */
    .navbar {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      box-sizing: border-box;
      gap: 16px;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-primary);
      font-weight: 700;
      font-size: 1.12rem;
    }

    .brand-logo span {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-pill {
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-secondary);
      padding: 8px 14px;
      border-radius: var(--radius-md);
      transition: all 0.15s ease-out;
    }

    .nav-pill:hover {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
    }

    .nav-pill.active {
      color: var(--text-primary);
      background: var(--bg-surface-subtle);
      font-weight: 600;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease-out;
    }

    .icon-btn:hover {
      background: var(--bg-surface-subtle);
      transform: translateY(-1px);
    }

    /* Main Container */
    .container {
      max-width: 1040px;
      width: 100%;
      margin: 36px auto;
      padding: 0 20px;
      flex: 1;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .page-title {
      font-family: var(--font-serif);
      font-size: 2.3rem;
      font-weight: 600;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
      color: var(--text-primary);
    }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: 0.95rem;
      max-width: 720px;
    }

    .section-title {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 600;
      margin: 36px 0 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--text-primary);
    }

    /* Certificates Grid */
    .certs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
      margin-bottom: 36px;
    }

    .cert-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: transform 0.16s ease-out, border-color 0.16s ease-out, box-shadow 0.16s ease-out;
    }

    .cert-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-strong);
    }

    .cert-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-amber), var(--border-subtle));
    }

    .cert-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .cert-code {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--text-secondary);
      background: var(--bg-surface-subtle);
      padding: 3px 8px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
    }

    .cert-badge {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-success);
      background: var(--color-success-bg);
      padding: 3px 10px;
      border-radius: var(--radius-full);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .cert-course-title {
      font-family: var(--font-serif);
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 8px;
      color: var(--text-primary);
    }

    .cert-meta {
      font-size: 0.82rem;
      color: var(--text-secondary);
      margin-bottom: 20px;
    }

    .cert-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Milestone & Discount Vouchers */
    .vouchers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      margin-bottom: 36px;
    }

    .voucher-card {
      background: var(--bg-surface);
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius-md);
      padding: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.15s ease-out;
    }

    .voucher-card:hover {
      border-color: var(--accent-amber);
      background: var(--bg-surface-subtle);
    }

    .voucher-discount {
      font-family: var(--font-mono);
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--accent-amber);
      line-height: 1;
    }

    .voucher-code {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      font-weight: 600;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 4px 10px;
      border-radius: var(--radius-sm);
      display: inline-block;
      margin-top: 6px;
      color: var(--text-primary);
      user-select: all;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.82rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease-out;
      min-height: 40px;
      box-sizing: border-box;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: var(--accent-text);
      border-color: var(--accent-primary);
    }

    .btn-primary:hover {
      background: var(--accent-primary-hover);
      transform: translateY(-1px);
    }

    .btn-outline {
      background: transparent;
      color: var(--text-primary);
      border-color: var(--border-subtle);
    }

    .btn-outline:hover {
      background: var(--bg-surface-subtle);
      border-color: var(--border-strong);
    }

    /* Modal Visualisasi Preview Sertifikat */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      max-width: 680px;
      width: 100%;
      padding: 32px 28px;
      box-shadow: var(--shadow-md);
      position: relative;
    }

    .preview-paper {
      background: #FAF9F5;
      color: #141413;
      border: 2px solid #C8A86B;
      border-radius: var(--radius-md);
      padding: 28px 24px;
      text-align: center;
      margin-bottom: 20px;
      position: relative;
    }

    .empty-state {
      text-align: center;
      padding: 48px 20px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      color: var(--text-secondary);
    }

    @media (max-width: 640px) {
      .navbar {
        padding: 0 16px;
      }
      .nav-links {
        display: none;
      }
      .page-title {
        font-size: 1.85rem;
      }
    }
  </style>
</head>
<body>

  <!-- Top Navigation -->
  <header class="navbar" role="banner">
    <div style="display: flex; align-items: center; gap: 16px;">
      <a href="/dashboard" class="brand-logo" aria-label="Ke Dashboard Utama">
        <i class="fa-solid fa-sparkles" style="color: var(--accent-amber);"></i>
        <span>SkillSphere AI</span>
      </a>

      <nav class="nav-links" aria-label="Navigasi Siswa">
        <a href="/dashboard" class="nav-pill">Dashboard</a>
        <a href="/catalog" class="nav-pill">Katalog</a>
        <a href="/certificates" class="nav-pill active" aria-current="page">Sertifikat</a>
      </nav>
    </div>

    <div style="display: flex; align-items: center; gap: 10px;">
      <button type="button" class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Ganti Tema Tampilan" title="Ganti Tema">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>

      <a href="/dashboard" class="btn btn-outline" style="min-height: 38px; padding: 4px 12px; font-size: 0.82rem;">
        <i class="fa-solid fa-house"></i>
        <span>Dashboard</span>
      </a>
    </div>
  </header>

  <main class="container" role="main">
    <div class="page-header">
      <h1 class="page-title">Sertifikat & Pencapaian Belajar</h1>
      <p class="page-subtitle">Pantau seluruh sertifikat kompetensi resmi Anda dan klaim voucher diskon unik dari tantangan milestone belajar.</p>
    </div>

    <!-- 1. Bagian Sertifikat Kelulusan Resmi -->
    <section aria-labelledby="headingCerts">
      <h2 class="section-title" id="headingCerts">
        <i class="fa-solid fa-award" style="color: var(--accent-amber);"></i>
        <span>Sertifikat Kelulusan Resmi</span>
      </h2>

      <div class="certs-grid" id="certsContainer" role="list">
        <div class="empty-state" style="grid-column: 1 / -1;">
          Memuat portofolio sertifikat resmi Anda...
        </div>
      </div>
    </section>

    <!-- 2. Bagian Voucher Diskon Milestone Belajar -->
    <section aria-labelledby="headingVouchers">
      <h2 class="section-title" id="headingVouchers">
        <i class="fa-solid fa-tags" style="color: var(--accent-amber);"></i>
        <span>Voucher Diskon dari Milestone Belajar</span>
      </h2>

      <div class="vouchers-grid" id="vouchersContainer" role="list">
        <div class="empty-state" style="grid-column: 1 / -1;">
          Memuat voucher diskon Anda...
        </div>
      </div>
    </section>
  </main>

  <!-- Modal Preview Sertifikat Interaktif -->
  <div class="modal-overlay" id="previewModal" onclick="closePreviewModal(event)" role="dialog" aria-modal="true" aria-labelledby="previewModalTitle">
    <div class="modal-card" onclick="event.stopPropagation()">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
        <h3 id="previewModalTitle" style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--text-primary);">Pratinjau Kredensial Resmi</h3>
        <button type="button" class="btn btn-outline" style="padding: 4px 10px; min-height: 32px;" onclick="document.getElementById('previewModal').style.display='none'" aria-label="Tutup Pratinjau">✕</button>
      </div>

      <div class="preview-paper">
        <div style="font-size: 0.78rem; letter-spacing: 2px; font-weight: 700; color: #7A7870;">SKILLSPHERE AI CERTIFICATION</div>
        <div style="font-family: 'Newsreader', serif; font-size: 1.6rem; font-weight: 600; color: #C8A86B; margin: 6px 0;">SERTIFIKAT KELULUSAN RESMI</div>
        <div style="font-size: 0.85rem; color: #615F56;">Diberikan dengan bangga kepada:</div>
        <div style="font-family: 'Newsreader', serif; font-size: 1.5rem; font-weight: 700; margin: 8px 0;" id="previewStudentName">-</div>
        <div style="font-size: 0.85rem; color: #474640; max-width: 480px; margin: 0 auto 12px;">Telah menyelesaikan kurikulum dan lulus Ujian Kelulusan Resmi pada kelas:</div>
        <div style="font-size: 1.1rem; font-weight: 700;" id="previewCourseTitle">-</div>
        <div style="font-size: 0.8rem; color: #615F56; margin-top: 14px;">
          <span id="previewScore">-</span> • <span id="previewDate">-</span>
        </div>
        <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #8F8D83; margin-top: 10px;" id="previewCertCode">-</div>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
        <button type="button" class="btn btn-outline" id="btnCopyVerify">
          <i class="fa-solid fa-link"></i>
          <span>Salin Tautan Verifikasi</span>
        </button>
        <a href="#" target="_blank" class="btn btn-outline" id="btnOpenVerify">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
          <span>Buka Verifikasi</span>
        </a>
        <a href="#" target="_blank" class="btn btn-primary" id="btnDownloadPdf">
          <i class="fa-solid fa-file-pdf"></i>
          <span>Unduh PDF Resmi</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const target = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', target);
      localStorage.setItem('skillsphere_theme', target);
      localStorage.setItem('theme', target);
      updateThemeIcon(target);
    }

    function updateThemeIcon(theme) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      }
    }

    function notifyUser(msg, type = 'success') {
      if (typeof window.showToast === 'function') {
        window.showToast(msg, type);
      } else {
        alert(msg);
      }
    }

    async function loadCertificates() {
      const container = document.getElementById('certsContainer');
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/certificates/my-certificates', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        const certs = (json.data && Array.isArray(json.data)) ? json.data : [];

        if (certs.length === 0) {
          container.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1;">
              <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 6px; color: var(--text-primary);">Belum Ada Sertifikat Kelulusan</p>
              <p style="font-size: 0.88rem;">Selesaikan kursus dan ikuti Ujian Kelulusan Resmi untuk memperoleh sertifikat kompetensi Anda.</p>
              <a href="/catalog" class="btn btn-primary" style="margin-top: 14px;">
                <i class="fa-solid fa-compass"></i>
                <span>Jelajahi Katalog Kursus</span>
              </a>
            </div>
          `;
          return;
        }

        container.innerHTML = '';
        certs.forEach(cert => {
          const card = document.createElement('div');
          card.className = 'cert-card';
          card.setAttribute('role', 'listitem');

          const formattedDate = new Date(cert.issue_date || Date.now()).toLocaleDateString('id-ID', {
            year: 'numeric', month: 'long', day: 'numeric'
          });

          card.innerHTML = `
            <div>
              <div class="cert-top">
                <span class="cert-code">${cert.certificate_code}</span>
                <span class="cert-badge">
                  <i class="fa-solid fa-check"></i>
                  <span>Lulus (Skor: ${cert.exam_score}%)</span>
                </span>
              </div>
              <h3 class="cert-course-title">${escapeHtml(cert.course_title)}</h3>
              <p class="cert-meta">Instruktur: ${escapeHtml(cert.tutor_name)} • Diterbitkan ${formattedDate}</p>
            </div>
            <div class="cert-actions">
              <button type="button" class="btn btn-outline" onclick="openPreview('${cert.certificate_code}', '${escapeHtml(cert.course_title)}', '${cert.exam_score}%', '${formattedDate}')">
                <i class="fa-regular fa-eye"></i>
                <span>Pratinjau</span>
              </button>
              <a href="/api/certificates/${cert.certificate_code}/pdf" target="_blank" class="btn btn-primary">
                <i class="fa-solid fa-file-pdf"></i>
                <span>Unduh PDF</span>
              </a>
              <button type="button" class="btn btn-outline" onclick="copyVerifyUrl('${cert.certificate_code}')">
                <i class="fa-solid fa-share-nodes"></i>
                <span>Bagikan</span>
              </button>
            </div>
          `;
          container.appendChild(card);
        });
      } catch (err) {
        console.error('Error loading certs:', err);
        container.innerHTML = `<div class="empty-state" style="grid-column: 1 / -1;">Gagal memuat sertifikat Anda.</div>`;
      }
    }

    async function loadVouchers() {
      const container = document.getElementById('vouchersContainer');
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/api/milestones/discounts', {
          headers: { 'Authorization': 'Bearer ' + token }
        });
        const json = await res.json();

        const vouchers = (json.data && Array.isArray(json.data)) ? json.data : [];

        if (vouchers.length === 0) {
          container.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1;">
              <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 6px; color: var(--text-primary);">Belum Ada Voucher Diskon Aktif</p>
              <p style="font-size: 0.88rem;">Selesaikan modul kursus tepat waktu untuk membuka voucher potongan harga belanja kursus selanjutnya!</p>
            </div>
          `;
          return;
        }

        container.innerHTML = '';
        vouchers.forEach(v => {
          const card = document.createElement('div');
          card.className = 'voucher-card';
          card.setAttribute('role', 'listitem');
          card.innerHTML = `
            <div>
              <div style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 600;">VOUCHER DISKON</div>
              <div class="voucher-discount">${v.discount_pct}% OFF</div>
              <div class="voucher-code">${v.discount_code}</div>
            </div>
            <div>
              <button type="button" class="btn btn-outline" onclick="copyCode('${v.discount_code}')" aria-label="Salin Kode Voucher ${v.discount_code}">
                <i class="fa-regular fa-copy"></i>
                <span>Salin</span>
              </button>
            </div>
          `;
          container.appendChild(card);
        });
      } catch (err) {
        console.error('Error loading vouchers:', err);
        container.innerHTML = `<div class="empty-state" style="grid-column: 1 / -1;">Gagal memuat daftar voucher.</div>`;
      }
    }

    function openPreview(code, title, score, date) {
      document.getElementById('previewCertCode').textContent = 'KODE SERTIFIKAT: ' + code;
      document.getElementById('previewCourseTitle').textContent = title;
      document.getElementById('previewScore').textContent = 'Nilai: ' + score;
      document.getElementById('previewDate').textContent = 'Terbit: ' + date;
      document.getElementById('previewStudentName').textContent = localStorage.getItem('userName') || 'Siswa Pembelajar';

      document.getElementById('btnDownloadPdf').href = '/api/certificates/' + code + '/pdf';
      document.getElementById('btnOpenVerify').href = '/verify-cert/' + code;
      document.getElementById('btnCopyVerify').onclick = () => copyVerifyUrl(code);

      document.getElementById('previewModal').style.display = 'flex';
    }

    function closePreviewModal(e) {
      if (e.target.id === 'previewModal') {
        document.getElementById('previewModal').style.display = 'none';
      }
    }

    function copyVerifyUrl(code) {
      const url = window.location.origin + '/verify-cert/' + code;
      navigator.clipboard.writeText(url).then(() => {
        notifyUser('Tautan verifikasi resmi berhasil disalin ke clipboard.', 'success');
      });
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code).then(() => {
        notifyUser('Kode voucher diskon ' + code + ' berhasil disalin.', 'success');
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeIcon(currentTheme);
      loadCertificates();
      loadVouchers();
    });
  </script>
</body>
</html>
